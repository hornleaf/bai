# 智能换算数据大小
# 用法: Get-Data-Size <字节数>
# 选项:
#       <字节数> 要换算的字节数
function Get-Data-Size {
  awk -v size="$1" 'function human(x){
    s="Bytes KiB MiB GiB TiB PiB EiB ZiB YiB"
    split(s, a, " ")
    for(i=1; x>=1024 && i<length(a); i++) x/=1024
    return sprintf("%.2f %s", x, a[i])
  }
  BEGIN{print human(size)}'
}

