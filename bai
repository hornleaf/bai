# 估算当前对话的 token 占用（图片按固定值估算，不按 base64 长度）
# 用法: bai_context_tokens
function bai_context_tokens {
  local __ct_text __ct_images __ct_t
  __ct_text="$(jq -r '[
      .messages[] |
      ((.content | if type=="array" then (map(if .type=="image_url" then "" else (.text // "") end) | join("")) elif type=="string" then . else "" end)
        + (if .tool_calls then ([.tool_calls[]?.function | (.name // "") + (.arguments // "")] | join(" ")) else "" end))
    ] | join("\n")' <<< "$data" 2>/dev/null)"
  __ct_images="$(jq '[.messages[]?.content | select(type=="array") | .[] | select(.type=="image_url")] | length' <<< "$data" 2>/dev/null)"
  [[ "$__ct_images" =~ ^[0-9]+$ ]] || __ct_images=0
  __ct_t="$(Estimate-Tokens-Int "$__ct_text")"
  [[ "$__ct_t" =~ ^[0-9]+$ ]] || __ct_t=0
  echo $((__ct_t + __ct_images * 1200))
}

# 获取服务商的模型列表（带缓存）
# 用法: bai_models_json [force]
# 行为控制:
#       变量 OPENAI_BASE_URL, API_AUTH, BAI_MODELS_CACHE_TTL
function bai_models_json {
  local __mj_url __mj_cache __mj_key __mj_out __mj_age
  __mj_url="${OPENAI_BASE_URL%/}/models"
  __mj_cache="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/bai"
  mkdir -p "$__mj_cache" 2>/dev/null
  __mj_key="models-$(printf '%s' "$__mj_url" | sha256sum | cut -c1-16).json"
  if [ "${1:-}" != "force" ] && [ -s "$__mj_cache/$__mj_key" ];then
    __mj_age=$(( $(date +%s) - $(stat -c %Y "$__mj_cache/$__mj_key" 2>/dev/null || echo 0) ))
    if (( __mj_age < ${BAI_MODELS_CACHE_TTL:-86400} ));then
      cat "$__mj_cache/$__mj_key"
      return 0
    fi
  fi
  __mj_out="$(curl -sL -m 10 -X GET "$__mj_url" -H 'Accept: application/json' -H "$API_AUTH" 2>/dev/null)" || return 1
  jq -e '.data | type == "array"' <<<"$__mj_out" >/dev/null 2>&1 || return 1
  printf '%s' "$__mj_out" > "$__mj_cache/$__mj_key"
  printf '%s' "$__mj_out"
}

# 内置已知模型的上下文长度（服务端未提供时兜底）
# 可用环境变量 BAI_CONTEXT_TABLE="模型=长度,模型2=长度" 覆盖或扩展
# 用法: bai_model_context_known <模型 id>
function bai_model_context_known {
  local __mk_id="$1" __mk_kv __mk_k __mk_v
  if [ -n "${BAI_CONTEXT_TABLE:-}" ];then
    local __mk_ifs="$IFS"
    IFS=','
    for __mk_kv in $BAI_CONTEXT_TABLE;do
      IFS="$__mk_ifs"
      __mk_k="${__mk_kv%%=*}"
      __mk_v="${__mk_kv#*=}"
      if [[ "$__mk_k" == "$__mk_id" ]] && [[ "$__mk_v" =~ ^[0-9]+$ ]];then
        echo "$__mk_v"
        return 0
      fi
    done
    IFS="$__mk_ifs"
  fi
}

# 从模型列表里取上下文长度（服务端提供时），否则查内置表
# 用法: bai_model_context <模型 id>
function bai_model_context {
  local __mc_id="$1" __mc_json
  __mc_json="$(bai_models_json 2>/dev/null)" || return 1
  local __mc_val
  __mc_val="$(jq -r --arg m "$__mc_id" '
    [.data[]? | select(.id == $m)][0] as $e
    | ($e.context_window // $e.context_length // $e.max_context_length // $e.max_model_len
       // $e.max_input_tokens
       // $e.top_provider.context_length // $e.meta.n_ctx_train // empty)
    | select(type == "number" or (type == "string" and test("^[0-9]+$")))
  ' <<<"$__mc_json" 2>/dev/null)"
  if [[ "$__mc_val" =~ ^[0-9]+$ ]] && ((__mc_val>0));then
    printf '%s' "$__mc_val"
    return 0
  fi
  bai_model_context_known "$__mc_id"
}

# 从模型列表里取输入模态（逗号分隔）
# 用法: bai_model_input_modalities <模型 id>
function bai_model_input_modalities {
  local __mm_json
  __mm_json="$(bai_models_json 2>/dev/null)" || return 1
  jq -r --arg m "$1" '
    [.data[]? | select(.id == $m)][0]?.input_modalities // [] | join(",")
  ' <<<"$__mm_json" 2>/dev/null
}

# 从模型列表里取支持的思考强度档位（逗号分隔）
# 用法: bai_model_efforts <模型 id>
function bai_model_efforts {
  local __me_json
  __me_json="$(bai_models_json 2>/dev/null)" || return 1
