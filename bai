      data.setkey "tool_choice" "$BAI_CALLTOOLS"
      $BAI_LIMIT_TURNS && ((__turns++))
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.assistant_response_recorded 已完成本轮会话记录，当前进程占用内存：%s MiB" "$(ps -o rss= -p $$ | awk '{printf "%.2f", $1/1024}')")"
      unset API_RETURN
    fi

    # 获取最新一轮对话
    function Get-New-Msg(){
      jq -r '[ .messages | .[] | select(.role == "assistant") ] | last | .content' <<< "$data"
    }
    # 用户输入
    Refresh-User-Prompt
    if $__has_extend_gum;then
      OPENAI_USER_PROMPT="$(gum write --placeholder "$(L10n-zh-Hans "msg.gum_placeholder 用户输入...")")"
      _return=$?
      ((_return==130)) && { for i in {1..6};do printf "\r\e[K\e[A"; done; trap=true bye;}
      [ -z "$OPENAI_USER_PROMPT" ] || echo -e "${c36}$user_prompt${c0} $OPENAI_USER_PROMPT"
    else
      read $read_e_option -rp "$__BAI_CHAT_PS1 " OPENAI_USER_PROMPT
      _return=$?
      __bai_multline_prompt="\[${c35}\]>>\[${c0}\]"
      Get-Var-Extend __bai_multline_prompt a:p
      # 判断最后两个个字符是否是空格+反斜杠
      while [[ "$OPENAI_USER_PROMPT" =~ [[:space:]]\\$ ]];do
        OPENAI_USER_PROMPT="${OPENAI_USER_PROMPT%?}" # 去掉最后一个反斜杠
        OPENAI_USER_PROMPT="${OPENAI_USER_PROMPT%?}" # 去掉最后一个空格
        read -rp "$__bai_multline_prompt " _additional_input
        OPENAI_USER_PROMPT+="$_additional_input"
      done
    fi
    ((_return==1)) && exit
  fi
  ((${#OPENAI_USER_PROMPT}>0)) && echo "$OPENAI_USER_PROMPT" >> $HISTFILE

  # 空输入时直接跳过，避免浪费资源
  if [ -z "$OPENAI_USER_PROMPT" ];then
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.user_input_empty 用户输入为空，跳过")"
    continue
  fi

  ########################################################################
  # 参数解析
  # 注册为指令参数

    # 添加一个函数来正确解析带引号的参数
  function Parse-Quoted-Args {
      local input="$1"
      local args=()
      local arg=''
      local in_quote=false
      local quote_char=''
      local escaped=false
      local name
      for ((i=0; i<${#input}; i++)); do
          char="${input:i:1}"
          if $escaped;then
              arg+="$char"
              escaped=false
          elif [[ $char == '\' ]];then
              escaped=true
          elif $in_quote;then
              if [[ $char == $quote_char ]];then
                  in_quote=false
                  args+=("$arg")
                  arg=''
              else
                  arg+="$char"
              fi
          else
              if [[ $char == '"' || $char == "'" ]];then
                  in_quote=true
                  quote_char="$char"
                  case "$quote_char" in
                      '"') name="$(L10n-zh-Hans "msg.quote.double 双引号")";;
                      "'") name="$(L10n-zh-Hans "msg.quote.single 单引号")";;
                  esac
              elif [[ $char == ' ' || $char == $'\t' ]];then
                  if [[ -n $arg ]];then
                      args+=("$arg")
                      arg=''
                  fi
              else
                  arg+="$char"
              fi
          fi
      done
      if $in_quote;then
          erron "$(L10n-zh-Hans "error.quote_unmatched 寻找匹配的%s时遇到了未预期的行结束符" "$name")"
          return 1
      fi
      if [[ -n $arg ]];then
          args+=("$arg")
      fi
      printf "%s\n" "${args[@]}"
  }

if [[ "$OPENAI_USER_PROMPT" =~ ^\.(.+)?$ && ! "$OPENAI_USER_PROMPT" =~ ^\.run' '(.+)?$ ]];then
    readarray -t subargv < <(Parse-Quoted-Args "$OPENAI_USER_PROMPT" || echo ".pass")
  else
    subargv=($OPENAI_USER_PROMPT)
  fi
  subarg0="${subargv[0]}"
  subargs=("${subargv[@]:1}")
  # 替换 ~ 为 $HOME，但保持数组结构
  for i in "${!subargs[@]}"; do
    subargs[$i]="${subargs[$i]/'~'/$HOME}"
  done
  debug "subarg0='$subarg0', subargs=(${subargs[*]})" >&2
  # 自定义局内指令
  $INTERACT_MODE && 
  if [[ "$subarg0" =~ ^\.(.+)?$ ]];then
    CMD="${BASH_REMATCH[1]}"
    # 忽略大小写进行指令匹配
    case "${CMD,,}" in
      pass)      
      # 无操作，等价于仅回车
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.empty_instruction 空的指令，跳过")"
        continue
        ;;
      cls)       
      # 清除屏幕
        clear
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.clear_screen 清除屏幕")"
        continue
        ;;
      exit|bye) 
      # 退出会话
        exitcode="$[${subargs[0]}]"
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.exit_session 退出会话，退出码: %s" "$exitcode")"
        exit $exitcode
        ;;
      run)
      # 执行命令
        subexec="${subargs[@]}"
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.execute_command 执行命令: %s" "$subexec")"
        if $LEXEC;then
          PS1="$BAI_SHELL_PROMPT" eval "$subexec"
          CMD_RETURN=$?
        else
          PS1="$BAI_SHELL_PROMPT" bash -ic "$subexec"
          CMD_RETURN=$?
        fi
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.command_return_value 命令返回值: %s" "$CMD_RETURN")"
        continue
        ;;
      call)
      # 手动执行工具
        Get-Call-Tools "${subargs[@]}"
        continue
        ;;
      record)   
      # 记录管理
        Get-Session-Messages "${subargs[@]}"
        continue
        ;;
      list)     
      # 列出对话记录
        Get-Session-History
        continue
        ;;
      clear)     
      # 清空对话
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.clear_conversation 清除对话轮数据和提交的文件...")"
        data="${old_data}"
        __turns=0
        unset old_filepath
        BAI_USERNAME="${BAI_USERNAME_OLD}"
        BAI_TITLE="${BAI_TITLE_OLD}"
        $INTERACT_MODE && Set-Terminal-Title "$BAI_TITLE"
        msg "$(L10n-zh-Hans "msg.conversation_cleared 对话已清空")"
        continue
        ;;
      help|\?)   
      # 显示帮助
        Get-Session-Help "${subargs[@]}"
        continue
        ;;
      set)
      # 设置
        argcs="${SET_ALIAS[*]//:*/,}"
        for i in debug-output erron-effect eval-skipask interact-complete local-execute print-effect;do
          argcs="${argcs/$i/b:$i}"
        done
        alias=set cmd=Set-Session-Functions \
        argc_set="$argcs" \
        argc_set_desc="${SET_DESCRIPTION[*]/#/$'\n'}" \
        argc_call_tools="${__bai_function_tools[*]/#/i:}" \
        argc_chat_model="${OPENAI_API_MODEL_in_array[*]}" \
        argc_enable_search="${__bai_shared_switches[*]}" \
        argc_enable_thinking="${__bai_shared_switches[*]}" \
        argc_reasoning_effort="${reasoning_effort_options[*]}" \
        Interactive-Completion \
        Set-Session-Functions "${subargs[@]}"
        continue
        ;;
      # 尝试执行 shell 命令
      eval)
        [ "$subargs" ] || continue
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.eval_mode 提交一段临时的提示词，并启用 EVAL 模式")"
        # OPENAI_USER_PROMPT="[!] 本次对话你只需要提供可以直接使用的终端命令或 Bash 脚本，我将执行它，我不需要你对此做任何解释，我很清楚后果。| [!] In this conversation, all you need to do is provide a terminal command or Bash script that can be used directly, and I will execute it. I don't need you to explain anything about it, I am aware of the consequences."$'\n'"${subargs[@]:1}"
        # data.setkey "tool_choice" "none"
        eval_system_prompt='You are a command-generation assistant. Your sole purpose is to output valid, executable commands based on user requests.\n\n**Rules:**\n- Respond **only** with the command(s) — no explanations, descriptions, or additional text.\n- If multiple commands are needed, separate them with `&&` or newlines.\n- Assume a Linux/bash environment unless the user specifies otherwise.\n- If the request is ambiguous, output the most common default command and nothing else.\n- Do not ask clarifying questions; if unable to generate a command, output `echo "Error"` (or a safe fallback).\n**Example:**\nUser: "list all files sorted by size"\nOutput: `ls -lS`'
        eval_system_prompt+="$(cat /etc/os-release 2>/dev/null || :)"
        data="$(jq --arg model "$OPENAI_API_MODEL" --arg sys "$eval_system_prompt" --arg msg "${subargs[@]}" '. | .model = $model | .messages[0].content = $sys | .messages[1].content = $msg' <<<'{"stream":false,"messages":[{"role":"system"},{"role":"user"}]}')" \
        Wait-Assistant-Content
        return_cmd="$(jq -r '.choices[0].message.content' <<< "$CURL_GET_API" 2>/dev/null)"
        if [[ "$return_cmd" && ! "$return_cmd" == null ]];then
          echo -e "\$ $c35$return_cmd$c0"
          if [[ "$(Dialog-Confirm "$(L10n-zh-Hans "eval_mode.confirm_message 确定执行以上命令？")" no)" == yes ]];then
            bash -c "$return_cmd"
            echo "Exit code: $?"
          else
            msg "$(L10n-zh-Hans "eval_mode.confirm_cancel 取消")"
          fi
        else
          Get-ReturnError-Info
        fi
        continue
        ;;
      code)
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.copy_code_block 复制代码块")"
        Get-New-Msg | Get-MarkDown-CodeBlocks "${subargs[@]}"
        continue
        ;;
      files)      
      # 提交文件
        Set-Temp-File "${subargs[@]}"
        continue
        ;;
      at)
      # 提及在服务商存储的文件并发出提问
        Get-AtFiles-Ask "${subargs[@]}" || continue
        ;;
      # 向对话提供文件内容
      file)
        Get-Import-File "${subargs[@]}"
        continue
        ;;
      *)        
      # 排除未知指令
      if [ "$CMD" ];then
        erron "$(L10n-zh-Hans "error.unknown_command 未知的指令 \"%s\"" "$CMD")"
      else
        erron "$(L10n-zh-Hans "error.empty_command 空的指令")"
      fi
      continue
    esac
  elif [[ "$subarg0" =~ ^\!(.+)?$ ]];then
    # 直接执行 shell 命令
    subexec="${subargv[*]#!}"
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.execute_command_shortcut 直接执行命令快捷方式: %s" "$subexec")"
    if $LEXEC;then
      PS1="$BAI_SHELL_PROMPT" eval "$subexec"
      CMD_RETURN=$?
    else
      PS1="$BAI_SHELL_PROMPT" bash -ic "$subexec"
      CMD_RETURN=$?
    fi
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.command_return_value_shortcut 命令返回值: %s" "$CMD_RETURN")"
    continue
  elif [[ "$subarg0" =~ ^\:(.+)?$ ]];then
    # 执行工具函数
    toolcalls_head="${subarg0#:}"
    Get-Call-Tools "$toolcalls_head" "${subargs[@]}"
    continue
  fi
  

  ########################################################################
  # 构建请求，主要逻辑实现
  if $IS_PUSH_IMAGE;then
    __read="$(jq --rawfile image <(echo "$IMAGE_INPUT") --arg content "$OPENAI_USER_PROMPT" '.messages += [{"role": "user", "content": [{"type": "text", "text": $content},{"type": "image_url", "image_url": { "url": $image}}]}]' <<< "$data")"
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.push_image 提交图片数据")"
    IS_PUSH_IMAGE=false
  else
    __read="$(jq --arg content "$STDIN_INPUT$OPENAI_USER_PROMPT" '.messages += [{"role": "user", "content": $content}]' <<< "$data")"
  fi

  if [[ "$OPENAI_USER_PROMPT" == *@file:* ]];then
    file_id="${OPENAI_USER_PROMPT#*@file:}"
    user_atfile_prompt="${OPENAI_USER_PROMPT%@file:*}"
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.at_file 提及文件ID: %s" "$file_id")"
    __read="$(jq --arg content "$user_atfile_prompt" --arg file_id "$file_id" '.messages += [{"role": "user", "content": [{"type": "text", "text": $content},{"type": "file", "file_id": $file_id}]}]' <<< "$data")"
  fi

  if $OPENAI_ENABLE_PARTIAL;then
    if [[ "$OPENAI_USER_PROMPT" == *@prefix ]];then
      OPENAI_USER_PROMPT="${OPENAI_USER_PROMPT%@prefix}"
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.partial_prompt 使用局部提示词")"
      data="$(jq --arg content "$OPENAI_USER_PROMPT" '.messages += [{"role": "assistant", "content": $content, "partial": true}]' <<< "$data")"
    else
      data="$__read"
    fi
  else
    data="$__read"
  fi
  unset STDIN_INPUT

  # 流模式分支
  $OPENAI_ENABLE_STREAM && { Get-Stream-Assistant-Content; continue; }
  # 构建接口请求
  if ! $DEBUG_MODE;then
    # 异步请求接口
    Wait-Assistant-Content
  else
    echo -en " + POST: $OPENAI_BASE_URL\n"\
            "+ DATA: "
    jq -C <<< "$data"
    echo
    API_RETURN="this a test message."
    continue
  fi

  # 检查响应中的错误
  if $(jq 'has("error")' <<< "$CURL_GET_API" 2>/dev/null);then
    ERROR_MSG=$(jq --exit-status -r '.error.message' <<< "$CURL_GET_API" 2>/dev/null || echo "$(L10n-zh-Hans "error.unexpected_request_error 请求时发生了意料之外的错误")")
    erron "$ERROR_MSG"
    unset API_RETURN
    continue
  else
    # 检查是否使用了工具
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.check_tools 检查是否使用了工具")"
    TOOLS_IS_CALL=false
    if $USE_TOOLS;then
      API_RETURN="$(jq --exit-status '.choices[0].message.tool_calls' <<< "$CURL_GET_API" 2>/dev/null)"
      API_STATUS=$?
      ! ((API_STATUS)) && { TOOLS_IS_CALL=true; debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.tools_found 发现模型使用了工具")"; } || { TOOLS_IS_CALL=false;debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.tools_not_used 模型还未使用工具")" ;Get-Assistant-Content; }
    else
      Get-Assistant-Content
      TOOLS_IS_CALL=false
    fi
    if ((API_STATUS)) && [[ "$API_RETURN" == "null" ]];then
      erron "$(L10n-zh-Hans "error.request_not_accepted 该次请求未正确被接受")"
      unset API_RETURN
    else
      # 调用工具，暂无多轮工具调用计划
      $TOOLS_IS_CALL || { Return-Assistant-Content; continue; }
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.init_tool_call 初始化工具调用")"
      _local_json_path='.choices[0].message.tool_calls[0].function'
      function_id="$(jq -r ".choices[0].message.tool_calls[0].id" <<< "$CURL_GET_API")"
      function_args="$(jq -r "$_local_json_path.arguments" <<< "$CURL_GET_API" | jq '.[]' | tr '\n' ' ')"
      function_run_name="$(jq -r "$_local_json_path.name" <<< "$CURL_GET_API")"
      function_name="$function_head::$function_run_name"
      function_call_msg="$(jq -r ".choices[0].message" <<< "$CURL_GET_API")"
      data="$(jq --argjson content "$function_call_msg" ' .messages += [$content]' <<< "$data")"
      local term_width="$(Get-TWidth)"
      echo -e " ${c35}┏${c0} $(L10n-zh-Hans "set_temp_file_messages.tool_calling 工具调用中")..."
      echo -en " ${c35}┃${c0} ${c34}❯${c0} "
      local execute_title="$function_run_name$([[ "$function_args" =~ ^(\{\})+$ ]] || echo ", arg: $function_args")"
      output_width=$(($(wc -L <<<"$execute_title")+26))
      if (((term_width-28)<output_width));then
        fold -s -w $((term_width-28)) <<< "$execute_title" | head -2 | sed '2s/.*/.../' | sed ':a;N;$!ba;s/\n//g'
      else
        echo "$execute_title"
      fi
      explicitly="${gco_explicitly[$function_name]}"
      catch_stderr="${gco_getstderr[$function_name]}"
      Get-Command-Output "$function_name $function_args"
      function_return="$gco_return_content"
      RETURN=$gco_status
      ((RETURN)) && { emsg "$(L10n-zh-Hans "error.tool_execution_failed 工具执行失败")";continue;}
      data="$(jq --arg content "$function_return" --arg id "$function_id" ' .messages += [{"role": "tool","content": $content, "tool_call_id": $id}]' <<< "$data")"
      Wait-Assistant-Content
      Get-Assistant-Content
      (((API_STATUS)) && [[ "$API_RETURN" == "null" ]]) || { Return-Assistant-Content; continue; }
      erron "$(L10n-zh-Hans "error.request_not_accepted 该次请求未正确被接受")"
      unset API_RETURN
      continue
    fi
  fi
done

# 拦截此后所有内容执行
exit $?

