# 指令补全注册模板
function instruct.append(){
  source /dev/stdin <<FUNCTION_CODE_BLOCK
    __instruct.${1}(){
      COMPREPLY=()
      local cur=\${COMP_WORDS[COMP_CWORD]}
      local prev=\${COMP_WORDS[COMP_CWORD-1]}
      local words=("\${COMP_WORDS[@]}")
      local cword="\${COMP_CWORD}"
      local argc=\${#words[@]}
      local argv=("\${words[@]}")
      local name=.${1}
      $([ -t 0 ] && echo : || cat)
    }
    complete -o nospace -F __instruct.${1} .${1}
    .${1}(){ :;}
FUNCTION_CODE_BLOCK
}

if $local_complete;then
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.local_complete_available Bash ReadLine 高级补全功能可用，正在注册指令补全规则...")"
  # 局内设置
  instruct.append set <<'EOM'
  case "$prev" in
    "$name")
      COMPREPLY=($(compgen -W "${SET_ALIAS[*]%:*}" -- "$cur"))
    ;;
    chat-model)
      COMPREPLY=($(compgen -W "${OPENAI_API_MODEL_in_array[*]}" -- "$cur"))
    ;;
    call-tools)
      COMPREPLY=($(compgen -W "${BAI_CALLTOOLS_in_array[*]}" -- "$cur"))
    ;;
    enable-search|enable-thinking)
      COMPREPLY=($(compgen -W "${__bai_shared_switches[*]}" -- "$cur"))
    ;;
    reasoning-effort)
      COMPREPLY=($(compgen -W "${reasoning_effort_options[*]}" -- "$cur"))
    ;;
    *)
      COMPREPLY=($(compgen -W "true false" -- "$cur"))
    ;;
  esac
EOM
  # 复制代码块
  instruct.append code <<'EOM'
  local codelet="$(seq $(Get-New-Msg | gawk '/^\s*```/ { count++ } END { print count / 2 }'))"
  case "$prev" in
    "$name")
      COMPREPLY=($(compgen -W "preview $codelet" -- "$cur"))
    ;;
    preview)
      COMPREPLY=($(compgen -W "$codelet" -- "$cur"))
    ;;
  esac
EOM
  # 会话管理
  instruct.append record <<'EOM'
  case "$prev" in
    "$name")
      COMPREPLY=($(compgen -f -- "$cur"))
    ;;
    export)
      COMPREPLY=($(compgen -W "@no:tool @no:system @use:all @default" -- "$cur"))
    ;;
    *)
      COMPREPLY=($(compgen -W "export import" -- "$cur"))
    ;;
  esac
EOM

  # 会话帮助
  instruct.append help <<'EOM'
  case "$prev" in
    "$name")
      COMPREPLY=($(compgen -W "help exit clear code pass files file run eval set record cls list" -- "$cur"))
    ;;
  esac
EOM

  # 文件管理
  instruct.append files <<'EOM'
  case "$prev" in
    "$name")
      COMPREPLY=($(compgen -W "push list del" -- "$cur"))
    ;;
    push)
      COMPREPLY=($(compgen -f))
    ;;
    *)
      if [[ "${argv[1]}" == "push" && $cword == 3 ]];then
        COMPREPLY=($(compgen -W "assistants fine-tune file-extract batch user_data" -- "$cur"))
      fi
    ;;
  esac
EOM

  # 用户使用工具函数
  instruct.append call <<'EOM'
  case "$prev" in
    "$name")
      COMPREPLY=($(compgen -W "${__bai_function_tools[*]}" -- "$cur"))
    ;;
  esac
EOM

  # 仅路径补全
  for i in file;do
    complete -o nospace -f .$i
    eval ".${i}(){ :;}"
  done

  # 仅占位
  for i in {list,pass,exit,bye,clear,cls,run,eval,set,\?};do
    eval ".${i}(){ :;}"
  done

  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.instruct_registered 指令补全规则注册完成。")"

fi

