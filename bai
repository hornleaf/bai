        sed -E \
            -e 's|\$\{?c3([0-9])\}?|\\e[3\1m|g' \
            -e 's|\$\{?c([0-9])\}?|\\e[\1m|g' \
            -e 's|\$\{?c237\}?|\\e[2\;37m|g' \
        >> "$ARG_EXPORT_L10N_FILE"
        echo "$(L10n-zh-Hans "option.export_l10n_file.export_successfully 成功导出本地化文本到文件:") $ARG_EXPORT_L10N_FILE"
        exec true
      else
        exmsg "$__bai_option_name: $ARGS_ERR"
      fi
