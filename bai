  STDIN_INPUT+="$(printf 'File: %s\n@File Content Head\n' "$filepath"; cat -n "$filepath" | sed -E 's/^([[:space:]]*[0-9]+)/\1 |/g')"$'\n@File Content Tail\n'
  return 0
}

# 解析提示词中的 @文件/@图片 提及
# 用法: bai_resolve_at_mentions
# 行为控制:
#       变量 OPENAI_USER_PROMPT, STDIN_INPUT, IMAGE_INPUTS, IS_PUSH_IMAGE
#       支持 @path、@"path with space"、@'path with space'
#       图片加入待发送队列，文本追加进标准输入缓冲，并把解析成功的提及从提示词中移除
function bai_resolve_at_mentions {
  [[ "$OPENAI_USER_PROMPT" == *"@"* ]] || return 0
  local remaining="$OPENAI_USER_PROMPT" out="" head rest path real
  local token_len handled
  while [[ "$remaining" == *"@"* ]];do
    head="${remaining%%@*}"
    rest="${remaining#*@}"
    out+="$head"
    path=""
    token_len=0
    if [[ "$rest" =~ ^\"([^\"]*)\" ]];then
      path="${BASH_REMATCH[1]}"
      token_len=$((${#path}+2))
    elif [[ "$rest" =~ ^\'([^\']*)\' ]];then
      path="${BASH_REMATCH[1]}"
      token_len=$((${#path}+2))
    elif [[ "$rest" =~ ^([^[:space:]\"\']+) ]];then
      path="${BASH_REMATCH[1]}"
      token_len=${#path}
    fi
    handled=false
    # @prefix 是局部续写标记，不当作本地路径
    [[ "$path" == "prefix" && "$OPENAI_ENABLE_PARTIAL" == true ]] && path=""
    # @file:xxx 属于服务商文件 ID 语法，不当作本地路径
    if [[ -n "$path" && "$path" != *:* ]];then
      real="${path/#\~/$HOME}"
      if [[ -f "$real" ]] && Check-File-Type "$real";then
        case "$check_file_type" in
          image)
            local __image_size
            __image_size=$(stat -c %s "$real" 2>/dev/null)
            if ((__image_size>52428800));then
              erron "$(L10n-zh-Hans "get_import_file.file_too_large 过大的文件") ($(Get-Data-Size "$__image_size") > 50 MiB)"
            else
              IMAGE_INPUTS+=("$(bai_image_data_uri "$real")")
              IS_PUSH_IMAGE=true
              handled=true
              msg "$(L10n-zh-Hans "get_import_file.image_submitted 提交图片") ${c35}${real##*/}${c0}"
            fi
            ;;
          text)
            if bai_append_text_file "$real";then
              handled=true
              msg "$(L10n-zh-Hans "get_import_file.file_submitted 提交文件") $real"
            fi
            ;;
        esac
      fi
    fi
    if $handled;then
      remaining="${rest:token_len}"
      # 顺带吃掉紧跟的一个空格，避免留下双空格
      [[ "$remaining" == " "* ]] && remaining="${remaining# }"
      continue
    fi
    out+="@"
    remaining="$rest"
  done
  out+="$remaining"
  # 去掉首尾多余空格
  out="${out#"${out%%[! ]*}"}"
  out="${out%"${out##*[! ]}"}"
  OPENAI_USER_PROMPT="$out"
}


