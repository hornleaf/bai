## 筛查非法值
typeof_index=0

# 变量名,变量类型
type_of=(
  # BAI 内建
  "BAI_TITLE",string                # 标题
  "BAI_USERNAME",string             # 用户名
  "BAI_LIMIT_TURNS",boolean         # 限制对话轮次
  "BAI_WAIT_STYLE",string           # 等待样式
  "BAI_WAIT_GRADIENT",string        # 等待指示器渐变模式
  "BAI_WAIT_GRAY_STYLE",string      # 灰度渐变风格
  "BAI_LOGO_FILE",string            # 自定义 logo 文件
  "BAI_LOGO_MODE",string            # logo 色彩模式
  "BAI_LIMIT_TOOLS",boolean         # 限制工具调用
  "BAI_CALLING_FILE",string         # 调用工具文件
  "BAI_PRINT_WELCOME",boolean       # 显示欢迎词
  "BAI_INTERACT_COMPLE",boolean     # 交互式命令补全
  # OpenAI 接口
  "OPENAI_API_KEY",string           # 接口密钥
  "OPENAI_API_MODEL",string         # 接口模型
  "OPENAI_API_TEMP",number          # 接口温度
  "OPENAI_TOP_K",number             # 接口TopK
  "OPENAI_TOP_P",number             # 接口TopP
  "OPENAI_PRESENCE",number          # 接口存在惩罚
  "OPENAI_FREQUENCY",number         # 接口频率惩罚
  "OPENAI_TEXT_NUM",number          # 接口文本数量
  "OPENAI_MAX_TOKENS",number        # 接口最大令牌
  "OPENAI_BASE_URL",url             # 接口原始地址
  "OPENAI_INCLUDE_USAGE",boolean    # 接口是否获取上下文占用
  "OPENAI_ENABLE_STREAM",boolean    # 接口是否开启流式
  "OPENAI_ENABLE_THINKING",string   # 接口是否开启思考
  "OPENAI_ENABLE_SEARCH",string     # 接口是否开启搜索
  "OPENAI_ENABLE_PARTIAL",boolean   # 接口是否开启部分输出
  "OPENAI_REASONING_EFFORT",string  # 推理努力程度
)

# 创建非法值列表
type_invalid=()
type_invalid_value=()

# 检查变量类型
for i in ${type_of[@]};do
  type_value="${i%,*}"
  type_in="${i#*,}"
  type_r="$(Check-Variable-Type "$type_value")"
  [[ "$type_r" == "$type_in" || -z "${!type_value}" ]] || {
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.variable_type_check_failed 变量 ${c32}%s${c0} 类型检查未通过，加入非法值列表" "$type_value")"
    type_invalid+=($type_value $type_in $type_r)
    type_invalid_value+=("${type_value}" "${!type_value}")
  }
done

# 报告异常的变量
if ! ((${#type_invalid[@]}==0));then
  emsg "$(L10n-zh-Hans "env.vars_type_invalid 环境变量类型异常")"
  echo -e "${c34}$(L10n-zh-Hans "env.vars_invalid_list 异常变量:")${c0}"
  printf " - ${c32}%s${c0}=${c31}%s${c0}\n" "${type_invalid_value[@]}"
  echo -e "${c34}$(L10n-zh-Hans "env.vars_invalid_explanation 说明:")${c0}"
  printf " - $(L10n-zh-Hans "env.invalid_explanation_detail.value 变量 ${c32}%%s${c0} 应该使用 ${c34}%%s${c0} 类型，但是错误的使用了 ${c31}%%s${c0} 类型")\n" "${type_invalid[@]}"
  echo
  let typeof_index++
fi

debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.type_check_complete.value 筛查变量类型完成, 继续筛查多目标类型变量...")"

# 组合多目标变量列表
vararray_typeof=(
  "OPENAI_API_MODEL"::string       # 接口模型
  "BAI_CALLTOOLS"::string          # 工具使用强度
  "BAI_REASONING_REPLACE"::string  # 推理替换选项
)

# 检查多目标类型变量
for i in ${vararray_typeof[@]};do
  var="${i%::*}"
  type="${i#*::}"
  Check-VarArray-Type "${!var}" "$type" "${var}"
done

# 报告异常的多目标类型变量
if ! ((${#__check_vararray[@]}==0));then
  emsg "$(L10n-zh-Hans "env.vars_composite_type_invalid 环境变量多目标类型异常")"
  echo -e "${c34}$(L10n-zh-Hans "env.vars_invalid_list 异常变量:")${c0}"
  printf " - ${c32}%s${c0}\n" "${__check_vararray[@]}"
  echo -e "${c34}$(L10n-zh-Hans "env.vars_invalid_explanation 说明:")${c0}"
  printf " - $(L10n-zh-Hans "env.invalid_explanation_detail.values 变量 ${c32}%%s${c0} 其中部分值 ${c33}%%s${c0} 并非 ${c34}%%s${c0} 类型，而是错误的使用了 ${c31}%%s${c0} 类型")\n" "${__check_vararray[@]}" "${__check_vararray_type[@]}"
  echo
  let typeof_index++
fi

((typeof_index==0)) || {
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.env_vars_check_failed 环境变量类型检查未通过，退出脚本")"
  exit 1
}

debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.type_check_complete.values 变量类型检查完成, 将多目标类型变量转换为数组...")"

# 将组合类型变量转换为数组, 并覆写第一个索引作为默认值 key => key_in_array, key_in_array[0] => key
for i in ${vararray_typeof[@]};do
  i="${i%::*}"
  if [[ "${!i}" =~ ^([^,]+)(,[^,]+)*$ ]];then
    eval "${i}_in_array=(${!i//,/ })"
    eval "$i=\"\$${i}_in_array\""
  fi
done

# 单独处理模型组
if [ "$OPENAI_API_MODEL_in_array" ];then
  declare -A OPENAI_API_MODEL_CONTEXT_LENGTH
  for ((n=0;n<${#OPENAI_API_MODEL_in_array[@]};n++));do
    i="${OPENAI_API_MODEL_in_array[n]}"
    [[ "$i" =~ ^(.+?)\[(.+?)\]$ ]] || continue
    __model_name="${BASH_REMATCH[1]}"
    __model_context_length="${BASH_REMATCH[2]}"
    [[ "$(Check-Variable-Type __model_context_length)" == number ]] || { exmsg "$(L10n-zh-Hans "model_list.illegal_length_marking 模型 $c33%s$c0: 非法的的上下文长度标识 $c35%s$c0" "$__model_name" "$__model_context_length")";}
    [[ "$__model_context_length" =~ ^([0-9]+)([km])$ ]] || continue
    __context_length_size="${BASH_REMATCH[1]}"
    __context_length_order="${BASH_REMATCH[2]}"
    case $__context_length_order in
      k) let __context_length_size=__context_length_size*10**3 ;;
      m) let __context_length_size=__context_length_size*10**6 ;;
    esac
    OPENAI_API_MODEL_CONTEXT_LENGTH["$__model_name"]="$__context_length_size"
    OPENAI_API_MODEL_in_array[n]="$__model_name"
  done
  OPENAI_API_MODEL="$OPENAI_API_MODEL_in_array"
fi

# 模型名若为 gguf 路径（llama.cpp 常见），界面只显示文件名
if [ -z "${BAI_MODEL_DISPLAY:-}" ] && [[ "$OPENAI_API_MODEL" == *.gguf ]];then
  BAI_MODEL_DISPLAY="$(basename "$OPENAI_API_MODEL")"
fi

# 未显式标注 [Nk] 时，尝试从 /models 探测上下文长度（服务端提供时）
if [[ -z "${OPENAI_API_MODEL_CONTEXT_LENGTH[$OPENAI_API_MODEL]:-}" ]] \
   && [[ "${BAI_CONTEXT_FROM_API:-true}" != "false" ]];then
  __bai_probe_cl="$(bai_model_context "$OPENAI_API_MODEL" 2>/dev/null)"
  if [[ "$__bai_probe_cl" =~ ^[0-9]+$ ]] && ((__bai_probe_cl>0));then
    OPENAI_API_MODEL_CONTEXT_LENGTH["$OPENAI_API_MODEL"]="$__bai_probe_cl"
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.models_context_detected 从模型列表探测到上下文长度: %s" "$__bai_probe_cl")"
  fi
fi

# --models：打印模型列表后退出
if ${BAI_SHOW_MODELS:-false};then
  bai_models_print || exmsg "$(L10n-zh-Hans "models.fetch_failed 获取模型列表失败")"
  exit 0
fi

# 思考强度校验：服务端声明了 supported_levels 时，不在档位内就回落到默认档位
if [[ "${OPENAI_REASONING_EFFORT:-default}" != "default" && "$OPENAI_REASONING_EFFORT" != "none" ]];then
  __bai_efforts="$(bai_model_efforts "$OPENAI_API_MODEL" 2>/dev/null)"
  if [ -n "$__bai_efforts" ] && [[ ",$__bai_efforts," != *",$OPENAI_REASONING_EFFORT,"* ]];then
    __bai_eff_default="$(bai_model_effort_default "$OPENAI_API_MODEL" 2>/dev/null)"
    erron "$(L10n-zh-Hans "models.effort_unsupported 模型 %s 不支持思考强度 %s（支持: %s）" "$OPENAI_API_MODEL" "$OPENAI_REASONING_EFFORT" "$__bai_efforts")"
    if [ -n "$__bai_eff_default" ];then
      OPENAI_REASONING_EFFORT="$__bai_eff_default"
      msg "$(L10n-zh-Hans "models.effort_fallback 已回落到默认档位 %s" "$__bai_eff_default")"
    fi
  fi
fi


########################################################################

debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.building_openai_basic_request_body 构建 OpenAI 基本请求体...")"

# 制作起始请求内容
builtin printf -v data \
  '{
    "model": "%s",
    "stream": %s,
    "messages": []
  }' \
  "$OPENAI_API_MODEL" "$OPENAI_ENABLE_STREAM"

  $OPENAI_ENABLE_STREAM && $OPENAI_INCLUDE_USGAE && data="$(jq '.stream_options.include_usage = true' <<<"$data")"

debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.openai_basic_request_body_complete 基本请求体构建完成, 继续扩展请求体...")"

# 检查键存在
function data.haskey(jq -e "$1" <<< "$data" &>/dev/null)

# 删除键值
function data.delkey { data=$(jq "del(.\"$1\")" <<< "$data"); }

# 动态加入键值（json 格式）
function data.append(){
  local key="$1" value="$2" type="$3"
  [[ "$type" == "--no-json" ]] && type="" || type="json"
  [[ -n "$value" ]] && data=$(jq --arg"$type" "$key" "$value" ". += {\"$key\": \$$key}" <<< "$data")
}

# 灵活修改键值
function data.setkey(){
  local key="$1" value="$2" type="$3"
  [[ "$type" == "--json" ]] && type="json" || type=""
  [[ -n "$value" ]] && data=$(jq --arg"$type" "$key" "$value" ".\"$key\" = \$$key" <<< "$data")
}

# 动态加入系统提示
function system_msg.append(){
  local content="$1"
  data="$(jq --arg content "$content" '.messages += [{"role": "system", "content": $content}]' <<< "$data")"
}

# 预留共用的开关值
__bai_shared_switches=(
  default
  enable
  disable
)

# 可自定义的思考开关
function thinking.setkey(){
  local key="${BAI_THINKING_OPTION:-thinking}"
  local enable_value="${BAI_THINKING_KEY_ENABLE:-{\"type\":\"enabled\"}}"
  local disable_value="${BAI_THINKING_KEY_DISABLE:-{\"type\":\"disabled\"}}"
  local extra="${BAI_THINKING_KEY_ISOBJECT:-true}"
        [[ "$extra" == true ]] && extra="--json" || extra=""
  if [[ "$1" == "default" ]];then
    data.delkey "$key"
    ${BAI_FUNC_SILENCE:-false} ||
      msg "$(L10n-zh-Hans "option.thinking.del_value 思考选项将使用供应商默认值")"
    return 0
  fi
  if ! data.haskey "$key";then
    [[ "$OPENAI_ENABLE_THINKING" == "enable" ]] &&
    data.append "$key" "$enable_value" "$extra"
  fi
  if [[ "$1" == "enable" ]];then
    data.setkey "$key" "$enable_value" --json
    ${BAI_FUNC_SILENCE:-false} ||
      msg "$(L10n-zh-Hans "option.thinking.enable_value 思考选项已启用")"
      return 0
  elif [[ "$1" == "disable" ]];then
    data.setkey "$key" "$disable_value" --json
    ${BAI_FUNC_SILENCE:-false} ||
      msg "$(L10n-zh-Hans "option.thinking.disable_value 思考选项已禁用")"
      return 0
  fi
  emsg "$(L10n-zh-Hans "option.thinking.invalid_value 思考选项无效: ${c33}%s${c0}, 可选值: ${c32}%s${c0}" "$1" "delete | enable | disable")"
}

# 可自定义的搜索开关
function search.setkey(){
  local key="${BAI_SEARCH_OPTION:-enable_search}"
  local enable_value="${BAI_SEARCH_KEY_ENABLE:-true}"
  local disable_value="${BAI_SEARCH_KEY_DISABLE:-false}"
  local extra="${BAI_SEARCH_KEY_ISOBJECT:-false}"
        [[ "$extra" == true ]] && extra="--json" || extra=""
  if [[ "$1" == "default" ]];then
    data.delkey "$key"
    ${BAI_FUNC_SILENCE:-false} ||
      msg "$(L10n-zh-Hans "option.search.del_value 搜索选项将使用供应商默认值")"
    return 0
  fi
  if ! data.haskey "$key";then
    [[ "$OPENAI_ENABLE_SEARCH" == "enable" ]] &&
    data.append "$key" "$enable_value" "$extra"
  fi
  if [[ "$1" == "enable" ]];then
    data.setkey "$key" "$enable_value"
    ${BAI_FUNC_SILENCE:-false} ||
      msg "$(L10n-zh-Hans "option.search.enable_value 搜索选项已启用")"
      return 0
  elif [[ "$1" == "disable" ]];then
    data.setkey "$key" "$disable_value"
    ${BAI_FUNC_SILENCE:-false} ||
      msg "$(L10n-zh-Hans "option.search.disable_value 搜索选项已禁用")"
      return 0
  fi
  emsg "$(L10n-zh-Hans "option.search.invalid_value 搜索选项无效: ${c33}%s${c0}, 可选值: ${c32}%s${c0}" "$1" "default | enable | disable")"
}

# 初始化思考强度选项
declare -A reasoning_effort_map=([default]="default" [low]="low" [medium]="medium" [high]="high" [xhigh]="xhigh")
for i in "${BAI_REASONING_REPLACE_in_array[@]}"; do
  replace_key="${i%:*}"
  replace_value="${i#*:}"
  # 除了 default 以外均可替换，default 作为硬编码保留值
  [ "$replace_key" == "default" ] && continue
  if [ "${reasoning_effort_map["$replace_key"]}" ];then
    reasoning_effort_map["$replace_key"]="$replace_value"
  fi
done
reasoning_effort_options=("${reasoning_effort_map[@]}")
# 可自定义的思考强度设置
function reasoning_effort.setkey(){
  [ "$1" ] || return 1
  local key="reasoning_effort"
  case "$1" in
    default)
      data.haskey "$key" && data.delkey "$key"
      ${BAI_FUNC_SILENCE:-false} ||
        msg "$(L10n-zh-Hans "option.reasoning_effort.default_value 将使用供应商默认的推理强度")"
      return 0
      ;;
    *)
      local found=false
      for i in "${reasoning_effort_options[@]}";do
        if [[ "$i" == "$1" ]];then
          data.setkey "$key" "$1"
          ${BAI_FUNC_SILENCE:-false} ||
            msg "$(L10n-zh-Hans "option.reasoning_effort.set_value 推理强度已设置为: ${c32}%s${c0}" "$1")"
          found=true
          return 0
        fi
      done
      if ! ${found:-false} && ! ${BAI_FUNC_SILENCE:-false};then
        emsg "$(L10n-zh-Hans "option.reasoning_effort.invalid_value 推理强度选项无效: ${c33}%s${c0}, 可选值: ${c32}%s${c0}" "$1" "${reasoning_effort_options[*]}")"
        return 1
      fi
      ;;
  esac
}

# 初始化
BAI_FUNC_SILENCE=true         thinking.setkey "$OPENAI_ENABLE_THINKING"
BAI_FUNC_SILENCE=true           search.setkey "$OPENAI_ENABLE_SEARCH"
BAI_FUNC_SILENCE=true reasoning_effort.setkey "$OPENAI_REASONING_EFFORT"
data.append "max_tokens"        "$OPENAI_MAX_TOKENS"   # 最大 tokens 输出量
data.append "n"                 "$OPENAI_TEXT_NUM"     # 文本范围
data.append "temperature"       "$OPENAI_API_TEMP"     # 模型温度
data.append "top_k"             "$OPENAI_TOP_K"        # 贪婪采样
data.append "top_p"             "$OPENAI_TOP_P"        # 精简采样
data.append "presence_penalty"  "$OPENAI_PRESENC"      # 重复惩罚
data.append "frequency_penalty" "$OPENAI_FREQUENCY"    # 频率惩罚

# 结束标语
if [ "$OPENAI_STOP_TEXTS" ];then
  array2json="$(jq -n --args '$ARGS.positional' --args "${OPENAI_STOP_TEXTS[@]}")"
  data.append "stop" "$array2json"                     # 结束标语
fi

debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.expanding_personalized_content 正在扩展个性化内容...")"

# 用户名
[ "$BAI_USERNAME" ] && {
  system_msg.append "$(L10n-zh-Hans "bai_prompt.system.username_notification 你需要以此称呼用户: \"%s\", **强调: 这是用户名, 不是你所使用的昵称**" "$BAI_USERNAME")"
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.username_used 使用的用户名: %s" "$BAI_USERNAME")"
}

# 提示命令
[ "$OPENAI_SYSTEM_PROMPT" ] &&
system_msg.append "$(
  sed "
    s|{{user.name}}|${BAI_USERNAME:-None}|g;
    s|{{user.gender}}|${BAI_USERGENDER:-None}|g;
    s|{{user.age}}|${BAI_USERAGE:-None}|g
  " \
  <<< "$OPENAI_SYSTEM_PROMPT"
)"

# 会话恢复（--continue / --resume）
if [ -n "${BAI_SESSION_RESUME:-}" ];then
  if bai_session_load "$BAI_SESSION_RESUME";then
    msg "$(L10n-zh-Hans "session.resumed 已恢复会话 %s（%s 条消息，模型 %s）" "$BAI_SESSION_ID" "$(jq '.messages | length' <<<"$data")" "$BAI_SESSION_RESUME_MODEL")"
  else
    erron "$(L10n-zh-Hans "session.resume_failed 未找到可恢复的会话: %s" "$BAI_SESSION_RESUME")"
  fi
fi
[ -n "${BAI_SESSION_ID:-}" ] || BAI_SESSION_ID="$(bai_session_new_id)"

# 补充：对于过小规模的模型禁用 function calling 功能，并发起警告
if $BAI_LIMIT_TOOLS;then
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.limiting_tools_detected 检测到限制工具调用功能，正在检查模型规模...")"
  if [[ "$OPENAI_API_MODEL" =~ ^.+[:-](([0-4]\.[1-9]|[1-4])[bB])$ ]];then
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.small_model_detected 显式指向的模型规模过小，将变量 TOOLS 设置为 false，发出警告")"
    USE_TOOLS=false
    msg "$(L10n-zh-Hans "msg.small_model_warning 显式指向的模型规模过小 (${c33}%s${c0})，已禁用 ${c32}Function Calling${c0} 功能，请使用更大参数量 (${c36}=<${c0}${c35}5b${c0}) 的模型或手动调用指令" "${BASH_REMATCH[1]}")"
  else
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.model_size_ok 模型无显式指向，跳过判断并继续加载工具预处理")"
  fi
fi

# 启用 Function Calling 功能
if $USE_TOOLS;then
  __bai_disable_function=(${BAI_DISABLE_TOOLS//,/ })
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.function_calling_enabled Function Calling 功能已启用，正在加载工具预处理...")"
  data.append "tool_choice" "auto" --no-json
  toolsdata="$(sed -E '/^\/\/.+$/d' "$BAI_CALLING_FILE" | jq -s)"
  tools="$(jq '. |= map({"type": "function","function": .})' <<<"$toolsdata")" 
  data="$(jq --argjson tools "$(jq 'map(del(.function.function) | del(.function.permission))' <<<"$tools")" '.tools = $tools' <<< "$data")"
  function_head="bai::function-calling"
  __bai_function_tools=()
  declare -gA bai_tool_argalias
  while IFS=$'\t' read -r _alias_name _alias_json; do
    [[ -n "$_alias_name" && -n "$_alias_json" ]] &&
      bai_tool_argalias["$_alias_name"]="$_alias_json"
  done < <(jq -r '.[] | select(.arg_alias != null) | .name + "\t" + (.arg_alias | tojson)' <<< "$toolsdata")
  while IFS= read -r line;do
    function_fromjson_name="$(cut -d' ' -f1 <<< "$line")"
    __bai_function_tools+=("$function_fromjson_name")
    [[ " ${__bai_disable_function[*]} " == *" ${function_fromjson_name} "* ]] && {
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.function_disabled_by_user 发现命令行参数要求禁用的函数: %s, 需要在请求中移除" "$function_fromjson_name")"
      data="$(jq --arg name "$function_fromjson_name" 'del(.tools[] | select(.function.name == $name))' <<< "$data")"
      continue
    }
    function_name="$function_head::$function_fromjson_name"
    declare -A gco_explicitly["$function_name"]="$(cut -d' ' -f2 <<<"$line")"
    declare -A gco_getstderr["$function_name"]="$(cut -d' ' -f4 <<<"$line")"

    for i in $(cut -d' ' -f3 <<< "$line" | tr ',' ' ');do
      [[ "$i" == "NULL" ]] && break
      bai_function_depend_command=${i%%:*}
      bai_function_depend_packname=${i##*:}
      [[ "$bai_function_depend_command" == "$bai_function_depend_packname" ]] ||
        bai_function_depend_packname+=" ($bai_function_depend_command)"
      command -v $bai_function_depend_command &>/dev/null ||
        declare -A __bai_function_depend_notfound["$function_fromjson_name"]="$bai_function_depend_packname"
    done
    function_code="$(cut -d' ' -f5- <<<"$line")"
    # eval "$function_name(){ $function_code;}"
    source /dev/stdin <<===
    function $function_name(){
      $function_code
    }
===
  done < <(jq -r '.[] | .name + " " + (.explicitly // "false") + " " + (.depend // "NULL") + " " + (.stderr // "true") + " " + .function' <<< "$toolsdata")
  ((${#__bai_disable_function[@]}==0)) || {
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.checking_disabled_functions 筛查命令行参数指定但工具文件中并不存在的函数")"
    __bai_disable_function_notfound=()
    for for_arg_tools in "${__bai_disable_function[@]}";do
      for for_file_tools in "${__bai_function_tools[@]}";do
        if [[ "$for_file_tools" == "$for_arg_tools" ]];then
          for_func_notfound=true
          break
        else
          for_func_notfound=false
        fi
      done
      $for_func_notfound ||
      __bai_disable_function_notfound+=("$for_arg_tools")
    done
    if ! ((${#__bai_disable_function_notfound[@]}==0));then
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.disabled_functions_not_found 命令行参数指定的排除项中有不存在的函数，%s 应当拒绝启动" "${arg0^^}")"
      emsg "$(L10n-zh-Hans "msg.disabled_functions_not_found 不存在的函数工具:")"
      printf " ${c34}-${c0} ${c33}%s${c0}\n" "${__bai_disable_function_notfound[@]}"
      exec echo
    fi
  }
  ((${#__bai_function_depend_notfound[@]}==0)) || {
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.missing_dependencies_found 发现了不存在依赖命令的的工具函数")"
    emsg "$(L10n-zh-Hans "msg.missing_dependencies_found 由于缺失声明所需的命令依赖，以下函数工具不可用:")"
    for i in "${!__bai_function_depend_notfound[@]}";do
      echo -e " ${c34}-${c0} $(L10n-zh-Hans "msg.missing_dependencies_found_for_function 函数工具 ${c32}%s${c0} 需要 ${c33}%s${c0}" "$i" "${__bai_function_depend_notfound["$i"]}")"
    done
    exec echo
  }
  ((${#gco_explicitly[@]}==0)) && exmsg "$(L10n-zh-Hans "msg.all_functions_disabled 禁用了所有的函数工具？在指定了工具文件时至少需要一个可用的函数工具。")"
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.tools_loaded 工具预处理加载完成")"
  $OPENAI_ENABLE_STREAM || {
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.stream_disabled_detected 检测到禁用流式输出，将推送限制多轮工具调用的系统提示")"
    system_msg.append "$(L10n-zh-Hans "msg.stream_disabled_detected 由于禁用流式输出，将限制多轮工具调用，如果注意到用户意图你使用多个工具，请拒绝请求")"
  }
fi

debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.request_ready 请求体已准备就绪")"

# 备份请求体
old_data="${data}"
# 备份用户名
BAI_USERNAME_OLD="${BAI_USERNAME}"
# 备份标题
