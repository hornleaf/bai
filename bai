# 公式化协程创建函数
# 用法:
# 1 | Create-Coproc [协程名称] <<EOM
# 2 |  协程内容
# 3 | EOM
BAI_COPROCS=()
BAI_COPROC_PIDS=()
function Create-Coproc {
  local name="$1"
  # 防止协程名称冲突
  if [[ " ${BAI_COPROCS[*]} " == *" $name "* ]];then
    erron "$(L10n-zh-Hans "create_coproc.error_name_conflict 协程名称冲突")"
    return 1
  fi
  eval "coproc $name { $(cat); }"
  eval "${name}_output=\${${name}[0]}"
  eval "${name}_input=\${${name}[1]}"
  local pid_var="${name}_PID"
  BAI_COPROCS+=("$name")
  BAI_COPROC_PIDS+=("${!pid_var}")
  
}

# 公式化创建管道函数
# 用法: Create-Pipe <管道名称>
# 写： >&${管道名称}_fd
# 读： <&${管道名称}_fd
BAI_PIPES=()
declare -gA BAI_PIPE_PATHS
declare -gA BAI_PIPE_FDS
function Create-Pipe {
  local name="$1"
  local pipe_path="${TMPDIR:-/tmp}/.bai_pipe_${name}_$$"
  # 检查冲突
  if [[ " ${BAI_PIPES[*]} " == *" $name "* ]];then
    erron "$(L10n-zh-Hans "create_pipe.error_name_conflict 管道名称冲突")"
    return 1
  fi
  # 创建命名管道
  mkfifo "$pipe_path"
  # 打开读写文件描述符
  eval "exec {${name}_fd}<> '$pipe_path'"
  # 保存管道路径和名称
  BAI_PIPES+=("$name")
  BAI_PIPE_PATHS["$name"]="$pipe_path"
  BAI_PIPE_FDS["$name"]="${name}_fd"
}

# 删除管道
# 用法: Remove-Pipe <管道名称>
function Remove-Pipe {
  local name="$1"
  local pipe_path="${BAI_PIPE_PATHS["$name"]}"
  if [[ -p "$pipe_path" ]];then
    eval "exec {${BAI_PIPE_FDS["$name"]}}>&-"
    for ((i=0;i<${#BAI_PIPES[@]};i++));do
      [[ "${BAI_PIPES[i]}" == "$name" ]] && unset -v "BAI_PIPES[$i]"
    done
    rm -f "$pipe_path"
    unset -v "BAI_PIPE_PATHS[$name]" "BAI_PIPE_FDS[$name]"
  fi
}

# 公式化创建临时文件函数
# 用法: Create-TempFile <文件标识>
BAI_TEMP_NAMES=()
declare -gA BAI_TEMP_FILES
function Create-TempFile {
  local name="$1"
  local temp_file="${TMPDIR:-/tmp}/.bai_temp_${name}_$$"
  # 创建临时文件
  touch "$temp_file"
  BAI_TEMP_NAMES+=("$name")
  BAI_TEMP_FILES["$name"]="$temp_file"
}

# 删除临时文件
# 用法: Remove-TempFile <文件标识>
function Remove-TempFile {
  local name="$1"
  local temp_file="${BAI_TEMP_FILES["$name"]}"
  if [[ -f "$temp_file" ]];then
    for ((i=0;i<${#BAI_TEMP_NAMES[@]};i++));do
      [[ "${BAI_TEMP_NAMES[i]}" == "$name" ]] && unset -v "BAI_TEMP_NAMES[$i]"
    done
    rm -f "$temp_file"
    unset -v "BAI_TEMP_FILES[$name]"
  fi
}

# 退出时
# 用法: bye
# 行为控制:
#       变量 trap
#       为 true 时，会在退出前输出 [Ctrl-C] 提示
function bye {
  Wait-Task kill    # 结束任务等候函数
  # 清理可能残留的协程
  for coproc in "${BAI_COPROC_PIDS[@]}";do
      kill -0 $coproc &>/dev/null &&
      kill -9 $coproc &>/dev/null
  done
  # 清理可能残留的管道
  for pipe in "${BAI_PIPES[@]}";do
      local pipe_path="${BAI_PIPE_PATHS["$pipe"]}"
      if [ -p "$pipe_path" ];then
        eval "exec {${pipe}_fd}>&-"
        rm -f "$pipe_path"
      fi
  done
  trap - SIGINT
  trap - EXIT
  if $INTERACT_MODE;then
    printf "${h25}\r${c0}${c32}"
    ${trap:-false} && printf "[Ctrl-C]${c0} "
    msg "$bye_prompt${ek}${c0}"
  else
    ${LF:-true} && echo
  fi
  exit 0
}

# 退出准备
trap 'trap=true bye' SIGINT
trap 'printf "\e[1A";bye' EXIT

