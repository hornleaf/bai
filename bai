# 计算两个字符串的 Levenshtein 距离
# 用法: Get-Levenshtein <字符串1> <字符串2>
# 选项:
#       <字符串1> 要比较的第一个字符串
#       <字符串2> 要比较的第二个字符串
function Get-Levenshtein {
  local str1="$1"
  local str2="$2"
  local len1=${#str1}
  local len2=${#str2}
  declare -A dp
  for ((i=0;i<=len1;i++));do
    dp[$i,0]="$i"
  done
  for ((j=0;j<=len2;j++));do
    dp[0,$j]="$j"
  done
  for ((i=1;i<=len1;i++));do
    for ((j=1;j<=len2;j++));do
      [[ "${str1:i-1:1}" == "${str2:j-1:1}" ]] && cost=0 ||cost=1
      insert="$((dp[$((i)),$((j-1))] + 1))"
      delete="$((dp[$((i-1)),$((j))] + 1))"
      replace="$((dp[$((i-1)),$((j-1))] + cost))"
      dp[$i,$j]="$(($insert < $delete ? ($insert < $replace ? $insert : $replace) : ($delete < $replace ? $delete : $replace)))"
    done
  done
  echo "${dp[$len1,$len2]}"
}

