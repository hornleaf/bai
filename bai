# 处理模型静态输出
# 用法: Return-Assistant-Content
# 行为控制:
#       变量 API_RETURN
#       处理模型静态输出
function Return-Assistant-Content {
  # 非连续对话模式下禁用逐字输出和前缀，以提高效率
  # 连续对话模式下启用逐字输出和前缀，以提升体验
  if $INTERACT_MODE;then
    if $PRINT;then
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.typing_effect_output 使用打字效果输出")"
    else
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.direct_output_with_syntax_highlighting 直接输出结果，如果可能，将使用 bat 语法高亮")"
    fi
    $INTERACT_MODE && printf "${c32}$ai_prompt${c0} "
    # 指定输出模式
    if $PRINT;then
      Print-FakeStream <<< "$API_RETURN"
    else
      if $__has_extend_bat;then
        bat --plain --no-pager -l markdown <<< "$API_RETURN"
      else
        cat <<< "$API_RETURN"
      fi
    fi
  else
    if $__has_extend_bat;then
      bat --plain --no-pager -l markdown <<< "$API_RETURN"
    else
      cat <<< "$API_RETURN"
    fi
    exit
  fi
}

