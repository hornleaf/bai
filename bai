# 管理暂存文件
# 用法: Set-Temp-File <操作> <文件路径> [用途]
# 选项:
#       操作 操作类型，可选值为 push、list、remove
#       文件路径 要操作的文件路径
#       用途 文件用途，可选值为 assistants、fine-tune、file-extract、batch，默认值为 assistants
function Set-Temp-File {
  if [ -z "$1" ];then
    emsg "$(L10n-zh-Hans "set_temp_file_messages.no_args 未指定参数")"
    return 1
  fi
  local fileapi="$OPENAI_BASE_URL/files"
  case "$1" in
    push)    
    # 提交文件
      if [ -z "$2" ];then
        erron "$(L10n-zh-Hans "set_temp_file_messages.no_file_path 未指定文件路径")"
        return 1
      fi
      if [ ! -f "$2" ];then
        erron "$(L10n-zh-Hans "set_temp_file_messages.file_not_found 文件不存在: %s" "$2")"
        return 1
      fi
      if [[ ! "${2,,}" =~ ^.+\.(docx|pdf|xlsx|epub|mobi|md|py3?|(j|t)s(x|p)?|(ba|z|fi)?sh|lua|ps1|rs|java|kt|c(pp)?|go|jsonl?|csv|txt|(ya?|to|x)ml|ini|conf|cfg|j?pe?n?g|(bm|web)p|svgz?|ico)$ ]];then
        erron "$(L10n-zh-Hans "set_temp_file_messages.file_suffix_invalid 文件后缀不符合要求")"
        return 1
      fi
      if [[ "$(file -b "$2")" == *image* ]];then
        Show-Sixel-Image "$2"
      fi
      local purpose="$3"
      if [[ "${purpose:=user_data}" =~ ^(assistants|fine-tune|file-extract|batch|vision|user_data|evals)$ ]];then
        CURL_FILE_GET="$(
          Wait-Task wait "$(L10n-zh-Hans "set_temp_file_messages.uploading_file {{正在上传文件}}")"
          (
            curl -s -X POST "$fileapi" -H "$API_AUTH" \
              -F "purpose=$purpose" -F "file=@$2" 2>/dev/null ||
            printf '{"error": {"message": "%s"}}' "$(L10n-zh-Hans "set_temp_file_messages.file_upload_error 上传文件时遇到错误")"
          )
          Wait-Task kill
        )"
        Get-Assistant-ReturnError "$CURL_FILE_GET" && {
          local file_id="$(jq -r '.id' <<< "$CURL_FILE_GET")"
          local file_name="$(jq -r '.filename' <<< "$CURL_FILE_GET")"
          msg "$(L10n-zh-Hans "set_temp_file_messages.file_uploaded 文件提交完成 %s, 用途: %s" "$file_id" "$purpose")"
          FILES_ID+=("$file_id")
          FILES_NAME+=("$file_name")
        }
      else
        erron "${c31}[Server]:${c0} ${c33}[$(L10n-zh-Hans "set_temp_file_messages.file_upload_failed 文件上传失败")]\e[0m $(jq -r '.error.message' <<<"$CURL_FILE_GET")"
        return 1
      fi
      ;;
    list)
    # 查看文件列表
      CURL_FILE_GET="$(
        Wait-Task wait "$(L10n-zh-Hans "set_temp_file_messages.getting_file_list {{正在获取文件列表}}")"
        (
          curl -s -X GET "$fileapi" -H "$API_AUTH" 2>/dev/null ||
          printf '{"error": {"message": "%s"}}' "$(L10n-zh-Hans "set_temp_file_messages.file_list_error 获取文件列表时遇到错误")"
        )
        Wait-Task kill
      )"
      Get-Assistant-ReturnError "$CURL_FILE_GET" || return 1
      FILES_ID=($(jq -r '.data[].id' <<< "$CURL_FILE_GET"))
      FILES_NAME=($(jq -r '.data[].filename' <<< "$CURL_FILE_GET"))
      jq -er '.data[] | "FileID: \(.id), FileName: \(.filename), Size: \(.bytes)Byte, Purpose: \(.purpose)"' <<<"$CURL_FILE_GET" || msg "$(L10n-zh-Hans "set_temp_file_messages.no_files_found 服务商无存储文件")"
      ;;
    del)      
    # 删除文件
      FILES_LIST="${#FILES_ID[@]}"
      if ((FILES_LIST==0));then
        msg "$(L10n-zh-Hans "set_temp_file_messages.no_files_to_delete 无可删除的文件，尝试刷新")"
        $FUNCNAME list 1>/dev/null
        FILES_LIST="${#FILES_ID[@]}"
        if ((FILES_LIST==0));then
          erron "$(L10n-zh-Hans "set_temp_file_messages.no_files_to_delete_again 无可删除的文件")"
          return 1
        fi
      fi
      while ((FILES_LIST > 0));do
        local fileitem items=()
        for ((i=0;i<FILES_LIST;i++));do
          printf -v fileitem "$((i+1)). %s | %s" "${FILES_ID[i]}" "${FILES_NAME[i]}"
          items+=("$fileitem")
        done
        choose="$(Dialog-Select "请选择要删除的文件" "${items[@]}")"
        [[ "$choose" == exit ]] && { msg "Files: 退出"; return; }
        max_choose="$((FILES_LIST-1))"
        CURL_FILE_GET="$(
          Wait-Task wait "$(L10n-zh-Hans "set_temp_file_messages.deleting_file {{请求删除文件中}}")"
          (
            curl -s -X DELETE "$fileapi/${FILES_ID[choose]}" -H "$API_AUTH" 2>/dev/null ||
            printf '{"error": {"message": "%s"}}' "$(L10n-zh-Hans "set_temp_file_messages.file_delete_error 删除文件时遇到错误")"
          )
          Wait-Task kill
        )"
        Get-Assistant-ReturnError "$CURL_FILE_GET" && {
          msg "$(L10n-zh-Hans "set_temp_file_messages.file_deleted 文件ID %s 已删除" "${FILES_ID[choose]}")"
          unset FILES_ID[choose] FILES_NAME[choose]
          FILES_ID=("${FILES_ID[@]}")
          FILES_NAME=("${FILES_NAME[@]}")
          FILES_LIST="${#FILES_ID[@]}"
        }
      done
  esac
}

######################################################################## 

# 提及在服务商存储的文件并发出提问
function Get-AtFiles-Ask {
  if ((${#FILES_ID[@]}==0));then
    msg "$(L10n-zh-Hans "set_temp_file_messages.no_files_available 未获取到可用的文件列表，尝试刷新列表")"
    Set-Temp-File list 1>/dev/null
    if ((${#FILES_ID[@]}==0));then
      erron "$(L10n-zh-Hans "set_temp_file_messages.no_files_available_again 未获取到可用的文件列表")"
      return 1
    fi
  fi
  [ "$1" ] || { emsg "$(L10n-zh-Hans "set_temp_file_messages.no_file_id_specified 未指定所需的文件ID")";return 1;}
  [[ " ${FILES_ID[*]} " == *" $1 "* ]] || { emsg "$(L10n-zh-Hans "set_temp_file_messages.invalid_file_id 不是可用的文件ID，请重新指定")";return 1;}
  [ "$2" ] || { emsg "$(L10n-zh-Hans "set_temp_file_messages.no_prompt_specified 未发起提问，请在提及文件时同时发起提问")";return 1;}
  data="$(jq --arg content "$2" --arg file_id "$1" '.messages += [{"role": "user", "content": [{"type": "text", "text": $content},{"type": "file", "file_id": $file_id}]}]' <<< "$data")"
}

########################################################################

# 从参数取值
# 用法: Get-Arguments-Value <参数>
# 选项:
#       参数 要取值的参数
# 行为控制:
#       从参数中取值，支持长参数和短参数
#       变量 ARG_OPTS[1]*, ARG_KEY[2]*, ARG_ERR[3]*
#       1* 要处理的长短参数，例：h,help
#       2* 提取参数选项后赋值所用的变量名
#       3* 错误提示信息
# * 作为参数处理组件使用，将参数选项转换为变量
function Get-Arguments-Value {
  function ARG_IFOPT { [[ "$(Check-Variable-Type "${ARG_KEY}")" == "option" ]] && unset -f $FUNCNAME && exmsg "$ARG_OPT_ERR";}
  ARG_OPT_ERR="非法的参数组合"
  [[ "$1" =~ ^(--?[^:=]+)[=:]?(.+)?$ ]]
  arg1="${BASH_REMATCH[1]}"
  [[ "$arg1" =~ ^(-?[^:=])[=:]?(.+)?$ ]] &&
  arg1="${BASH_REMATCH[1]}"
  local LONG="${ARG_OPTS#*,}"
  local SHORT="${ARG_OPTS%,*}"
  if [[ "$1" =~ ^--"$LONG"[=:](.+)$ ]];then
    __bai_option_name="--$LONG"
  elif [[ "$1" =~ ^-"$SHORT":?(.+)$ ]];then
    __bai_option_name="-$SHORT"
  else
    __bai_option_name=""
  fi
  if [[ "$1" =~ ^--"$LONG"[=:](.+)$ || "$1" =~ ^-"$SHORT":?(.+)$ ]];then
    eval "${ARG_KEY}=\"${BASH_REMATCH[1]}\""
    [ -z "${!ARG_KEY}" ] && exmsg "$1: $ARG_ERR"
    ARG_IFOPT
    return 101
  else
    [[ "$1" =~ ^--"$LONG"(.+)$ ]] && exmsg "$1: $ARG_OPT_ERR"
    [ -z "$2" ] && exmsg "$1: $ARG_ERR"
    if "${ARG_USE_ARRAY:-false}";then
      eval "${ARG_KEY}_in_array=(\"${2//,/ }\")"
      eval "${ARG_KEY}=\"\$${ARG_KEY}_in_array\""
    else
      eval "${ARG_KEY}=\"${2}\""
    fi
    ARG_IFOPT
    return 102
  fi
}

