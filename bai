# 列出服务商提供的模型
# 用法: bai_models_print [force]
function bai_models_print {
  local __mp_json __mp_cur="$OPENAI_API_MODEL"
  __mp_json="$(bai_models_json "${1:-}" 2>/dev/null)" || return 1
  local __mp_rows __mp_md __mp_id __mp_name __mp_cl __mp_out_tok __mp_in __mp_eff __mp_known __mp_count=0
  __mp_rows="$(jq -r --arg cur "$__mp_cur" '
    .data[]? |
    [ (if .id == $cur then ("* " + .id) else .id end),
      (.name // "-"),
      ((.context_window // .context_length // .max_context_length // .max_model_len
        // .max_input_tokens // .top_provider.context_length // .meta.n_ctx_train // "?") | tostring),
      ((.max_output_tokens // .max_completion_tokens // "?") | tostring),
      ((.input_modalities // []) | join("/") | if . == "" then "-" else . end),
      ((.effort.supported_levels // []) | join("/") | if . == "" then "-" else . end)
    ] | @tsv
  ' <<<"$__mp_json" 2>/dev/null)"
  __mp_md="$(L10n-zh-Hans "models.table_headline | 模型 | 名称 | 上下文 | 输出 | 输入 | 思考档位 |")"$'\n''| --- | --- | --- | --- | --- | --- |'$'\n'
  while IFS=$'\t' read -r __mp_id __mp_name __mp_cl __mp_out_tok __mp_in __mp_eff;do
    [ -n "$__mp_id" ] || continue
    if [ "$__mp_cl" = "?" ];then
      __mp_known="$(bai_model_context_known "${__mp_id#* }" 2>/dev/null)"
      [ -n "$__mp_known" ] && __mp_cl="${__mp_known}~"
    fi
    __mp_md+="| ${__mp_id} | ${__mp_name} | ${__mp_cl} | ${__mp_out_tok} | ${__mp_in} | ${__mp_eff} |"$'\n'
    __mp_count=$((__mp_count+1))
  done <<< "$__mp_rows"
  (( __mp_count > 0 )) || return 1
  printf '%s' "$__mp_md" | Render-MDtable
  msg "$(L10n-zh-Hans "models.legend （* 表示当前模型，~ 表示由内置表推断，? 表示服务端未提供）")"
}


# llama.cpp 模式下强制覆盖 baseurl/apikey/model（屏蔽配置文件）
# 用法: bai_llamacpp_apply_env <url>
function bai_llamacpp_apply_env {
  local url="$1" mid
  OPENAI_BASE_URL="$url/v1"
  OPENAI_API_KEY="sk-llamacpp"
  # CLI 显式 -m 时尊重它，否则用本地服务上报的模型
  if [ "${BAI_MODEL_FROM_CLI:-false}" != "true" ];then
    mid="$(curl -fsS -m 3 "$url/v1/models" 2>/dev/null | jq -r '.data[0].id // empty' 2>/dev/null)"
    OPENAI_API_MODEL="${mid:-default}"
    OPENAI_API_MODEL_in_array=( "$OPENAI_API_MODEL" )
    unset OPENAI_API_MODEL_CONTEXT_LENGTH
  fi
  # llama.cpp 的模型 id 常是 gguf 路径，界面只显示文件名
  if [[ "$OPENAI_API_MODEL" == */* ]];then
    BAI_MODEL_DISPLAY="$(basename "$OPENAI_API_MODEL")"
  else
    BAI_MODEL_DISPLAY="$OPENAI_API_MODEL"
  fi
}

# 每轮检查 llama.cpp 进程是否还活着；已结束则退出
# 用法: bai_llamacpp_check
function bai_llamacpp_check {
  [ -n "${BAI_LLAMACPP_PID:-}" ] || return 0
  kill -0 "$BAI_LLAMACPP_PID" 2>/dev/null && return 0
  erron "$(L10n-zh-Hans "llamacpp.died llama.cpp 服务已结束（PID %s），退出" "$BAI_LLAMACPP_PID")"
