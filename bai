# ── MCP（Model Context Protocol）客户端 ────────────────────────────────
# 仅支持 stdio 传输：newline 分隔的 JSON-RPC 2.0
declare -gA BAI_MCP_FDW BAI_MCP_FDR BAI_MCP_PID BAI_MCP_TYPE BAI_MCP_URL BAI_MCP_FIRST_PARAM BAI_MCP_PERMISSION
BAI_MCP_NEXT_ID=0
BAI_MCP_DIR=""

# MCP 是否启用
function bai_mcp_enabled {
  [ "${BAI_MCP:-true}" = "true" ] || return 1
  [ -n "${BAI_MCP_CONFIG:-}" ] && [ -f "$BAI_MCP_CONFIG" ]
}

# 启动一个 MCP server（stdio）
# 用法: bai_mcp_start <名字> <命令> [参数...]
function bai_mcp_start {
  local name="$1" cmd="$2"; shift 2
  local fdw fdr log in out
  [ -n "$BAI_MCP_DIR" ] || BAI_MCP_DIR="${TMPDIR:-/tmp}/bai-mcp-$$"
  mkdir -p "$BAI_MCP_DIR" 2>/dev/null || return 1
  in="$BAI_MCP_DIR/$name.in"
  out="$BAI_MCP_DIR/$name.out"
  log="$BAI_MCP_DIR/$name.log"
  rm -f "$in" "$out"
  mkfifo "$in" "$out" 2>/dev/null || return 1
  ( "$cmd" "$@" <"$in" >"$out" 2>"$log" ) &
  BAI_MCP_PID["$name"]=$!
  exec {fdw}<>"$in" || return 1
  exec {fdr}<>"$out" || { exec {fdw}>&-; return 1; }
  BAI_MCP_FDW["$name"]=$fdw
  BAI_MCP_FDR["$name"]=$fdr
  return 0
}

# 发送 JSON-RPC 请求并等待同 id 的响应
# 用法: bai_mcp_rpc <名字> <方法> <参数JSON|null> [超时秒]
function bai_mcp_rpc {
  local name="$1" method="$2" params="${3:-null}" timeout="${4:-60}"
  local id line deadline
  [ -n "${BAI_MCP_FDW[$name]:-}" ] || return 1
  BAI_MCP_NEXT_ID=$((BAI_MCP_NEXT_ID+1))
  id=$BAI_MCP_NEXT_ID
  printf '%s\n' "$(jq -cn --argjson id "$id" --arg m "$method" --argjson p "$params" \
    '{jsonrpc:"2.0", id:$id, method:$m, params:$p}')" >&"${BAI_MCP_FDW[$name]}" || return 1
  deadline=$((SECONDS + timeout))
  while (( SECONDS <= deadline ));do
    IFS= read -r -t 2 -u "${BAI_MCP_FDR[$name]}" line || {
      kill -0 "${BAI_MCP_PID[$name]:-0}" 2>/dev/null || return 1
      continue
    }
    [ -n "$line" ] || continue
    if jq -e --argjson id "$id" 'type=="object" and (.id == $id)' <<<"$line" >/dev/null 2>&1;then
      if jq -e 'has("error")' <<<"$line" >/dev/null 2>&1;then
        jq -r '.error.message // "unknown MCP error"' <<<"$line" >&2
        return 2
      fi
      jq -c '.result' <<<"$line"
      return 0
    fi
  done
  return 1
}

# HTTP 传输的 JSON-RPC 请求（POST，兼容 SSE 响应）
# 用法: bai_mcp_http_rpc <名字> <方法> <参数JSON|null> [超时秒]
function bai_mcp_http_rpc {
  local name="$1" method="$2" params="${3:-null}" timeout="${4:-60}"
  local url="${BAI_MCP_URL[$name]:-}" id req resp
  [ -n "$url" ] || return 1
  BAI_MCP_NEXT_ID=$((BAI_MCP_NEXT_ID+1))
  id=$BAI_MCP_NEXT_ID
  req="$(jq -cn --argjson id "$id" --arg m "$method" --argjson p "$params" \
    '{jsonrpc:"2.0", id:$id, method:$m, params:$p}')" || return 1
  resp="$(curl -fsS -m "$timeout" -X POST "$url" \
      -H 'Content-Type: application/json' \
      -H 'Accept: application/json, text/event-stream' \
      -d "$req" 2>/dev/null)" || return 1
  if [[ "$resp" == *"data:"* ]];then
    resp="$(printf '%s\n' "$resp" | sed -n 's/^data:[[:space:]]*//p' | jq -c --argjson id "$id" 'select(.id == $id)' 2>/dev/null | tail -1)"
  fi
  [ -n "$resp" ] || return 1
  if jq -e 'has("error")' <<<"$resp" >/dev/null 2>&1;then
    jq -r '.error.message // "unknown MCP error"' <<<"$resp" >&2
    return 2
  fi
  jq -c '.result' <<<"$resp"
}

# 统一请求入口：按 server 类型走 stdio 或 http
# 用法: bai_mcp_request <名字> <方法> <参数JSON|null> [超时秒]
function bai_mcp_request {
  local name="$1" method="$2" params="${3:-null}" timeout="${4:-60}"
  if [ "${BAI_MCP_TYPE[$name]:-stdio}" = "http" ];then
    bai_mcp_http_rpc "$name" "$method" "$params" "$timeout"
  else
    bai_mcp_rpc "$name" "$method" "$params" "$timeout"
  fi
}

# 通知（无 id，不需要响应）
# 用法: bai_mcp_notify <名字> <方法> <参数JSON|null>
function bai_mcp_notify {
  local name="$1" method="$2" params="${3:-null}"
  [ -n "${BAI_MCP_FDW[$name]:-}" ] || return 1
  printf '%s\n' "$(jq -cn --arg m "$method" --argjson p "$params" \
    '{jsonrpc:"2.0", method:$m, params:$p}')" >&"${BAI_MCP_FDW[$name]}" 2>/dev/null
  return 0
}

# 初始化握手
# 用法: bai_mcp_init <名字>
function bai_mcp_init {
  local name="$1"
  if [ "${BAI_MCP_TYPE[$name]:-stdio}" = "http" ];then
    bai_mcp_http_rpc "$name" initialize \
      '{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"bai","version":"1.0"}}' 20 >/dev/null || return 1
    return 0
  fi
  bai_mcp_rpc "$name" initialize \
    '{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"bai","version":"1.0"}}' 20 >/dev/null || return 1
  bai_mcp_notify "$name" notifications/initialized 'null'
  return 0
}

# 列出工具并转成 bai 的工具 JSONL 行
# 用法: bai_mcp_tools <名字> <输出文件>
function bai_mcp_tools {
  local name="$1" out="$2" perm="${3:-medium}" res
  res="$(bai_mcp_request "$name" tools/list '{"cursor":null}' 30)" || return 1
  jq -c --arg srv "$name" --arg perm "$perm" '
    (.tools // [])[] |
    (.name | gsub("[^A-Za-z0-9_-]"; "_")) as $safe |
    {
      name: ("mcp__" + $srv + "__" + $safe),
      description: (((.description // .name) + " [MCP:" + $srv + "]") | .[0:900]),
      function: ("bai_mcp_call " + ($srv | @sh) + " " + (.name | @sh) + " \"$@\""),
      permission: $perm,
      parameters: ((.inputSchema // {}) | .type //= "object" | .properties //= {} | .required //= [])
    }
  ' <<<"$res" >> "$out" 2>/dev/null
  # 记录首个参数名，供 .call 这类手动调用把裸值包装成 {参数: 值}
  local tname tfirst
  while IFS=$'\t' read -r tname tfirst;do
    [ -n "$tname" ] && [ -n "$tfirst" ] && BAI_MCP_FIRST_PARAM["$tname"]="$tfirst"
  done < <(jq -r --arg srv "$name" '
    (.tools // [])[] |
    (.name | gsub("[^A-Za-z0-9_-]"; "_")) as $safe |
    ["mcp__" + $srv + "__" + $safe,
     ((.inputSchema.required[0]) // ((.inputSchema.properties // {}) | keys[0]) // "")] | @tsv
  ' <<<"$res" 2>/dev/null)
  return 0
}

# 调用 MCP 工具并展开返回内容
# 用法: bai_mcp_call <server> <tool>
# 行为控制:
#       变量 BAI_TOOL_JSON（模型传入的参数 JSON）
function bai_mcp_call {
  local server="$1" tool="$2" args="${BAI_TOOL_JSON:-}"
  local res rc extra="" safe fp_key key
  shift 2
  (( $# )) && extra="$*"
  if [ -z "$args" ] && [ -n "$extra" ];then
    if jq -e 'type == "object"' <<<"$extra" >/dev/null 2>&1;then
      args="$extra"
    elif [[ "$extra" =~ ^[A-Za-z0-9_.-]+= ]];then
      # .call tool a=1 b=2 形式
      args='{}'
      local kv k v
      for kv in $extra;do
        k="${kv%%=*}"; v="${kv#*=}"
        if [[ "$v" =~ ^-?[0-9]+([.][0-9]+)?$ ]];then
          args="$(jq -c --arg k "$k" --argjson v "$v" '. + {($k): $v}' <<<"$args")"
        else
          args="$(jq -c --arg k "$k" --arg v "$v" '. + {($k): $v}' <<<"$args")"
        fi
      done
    else
      safe="$(printf '%s' "$tool" | sed 's/[^A-Za-z0-9_-]/_/g')"
      fp_key="mcp__${server}__${safe}"
      key="${BAI_MCP_FIRST_PARAM[$fp_key]:-}"
      if [ -z "$key" ];then
        L10n-zh-Hans "mcp.need_arg 无法自动推断参数名，请传 JSON：{\"参数\":\"值\"}"
        return 1
      fi
      if [[ "$extra" =~ ^-?[0-9]+([.][0-9]+)?$ ]];then
        args="$(jq -cn --arg k "$key" --argjson v "$extra" '{($k): $v}')"
      else
        args="$(jq -cn --arg k "$key" --arg v "$extra" '{($k): $v}')"
      fi
    fi
  fi
  [ -n "$args" ] || args='{}'
  [[ "$args" =~ ^\{.*\}$ ]] || args='{}'
  res="$(bai_mcp_request "$server" tools/call \
    "$(jq -cn --arg n "$tool" --argjson a "$args" '{name:$n, arguments:$a}')" 120)"
  rc=$?
  if (( rc != 0 ));then
    L10n-zh-Hans "mcp.call_failed MCP 调用失败: %s (server: %s)" "$tool" "$server"
    return 1
  fi
  jq -r '
    (if (.isError // false) then "MCP 工具返回错误:\n" else "" end) +
    ((.content // []) | map(
      if .type == "text" then (.text // "")
      elif .type == "image" then "[image]"
      elif .type == "resource" then ((.resource.uri // "") | if . == "" then "[resource]" else "[resource] " + . end)
      else "[" + (.type // "unknown") + "]"
      end) | join("\n"))
  ' <<<"$res"
}

# 按配置启动全部 server，并生成合并后的工具文件
# 用法: bai_mcp_setup
function bai_mcp_setup {
  bai_mcp_enabled || return 0
  local cfg mcp_dir tools_file started=0
  cfg="$(cat "$BAI_MCP_CONFIG" 2>/dev/null)" || return 0
  jq -e '(.servers | type) == "array"' <<<"$cfg" >/dev/null 2>&1 || {
    erron "$(L10n-zh-Hans "mcp.invalid_config MCP 配置无效: %s" "$BAI_MCP_CONFIG")"
    return 0
  }
  # 同名 server 会互相覆盖（FIFO/工具前缀相同），直接拒绝
  local dup_names
  dup_names="$(jq -r '[.servers[].name] | group_by(.)[] | select(length > 1) | .[0]' <<<"$cfg" 2>/dev/null)"
  if [ -n "$dup_names" ];then
    erron "$(L10n-zh-Hans "mcp.duplicate_name MCP 配置里有重名的 server: %s（名字会作为工具前缀，必须唯一）" "$(tr '\n' ' ' <<<"$dup_names")")"
    return 0
  fi
  mcp_dir="${TMPDIR:-/tmp}/bai-mcp-$$"
  mkdir -p "$mcp_dir" 2>/dev/null || return 0
  BAI_MCP_DIR="$mcp_dir"
  tools_file="$mcp_dir/tools.jsonl"
  : > "$tools_file"
  local name cmd args_json url
  BAI_MCP_SERVERS=()
  while IFS=$'\x1f' read -r name cmd args_json url;do
    [ -n "$name" ] || continue
    local -a argv=()
    BAI_MCP_PERMISSION["$name"]="$(jq -r --arg n "$name" '.servers[]? | select(.name == $n) | .permission // "medium"' <<<"$cfg" 2>/dev/null)"
    if [ -n "$url" ];then
      BAI_MCP_TYPE["$name"]=http
      BAI_MCP_URL["$name"]="$url"
    elif [ -n "$cmd" ];then
      BAI_MCP_TYPE["$name"]=stdio
      mapfile -t argv < <(jq -r '.[]?' <<<"$args_json" 2>/dev/null)
    else
      continue
    fi
    if { [ "${BAI_MCP_TYPE[$name]}" = "http" ] || bai_mcp_start "$name" "$cmd" "${argv[@]}"; } \
       && bai_mcp_init "$name" \
       && bai_mcp_tools "$name" "$tools_file" "${BAI_MCP_PERMISSION[$name]:-medium}";then
      started=$((started+1))
      BAI_MCP_SERVERS+=("$name")
    else
      erron "$(L10n-zh-Hans "mcp.init_failed MCP server 初始化失败: %s（日志: %s）" "$name" "$mcp_dir/$name.log")"
    fi
  done < <(jq -r '.servers[] | (.name // "mcp") + "\u001f" + (.command // "") + "\u001f" + ((.args // []) | tojson) + "\u001f" + (.url // "")' <<<"$cfg")
  if [ -s "$tools_file" ];then
    local long_names
    long_names="$(jq -r 'select((.name | length) > 64) | .name' "$tools_file" 2>/dev/null | head -5)"
    [ -n "$long_names" ] && erron "$(L10n-zh-Hans "mcp.name_too_long 以下 MCP 工具名超过 64 字符，可能被接口拒绝，请缩短 server 或工具名: %s" "$(tr '\n' ' ' <<<"$long_names")")"
  fi
  if (( started > 0 )) && [ -s "$tools_file" ];then
    if [ -n "${BAI_CALLING_FILE:-}" ] && [ -f "$BAI_CALLING_FILE" ];then
      cat "$BAI_CALLING_FILE" "$tools_file" > "$mcp_dir/all-tools.jsonl"
      BAI_CALLING_FILE="$mcp_dir/all-tools.jsonl"
    else
      BAI_CALLING_FILE="$tools_file"
    fi
    USE_TOOLS=true
    msg "$(L10n-zh-Hans "mcp.loaded 已加载 %s 个 MCP server，工具已合并" "$started")"
  fi
  return 0
}

# 展示 MCP 状态（markdown 表格）
# 用法: bai_mcp_status
function bai_mcp_status {
  if [ "${#BAI_MCP_SERVERS[@]}" -eq 0 ] 2>/dev/null;then
    msg "$(L10n-zh-Hans "mcp.none 没有已加载的 MCP server（配置: %s）" "${BAI_MCP_CONFIG:-未设置}")"
    return 0
  fi
  local rows='| 服务 | 进程/地址 | 工具数 |'$'\n''| --- | --- | --- |'$'\n' name n tgt
  for name in "${BAI_MCP_SERVERS[@]}";do
    n=0
    [ -n "${BAI_MCP_DIR:-}" ] && [ -f "$BAI_MCP_DIR/tools.jsonl" ] && n="$(grep -c "\"mcp__${name}__" "$BAI_MCP_DIR/tools.jsonl" 2>/dev/null)"
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    if [ "${BAI_MCP_TYPE[$name]:-stdio}" = "http" ];then tgt="${BAI_MCP_URL[$name]:-http}";else tgt="${BAI_MCP_PID[$name]:-?}";fi
    rows+="| ${name} | $tgt | $n |"$'\n'
  done
  printf '%s' "$rows" | Render-MDtable
  return 0
}

# 关闭全部 MCP server
# 用法: bai_mcp_shutdown
function bai_mcp_shutdown {
  local name
  for name in "${!BAI_MCP_PID[@]}";do
    [ "${BAI_MCP_TYPE[$name]:-stdio}" = "http" ] && continue
    [ -n "${BAI_MCP_PID[$name]:-}" ] || continue
    kill "${BAI_MCP_PID[$name]}" 2>/dev/null
    exec {BAI_MCP_FDW[$name]}>&- 2>/dev/null
    exec {BAI_MCP_FDR[$name]}<&- 2>/dev/null
  done
  [ -n "$BAI_MCP_DIR" ] && rm -rf "$BAI_MCP_DIR" 2>/dev/null
  return 0
}

# 优先使用 llama-server，其次 llama server
# 用法: bai_llamacpp_launch
# 行为控制:
#       变量 LLAMACPP_EXTRA_ARGS, BAI_LLAMACPP_PORT, BAI_LLAMACPP_TIMEOUT
function bai_llamacpp_launch {
  local i port="${BAI_LLAMACPP_PORT:-9931}" host=127.0.0.1
  local -a args=("${LLAMACPP_EXTRA_ARGS[@]}")
  # 从透传参数里读取端口/主机
  for ((i=0;i<${#args[@]};i++));do
    case "${args[i]}" in
      --port) port="${args[i+1]:-$port}" ;;
      --port=*) port="${args[i]#*=}" ;;
      --host) host="${args[i+1]:-$host}" ;;
      --host=*) host="${args[i]#*=}" ;;
    esac
  done
  local url="http://$host:$port"
  # 0 = 一直等（默认），避免模型加载慢时直接退出
  local wait_s="${BAI_LLAMACPP_TIMEOUT:-0}"
  local wait_start elapsed now

  local bin sub=()
  if command -v llama-server >/dev/null 2>&1;then
    bin=llama-server
  elif command -v llama >/dev/null 2>&1;then
    bin=llama
    sub=(server)
  else
    exmsg "$(L10n-zh-Hans "llamacpp.not_found 未找到 llama-server 或 llama 命令，无法启动 llama.cpp 服务")"
  fi
  local log="${TMPDIR:-/tmp}/bai-llamacpp-$$.log"
  msg "$(L10n-zh-Hans "llamacpp.starting 正在启动 llama.cpp: %s %s（日志: %s）" "$bin" "${sub[*]} ${args[*]}" "$log")"
  (
    exec "$bin" "${sub[@]}" "${args[@]}" >"$log" 2>&1
  ) &
  BAI_LLAMACPP_PID=$!
  wait_start=$(date +%s)
  while :;do
    if ! kill -0 "$BAI_LLAMACPP_PID" 2>/dev/null;then
      [ -t 2 ] && printf '\r\e[K' >&2
      erron "$(L10n-zh-Hans "llamacpp.exited llama.cpp 进程已退出，日志尾部:" )"
      tail -n 20 "$log" >&2 2>/dev/null
      exit 1
    fi
    if curl -fsS -m 2 "$url/health" >/dev/null 2>&1;then
      [ -t 2 ] && printf '\r\e[K' >&2
      bai_llamacpp_apply_env "$url"
      msg "$(L10n-zh-Hans "llamacpp.ready llama.cpp 已就绪: %s（PID %s）" "$url" "$BAI_LLAMACPP_PID")"
      return 0
    fi
    now=$(date +%s)
    elapsed=$((now - wait_start))
    if (( wait_s > 0 && elapsed >= wait_s ));then
      [ -t 2 ] && printf '\r\e[K' >&2
      erron "$(L10n-zh-Hans "llamacpp.timeout 等待 llama.cpp 就绪超时（%s 秒），日志尾部:" "$wait_s")"
      tail -n 20 "$log" >&2 2>/dev/null
      exit 1
    fi
    if [ -t 2 ];then
      printf '\r\e[K%s' "$(L10n-zh-Hans "llamacpp.loading 正在加载模型... %ss（Ctrl+C 取消）" "$elapsed")" >&2
    elif (( elapsed > 0 && elapsed % 10 == 0 ));then
      printf '%s\n' "$(L10n-zh-Hans "llamacpp.loading 正在加载模型... %ss（Ctrl+C 取消）" "$elapsed")" >&2
    fi
    sleep 1
  done
}

# ── 基于文件的打断控制 ─────────────────────────────────────────────────
# 用户/外部程序创建该文件即可中断当前请求或工具执行
# 用法: bai_interrupt_file
function bai_interrupt_file {
  printf '%s' "${BAI_INTERRUPT_FILE:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/bai-interrupt-${BAI_SESSION_ID:-$$}}"
}

# 是否收到打断请求
# 用法: bai_interrupt_requested
function bai_interrupt_requested {
  [ "${BAI_INTERRUPT:-true}" = "true" ] || return 1
  [ -e "$(bai_interrupt_file)" ]
}

# 清除打断标记（每轮开始/打断处理后调用）
# 用法: bai_interrupt_clear
function bai_interrupt_clear {
  rm -f "$(bai_interrupt_file)" 2>/dev/null
  return 0
}

# 判断这次 Ctrl+C 是否构成"连按两次"（时间窗内第二次）
# 用法: bai_sigint_is_double
# 行为控制:
#       变量 BAI_LAST_SIGINT, BAI_DOUBLE_CTRLC_WINDOW
function bai_sigint_is_double {
  local now="${EPOCHREALTIME//[!0-9]/}" last="${BAI_LAST_SIGINT:-0}" window_us
  [[ "$now" =~ ^[0-9]+$ ]] || now=$(date +%s%6N)
  BAI_LAST_SIGINT="$now"
  window_us=$(( ${BAI_DOUBLE_CTRLC_WINDOW:-2} * 1000000 ))
  (( last > 0 && now - last < window_us ))
}

# 等待回复阶段的 Ctrl+C：第一次打断，连按两次直接退出
# 用法: bai_interrupt_by_signal
function bai_interrupt_by_signal {
  local file
  printf '\e[K' >&2
  if bai_sigint_is_double;then
    erron "$(L10n-zh-Hans "interrupt.double_quit 再次收到 Ctrl+C，直接退出")"
    trap=true bye
    return
  fi
  file="$(bai_interrupt_file)"
  mkdir -p "$(dirname "$file")" 2>/dev/null
  : > "$file" 2>/dev/null
  erron "$(L10n-zh-Hans "interrupt.signal_received 收到 Ctrl+C，正在打断当前请求...（再按一次直接退出）")"
}

# 进入"等待回复"阶段：Ctrl+C = 打断
# 用法: bai_interrupt_trap_wait
function bai_interrupt_trap_wait {
  trap 'bai_interrupt_by_signal' SIGINT
}

# 等待用户输入阶段的 Ctrl+C：连按两次才退出（第一次只提示）
# 用法: bai_sigint_at_input
function bai_sigint_at_input {
  printf '\e[K' >&2
  if bai_sigint_is_double;then
    trap=true bye
    return
  fi
  erron "$(L10n-zh-Hans "interrupt.input_hint 再按一次 Ctrl+C 退出")"
}

# 回到"等待用户输入"阶段：Ctrl+C 需连按两次才退出
# 用法: bai_interrupt_trap_input
function bai_interrupt_trap_input {
  BAI_LAST_SIGINT=0
  trap 'bai_sigint_at_input' SIGINT
}

# 检查并处理打断：命中时清标记并返回 0
# 用法: bai_interrupt_check
function bai_interrupt_check {
  bai_interrupt_requested || return 1
  bai_interrupt_clear
  return 0
}

# ── 会话自动保存 / 恢复 ───────────────────────────────────────────────
# 存储: $BAI_SESSION_DIR 或 $XDG_STATE_HOME/bai/sessions/<id>.json
function bai_session_dir {
  printf '%s' "${BAI_SESSION_DIR:-${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/bai/sessions}"
}

# 生成新的会话 id
function bai_session_new_id {
  printf '%s-%04x' "$(date +%Y%m%d-%H%M%S)" "$((RANDOM % 65536))"
}

# 只保留最近 N 个会话
function bai_session_prune {
  local dir keep
  dir="$(bai_session_dir)"
  keep="${BAI_SESSION_KEEP:-50}"
  [[ "$keep" =~ ^[0-9]+$ ]] || keep=50
  local files n
  files="$(ls -1t "$dir"/*.json 2>/dev/null)"
  n="$(printf '%s' "$files" | grep -c . 2>/dev/null)"
  { [ -n "$files" ] && (( n > keep )); } || return 0
  printf '%s
' "$files" | tail -n +$((keep+1)) | while read -r f;do rm -f "$f";done
}

# 保存当前对话（不含 system 消息，恢复时会重新生成）
# 用法: bai_session_save
function bai_session_save {
  [ "${BAI_SESSION_AUTOSAVE:-true}" = "true" ] || return 0
  [ -n "${data:-}" ] || return 0
  [ -n "${BAI_SESSION_ID:-}" ] || BAI_SESSION_ID="$(bai_session_new_id)"
  local dir file tmp now created title
  dir="$(bai_session_dir)"
  mkdir -p "$dir" 2>/dev/null || return 1
  file="$dir/$BAI_SESSION_ID.json"
  now="$(date +%s)"
  created="${BAI_SESSION_CREATED:-$now}"
  BAI_SESSION_CREATED="$created"
  title="$(jq -r '[.messages[] | select(.role=="user") | (if (.content|type)=="string" then .content else ([.content[]? | .text // ""] | join(" ")) end)] | map(gsub("[
\r\t]+"; " ")) | .[0] // ""' <<<"$data" 2>/dev/null | cut -c1-100)"
  tmp="$(mktemp "$dir/.tmp.XXXXXX" 2>/dev/null)" || return 1
  if jq --arg id "$BAI_SESSION_ID" --arg model "${OPENAI_API_MODEL:-}" --arg cwd "$PWD" --arg title "$title" \
        --argjson created "$created" --argjson updated "$now" \
        '{id:$id, model:$model, cwd:$cwd, title:$title, created:$created, updated:$updated,
          messages:[.messages[] | select(.role != "system")]}' <<<"$data" > "$tmp" 2>/dev/null;then
    mv -f "$tmp" "$file" 2>/dev/null
  else
    rm -f "$tmp"
    return 1
  fi
  bai_session_prune
  return 0
}

# 找会话文件对应的 id；"last" 取最近（优先当前目录）
# 用法: bai_session_find <id|last>
function bai_session_find {
  local dir want="$1" f t cwd best="" best_t=0 id
  dir="$(bai_session_dir)"
  if [ "$want" != "last" ] && [ -n "$want" ];then
    [ -f "$dir/$want.json" ] && { printf '%s' "$want"; return 0; }
    return 1
  fi
  for f in "$dir"/*.json;do
    [ -f "$f" ] || continue
    t="$(jq -r '.updated // 0' "$f" 2>/dev/null)"
    [[ "$t" =~ ^[0-9]+$ ]] || t=0
    cwd="$(jq -r '.cwd // ""' "$f" 2>/dev/null)"
    [ "$cwd" = "$PWD" ] && t=$((t + 1000000000))
    if (( t > best_t ));then best_t="$t"; best="$(basename "$f" .json)";fi
  done
  [ -n "$best" ] && { printf '%s' "$best"; return 0; }
  return 1
}

# 恢复会话到当前请求（保留新生成的 system 提示）
# 用法: bai_session_load <id|last>
function bai_session_load {
  local want="$1" id dir file msgs_file
  id="$(bai_session_find "$want")" || return 1
  dir="$(bai_session_dir)"
  file="$dir/$id.json"
  [ -f "$file" ] || return 1
  msgs_file="$(mktemp "${TMPDIR:-/tmp}/.bai_session.XXXXXX" 2>/dev/null)" || return 1
  if ! jq -c '.messages' "$file" > "$msgs_file" 2>/dev/null;then
    rm -f "$msgs_file"
    return 1
  fi
  data="$(jq --slurpfile m "$msgs_file" '.messages = (.messages[0:1] + $m[0])' <<<"$data" 2>/dev/null)"
  rm -f "$msgs_file"
  BAI_SESSION_ID="$id"
  BAI_SESSION_CREATED="$(jq -r '.created // empty' "$file" 2>/dev/null)"
  BAI_SESSION_RESUME_TURNS="$(jq '[.messages[]? | select(.role=="user")] | length' <<<"$data" 2>/dev/null)"
  [[ "$BAI_SESSION_RESUME_TURNS" =~ ^[0-9]+$ ]] || BAI_SESSION_RESUME_TURNS=0
  BAI_SESSION_RESUME_MODEL="$(jq -r '.model // "-"' "$file" 2>/dev/null)"
  return 0
}

# 列出最近会话（markdown 表格）
# 用法: bai_session_list
function bai_session_list {
  local dir f id tmp rows n=0
  dir="$(bai_session_dir)"
  tmp="$(mktemp "${TMPDIR:-/tmp}/.bai_sessions.XXXXXX" 2>/dev/null)" || return 1
  for f in "$dir"/*.json;do
    [ -f "$f" ] || continue
    id="$(basename "$f" .json)"
    jq -r --arg id "$id" '[.updated // 0, $id, (.model // "-"), (([.messages[]? | select(.role=="user")] | length) | tostring), (.title // "-")] | @tsv' "$f" 2>/dev/null >> "$tmp"
  done
  [ -s "$tmp" ] || { rm -f "$tmp"; return 1; }
  rows="$(L10n-zh-Hans "session.table_headline | 会话 | 更新时间 | 模型 | 轮数 | 首句 |")"$'
''| --- | --- | --- | --- | --- |'$'
'
  while IFS=$'\t' read -r upd id model turns title;do
    [ -n "$id" ] || continue
    local mark="" tstr
    [ "$id" = "${BAI_SESSION_ID:-}" ] && mark="* "
    tstr="$(date -d "@$upd" '+%m-%d %H:%M' 2>/dev/null || echo "$upd")"
    rows+="| ${mark}$id | $tstr | $model | $turns | $title |"$'
'
    n=$((n+1))
    [ "$n" -ge "${BAI_SESSION_LIST_LIMIT:-15}" ] && break
  done < <(sort -rn "$tmp")
  rm -f "$tmp"
  printf '%s' "$rows" | Render-MDtable
  msg "$(L10n-zh-Hans "session.legend （* 表示当前会话；用 --resume <id> 恢复）")"
  return 0
}


# 计算压缩切点（保留最近 N 轮用户消息，切点一定落在 user 消息上，避免拆散工具调用配对）
# 用法: bai_context_cut_index [保留轮数]
function bai_context_cut_index {
  local __ck_keep="${1:-$BAI_COMPRESS_KEEP_TURNS}"
  jq --argjson keep "$__ck_keep" '
    . as $root
    | ([range(0; ($root.messages|length)) | select($root.messages[.].role == "user")]) as $users
    | if ($users|length) <= $keep then 0 else $users[($users|length) - $keep] end
  ' <<< "$data" 2>/dev/null
}

# 显示上下文压缩状态
function bai_compact_status {
  local __cs_tok __cs_pct
  __cs_tok="$(bai_context_tokens)"
  if [[ "${__model_cl:-0}" =~ ^[0-9]+$ ]] && ((__model_cl>0));then
    __cs_pct=$(gawk -v t="$__cs_tok" -v c="$__model_cl" 'BEGIN{printf "%.1f", t/c*100}' 2>/dev/null)
    msg "$(L10n-zh-Hans "compact.status 上下文估算 %s tokens / %s（占用 %s%%）｜自动压缩: %s｜阈值: %s%%｜保留最近 %s 轮｜摘要模型: %s" "$__cs_tok" "$__model_cl" "${__cs_pct:-?}" "$BAI_CONTEXT_COMPRESS" "$BAI_COMPRESS_THRESHOLD" "$BAI_COMPRESS_KEEP_TURNS" "${BAI_COMPRESS_MODEL:-$OPENAI_API_MODEL}")"
  else
    msg "$(L10n-zh-Hans "compact.status_unknown 上下文估算 %s tokens（未知上下文长度）｜自动压缩: %s｜阈值: %s%%｜保留最近 %s 轮" "$__cs_tok" "$BAI_CONTEXT_COMPRESS" "$BAI_COMPRESS_THRESHOLD" "$BAI_COMPRESS_KEEP_TURNS")"
  fi
}

# 第一层：截断切点之前的工具结果（保留最近 N 轮原文不动）
# 用法: bai_compact_truncate_tools <切点> [长度上限]
function bai_compact_truncate_tools {
  local __tt_cut="$1" __tt_limit="${2:-$BAI_COMPRESS_TOOL_LIMIT}" __tt_new __tt_keep
  ((__tt_cut>0)) || return 0
  # 与工具输出上限保持一致：旧结果最多保留到与上限相同，避免两套阈值打架
  if [[ "${BAI_TOOL_OUTPUT_LIMIT:-0}" =~ ^[0-9]+$ ]] && ((BAI_TOOL_OUTPUT_LIMIT>0)) && ((__tt_limit>BAI_TOOL_OUTPUT_LIMIT));then
    __tt_limit=$BAI_TOOL_OUTPUT_LIMIT
  fi
  if ((__tt_limit>80));then __tt_keep=$((__tt_limit-60));else __tt_keep=$((__tt_limit/2));fi
  __tt_new="$(jq --argjson cut "$__tt_cut" --argjson limit "$__tt_limit" --argjson keep "$__tt_keep" '
    . as $root
    | .messages = ([$root.messages[0:$cut][] |
        if (.role == "tool") and ((.content|type) == "string") and ((.content|length) > $limit)
        then .content = ((.content[0:$keep]) + "\n…（已截断，原文 " + ((.content|length)|tostring) + " 字符）")
        else . end] + $root.messages[$cut:])
  ' <<< "$data" 2>/dev/null)"
  [ -n "$__tt_new" ] && data="$__tt_new"
  return 0
}

# 第二层（图片）：把切点之前的图片换成一段文字描述
# 用法: bai_compact_caption_images <切点>
function bai_compact_caption_images {
  local __ci_cut="$1" __ci_i __ci_j __ci_n __ci_img __ci_key __ci_cap __ci_saved __ci_body
  ((__ci_cut>0)) || return 0
  declare -gA BAI_IMAGE_CAPTIONS 2>/dev/null
  for ((__ci_i=0;__ci_i<__ci_cut;__ci_i++));do
    __ci_n=$(jq --argjson i "$__ci_i" '(.messages[$i].content // []) | if type == "array" then length else 0 end' <<< "$data" 2>/dev/null)
    [[ "$__ci_n" =~ ^[0-9]+$ ]] || continue
    ((__ci_n)) || continue
    for ((__ci_j=__ci_n-1;__ci_j>=0;__ci_j--));do
      [[ "$(jq -r --argjson i "$__ci_i" --argjson j "$__ci_j" '.messages[$i].content[$j].type // empty' <<< "$data" 2>/dev/null)" == "image_url" ]] || continue
      __ci_img=$(jq -r --argjson i "$__ci_i" --argjson j "$__ci_j" '.messages[$i].content[$j].image_url.url // empty' <<< "$data" 2>/dev/null)
      [ -n "$__ci_img" ] || continue
      __ci_key=$(printf '%s' "$__ci_img" | sha256sum | cut -d' ' -f1)
      __ci_cap="${BAI_IMAGE_CAPTIONS[$__ci_key]:-}"
      if [ -z "$__ci_cap" ];then
        __ci_saved="$data"
        __ci_body=$(jq -n --arg model "$OPENAI_API_MODEL" --arg url "$__ci_img" \
          --arg prompt "$(L10n-zh-Hans "compact.image_prompt 请用一段话描述这张图片的要点，保留与当前对话相关的信息（文字内容、界面元素、关键数字）。只输出描述本身。")" \
          '{model: $model, stream: false, messages: [{role: "user", content: [{type: "text", text: $prompt}, {type: "image_url", image_url: {url: $url}}]}]}')
        data="$__ci_body"
        Wait-Assistant-Content 2>/dev/null
        __ci_cap="$(jq -r "$(bai_api_aux_content_path) // empty" <<< "$CURL_GET_API" 2>/dev/null)"
        data="$__ci_saved"
        [ -n "$__ci_cap" ] || __ci_cap="$(L10n-zh-Hans "compact.image_omitted （图片已省略：未能生成描述）")"
        BAI_IMAGE_CAPTIONS["$__ci_key"]="$__ci_cap"
      fi
      data=$(jq --argjson i "$__ci_i" --argjson j "$__ci_j" --arg text "[图片描述：$__ci_cap]" \
        '.messages[$i].content[$j] = {type: "text", text: $text}' <<< "$data")
    done
  done
  return 0
}

# 第三层：把切点之前的对话分块摘要成一段文字
# 用法: bai_compact_summarize <切点>
# 行为控制:
#       变量 BAI_COMPACT_SUMMARY（成功时写入摘要）
function bai_compact_summarize {
  local __sm_cut="$1" __sm_budget="${BAI_COMPRESS_CHUNK_CHARS:-40000}"
  local __sm_model="${BAI_COMPRESS_MODEL:-$OPENAI_API_MODEL}"
  local __sm_i=0 __sm_piece __sm_chunk __sm_summary="" __sm_user __sm_saved __sm_body __sm_rounds=0
  local __sm_sys
  __sm_sys="$(L10n-zh-Hans "compact.summary_system You are a conversation compression assistant. Please compress the given conversation history into key points, retaining: user goals and preferences, achieved decisions, key facts and numbers, file paths/commands/interface names, and unfinished tasks. Don't fabricate, don't output polite words.")"
  while ((__sm_i<__sm_cut));do
    __sm_chunk=""
    while ((__sm_i<__sm_cut));do
      __sm_piece=$(jq -r --argjson i "$__sm_i" '
        .messages[$i] as $m
        | if ($m.role == "system") then ""
          else "[" + ($m.role // "?") + "] "
            + (if ($m.content|type) == "array" then ($m.content | map(if .type == "text" then .text else (if .type == "image_url" then "[Image]" else "" end) end) | join(" "))
               elif ($m.content|type) == "string" then $m.content else "" end)
            + (if $m.tool_calls then " | Call: " + ($m.tool_calls | map(.function.name + "(" + .function.arguments + ")") | join("; ")) else "" end)
          end
      ' <<< "$data" 2>/dev/null)
      __sm_piece="${__sm_piece//$'\n'/ }"
      if ((${#__sm_chunk} + ${#__sm_piece} > __sm_budget)) && ((${#__sm_chunk} > 0));then break;fi
      __sm_chunk+="$__sm_piece"$'\n'
      __sm_i=$((__sm_i+1))
    done
    if [ -n "$__sm_summary" ];then
      __sm_user="$(L10n-zh-Hans "compact.summary_user_update 已有摘要：\n%s\n\n新增对话：\n%s\n\n请输出合并后的完整摘要。" "$__sm_summary" "$__sm_chunk")"
    else
      __sm_user="$(L10n-zh-Hans "compact.summary_user_first 对话记录：\n%s\n\n请输出摘要。" "$__sm_chunk")"
    fi
    __sm_saved="$data"
    __sm_body=$(jq -n --arg model "$__sm_model" --arg sys "$__sm_sys" --arg user "$__sm_user" \
      '{model: $model, stream: false, messages: [{role: "system", content: $sys}, {role: "user", content: $user}]}')
    data="$__sm_body"
    Wait-Assistant-Content 2>/dev/null
    __sm_summary="$(jq -r "$(bai_api_aux_content_path) // empty" <<< "$CURL_GET_API" 2>/dev/null)"
    data="$__sm_saved"
    [ -n "$__sm_summary" ] || return 1
    __sm_rounds=$((__sm_rounds+1))
    ((__sm_rounds>40)) && return 1
  done
  BAI_COMPACT_SUMMARY="$__sm_summary"
  return 0
}

# 执行上下文压缩
# 用法: bai_compact [full|tools|auto]
# 行为控制:
#       变量 data, BAI_COMPACT_BACKUP
function bai_compact {
  local __cp_mode="${1:-full}" __cp_cut __cp_before __cp_after __cp_text
  __cp_cut="$(bai_context_cut_index)"
  [[ "$__cp_cut" =~ ^[0-9]+$ ]] || __cp_cut=0
  if ((__cp_cut<=0));then
    msg "$(L10n-zh-Hans "compact.nothing_to_do 没有可压缩的历史（保留最近 %s 轮原文）" "$BAI_COMPRESS_KEEP_TURNS")"
    return 0
  fi
  __cp_before="$(bai_context_tokens)"
  BAI_COMPACT_BACKUP="${TMPDIR:-/tmp}/.bai_compact_backup_$$"
  printf '%s' "$data" > "$BAI_COMPACT_BACKUP"
  bai_compact_truncate_tools "$__cp_cut"
  if [ "$__cp_mode" != "tools" ];then
    bai_compact_caption_images "$__cp_cut"
    if bai_compact_summarize "$__cp_cut";then
      __cp_text="$(L10n-zh-Hans "compact.summary_prefix 以下是此前对话的压缩摘要（原文已省略）：")"$'\n'"$BAI_COMPACT_SUMMARY"
      data=$(jq --argjson cut "$__cp_cut" --arg s "$__cp_text" '
        . as $r
        | .messages = ([$r.messages[] | select(.role == "system")] + [{role: "system", content: $s}] + $r.messages[$cut:])
      ' <<< "$data")
    else
      emsg "$(L10n-zh-Hans "compact.summary_failed 摘要生成失败，已直接丢弃早期对话")"
      data=$(jq --argjson cut "$__cp_cut" '
        . as $r
        | .messages = ([$r.messages[] | select(.role == "system")] + [{role: "system", content: "（更早的对话已省略以节省上下文）"}] + $r.messages[$cut:])
      ' <<< "$data")
    fi
  fi
  __cp_after="$(bai_context_tokens)"
  msg "$(L10n-zh-Hans "compact.done 上下文压缩完成：约 %s → %s tokens（%s）" "$__cp_before" "$__cp_after" "$__cp_mode")"
  return 0
}

# 撤销上一次压缩
function bai_compact_undo {
  if [ -n "${BAI_COMPACT_BACKUP:-}" ] && [ -f "${BAI_COMPACT_BACKUP}" ];then
    data="$(cat "$BAI_COMPACT_BACKUP")"
    msg "$(L10n-zh-Hans "compact.undo_done 已恢复压缩前的对话")"
    return 0
  fi
  emsg "$(L10n-zh-Hans "compact.undo_missing 没有可恢复的压缩记录")"
  return 1
}

########################################################################

# 导入导出对话记录
# 用法: Get-Session-Messages <文件> <操作> [行为]
# 选项:
#       操作 操作类型，可选值为 export、import
#       参数 操作参数，可选
#            操作参数（export）:
#            @no:system 默认行为基础上不包含系统消息
#            @no:tool 默认行为基础上不包含工具调用记录
#            @use:all 包含所有记录，包括请求体中的参数，此行为仅兼容导入messages记录（泄露风险较高）
#            @default 默认行为，包含message内所有记录，不包含请求体中的参数
# * 如有用户名则在所有行为中添加用户名
function Get-Session-Messages {
  function __subfunction_ask(){
    if $__has_extend_gum;then
      if gum confirm "${!2}";then
        get_session_import_or_export="$1"
      else
        msg "$(L10n-zh-Hans "get_session_messages.cancelled 取消操作")"
        return 1
      fi
    else
      msg "${!2}[Y/n] " -n
      read confirm
      if [[ "${confirm:=Y}" =~ ^[Yy]$ ]];then
        get_session_import_or_export="$1"
      else
        msg "$(L10n-zh-Hans "get_session_messages.cancelled 取消操作")"
        return 1
      fi
    fi
  }
  get_session_import_or_export=""
  local get_session_params
  local get_session_json
  local import_ask="$(L10n-zh-Hans "get_session_messages.import_ask 导入对话记录将覆盖当前对话记录，确定吗？")"
  local export_ask="$(L10n-zh-Hans "get_session_messages.export_ask 导出对话记录将覆盖当前文件，确定吗？")"
  [[ "$1" && -f "$1" ]] || { emsg "$(L10n-zh-Hans "get_session_messages.no_file_specified 未指定文件")"; return 1;}
  case "$2" in
    export)
      jq -e '.messages | length > 0' <<< "$data" &>/dev/null || { emsg "$(L10n-zh-Hans "get_session_messages.empty_session 对话记录为空")"; return 1;}
      ((__turns)) || { emsg "$(L10n-zh-Hans "get_session_messages.empty_session 对话记录为空")"; return 1;}
      __subfunction_ask "false" export_ask
      ;;
    import)
      __subfunction_ask "true" import_ask
      ;;
    *)
      [ "$2" ] && emsg "$(L10n-zh-Hans "get_session_messages.no_operation 未指定操作")" && return 1
      emsg "$(L10n-zh-Hans "get_session_messages.unknown_operation 未知操作") $2"
      return 1
      ;;
  esac

  case "${3:-@default}" in
    @no:system)
      get_session_params='{ messages: [ .messages[] | select(.role != "system") ] }'
      ;;
    @no:tool)
      get_session_params='{ messages: [ .messages[] | select(.role != "tool") ] }'
      ;;
    @use:all)
      get_session_params='. + { content_type: "application/json", url: $baseurl + "/chat/completions", apikey: $apikey, client: "bai-cli (github.com/hornleaf)", export_date: now }'
      ;;
    @default)
      get_session_params='{ messages: [.messages[]]}'
      ;;
    *)
      emsg "$(L10n-zh-Hans "get_session_messages.unknown_behavior 未知行为") $3"
      return 1
      ;;
  esac
  
  if $get_session_import_or_export;then
    # 校验数据结构，message[]中对象包含role和content即可
    jq -e '.messages[] | has("role") and has("content")' "$1" &>/dev/null || { emsg "#import: $(L10n-zh-Hans "get_session_messages.import_data_structure_error 数据结构错误")"; return 1;}
    get_session_json="$(jq -r '[.messages[]]' "$1")" || { emsg "#import: $(L10n-zh-Hans "get_session_messages.import_read_failed 读取对话记录失败")"; return 1;}
    data="$(jq -r --argjson messages "$get_session_json" '.messages =$messages' <<< "$data")" || { emsg "#import: $(L10n-zh-Hans "get_session_messages.import_write_failed 写入对话记录失败")"; return 1;}
    __turns="$(jq '[.messages[] | select(.role == "user")] | length' <<< "$data")"
    if jq -e '.username' "$1" &>/dev/null;then
      BAI_USERNAME="$(jq -r '.username' "$1")"
      data="$(jq -r --arg username "$BAI_USERNAME" '. + { username: $username }' <<< "$data")"
      get.session.title
      $INTERACT_MODE && Set-Terminal-Title "$BAI_TITLE"
    fi
    msg "#import: $(L10n-zh-Hans "get_session_messages.import_success 导入成功")"
  else
    get_session_json="$(jq -r --arg baseurl "$OPENAI_BASE_URL" --arg model "$OPENAI_API_MODEL" --arg apikey "$OPENAI_API_KEY" "$get_session_params" <<< "$data" | (if [ "$BAI_USERNAME" ];then jq --arg username "$BAI_USERNAME" '. + { username: $username }';else cat;fi))" || { emsg "#export: $(L10n-zh-Hans "get_session_messages.export_read_failed 读取对话记录失败")"; return 1;}
    echo "$get_session_json" > "$1"
    msg "#export: $(L10n-zh-Hans "get_session_messages.export_success 导出成功")"
  fi
}

########################################################################

# 查看对话记录
# 用法: Get-Session-History
# 选项:
#       无
# 行为控制:
#       变量 __has_extend_bat
#       若为 true 则使用 bat，否则使用 less
function Get-Session-History {
  ((__turns)) || { emsg "$(L10n-zh-Hans "get_session_messages.empty_session 对话记录为空")"; return 1;}
  local session_username="${BAI_USERNAME:-"$(L10n-zh-Hans "get_session_messages.default_username 用户")"}"
  if jq -e '.username' <<< "$data" &>/dev/null;then
    session_username="$(jq -r '.username' <<< "$data")"
  fi
  local __jq_filter='
    def extract_user_text(\\$c):
      if (\\$c | type) == "array" then
        (\\$c | map(select(.type == "text").text) | join(" "))
      else
        \\$c
      end;
    def extract_image_marker(\\$c):
      if (\\$c | type) == "array" then
        (\\$c | map(select(.type == "image_url")) | length) as \\$cnt |
        if \\$cnt > 0 then " \e[34m[{{IMAGE}}×\(\\$cnt)]\e[0m" else "" end
      else
        ""
      end;
    def extract_file_marker(\\$c):
      if (\\$c | type) == "array" then
        (\\$c | map(select(.file_id).file_id) + map(select(.type == "file").file_id)) as \\$ids |
        if (\\$ids | length) > 0 then " \e[32m[{{FILE}} " + (\\$ids | join(", ")) + "]\e[0m" else "" end
      elif (\\$c | type) == "object" and \\$c.file_id then
        " \e[32m[{{FILE}} " + \\$c.file_id + "]\e[0m"
      else
        ""
      end;
    .messages[] |
    if .role == "system" then
      "\e[35m{{SYSTEM}}\e[0m " + .content
    elif .role == "user" then
      extract_user_text(.content) as \\$text |
      extract_image_marker(.content) as \\$img |
      extract_file_marker(.content) as \\$files |
      "\e[32m" + \\$username + ":\e[0m " + \\$text + \\$img + \\$files
    elif .role == "assistant" then
      if .tool_calls then
        ("" +
        (if .reasoning_content then "(\e[35m{{REASONING}}\e[0m) " + (.reasoning_content | gsub("\\\\\\\\\\\\\\n"; "\n")) + "\n" else "" end) +
        (if .content then "\e[34m{{ASSISTANT}}\e[0m " + .content + "\n" else "" end) +
        (if .tool_calls then "\e[32m{{RUN_FUNCTION}}\e[0m \e[35m" + ([.tool_calls[] | .function.name // "?"] | join("\e[0m \e[35m")) + "\e[0m" else "" end)
        ) as \\$body |
        "\e[34m{{ASSISTANT}}\e[0m " + (\\$body | gsub("\\n$"; ""))
      elif .reasoning_content then
        "\e[34m{{ASSISTANT}}\e[0m (\e[35m{{REASONING}}\e[0m) " + (.reasoning_content | gsub("\\\\\\\\\\\\\\n"; "\n")) + "\n\e[34m{{ASSISTANT}}\e[0m " + .content
      else
        "\e[34m{{ASSISTANT}}\e[0m " + .content
      end
    else
      empty
    end
  '
  Set-Terminal-Title "$BAI_TITLE | History"
  jq -r --arg username "$session_username" "${__jq_filter@P}" <<< "$data" <<< "$data" |
  sed "s|{{ASSISTANT}}|$(L10n-zh-Hans "get_session_history.assistant_label 助手:")|g;
       s|{{RUN_FUNCTION}}|$(L10n-zh-Hans "get_session_history.run_function_label 调用工具:")|g;
       s|{{REASONING}}|$(L10n-zh-Hans "get_session_history.reasoning_label 正在思考")|g;
       s|{{SYSTEM}}|$(L10n-zh-Hans "get_session_history.system_label 系统提示:")|g;
       s|{{IMAGE}}|$(L10n-zh-Hans "get_session_history.image_label 图片")|g;
       s|{{FILE}}|$(L10n-zh-Hans "get_session_history.file_label 文件")|g" |
  (if $__has_extend_bat;then bat -l markdown --paging=always --plain;else less -R;fi)
  Set-Terminal-Title "$BAI_TITLE"
}

