# 用户提示符刷新
# 转义 sed 替换串里的特殊字符（反斜杠 / 分隔符 / &）
# 用法: bai_sed_escape <字符串>
function bai_sed_escape {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//|/\\|}"
  s="${s//&/\\&}"
  printf '%s' "$s"
}

function Refresh-User-Prompt {
