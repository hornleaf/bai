# 错误输出并退出
# 用法: exmsg <message> <echo option>
# 输入: <message> 错误信息
#       <echo option> 使用echo命令输出选项，已占用 -e
function exmsg { exec echo -e $2 "${c0}${c31}$(L10n-zh-Hans "error_prefix 错误"):${c0} $1" >&2; }

# 仅错误输出
# 用法: emsg <message> <echo option>
# 输入: <message> 错误信息
#       <echo option> 使用echo命令输出选项，已占用 -e
function emsg(echo -e $2 "${c0}${c31}$(L10n-zh-Hans "error_prefix 错误"):${c0} $1" >&2)

# 常时输出
# 用法: msg <message> <echo option>
# 输入: <message> 输出信息
#       <echo option> 使用echo命令输出选项，已占用 -e
function msg(echo -e $2 "${c0}${c35}$arg0:${c0} $1")

# 更具交互性的错误输出
# 用法: erron <message>
# 行为控制:
#         变量 ERRON
#         为 true 时，会在错误输出前清除当前行，等待 1 秒后恢复
#         为 false 时，会直接输出错误信息
function erron
  if $ERRON;then
    printf "${c0}\e[1A\r${ek}"
    emsg "$1${l25}\e[8m" -n
    sleep 1
    printf "\r${h25}\e[28m${ek}"
  else
    emsg "$1" $2
  fi

# 调试输出
# 用法: debug <message> <echo option>
# 输入: <message> 调试信息
#       <echo option> 使用echo命令输出选项，已占用 -e
# 行为控制:
#         变量 DEBUG
#         为 true 时，会输出预定的调试信息
#         为 false 时，不会输出调试信息
function debug(${DEBUG:-false} && echo -e $2 "${c0}${c33}$(DEBUG_MESSAGE=true L10n-zh-Hans "debug_prefix 调试"):${c0} $1" >&2)

