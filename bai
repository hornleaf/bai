# 规范化等待指示器的渐变模式
# 用法: bai_wait_gradient_mode [模式]
# 输出: color | gray | dual | none
# 选项:
#       [模式] 未指定时读取 BAI_WAIT_GRADIENT（默认 color）
# 返回值: 0 合法 / 1 未知模式
function bai_wait_gradient_mode {
  local m="${1:-${BAI_WAIT_GRADIENT:-dual}}"
  case "${m,,}" in
    color|colour|rainbow|彩色|true|on)   echo color;;
    gray|grey|grayscale|grey-scale|灰度) echo gray;;
    dual|two|two-color|duo|双色)          echo dual;;
    none|off|plain|无|false)             echo none;;
    *) return 1;;
  esac
}

# 判断当前输出是否启用颜色
# 用法: bai_color_enabled
# 返回值: 0 启用颜色 / 1 不启用（BAI_COLOR=never，或 auto 且非 tty）
function bai_color_enabled {
  case "${BAI_COLOR:-auto}" in
    always) return 0;;
    never)  return 1;;
    *)      [[ "${BAI_STDOUT_TTY:-false}" == "true" ]];;
  esac
}

# 规范化灰度渐变风格
# 用法: bai_wait_gray_style [风格]
# 输出: band | sine | white | breath | contrast | ramp
# 选项:
#       [风格] 未指定时读取 BAI_WAIT_GRAY_STYLE（默认 band）
# 说明:
#       band     暗灰底 + 白色亮斑从左向右横扫（默认，最"有动感"）
#       sine     灰阶正弦明暗流动（最初的灰度效果）
#       white    150–255，只灰到白，不发黑
#       breath   整行同一亮度一起明暗（呼吸）
#       contrast 56–255，暗部更暗、白更亮
#       ramp     白→灰单向斜坡横向滚动
# 返回值: 0 合法 / 1 未知风格
function bai_wait_gray_style {
  local s="${1:-${BAI_WAIT_GRAY_STYLE:-band}}"
  case "${s,,}" in
    band|sweep|scan|wipe|扫光|亮带)    echo band;;
    sine|wave|classic|正弦)            echo sine;;
    white|灰白)                        echo white;;
    breath|breathe|pulse|呼吸)         echo breath;;
    contrast|high|strong|对比)         echo contrast;;
    ramp|shimmer|metal|flow|流动)      echo ramp;;
    *) return 1;;
  esac
}

# 规范化双色渐变的两个端点颜色
# 用法: bai_wait_dual_colors [颜色对]
# 输出: "r1;g1;b1 r2;g2;b2"
# 选项:
#       [颜色对] 形如 255,128,255:128,255,255；未指定时读取 BAI_WAIT_DUAL_COLORS
# 说明:
#       任一分量非法或越界时整体回落默认（255,0,255:0,255,255）
function bai_wait_dual_colors {
  local pair="${1:-${BAI_WAIT_DUAL_COLORS:-255,0,255:0,255,255}}" c1 c2
  local a1 a2 a3 b1 b2 b3 v ok=true
  c1="${pair%%:*}"
  c2="${pair#*:}"
  [ "${c1}" = "${pair}" ] && c2=""     # 没有冒号：非法
  IFS=, read -r a1 a2 a3 <<< "${c1}"
  IFS=, read -r b1 b2 b3 <<< "${c2}"
  for v in "${a1}" "${a2}" "${a3}" "${b1}" "${b2}" "${b3}";do
    if [[ ! "$v" =~ ^[0-9]+$ ]] || (( v > 255 ));then ok=false; fi
  done
  $ok || { a1=255; a2=128; a3=255; b1=128; b2=255; b3=255; }
  printf '%d;%d;%d %d;%d;%d\n' "$((a1))" "$((a2))" "$((a3))" "$((b1))" "$((b2))" "$((b3))"
}

# 应用等待指示器渐变模式
# 用法: bai_wait_gradient_apply [模式]
# 行为控制:
#       变量 __bai_wait_gradient
#       保存生效的模式（color|gray|none），供 Print-ColorFull 读取
#       变量 BAI_COLOR
#       为 never 时强制降级为 none（ANSI 会被剥掉，没必要每帧算渐变）
function bai_wait_gradient_apply {
  local mode
  mode="$(bai_wait_gradient_mode "${1:-${BAI_WAIT_GRADIENT:-dual}}")" || return 1
  bai_color_enabled || mode=none
  __bai_wait_gradient="$mode"
  __bai_gray_style="$(bai_wait_gray_style)" || __bai_gray_style=band
  __bai_wait_dual="$(bai_wait_dual_colors)" || __bai_wait_dual="255;128;255 128;255;255"
  case "${BAI_WAIT_DUAL_STYLE:-band}" in
    band|sweep|扫光) __bai_wait_dual_style=band;;
    static|固定)     __bai_wait_dual_style=static;;
    *)               __bai_wait_dual_style=flow;;
  esac
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.wait_gradient 等待指示器渐变模式: %s（灰度风格 %s）" "$mode" "$__bai_gray_style")"
  return 0
}

