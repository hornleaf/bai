        shift ${BASH_REMATCH[1]}
      else
        exmsg "${!ARGS_ERR}"
      fi
      ;;
    --no-extend*|-ne*)
      Limit-Repeation-Arguments mark_options_no_extend "$1"
      VAR_ARG="BAI_DISABLE_EXTEND"
      ARG_ERR="$(L10n-zh-Hans "option.no-extend.no_arg_value 未指定排除项")" \
      ARG_OPTS="ne,no-extend" \
      ARG_KEY="$VAR_ARG" \
      Get-Arguments-Value "$@"
      RETURN=$?
      if [[ "$RETURN" =~ ^10([12])$ ]];then
        shift ${BASH_REMATCH[1]}
      else
        exmsg "${!ARGS_ERR}"
      fi
      ;;
    --no-tools*|-nt*)
      Limit-Repeation-Arguments mark_options_no_tools "$1"
      VAR_ARG="BAI_DISABLE_TOOLS"
      ARG_ERR="$(L10n-zh-Hans "option.no-tools.no_arg_value 未指定排除项")" \
      ARG_OPTS="nt,no-tools" \
      ARG_KEY="$VAR_ARG" \
      Get-Arguments-Value "$@"
      RETURN=$?
      if [[ "$RETURN" =~ ^10([12])$ ]];then
        shift ${BASH_REMATCH[1]}
      else
        exmsg "${!ARGS_ERR}"
      fi
      [[ "${!VAR_ARG}" =~ ^[a-zA-Z0-9_]+($|,([a-zA-Z0-9_]+,)*[a-zA-Z0-9_]+)?$ ]] ||
      exmsg "$(L10n-zh-Hans "option.no-tools.invalid_list 非法的函数禁用名单")"
      ;;
    --wait-style*|-w*)
      Limit-Repeation-Arguments mark_options_wait_style "$1"
      VAR_ARG="BAI_WAIT_STYLE"
      ARG_ERR="$(L10n-zh-Hans "option.wait-style.no_arg_value 未指定等待样式")" \
      ARG_OPTS="w,wait-style" \
      ARG_KEY="BAI_WAIT_STYLE" \
      Get-Arguments-Value "$@"
      RETURN=$?
      if [[ "$RETURN" =~ ^10([12])$ ]];then
        shift ${BASH_REMATCH[1]}
      else
        exmsg "$__bai_option_name: $ARGS_ERR"
      fi
      _all_wait_style=(
        bar
        dot
        bell
        {roll,invisible}{,:{fraktur,double,cursive}}
        block
        breakdown
        custom
        dotmatrix
      )
      if [[ " ${_all_wait_style[@]} " == *" ${!VAR_ARG} "* ]];then
        Switch-Wait-Frame "${!VAR_ARG}"
      else
        _for_wait_style=()
        for i in "${_all_wait_style[@]}";do
          [[ "$i" == *"${!VAR_ARG}"* ]] && _for_wait_style+=("$i")
        done
        ((${#_for_wait_style[@]})) && {
          emsg "$(L10n-zh-Hans "option.wait-style.unknown_style 未知的等待样式: ${c32}%s${c0}, 找到包含 \"${c32}%s${c0}\" 的样式:" "${!VAR_ARG}" "${!VAR_ARG}")"
          printf " --- ${c32}%s${c0}\n" "${_for_wait_style[@]}"
          exec echo
        }
        # 初始化最小距离和最相似参数
        _min_da=5
        _min_distance="$_min_da"
        _sim_option=""
        # 遍历所有有效参数，计算距离
        for o in "${_all_wait_style[@]}";do
          _distance=$(Get-Levenshtein "${!VAR_ARG}" "$o")
          if ((_distance<_min_distance));then
            _min_distance="$_distance"
            _sim_option="$o"
          fi
        done
        if ((_min_distance<_min_da));then
          exmsg "$(L10n-zh-Hans "option.wait-style.unknown_style_with_similar 未知的等待样式: ${c33}%s${c0}, 找到距离最近的样式 ${c32}%s${c0}" "${!VAR_ARG}" "$_sim_option")"
        else
          exmsg "$(L10n-zh-Hans "option.wait-style.unknown_style 未知的等待样式: ${c33}%s${c0}" "${!VAR_ARG}")"
        fi
      fi
      ;;
    --)
      shift
      ;;
    -*)
      # 检查参数
      if [[ "$1" == --* ]];then
        _all_options=(
          help
          session-help
          argtest
          stream
          thinking
          reasoning-effort{,-replace}
          search
          partial
          debug
          no-limit-turns
          no-limit-tools
          baseurl
          apikey
          model
          title
          inspect
          sysfile
          histfile
          config
          callfile
          no-extend
          wait-style
          conemu-status
        )
        _arg1=${1:2}
        _for_num=0
        _for_options=()
        for i in "${_all_options[@]}";do
          [[ "$i" == *"$_arg1"* ]] && _for_options+=("$i")
        done
        ((${#_for_options[@]})) && {
          emsg "$(L10n-zh-Hans "option.unknown_option_with_similar 未知的选项: ${c33}%s${c0}, 找到包含 \"${c32}%s${c0}\" 的选项:" "$1" "$_arg1")"
          printf "  ${c32}--%s${c0}\n" "${_for_options[@]}"
          exec echo
        }
        # 初始化最小汉明距离和最相似参数
        _min_da=5
        _min_distance="$_min_da"
        _sim_option=""
        # 遍历所有有效参数，计算汉明距离
        for o in "${_all_options[@]}";do
          _distance=$(Get-Levenshtein "$_arg1" "$o")
          if ((_distance<_min_distance));then
            _min_distance="$_distance"
            _sim_option="$o"
          fi
        done
        if ((_min_distance<_min_da));then
          exmsg "$(L10n-zh-Hans "option.unknown_option_with_similar_and_similar 未知的选项: ${c33}%s${c0}, 找到距离最近的选项 ${c32}--%s${c0}" "$1" "$_sim_option")"
        else
          exmsg "$(L10n-zh-Hans "option.unknown_option 未知的选项: ${c33}%s${c0}" "$1")"
        fi
      else
        exmsg "$(L10n-zh-Hans "option.unknown_option 未知的选项: ${c33}%s${c0}" "$1")"
      fi
      ;;
    *)
      # 输入提问文件或提问
      if [ "$1" ];then
        if [[ -z "$OPENAI_USER_PROMPT" ]];then
          OPENAI_USER_PROMPT="${1}"
          [[ -f "$OPENAI_USER_PROMPT" ]] && OPENAI_USER_PROMPT="$(cat "$OPENAI_USER_PROMPT")"
          shift
        else
          exmsg "$(L10n-zh-Hans "option.too_many_prompts 过多的提问")"
        fi
      fi
      ;;
  esac
done

