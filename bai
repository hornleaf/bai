# MarkDown 表格渲染
# 用法: Render-MDtable
function Render-MDtable {
  gawk '
    BEGIN {
        if (w == "") {
            cmd = "stty size -F /dev/tty 2>/dev/null"
            if ((cmd | getline out) > 0) {
                split(out, a, " ")
                w = a[2]
            } else {
                cmd2 = "tput cols 2>/dev/null"
                w = ((cmd2 | getline out2) > 0) ? out2 : 80
                close(cmd2)
            }
            close(cmd)
        }
        w += 0
        if (w < 20) w = 80

        H  = "─"; V  = "│"
        TL = "┌"; TR = "┐"; BL = "└"; BR = "┘"
        ML = "├"; MR = "┤"; MT = "┬"; MB = "┴"; MC = "┼"
        tn = 0
    }

    # ---- display width -----------------------------------------------------------
    function wwidth(s,    esc, cmd, wd) {
        if (s in _W) return _W[s]
        if (s !~ /[^\x00-\x7F]/) { _W[s] = length(s); return length(s) }
        esc = s; gsub(/\x27/, "\x27\\\x27\x27", esc)
        cmd = "printf %s \x27" esc "\x27 | wc -L"
        cmd | getline wd; close(cmd)
        _W[s] = wd + 0
        return _W[s]
    }

    # ---- input collector ---------------------------------------------------------
    /^[[:space:]]*\|.*\|[[:space:]]*$/ {
        _TR[++tn] = $0; next
    }
    {
        if (tn > 0) { draw(_TR, tn); delete _TR; tn = 0 }
        print
    }
    END { if (tn > 0) draw(_TR, tn) }

    # ---- table rendering ---------------------------------------------------------
    function repeat(s, n,  r) { r = ""; while (n-- > 0) r = r s; return r }
    function strip(s)         { gsub(/^[[:space:]]+|[[:space:]]+$/, "", s); return s }

    function split_cells(line, cells,   t, n, i) {
        t = line; sub(/^[[:space:]]*\|/, "", t); sub(/\|[[:space:]]*$/, "", t)
        n = split(t, cells, /[[:space:]]*\|[[:space:]]*/)
        for (i = 1; i <= n; i++) cells[i] = strip(cells[i])
        return n
    }

    function is_sep_row(line,    n, cells, i, s) {
        if (line !~ /^\s*\|.*\|\s*$/) return 0
        n = split_cells(line, cells); if (n < 1) return 0
        for (i = 1; i <= n; i++) {
            s = cells[i]; gsub(/ /, "", s)
            if (s !~ /^:?--+:?$/) return 0
        }
        return 1
    }

    function parse_align(s,   t) {
        t = s; gsub(/ /, "", t)
        if (t ~ /^:.*:$/) return "center"
        if (t ~ /:$/)     return "right"
        return "left"
    }

    function align(s, w, a,   l) {
        if (a == "right")  return sprintf("%*s%s", w - wwidth(s), "", s)
        if (a == "center") {
            l = int((w - wwidth(s)) / 2)
            return sprintf("%*s%s%*s", l, "", s, w - wwidth(s) - l, "", "")
        }
        return sprintf("%s%*s", s, w - wwidth(s), "")
    }

    function wrap(text, wid,    nw, words, i, wd, line, nl, k) {
        delete WL; nl = 0; line = ""
        nw = split(text, words, / /)
        for (i = 1; i <= nw; i++) {
            wd = words[i]; if (wd == "") continue
            if (line == "") {
                while (wwidth(wd) > wid) {
                    for (k = length(wd); k >= 1; k--)
                        if (wwidth(substr(wd, 1, k)) <= wid) break
                    if (k < 1) k = 1
                    WL[++nl] = substr(wd, 1, k); wd = substr(wd, k + 1)
                }
                line = wd
            } else if (wwidth(line) + 1 + wwidth(wd) <= wid) {
                line = line " " wd
            } else {
                WL[++nl] = line
                while (wwidth(wd) > wid) {
                    for (k = length(wd); k >= 1; k--)
                        if (wwidth(substr(wd, 1, k)) <= wid) break
                    if (k < 1) k = 1
                    WL[++nl] = substr(wd, 1, k); wd = substr(wd, k + 1)
                }
                line = (wd == "" ? "" : wd)
            }
        }
        if (line != "") WL[++nl] = line
        if (nl == 0)   WL[++nl] = ""
        return nl
    }

    function _J(pos, side) {
        if (pos == "t") { if (side == "l") return TL; if (side == "r") return TR; return MT }
        if (pos == "m") { if (side == "l") return ML; if (side == "r") return MR; return MC }
        if (side == "l") return BL; if (side == "r") return BR; return MB
    }

    function border(widths, nc, pos,    j) {
        for (j = 1; j <= nc; j++)
            printf "%s%s", (j == 1 ? _J(pos, "l") : _J(pos, "m")), repeat(H, widths[j] + 2)
        print _J(pos, "r")
    }

    function cell_row(cells, ri, nc, widths, alns,
                      maxh, j, li, k, n, text, inner) {
        delete CL; delete NL; maxh = 0
        for (j = 1; j <= nc; j++) {
            n = wrap(cells[ri, j], widths[j])
            NL[j] = n; if (n > maxh) maxh = n
            for (k = 1; k <= n; k++) CL[j, k] = WL[k]
        }
        if (maxh == 0) maxh = 1
        for (li = 1; li <= maxh; li++) {
            for (j = 1; j <= nc; j++) {
                text = (li <= NL[j]) ? CL[j, li] : ""
                inner = align(text, widths[j], alns[j])
                printf "%s %s ", V, inner
            }
            print V
        }
    }

    function draw(T, tn,
                  nc, hc, sc, dc, alns, widths, has_sep, ds,
                  i, j, n_data, tmp, total, avail, extra) {
        nc = split_cells(T[1], hc)

        has_sep = 0; ds = 2
        if (tn >= 2 && is_sep_row(T[2])) {
            has_sep = 1; split_cells(T[2], sc)
            for (j = 1; j <= nc; j++) alns[j] = parse_align(sc[j])
            ds = 3
        } else {
            for (j = 1; j <= nc; j++) alns[j] = "left"
        }

        n_data = 0; delete dc
        for (i = ds; i <= tn; i++) {
            n_data++; split_cells(T[i], tmp)
            for (j = 1; j <= nc; j++) dc[n_data, j] = tmp[j]
        }

        for (j = 1; j <= nc; j++) {
            widths[j] = wwidth(hc[j])
            for (i = 1; i <= n_data; i++) {
                k = wwidth(dc[i, j])
                if (k > widths[j]) widths[j] = k
            }
            if (widths[j] < 3) widths[j] = 3
            widths[j]++
        }

        total = 0; for (j = 1; j <= nc; j++) total += widths[j]
        avail = w - 3 * nc - 1
        if (avail < nc * 3) avail = nc * 3
        if (total > avail) {
            for (j = 1; j <= nc; j++) {
                widths[j] = int(avail * widths[j] / total)
                if (widths[j] < 3) widths[j] = 3
            }
            total = 0; for (j = 1; j <= nc; j++) total += widths[j]
            extra = avail - total
            for (j = 1; extra > 0; j = (j % nc) + 1) { widths[j]++; extra-- }
        }

        border(widths, nc, "t")
        for (j = 1; j <= nc; j++) hc_tmp[1, j] = hc[j]
        cell_row(hc_tmp, 1, nc, widths, alns)
        delete hc_tmp
        border(widths, nc, "m")
        for (i = 1; i <= n_data; i++) {
            cell_row(dc, i, nc, widths, alns)
            border(widths, nc, (i < n_data ? "m" : "b"))
        }
    }
  '
}

