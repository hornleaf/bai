# 导入导出对话记录
# 用法: Get-Session-Messages <文件> <操作> [行为]
# 选项:
#       操作 操作类型，可选值为 export、import
#       参数 操作参数，可选
#            操作参数（export）:
#            @no:system 默认行为基础上不包含系统消息
#            @no:tool 默认行为基础上不包含工具调用记录
#            @use:all 包含所有记录，包括请求体中的参数，此行为仅兼容导入messages记录（泄露风险较高）
#            @default 默认行为，包含message内所有记录，不包含请求体中的参数
# * 如有用户名则在所有行为中添加用户名
function Get-Session-Messages {
  function __subfunction_ask(){
    if $__has_extend_gum;then
      if gum confirm "${!2}";then
        get_session_import_or_export="$1"
      else
        msg "$(L10n-zh-Hans "get_session_messages.cancelled 取消操作")"
        return 1
      fi
    else
      msg "${!2}[Y/n] " -n
      read confirm
      if [[ "${confirm:=Y}" =~ ^[Yy]$ ]];then
        get_session_import_or_export="$1"
      else
        msg "$(L10n-zh-Hans "get_session_messages.cancelled 取消操作")"
        return 1
      fi
    fi
  }
  get_session_import_or_export=""
  local get_session_params
  local get_session_json
  local import_ask="$(L10n-zh-Hans "get_session_messages.import_ask 导入对话记录将覆盖当前对话记录，确定吗？")"
  local export_ask="$(L10n-zh-Hans "get_session_messages.export_ask 导出对话记录将覆盖当前文件，确定吗？")"
  [[ "$1" && -f "$1" ]] || { emsg "$(L10n-zh-Hans "get_session_messages.no_file_specified 未指定文件")"; return 1;}
  case "$2" in
    export)
      jq -e '.messages | length > 0' <<< "$data" &>/dev/null || { emsg "$(L10n-zh-Hans "get_session_messages.empty_session 对话记录为空")"; return 1;}
      ((__turns)) || { emsg "$(L10n-zh-Hans "get_session_messages.empty_session 对话记录为空")"; return 1;}
      __subfunction_ask "false" export_ask
      ;;
    import)
      __subfunction_ask "true" import_ask
      ;;
    *)
      [ "$2" ] && emsg "$(L10n-zh-Hans "get_session_messages.no_operation 未指定操作")" && return 1
      emsg "$(L10n-zh-Hans "get_session_messages.unknown_operation 未知操作") $2"
      return 1
      ;;
  esac

  case "${3:-@default}" in
    @no:system)
      get_session_params='{ messages: [ .messages[] | select(.role != "system") ] }'
      ;;
    @no:tool)
      get_session_params='{ messages: [ .messages[] | select(.role != "tool") ] }'
      ;;
    @use:all)
      get_session_params='. + { content_type: "application/json", url: $baseurl + "/chat/completions", apikey: $apikey, client: "bai-cli (github.com/hornleaf)", export_date: now }'
      ;;
    @default)
      get_session_params='{ messages: [.messages[]]}'
      ;;
    *)
      emsg "$(L10n-zh-Hans "get_session_messages.unknown_behavior 未知行为") $3"
      return 1
      ;;
  esac
  
  if $get_session_import_or_export;then
    # 校验数据结构，message[]中对象包含role和content即可
    jq -e '.messages[] | has("role") and has("content")' "$1" &>/dev/null || { emsg "#import: $(L10n-zh-Hans "get_session_messages.import_data_structure_error 数据结构错误")"; return 1;}
    get_session_json="$(jq -r '[.messages[]]' "$1")" || { emsg "#import: $(L10n-zh-Hans "get_session_messages.import_read_failed 读取对话记录失败")"; return 1;}
    data="$(jq -r --argjson messages "$get_session_json" '.messages =$messages' <<< "$data")" || { emsg "#import: $(L10n-zh-Hans "get_session_messages.import_write_failed 写入对话记录失败")"; return 1;}
    __turns="$(jq '[.messages[] | select(.role == "user")] | length' <<< "$data")"
    if jq -e '.username' "$1" &>/dev/null;then
      BAI_USERNAME="$(jq -r '.username' "$1")"
      data="$(jq -r --arg username "$BAI_USERNAME" '. + { username: $username }' <<< "$data")"
      get.session.title
      $INTERACT_MODE && Set-Terminal-Title "$BAI_TITLE"
    fi
    msg "#import: $(L10n-zh-Hans "get_session_messages.import_success 导入成功")"
  else
    get_session_json="$(jq -r --arg baseurl "$OPENAI_BASE_URL" --arg model "$OPENAI_API_MODEL" --arg apikey "$OPENAI_API_KEY" "$get_session_params" <<< "$data" | (if [ "$BAI_USERNAME" ];then jq --arg username "$BAI_USERNAME" '. + { username: $username }';else cat;fi))" || { emsg "#export: $(L10n-zh-Hans "get_session_messages.export_read_failed 读取对话记录失败")"; return 1;}
    echo "$get_session_json" > "$1"
    msg "#export: $(L10n-zh-Hans "get_session_messages.export_success 导出成功")"
  fi
}

