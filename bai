            echo "$__bai_option_name: $file: $(L10n-zh-Hans "option.add_l10n_file.invalid_mark 文件中缺少必要的本地化标记")"
          else
            BAI_LOCATE_PERFORMANCE_MODE=false
          fi
        done
        shift
