      ARG_ERR="$(L10n-zh-Hans "option.export_l10n_file.no_arg_value 未指定导出文件")" \
      ARG_OPTS="export-l10n-file" \
      ARG_KEY="ARG_EXPORT_L10N_FILE" \
      Get-Arguments-Value "$@"
      RETURN=$?
      if [[ "$RETURN" =~ ^10([12])$ ]];then
        shift ${BASH_REMATCH[1]}
        if [ -f "$ARG_EXPORT_L10N_FILE" ];then
          exmsg "$__bai_option_name: $ARG_EXPORT_L10N_FILE: $(L10n-zh-Hans "option.export_l10n_file.file_exists 文件已存在")"
