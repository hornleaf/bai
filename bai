# 处理模型流式输出
# 用法: Get-Stream-Assistant-Content
# 行为控制:
#       变量 DEBUG_MODE[1]*, CHAT[2]*
#       1* 调试模式
#       2* 连续对话返回
function Get-Stream-Assistant-Content {
  # 流模式下的调试
  if $DEBUG_MODE;then
    echo -en " + POST: $OPENAI_BASE_URL\n"\
            "+ DATA: "
    jq -C <<< "$data"
    cat <<EOF
COMMAND:
"""
curl -sS -XPOST \\
  "$OPENAI_BASE_URL/chat/completions" \\
  -H "$API_AUTH" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "$OPENAI_API_MODEL",
    "messages": [
      {
        "role": "user",
        "content": "$OPENAI_USER_PROMPT"
      }
    ]
  }'
"""
EOF
    API_RETURN="this a test message"
    if $INTERACT_MODE;then
      continue
    else
      exit
    fi
  fi

  # 构建流式接口请求
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.starting_stream_request 向此 BaseURL 发起 POST 请求: %s, 使用模型: %s, 使用流式响应" "$OPENAI_BASE_URL" "$OPENAI_API_MODEL")"
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.waiting_for_api_response 等待接口响应...")"
  Wait-Task wait "$(L10n-zh-Hans "set_temp_file_messages.waiting_for_assistant_response 等待 {{assistant}} 回应")"
  STREAM_DATA=""
  STREAM_CONTENT=""
  REASONING_CONTENT=""
  STREAM_LINE=0
  REASONING_LINE=0
  TOOLS_IS_CALL=false
  TOOLS_CHECK_COUNT=0
  [ "$TOOLS_TRUN_COUNT" ] || TOOLS_TRUN_COUNT=0
  [ "$TOOLS_USE_COUNT" ] || TOOLS_USE_COUNT=0

  DEBUG_ORIGIN=""

  function_run_name=""
  function_name=""
  function_args=""
  function_call_msg=""
  function_return=""
  function_id=""
  mark_thinking=false
  mark_thinking_count=0
  
  __gar_error=""
  __gar_headers=""
  __http_response=""

  # ── 代码块实时高亮状态机 ───────────────────────────────────────────────────
  # 拦截 content 流中的 ```围栏代码块```，缓冲，闭合时整块丢给 bat 高亮。
  # 围栏检测兼容跨 fragment 分裂的情况（如 `` + `ja = ```java）。
  # 关闭围栏要求行首（前有 $'\n'），防止代码内嵌 ``` 或 ```` 误触发。

  __hl_flush_code_block() {           # 将缓冲的代码体交给 bat 高亮输出
    local lang="${__hl_lang:-text}" code="${1-}"
    # 代码体已是展开后的真实文本，用 %s 原样输出
    local bat_options=(
      --style=plain
      --color=always
      --paging=never
      --theme=base16
      --number
    )
    local term_width="$(Get-TWidth)"  # 获取终端宽度
          term_width="$[term_width-3]"  # 留出边距
    bat_options+=("--terminal-width=${term_width}")  # 限制 bat 最大宽度，防止过宽导致的换行问题
    __hl_bat(){
      # 如果是不支持的语法则默认设为 text
      local syntax="${1,,}"
       (bat -L | grep -qiE "(:|,)${syntax}(,|$)" || bat -L | grep -qi "${syntax}.*:") || syntax="txt"
      [[ "$syntax" == "text" ]] && syntax="txt"
      # 设置背景色
      local bg_color="32;32;32"  # 默认灰色背景
      local title_color="8;8;8"  # 默认深灰色标题
      __hl_bat_setbg(){
        sed -r -e 's/\x1B]8;;(.*?)\x07(.*?)\x1B]8;;\x07/\2/g' -e 's/\t/    /g' -e "s/^/\x1B[48;2;${bg_color}m/" -e "s/$/\x1B[49m/" -e "s/\x1B\[0m/\x1B[0m\x1B[48;2;${bg_color}m/g"
      }
      local max_width="$(printf '%s\n' "$code" | bat --number --color=never --terminal-width=${term_width} 2>/dev/null | wc -L)"  # 提取无高亮的样本，准备计算最长行以渲染背景
      local lang_label="$(wc -L <<< "$lang")"  # 获取语言标签的长度
      local line_number="$(wc -l <<< "$code")"  # 获取代码行数
      # 渲染语言标签背景
      printf '\e[48;2;%sm%*s\e[2;37m%s \e[0m\n' "$title_color" "$[max_width-lang_label+2]" ' ' "$lang"
        printf '%s\n' "$code" | bat -l "$syntax" "${bat_options[@]}" 2>/dev/null | while IFS= read -r line;do
          printf '\e[48;2;%sm%*s\e[0m' "$bg_color" "$[max_width+3]" ' '  # 渲染背景
          printf '\r%s\n' "$line" | __hl_bat_setbg
        done
    }
    if $__has_extend_bat;then
      __hl_bat "$lang"
    else
      printf '%s\n' "$code"
    fi
  }

  __hl_state=0                        # 0=文本 1=提取语言标签 2=缓冲代码体
  __hl_hold=""                        # 待定行（尾部有反引号，可能为裂围栏前半段）
  __hl_block=""                       # 代码体缓冲（已展开的真实文本）
  __hl_tag=""                         # 语言标签缓冲
  __hl_lang="text"                    # 检测到的语言
  __hl_table=""                       # 表格行缓冲
  __hl_line_buf=""                    # 行组装缓冲（碎片拼成完整逻辑行）

  # 将 content 碎片组装为完整逻辑行后逐行喂入状态机。
  # SSE 流中的一个表格行可能被拆成多个 STREAM_MSG 碎片到达，
  # 因此先把碎片拼到遇到 \n 为止，形成完整行再交给状态机。
  __hl_feed() {
    local text="$1"
    [[ -z "$text" ]] && return

    # 无 bat 时直接透传，整个状态机旁路
    if ! $__has_extend_bat || ! $BAI_STREAM_SYNTAX;then
      printf '%b' "$text"
      return
    fi

    # 兼容不同 API 供应商：将字面 \n（两字符）展开为真实换行符
    text="${text//\\n/$'\n'}"

    if [[ $__hl_state -eq 0 ]]; then
      # 从 state 1/2/3 切回 0 时，行缓冲可能残留半行，先拼上
      [[ -n "$__hl_line_buf" ]] && { text="$__hl_line_buf$text"; __hl_line_buf=""; }
      if [[ "$text" != *$'\n'* ]]; then
        # 无换行单片段：可能为表格/水平线开头则暂扣到 \n 再判，否则即时输出
        if [[ "$text" =~ ^[[:space:]]*([|│]|[┌├└┃┏┣┗]) ]]; then
          __hl_line_buf="$text"
        else
          __hl_process_line "$text"
        fi
      else
        # 含换行：拆行逐条喂入状态机
        local rest="$text" ln
        while [[ "$rest" == *$'\n'* ]]; do
          ln="${rest%%$'\n'*}"
          rest="${rest#*$'\n'}"
          __hl_process_line "$ln"$'\n'
        done
        [[ -n "$rest" ]] && __hl_process_line "$rest"
      fi
    else
      # States 1/2/3：缓冲到完整行再处理（代码块/表格需要整块渲染）
      __hl_line_buf+="$text"
      local ln
      while [[ "$__hl_line_buf" == *$'\n'* ]]; do
        ln="${__hl_line_buf%%$'\n'*}"
        __hl_line_buf="${__hl_line_buf#*$'\n'}"
        __hl_process_line "$ln"$'\n'
      done
    fi
  }

  # 状态机核心：逐行处理
  __hl_process_line() {
    local line="$1" chunk before after

    case $__hl_state in
      0)
        # 普通文本：直接输出，检测开围栏 ```
        chunk="$__hl_hold$line"
        __hl_hold=""

        if [[ "$chunk" == *'```'* ]];then
          before="${chunk%%'```'*}"
          after="${chunk#*'```'}"
          [[ -n "$before" ]] && printf '%s' "$before"
          __hl_state=1
          __hl_tag="$after"
        elif [[ "$chunk" =~ \`\`$ ]];then
          __hl_hold="$chunk"           # 尾有 2 反引号 → 持有待判
        elif [[ "$chunk" =~ \`$ ]];then
          __hl_hold="$chunk"           # 尾有 1 反引号 → 持有待判
        elif ( \
               [[ "$chunk" =~ ^[[:space:]]*([-][[:space:]]*){3,}$ ]] || \
               [[ "$chunk" =~ ^[[:space:]]*([*][[:space:]]*){3,}$ ]] || \
               [[ "$chunk" =~ ^[[:space:]]*([_][[:space:]]*){3,}$ ]] ); then
          local cols pad
          cols=$(Get-TWidth)
          printf -v pad '%*s' "${cols:-80}" ''
          printf '%s\n' "${pad// /─}"
        elif [[ "$chunk" =~ ^[[:space:]]*(\||│).*(\||│)[[:space:]]*$ ]] || \
             [[ "$chunk" =~ ^[[:space:]]*[┌├└┃┏┣┗] ]];then
          __hl_state=3                 # 检测到表格行（管道表或制表符表）→ 缓冲
          __hl_table="$chunk"          # chunk 已含行尾 \n
          Wait-Task wait "$(L10n-zh-Hans "set_temp_file_messages.table_rendering ${arg0^^}正在制作表格...")"
        elif [[ -n "$chunk" ]];then
          printf '%s' "$chunk"
        fi
        ;;

      1)
        # 提取语言标签：``` 到第一个 $'\n' 之间
        __hl_tag+="$line"
        if [[ "$__hl_tag" == *'```'* ]];then
          before="${__hl_tag%%'```'*}"
          after="${__hl_tag#*'```'}"
          if [[ "$before" == *$'\n'* ]];then
            __hl_lang="${before%%$'\n'*}"
            __hl_block="${before#*$'\n'}"
          else
            __hl_lang="$before"; __hl_block=""
          fi
          Wait-Task kill                     # 清除等待动画
          [[ -n "$__hl_block" ]] && __hl_flush_code_block "$__hl_block"
          [[ -n "$after" ]]     && printf '%s' "$after"
          __hl_state=0; __hl_tag=""; __hl_block=""; __hl_lang="text"
        elif [[ "$__hl_tag" == *$'\n'* ]];then
          __hl_lang="${__hl_tag%%$'\n'*}"
          __hl_block="${__hl_tag#*$'\n'}"
          [[ -z "$__hl_lang" ]] && __hl_lang="text"
          __hl_state=2; __hl_tag=""
          Wait-Task wait "$(L10n-zh-Hans "set_temp_file_messages.code_coloring ${arg0^^}正在为代码上色...")"                     # 显示缓冲等待提示
        fi
        ;;

      2)
        # 缓冲代码体：累积直到行首关闭围栏 ```
        chunk="$__hl_block$line"

        if [[ "$chunk" == *$'\n''```'* || "$chunk" == '```'* ]];then
          before="${chunk%%$'\n''```'*}"
          after="${chunk#*$'\n''```'}"
          [[ "$before" == "$chunk" ]] && { before=""; after="${chunk#'```'}"; }
          Wait-Task kill                     # 清除等待动画
          [[ -n "$before" ]] && __hl_flush_code_block "$before"
          [[ -n "$after" ]]  && printf '%s' "$after"
          __hl_state=0; __hl_block=""; __hl_lang="text"
        else
          __hl_block="$chunk"
        fi
        ;;

      3)
      # 缓冲表格：逐行收集直到非表格行
        if [[ "$line" =~ ^[[:space:]]*(\||│).*(\||│)[[:space:]]*$ ]] || \
           [[ "$line" =~ ^[[:space:]]*[┌├└│┃┏┣┗] ]];then
          __hl_table+="$line"            # 仍是表格行 → 继续缓冲（line 已含行尾 \n）
        else
          __hl_format_table "$__hl_table"  # 表格结束 → 格式化输出
          __hl_state=0; __hl_table=""
          __hl_process_line "$line"     # 重新处理当前行（属于普通文本）
        fi
        ;;
    esac
  }

  # 表格格式化：管道表直接用 mdbox.awk 渲染为制表符表；
  # 制表符表先转回管道格式再送 mdbox.awk（重建列宽以修正 emoji/CJK 宽度）。
  __hl_format_table() {
    local table="$1"
    Wait-Task kill
    # 纯管道表（含 | 但不含 ─│）→ 直接渲染
    if [[ "$table" == *'|'* && "$table" != *[─│┌├└┐┤┘┬┴┼]* ]];then
      printf '%s' "$table" | Render-MDtable
      return
    fi

    # 制表符表 → │ 替换为 |，去掉边框行，重绘以修正列宽
    printf '%s' "$table" | sed 's/│/|/g' | grep -v '^[[:space:]]*[┌├└┐┤┘┬┴┼─]' | Render-MDtable
  }

  # 流结束时刷新各状态的残留缓冲
  __hl_flush_eof() {
    # State 1/2/3 行组装缓冲中的残留半行（state 0 不缓冲，无需清）
    if [[ $__hl_state -ne 0 && -n "$__hl_line_buf" ]];then
      __hl_process_line "$__hl_line_buf"
      __hl_line_buf=""
    fi
    # 再清各状态的残留缓冲
    case $__hl_state in
      2) Wait-Task kill; [[ -n "$__hl_block" ]] && __hl_flush_code_block "$__hl_block" ;;
      3) [[ -n "$__hl_table" ]] && __hl_format_table "$__hl_table" ;;
      1) [[ -n "$__hl_tag" ]]   && printf '%s' "$__hl_tag" ;;
      0) [[ -n "$__hl_hold" ]]  && printf '%s' "$__hl_hold" ;;
    esac
  }
  # ── 高亮状态机结束 ─────────────────────────────────────────────────────────

  # 开始计时
  Get-Timer Assistant
  Get-Timer ToolsCall

  # 流式处理接口数据
  Create-TempFile http_response_error
  Create-TempFile http_response_headers
  while IFS= read -r line;do
    # 如果是空行，则跳过，避免连续误判思考模式
    [ -z "$line" ] && continue
    # 上一个块的数据
    local _odata="$_data"
    # 定义交换变量
    local _data="${line#data: }"
    # echo "$_data"
    local _path=".choices[0].delta"
    local _key1="content"
    local _key2="reasoning_content"
    local _func='gsub("\\n"; "\\n")'
    
    __http_response+="$line"$'\n'

    if [[ "$_data" =~ ^\[DONE\] ]];then
      if $OPENAI_INCLUDE_USAGE && jq -e '.usage | type == "object" and .total_tokens' <<<"$_odata" &>/dev/null;then
        LFR=false
        declare -A token_map=(
          [prompt_token]=".usage.prompt_tokens"
          [completion_token]=".usage.completion_tokens"
          [reasoning_token]=".usage.completion_tokens_details.reasoning_tokens"
          [total_token]=".usage.total_tokens"
          [hit_token]=".usage.prompt_cache_hit_tokens"
          [miss_token]=".usage.prompt_cache_miss_tokens"
        )
        function get_token_size {
          awk -v size="$1" -v mp=1000 '
            function human(x){
              if (x<mp)
                return sprintf("%d",x)
              else if(x<mp**2)
                return sprintf("%.2fK",x/mp)
              else
                return sprintf("%.2fM",x/(mp**2))
            }
            BEGIN {print human(size)}
          '
        }
        for v in ${!token_map[@]};do
          local ${v} ${v}s
        done
        for var in "${!token_map[@]}"; do
          local tokens_key="__${var}"
          [ "${!tokens_key}" ] || printf -v "$tokens_key" 0
          local value=$(jq -r "${token_map[$var]}" <<<"$_odata" 2>/dev/null)
          if [[ $? -eq 0 && -n "$value" && "$value" != "null" ]]; then
            printf -v "$var" "%s" "$value"
            printf -v "${var}s" "%s" "$(get_token_size "$value")"
            let $tokens_key+=$value
            printf -v "${tokens_key}s" "$(get_token_size "${!tokens_key}")" 
          fi
        done
        echo
        local cache_hit_rate=$(awk -v h=$((hit_token)) -v t=$((total_token)) 'BEGIN{printf("%.2f", h/t*100)}' 2>/dev/null)
        __usage_rate=$(awk -v t=$((__total_token)) -v c=$((__model_cl)) 'BEGIN{printf("%.2f", t/c*100)}' 2>/dev/null)
        __cache_hit_rate=$(awk -v h=$((__hit_token)) -v t=$((__total_token)) 'BEGIN{printf("%.2f", h/t*100)}' 2>/dev/null)
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.dialogue_data_report 本轮对话完成, 消耗 %s Tokens (输入: %s, 输出: %s), 缓存命中 %s Tokens, 缓存命中率: %s%%" "${total_tokens:-None}" "${prompt_tokens:-None}" "${completion_tokens:-None}" "${hit_tokens:-None}" "$cache_hit_rate")"
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.dialogue_data_report_total 历史统计: 消耗 %s Tokens (输入: %s, 输出: %s), 缓存命中 %s Tokens, 缓存命中率: %s%%, 上下文占用: %s%%" "$__total_tokens" "$__prompt_tokens" "$__completion_tokens" "$__hit_tokens" "$__cache_hit_rate" "$__usage_rate")"
        unset -f get_token_size
      fi
      Wait-Task kill
      continue
    fi
    STREAM_DATA+="$_data"$'\n'
    
    # 杀死半阻塞进程后将等待片刻，防止输出时被吞字
    ((STREAM_LINE)) || Wait-Task kill
    
    # 尝试分支响应类型(reasoning/normal)，并设置相应的前缀
    unset STREAM_HEAD REASONING_HEAD RT
    $INTERACT_MODE && ! ((STREAM_LINE)) && STREAM_HEAD="${c32}$ai_prompt${c0} " REASONING_HEAD="${c32}$thinking_prompt${c0} "

    # 检查是否具备思维链响应特征
    local is_reasoning=$(jq --exit-status "$_path | has(\"$_key2\")" <<< "$_data" 2>/dev/null || echo false)

    # 流消息
    STREAM_MSG="$(jq -r "$_path.$_key1 | $_func" <<< "$_data" 2>/dev/null)"

    # 拼接对话
    STREAM_CONTENT+="$STREAM_MSG"

    # 在此分支流模式
    if $is_reasoning;then # deepseek

      # 拼接思维链和对话，并独立输出
      # tip: 思维链模式下的命令生成稳定性尚待验证
      if ! $mark_thinking;then
        Get-Timer Assistant
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.thinking_chain_response 流模式: 思维链, 响应耗时: %s, 继续等待..." "$Get_AssistantTimer")"
        Get-Timer Assistant
        mark_thinking=true # 标记是否思考过
      fi
      RT=""
      ((STREAM_LINE==0)) && RT+="\n"
      STREAM_REASONING="$(jq -r "$_path.[\"$_key2\"] | $_func" <<< "$_data" 2>/dev/null)"
      ((REASONING_LINE==0)) && STREAM_REASONING="${STREAM_REASONING//'\n'/}"
      ((REASONING_LINE==0)) || unset REASONING_HEAD
      REASONING_CONTENT+="$STREAM_REASONING"
      
      # 适时插入前缀，去除开头多余的换行符
      if ((STREAM_LINE==0));then
        $INTERACT_MODE && RT+="${c32}$ai_prompt${c0} "
        STREAM_MSG="${STREAM_MSG//'\n'/}"
      fi
      
      if [ "$STREAM_MSG" ];then
        if ((STREAM_LINE==0));then
          if $DEBUG;then
            Get-Timer Assistant
            if ! $OPENAI_INCLUDE_USAGE;then
              _tokens=$(Estimate-Tokens-Int "$REASONING_CONTENT")
              echo
              debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.thinking_chain_tokens 思考耗时: %s, 大约输出了 $_tokens Tokens" "$Get_AssistantTimer")"
            fi
            Get-Timer Assistant
          fi
        else
          unset RT
        fi
        [[ -n "$RT" ]] && printf "%b" "$RT" && RT=""; __hl_feed "$STREAM_MSG"
      else
        printf "%b" "$REASONING_HEAD$c237$STREAM_REASONING$c0"
        let REASONING_LINE++
        continue
      fi
    
    else # openai | 在此将尝试支持流模式下使用 function calling 功能
      # 检查是否使用了工具
      $TOOLS_IS_CALL || TOOLS_IS_CALL=false
      _local_json_path='.choices[0].delta.tool_calls[0].function'
      if $USE_TOOLS;then
        ((TOOLS_TRUN_COUNT)) || debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.checking_if_tools_used 检查是否使用了工具")"
        RETURN_MSG="$(jq -e "$_local_json_path" <<< "$_data" 2>/dev/null)"
        STATUS=$?
        ((TOOLS_TRUN_COUNT)) || debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.jq_check_status jq 检查时返回状态: %s" "$STATUS")"
        # 在第一轮确认调用时锁定工具调用状态
        if ! $TOOLS_IS_CALL;then
          if ((STATUS));then                              # 检查是否使用了工具
            ((TOOLS_TRUN_COUNT)) || debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.tools_not_used 模型还未使用工具")"
            TOOLS_IS_CALL=false                           # 未使用工具
            RETURN_MSG="$STREAM_MSG"
          else
            ((TOOLS_TRUN_COUNT)) || debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.tools_used 发现模型使用了工具")"
            TOOLS_IS_CALL=true                            # 使用了工具
            ((TOOLS_CHECK_COUNT++))                       # 锁定工具调用状态，避免冗余日志
            ((TOOLS_TRUN_COUNT++))                        # 锁定工具多轮调用状态，避免冗余日志
          fi
        fi
      else
        RETURN_MSG="$STREAM_MSG"
        TOOLS_IS_CALL=false
      fi
      ((TOOLS_TRUN_COUNT)) || debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.tools_call_status 工具调用状态: %s" "$TOOLS_IS_CALL")"
      if ! $TOOLS_IS_CALL && ((STATUS)) && [[ "$RETURN_MSG" == "null" ]];then
        erron "$(L10n-zh-Hans "set_temp_file_messages.exception_during_session_processing 处理本轮会话时发生异常")"
        unset RETURN_MSG
      fi
      if $TOOLS_IS_CALL;then
        ((TOOLS_CHECK_COUNT==1)) && { debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.building_tool_call 构建工具调用...")"; ((TOOLS_CHECK_COUNT++)); }
        [ "$function_id" ] || function_id="$(jq -r '.choices[0].delta.tool_calls[0].id' <<< "$_data" 2>/dev/null)"
        [ "$function_run_name" ] || function_run_name="$(jq -r "$_local_json_path.name" <<< "$_data" 2>/dev/null)"

        [ "$function_name" ] || function_name="$function_head::$function_run_name"
        if jq -e "$_local_json_path.arguments" <<< "$_data" &>/dev/null;then
          function_args+="$(jq -r "$_local_json_path.arguments" <<< "$_data" 2>/dev/null)"
        fi
        continue
      fi
      # 仅拼接对话并输出
      if ! ((STREAM_LINE));then
        if $DEBUG;then
          if $TOOLS_IS_CALL;then
            Get-Timer ToolsCall
            debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.tools_call_response 流模式: 工具调用, 响应耗时: %s" "$Get_ToolsCallTimer")"
            Get-Timer ToolsCall
          else
            Get-Timer Assistant
            debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.standard_openai_response 流模式: 标准 OpenAI 响应, 响应耗时: %s" "$Get_AssistantTimer")"
            [ "$DEBUG_ORIGIN" ] || DEBUG_ORIGIN=$DEBUG
            DEBUG=false
            Get-Timer Assistant
          fi
        fi
      fi
      # 处理部分供应商因机制差异可能导致的的消息错位
      $mark_thinking && mark_thinking=false && echo;[ "$STREAM_MSG" ] && printf "%b" "$STREAM_HEAD"; __hl_feed "$STREAM_MSG"
    fi
    [ "$STREAM_MSG" ] && let STREAM_LINE++
  done < <(Get-Assistant-Return;echo)
  # 缓存 HTTP 响应头和错误信息
  __gar_headers="$(cat "${BAI_TEMP_FILES["http_response_headers"]}")"
  __gar_error="$(cat "${BAI_TEMP_FILES["http_response_error"]}")"
  Remove-TempFile http_response_headers
  Remove-TempFile http_response_error
  __hl_flush_eof                       # 刷新代码块高亮状态机残留缓冲"

  # 如果有返回消息、且末尾无换行符时，强制换行一次
  [ "$STREAM_CONTENT$REASONING_CONTENT" ] && { [[ "$STREAM_CONTENT" == *$'\n' ]] || ${LFR:-true} && echo ;}

  # 重置 debug 状态
  [ "$DEBUG_ORIGIN" ] && DEBUG=$DEBUG_ORIGIN

  # 处理工具调用
  Get-Stream-Assistant-ToolsCall || return 1

  function_run_name=""
  function_name=""
  function_args=""
  function_call_msg=""
  function_return=""
  function_id=""

  # 再次尝试杀死半阻塞进程
  Wait-Task kill

  # 处理最终返回
  # 如果仅有思维链但无对话内容，则直接 copy 思维链为最终返回内容
  [[ "$REASONING_CONTENT" && ! "$STREAM_CONTENT" ]] && STREAM_CONTENT="$REASONING_CONTENT"
  API_RETURN="${STREAM_CONTENT//'\n'/$'\n'}"
  if ! [ "$API_RETURN" ];then
    # printf "\e[1A\r\e[K"
    Get-ReturnError-Info
    # jq <<<"$data"
    # echo "$STREAM_DATA"
    return 114
  fi

  # 最终计时
  if ! ((TOOLS_USE_COUNT));then
    Get-Timer Assistant
    if [ "$Get_AssistantTimer" ];then
      if ! $OPENAI_INCLUDE_USAGE;then
        _return_tokens="$(Estimate-Tokens-Int "$STREAM_CONTENT")"
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.assistant_return_time 模型返回耗时: %s, 大约输出了 %s Tokens" "$Get_AssistantTimer" "$_return_tokens")"
      fi
      ((TOOLS_USE_COUNT++))
      unset TOOLS_TRUN_COUNT TOOLS_USE_COUNT
    fi
  fi
  $INTERACT_MODE || exit 0
}

# 处理模型工具调用
# 用法: Get-Stream-Assistant-ToolsCall
# 行为控制:
#       变量 TOOLS_IS_CALL, TOOLS_CHECK_COUNT, TOOLS_TRUN_COUNT, TOOLS_USE_COUNT
#       处理模型工具调用
function Get-Stream-Assistant-ToolsCall {
    # 调用工具
  if $TOOLS_IS_CALL;then
    # 让 jq 校验参数是否是一组 json 字符串
    jq -e '.[]' <<< "$function_args" &>/dev/null && __func_args_is_json=true || __func_args_is_json=false
    $__func_args_is_json && function_args=$(jq '.[]' <<< "$function_args")
    function_args="${function_args//$'\n'/' '}"
    # 构建工具调用消息
    function_call_msg="$(
      jq --arg id "$function_id" \
          --arg name "$function_run_name" \
          --arg args "$function_args" \
          '{
            content: "",
            role: "assistant",
            tool_calls: [
              {
                index: 0,
                id: $id,
                type: "function",
                function:
                {
                  name: $name,
                  arguments: $args
                }
              }
            ]
          }' <<< '{}'
    )"
    # 根据 DeepSeek 官方文档，如果是在思考时调用工具，也应该要回传思维链内容，避免后续缺失思维链导致接口返回 400 状态错误
    # 参考文档：https://api-docs.deepseek.com/zh-cn/guides/thinking_mode#输入输出参数
    [ "$REASONING_CONTENT" ] && function_call_msg="$(jq --arg content "$REASONING_CONTENT" '. += {"reasoning_content": $content}' <<< "$function_call_msg" 2>/dev/null)"
    # 先保存对话记录
    local msg='{"role": "assistant"}'
    if [ "$STREAM_CONTENT" ];then
      msg="$(jq --arg content "$STREAM_CONTENT" '. += {"content": $content}' <<< "$msg" 2>/dev/null)"
    else
      msg="$(jq '. += {"content": ""}' <<< "$msg" 2>/dev/null)"
    fi
    [ "$REASONING_CONTENT" ] && msg="$(jq --arg content "$REASONING_CONTENT" '. += {"reasoning_content": $content}' <<< "$msg" 2>/dev/null)"
    [ "$STREAM_CONTENT$REASONING_CONTENT" ] && data="$(jq --argjson content "$msg" ' .messages += [$content]' <<< "$data" 2>/dev/null)"
    # 再保存工具调用记录
    data="$(jq --argjson content "$function_call_msg" ' .messages += [$content]' <<< "$data" 2>/dev/null)"
    explicitly="${gco_explicitly[$function_name]}"
    catch_stderr="${gco_getstderr[$function_name]}"
    if [[ "$explicitly" != "silence" ]];then
      local term_width="$(Get-TWidth)"
      echo -e " ${c35}┏${c0} $(L10n-zh-Hans "set_temp_file_messages.tool_calling 工具调用中")..."
      echo -en " ${c35}┃${c0} ${c34}❯${c0} "
      local execute_title="$function_run_name$([[ "$function_args" =~ ^(\{\})+$ ]] || echo ", arg: $function_args")"
      output_width=$(($(wc -L <<<"$execute_title")+26))
      if (((term_width-28)<output_width));then
        fold -s -w $((term_width-28)) <<< "$execute_title" | head -2 | sed '2s/.*/.../' | sed ':a;N;$!ba;s/\n//g'
      else
        echo "$execute_title"
      fi
    fi
    Get-Command-Output "$function_name $function_args"
    function_return="$gco_return_content"
    RETURN=$gco_status
    ((RETURN)) && { emsg "$(L10n-zh-Hans "set_temp_file_messages.tools_execution_failed 工具执行失败")";}
    data="$(jq --arg content "$function_return" --arg id "$function_id" ' .messages += [{"role": "tool","content": $content, "tool_call_id": $id}]' <<< "$data" 2>/dev/null)"
    Get-Stream-Assistant-Content
    [[ $? == 114 ]] && return
    if ((STATUS)) && [[ "$RETURN_MSG" == "null" ]];then
      erron "$(L10n-zh-Hans "set_temp_file_messages.request_not_accepted 该次请求未正确被接受")"
      unset RETURN_MSG
    fi
  fi
}

