# 等待阻塞任务
# 用法: Wait-Task <wait|kill|pid>
# 选项: <wait|kill|pid>
#       wait 永远等待
#       kill 杀死进程 （wait）
#       pid 进程 PID
# 行为控制:
#       变量 CHAT
#       为 true 时，会在等待过程中输出提示信息
#       为 false 时，<wait> 会立即返回
function Wait-Task {
  [ "$__wait_task_frame" ] || Switch-Wait-Frame "${BAI_WAIT_STYLE:-}"
  local ARG1="$1"
  local ARG2="$2"
  local frame=0
  local wait_prompt="${l25}\r\e[1;32m%s${c0} ${ARG2:-$(L10n-zh-Hans "wait_task.waiting {{正在等待}}")...} ${c237}%s${c0}${ek}"
  local exit_prompt="${h25}\r${ek}"
  case "${ARG1:-null}" in
    null)return;;
    wait)
    # 永远等待
      local start_time=$(date +%s)
      Set-Osc-Progress doubt
      while $INTERACT_MODE;do
        for i in "${__wait_task_frame[@]}";do
          printf "$(Print-ColorFull "$frame" <<<"$wait_prompt")" "$i" "$(( $(date +%s) - start_time ))s" >&2
          frame=$[frame+4]
          sleep 0.05
        done
      done &
      GETWAIT_PID=$!
      ;;
    kill)
    # 杀死进程 （wait）
      Set-Osc-Progress clear
      if kill -0 "$GETWAIT_PID" &>/dev/null;then
        kill "$GETWAIT_PID" &>/dev/null
        printf "$exit_prompt" >&2
      fi
      ;;
    *) 
    # 使用 kill 命令判断进程存在，不存在即停止等待
      local start_time=$(date +%s)
      Set-Osc-Progress doubt
      while $INTERACT_MODE;do
        for i in "${__wait_task_frame[@]}";do
          if kill -0 "$ARG1" &>/dev/null;then
            printf "$(Print-ColorFull "$frame" <<<"$wait_prompt")" "$i" "$(( $(date +%s) - start_time ))s" >&2
            frame=$[frame+4]
            sleep 0.05
          else
            printf "$exit_prompt" >&2
            Set-Osc-Progress clear
            exec true
          fi
        done
      done
  esac
}

