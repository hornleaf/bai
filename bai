# 逐字输出
# 用法: Print-FakeStream
# 从标准输入中读取文本，并逐字打印至当前终端
function Print-FakeStream {
  local WITH=""
  local _msg=
  local _stdin="$(cat -)"
  local _stdin_num="${#_stdin}"
  while IFS= read -r LINE;do
    local STR="$LINE"
    local LEN=${#STR}
    for ((i=0;i<LEN;i++));do
      _msg="${STR:i:1}"
      WITH+="$_msg"
      echo -n "$_msg"
      Set-Osc-Progress info "${#WITH}:${_stdin_num}"
      sleep 0.001
    done
    echo
  done <<< "$_stdin"
  Set-Osc-Progress clear
}

