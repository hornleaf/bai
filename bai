# ── 接口风格适配层 ─────────────────────────────────────────────────────
# 内部规范（canonical）固定使用 chat/completions 的 messages 结构：
#   system/user/assistant/tool 消息、assistant.tool_calls、tool_call_id、reasoning_content
# 新增接口风格（如 OpenAI Responses API）时，只需实现这组钩子：
#   bai_api_endpoint         主请求 URL
#   bai_api_prepare_payload  规范 data → 目标请求体
#   bai_api_message_path     非流式响应中 assistant 消息的 jq 路径
#   bai_api_delta_path       流式增量对象的 jq 路径
#   bai_api_aux_endpoint     辅助调用（压缩/权限审查）的 URL
# 其余代码只依赖规范化结构，不直接拼接口细节。

# 当前接口风格
# 用法: bai_api_style
function bai_api_style {
  printf '%s' "${BAI_API_STYLE:-chat}"
}

# 该接口风格是否已实现
# 用法: bai_api_supported
function bai_api_supported {
  case "$(bai_api_style)" in
    chat|responses) return 0 ;;
    *) return 1 ;;
  esac
}

# 未实现风格给出明确错误
# 用法: bai_api_require_supported
function bai_api_require_supported {
  bai_api_supported && return 0
  erron "$(L10n-zh-Hans "api_style.unsupported 接口风格 %s 尚未实现（适配层已预留，当前仅支持 chat）" "$(bai_api_style)")"
  return 1
}

# 主请求 URL
# 用法: bai_api_endpoint
function bai_api_endpoint {
  case "$(bai_api_style)" in
    responses) printf '%s/responses' "$OPENAI_BASE_URL" ;;
    *) printf '%s/chat/completions' "$OPENAI_BASE_URL" ;;
  esac
}

# 辅助请求 URL（压缩摘要、权限审查等内部小请求）
# 用法: bai_api_aux_endpoint
function bai_api_aux_endpoint {
  printf '%s/chat/completions' "$OPENAI_BASE_URL"
}

# 非流式响应中 assistant 消息的 jq 路径（响应已在边界归一化，恒为 chat 结构）
# 用法: bai_api_message_path
function bai_api_message_path {
  printf '%s' '.choices[0].message'
}

# 辅助响应中正文的 jq 路径
# 用法: bai_api_aux_content_path
function bai_api_aux_content_path {
  printf '%s' '.choices[0].message.content'
}

# 流式增量对象的 jq 路径（事件已翻译成 chat delta，恒为 chat 结构）
# 用法: bai_api_delta_path
function bai_api_delta_path {
  printf '%s' '.choices[0].delta'
}

# 规范请求体 → 目标请求体（chat 为恒等映射）
# 用法: bai_api_prepare_payload <JSON>
function bai_api_prepare_payload {
  local __api_body="$1"
  case "$(bai_api_style)" in
    responses)
      local __api_files __api_dropped
      __api_files="$(jq '[.messages[]? | select((.content|type)=="array") | .content[]? | select(.type=="file")] | length' <<<"$__api_body" 2>/dev/null)"
      if [[ "$__api_files" =~ ^[1-9][0-9]*$ ]] && [ -z "${BAI_RESP_WARNED_FILES:-}" ];then
        BAI_RESP_WARNED_FILES=1
        msg "responses 模式不支持文件输入（Files API），已忽略 $__api_files 个 file 块" >&2
      fi
      __api_dropped="$(jq -r '. as $root | ["stop","n","top_k","presence_penalty","frequency_penalty","stream_options"] | map(select(. as $k | $root | has($k))) | join(" ")' <<<"$__api_body" 2>/dev/null)"
      if [ -n "$__api_dropped" ] && [ -z "${BAI_RESP_WARNED_DROPPED:-}" ];then
        BAI_RESP_WARNED_DROPPED=1
        msg "responses 模式忽略不支持的参数: $__api_dropped" >&2
      fi
      jq -c '
        def content_items:
          if type == "string" then .
          else [ .[] |
              if .type == "text" then {type:"input_text", text:(.text // "")}
              elif .type == "image_url" then {type:"input_image", image_url:(.image_url.url // "")}
              else empty end ]
          end;
        def assistant_items:
          . as $m |
          (if ($m.reasoning_content // "") != "" then
             [{type:"reasoning", content:[{type:"reasoning_text", text:$m.reasoning_content}]}]
           else [] end)
          + (if ($m.content // "") != "" then
               [{type:"message", role:"assistant", content:[{type:"output_text", text:$m.content}]}]
             else [] end)
          + (($m.tool_calls // []) | map({type:"function_call", call_id:.id, name:(.function.name // ""), arguments:(.function.arguments // "")}));
        def msg_items:
          . as $m |
          if $m.role == "system" or $m.role == "developer" then
            {type:"message", role:"system", content:[{type:"input_text", text:($m.content | tostring)}]}
          elif $m.role == "user" then
            {type:"message", role:"user", content:($m.content | content_items)}
          elif $m.role == "tool" then
            {type:"function_call_output", call_id:($m.tool_call_id // ""), output:($m.content | tostring)}
          else empty end;
        {
          model: .model,
          input: ([ .messages[] | if .role == "assistant" then assistant_items else msg_items end ] | flatten),
          stream: (.stream // false)
        }
        + (if .max_tokens then {max_output_tokens: .max_tokens} else {} end)
        + (if .temperature then {temperature: .temperature} else {} end)
        + (if .top_p then {top_p: .top_p} else {} end)
        + (if .tools then {tools: [ .tools[] | .function | {type:"function", name:.name, description:(.description // ""), parameters:(.parameters // {type:"object", properties:{}})} ]} else {} end)
        + (if .tool_choice then {tool_choice: .tool_choice} else {} end)
        + (
            if ((.thinking.type // "") == "disabled") then {reasoning:{effort:"none"}}
            elif (.reasoning_effort // "default") != "default" then
              {reasoning:{effort:(
                 .reasoning_effort as $e |
                 if $e == "minimal" or $e == "low" then "low"
                 elif $e == "medium" or $e == "high" or $e == "xhigh" then "high"
                 elif $e == "max" then "max"
                 else "high" end
              )}}
            else {} end
          )
      ' <<< "$__api_body"
      ;;
    *)
      printf '%s' "$__api_body"
      ;;
  esac
}


# 非流式响应 → 内部规范（chat）结构
# 用法: bai_api_normalize_response <原始响应JSON>
function bai_api_normalize_response {
  local __anr_raw="$1"
  case "$(bai_api_style)" in
    responses)
      jq -c '
        def msg_text: [ .output[]? | select(.type=="message") | .content[]? | select(.type=="output_text") | .text ] | join("");
        def reason_text: [ .output[]? | select(.type=="reasoning") | .content[]? | select(.type=="reasoning_text") | .text ] | join("");
        def calls: [ .output[]? | select(.type=="function_call") | {id:(.call_id // ""), type:"function", function:{name:(.name // ""), arguments:(.arguments // "")}} ];
        . as $r
        | if ($r.status == "failed" or $r.status == "incomplete") then
            {error: {message: ($r.error.message // $r.incomplete_details.reason // "响应失败")}}
          else
        {
          choices: [{
            message: (
              {role:"assistant", content: msg_text}
              + (if reason_text != "" then {reasoning_content: reason_text} else {} end)
              + (if ((calls|length) > 0) then {tool_calls: calls} else {} end)
            )
          }],
          usage: {
            prompt_tokens: (.usage.input_tokens // 0),
            completion_tokens: (.usage.output_tokens // 0),
            total_tokens: (.usage.total_tokens // 0),
            completion_tokens_details: {reasoning_tokens: (.usage.output_tokens_details.reasoning_tokens // 0)},
            prompt_cache_hit_tokens: (.usage.input_tokens_details.cached_tokens // 0)
          }
        } end' <<< "$__anr_raw"
      ;;
    *)
      printf '%s' "$__anr_raw"
      ;;
  esac
}

# 流式事件 → 内部规范（chat delta）结构（纯 Bash，无 jq fork；结果写入 __ast_out）
# 用法: bai_api_stream_translate <事件JSON>
declare -gA __resp_tc_args_seen=()
function bai_api_stream_translate {
  local __ast_raw="$1" __ast_type __ast_idx __ast_id __ast_name
  local __re_type='"type"[[:space:]]*:[[:space:]]*"([^"]+)"'
  local __re_delta='"delta"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  local __re_idx='"output_index"[[:space:]]*:[[:space:]]*([0-9]+)'
  local __re_id='"call_id"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  local __re_name='"name"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  local __re_args='"arguments"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
  __ast_out=""
  case "$(bai_api_style)" in
    responses)
      [[ "$__ast_raw" =~ $__re_type ]] || return 0
      __ast_type="${BASH_REMATCH[1]}"
      case "$__ast_type" in
        response.output_text.delta)
          [[ "$__ast_raw" =~ $__re_delta ]] || return 0
          printf -v __ast_out '{"choices":[{"delta":{"content":"%s"}}]}' "${BASH_REMATCH[1]}"
          ;;
        response.reasoning_text.delta)
          [[ "$__ast_raw" =~ $__re_delta ]] || return 0
          printf -v __ast_out '{"choices":[{"delta":{"reasoning_content":"%s"}}]}' "${BASH_REMATCH[1]}"
          ;;
        response.function_call_arguments.delta)
          [[ "$__ast_raw" =~ $__re_idx ]] && __ast_idx="${BASH_REMATCH[1]}" || __ast_idx=0
          [[ "$__ast_raw" =~ $__re_delta ]] || return 0
          __resp_tc_args_seen[$__ast_idx]=1
          printf -v __ast_out '{"choices":[{"delta":{"tool_calls":[{"index":%s,"function":{"arguments":"%s"}}]}}]}' "$__ast_idx" "${BASH_REMATCH[1]}"
          ;;
        response.function_call_arguments.done|response.output_item.done)
          [[ "$__ast_raw" =~ $__re_idx ]] && __ast_idx="${BASH_REMATCH[1]}" || __ast_idx=0
          [ -z "${__resp_tc_args_seen[$__ast_idx]:-}" ] || return 0
          [[ "$__ast_raw" =~ $__re_args ]] || return 0
          __resp_tc_args_seen[$__ast_idx]=1
          printf -v __ast_out '{"choices":[{"delta":{"tool_calls":[{"index":%s,"function":{"arguments":"%s"}}]}}]}' "$__ast_idx" "${BASH_REMATCH[1]}"
          ;;
        response.output_item.added)
          [[ "$__ast_raw" == *'"function_call"'* ]] || return 0
          [[ "$__ast_raw" =~ $__re_idx ]] && __ast_idx="${BASH_REMATCH[1]}" || __ast_idx=0
          [[ "$__ast_raw" =~ $__re_id ]] && __ast_id="${BASH_REMATCH[1]}"
          [[ "$__ast_raw" =~ $__re_name ]] && __ast_name="${BASH_REMATCH[1]}"
          printf -v __ast_out '{"choices":[{"delta":{"tool_calls":[{"index":%s,"id":"%s","type":"function","function":{"name":"%s","arguments":""}}]}}]}' "$__ast_idx" "$__ast_id" "$__ast_name"
          ;;
        response.completed)
          __ast_out="$(jq -c '
            {choices:[{delta:{}, finish_reason:"stop"}], usage:{
              prompt_tokens:(.response.usage.input_tokens // 0),
              completion_tokens:(.response.usage.output_tokens // 0),
              total_tokens:(.response.usage.total_tokens // 0),
              completion_tokens_details:{reasoning_tokens:(.response.usage.output_tokens_details.reasoning_tokens // 0)}}}' <<< "$__ast_raw")"
          ;;
        response.failed|response.incomplete)
          BAI_RESP_ERROR="$(jq -r '.response.error.message // .response.incomplete_details.reason // "响应失败"' <<< "$__ast_raw" 2>/dev/null)"
          return 0
          ;;
        *) return 0 ;;
      esac
      ;;
    *) __ast_out="$__ast_raw" ;;
  esac
  return 0
}

# 适配层自检# 用法: bai_api_selfcheck
function bai_api_selfcheck {
  local rows='| Item | Value |'$'\n''| --- | --- |'$'\n'
  rows+="| Style | $(bai_api_style) |"$'\n'
  rows+="| Main Request | $(bai_api_endpoint) |"$'\n'
  rows+="| Standby Request | $(bai_api_aux_endpoint) |"$'\n'
  rows+="| Realized | $(bai_api_supported && echo True || echo False) |"$'\n'
  printf '%s' "$rows" | Render-MDtable
}

# BAI 核心请求体
# 用法: Get-Assistant-Return
# 行为控制:
#       变量 OPENAI_BASE_URL[1]*, API_AUTH[2]*, data[3]*
#       1* 基础 URL
#       2* API 认证
#       3* 请求体
function Get-Assistant-Return {
  # -N: 关闭 curl 输出缓冲，SSE 分片逐行到达（否则小于缓冲区的流会被整体延迟，打断也不及时）
  local __api_url __api_body
  __api_url="$(bai_api_endpoint)"
  __api_body="$(bai_api_prepare_payload "$data")"
  curl -sS -N -XPOST \
    "$__api_url" \
    -D "${BAI_TEMP_FILES["http_response_headers"]}" \
    -H "$API_AUTH" \
    -H "Content-Type: application/json" \
    -d @- <<< "$__api_body" 2>${BAI_TEMP_FILES["http_response_error"]} ||
  printf '{"error": {"message": "%s"}}' \
    "$(L10n-zh-Hans "api_return_error.network_error 网络请求失败")"
}

