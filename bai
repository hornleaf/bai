  printf -v BAI_CHAT_PS0 "%s" "$BAI_CHAT_PS0"
  local __ps_user __ps_model __ps_name __ps_effort __ps_usage __ps_hit
  __ps_user="$(bai_sed_escape "$user_prompt")"
  __ps_model="$(bai_sed_escape "${BAI_MODEL_DISPLAY:-$OPENAI_API_MODEL}")"
  __ps_name="$(bai_sed_escape "${BAI_USERNAME:-User}")"
  __ps_effort="$(bai_sed_escape "${OPENAI_REASONING_EFFORT:-default}")"
  __ps_usage="$(bai_sed_escape "${__usage_rate:-0.00}")"
  __ps_hit="$(bai_sed_escape "${__cache_hit_rate:-0.00}")"
  __BAI_CHAT_PS1="$(
    sed -e "s|%U|$__ps_user|g" \
        -e "s|%m|$__ps_model|g" \
        -e "s|%u|$__ps_name|g" \
        -e "s|%e|$__ps_effort|g" \
        -e "s|%s:u|$__ps_usage|g" \
        -e "s|%s:h|$__ps_hit|g" \
      <<<"$BAI_CHAT_PS0"
  )"
}

function Pormpt-Effort {
  [[ "$OPENAI_REASONING_EFFORT" == default ]] || printf " · $OPENAI_REASONING_EFFORT"
  if [[ "$OPENAI_ENABLE_STREAM" == true && "$OPENAI_INCLUDE_USAGE" == true ]];then
    printf "${nf_memory_2/\\$nf_memory_2/ $nf_memory_2} ${__usage_rate:-0.00}%%"
  fi
}

