function Print-ColorFull {
  local freq="${LOL_FREQ:-0.1}"
  local spread="${LOL_SPREAD:-3.0}"
  local mode="${2:-${__bai_wait_gradient:-dual}}"
  # none 模式不需要渐变：纯 Bash 去掉标记，省掉每帧一次 gawk
  if [[ "$mode" == "none" ]];then
    local plain
    IFS= read -r -d '' plain || :
    plain="${plain//\{\{/}"
    plain="${plain//\}\}/}"
    printf '%s\n' "$plain"
    return 0
  fi
  # 灰度风格只在启动/.set 时解析一次，避免每帧一次子壳
  local gstyle="${__bai_gray_style:-}"
  if [[ -z "$gstyle" ]];then
    gstyle="$(bai_wait_gray_style)" || gstyle=band
    __bai_gray_style="$gstyle"
  fi
  # 双色端点只在模式为 dual 时才需要（避免其它模式每帧解析）
  local dual=""
  if [[ "$mode" == "dual" ]];then
    dual="${__bai_wait_dual:-}"
    [ "$dual" ] || dual="$(bai_wait_dual_colors)" || dual="255;128;255 128;255;255"
  fi
  gawk -v freq="$freq" -v spread="$spread" -v frame="$1" -v mode="$mode" -v gstyle="$gstyle" -v dual="$dual" -v dstyle="${__bai_wait_dual_style:-band}" '
      BEGIN {
        pi = atan2(0, -1);
        split(dual, _dp, " ");
        split(_dp[1], _da, ";"); split(_dp[2], _db, ";");
        d1r = _da[1] + 0; d1g = _da[2] + 0; d1b = _da[3] + 0;
        d2r = _db[1] + 0; d2g = _db[2] + 0; d2b = _db[3] + 0;
      }
      function rainbow(idx) {
        r = int(sin(freq * idx) * 127 + 128);
        g = int(sin(freq * idx + 2*pi/3) * 127 + 128);
        b = int(sin(freq * idx + 4*pi/3) * 127 + 128);
        return sprintf("\033[38;2;%d;%d;%dm", r, g, b);
      }
      # 灰度：多种风格（band=暗灰底 + 白色亮斑横扫，默认）
      # pos 是标记段内第几个字符（1 起），cycle 是扫光周期（按标记段长度自适应）
      function gray_shade(idx, pos,   band, v, ph, cycle, sigma) {
        cycle = mlen + 6;
        if (gstyle == "sine") {
          v = 88 + (sin(freq * idx) * 0.5 + 0.5) * 167;
        } else if (gstyle == "white") {
          v = 150 + (sin(freq * idx) * 0.5 + 0.5) * 105;
        } else if (gstyle == "breath") {
          v = 110 + (sin(freq * frame / spread) * 0.5 + 0.5) * 145;
        } else if (gstyle == "contrast") {
          v = 56 + (sin(freq * idx) * 0.5 + 0.5) * 199;
        } else if (gstyle == "ramp") {
          ph = (pos - frame / 8.0) % cycle;
          if (ph < 0) ph += cycle;
          v = 100 + 155 * (ph / cycle);
        } else {
          # band：暗灰底（92）上叠一道白色亮斑（到 255），从左向右扫过整段标记文字
          band = (frame / 10.0) % cycle - 3;
          sigma = mlen / 2.6 + 1.6;
          v = 92 + 163 * exp(-((pos - band) / sigma) ** 2);
        }
        if (v < 0) v = 0; else if (v > 255) v = 255;
        return sprintf("\033[38;2;%d;%d;%dm", int(v), int(v), int(v));
      }
      # 双色渐变：底色取颜色 A，颜色 B 化作一道亮带沿标记段横扫（与灰度 band 同款节奏）
      # pos 是标记段内第几个字符（1 起）；band 每帧右移，扫过整段后循环
      function dual_shade(pos,   band, sigma, u, w, r, g, b) {
        if (dstyle == "flow") {
          # 流动渐变：横向渐变缓慢平移。用余弦包络而不是锯齿——
          # 锯齿回绕时行尾的青白会直接跳回品红，视觉上很生硬
          u = (pos - 0.5) / (mlen > 0 ? mlen : 1);
          w = 0.5 - 0.5 * cos(pi * (u + frame / 120.0));
        } else if (dstyle == "static") {
          # 静止渐变：整段从 A 到 B 固定铺开，不随时间变化
          u = (mlen > 1) ? (pos - 1) / (mlen - 1) : 0.5;
          w = u;
        } else {
          # band（默认）：底色 A，B 化作亮带横扫
          band = (frame / 12.5) % (mlen + 6) - 3;
          sigma = mlen / 2.6 + 1.6;
          w = exp(-((pos - band) / sigma) ** 2);
        }
        r = int(d1r + (d2r - d1r) * w);
        g = int(d1g + (d2g - d1g) * w);
        b = int(d1b + (d2b - d1b) * w);
        if (r < 0) r = 0; else if (r > 255) r = 255;
        if (g < 0) g = 0; else if (g > 255) g = 255;
        if (b < 0) b = 0; else if (b > 255) b = 255;
        return sprintf("\033[38;2;%d;%d;%dm", r, g, b);
      }
      # 按模式选择着色方案
      function paint(idx, pos) {
        if (mode == "gray") return gray_shade(idx, pos);
        if (mode == "dual") return dual_shade(pos);
        return rainbow(idx);
      }
      {
        out = "";
        in_marker = 0;
        mpos = 0;
        len = length($0);
        # 预扫描最长的 {{...}} 标记段，决定扫光周期（band/ramp 用）
        mlen = 4;
        if (mode == "gray" || mode == "dual") {
          tmp = $0;
          while (match(tmp, /\{\{[^{}]*\}\}/)) {
            seg = substr(tmp, RSTART + 2, RLENGTH - 4);
            if (length(seg) > mlen) mlen = length(seg);
            tmp = substr(tmp, RSTART + RLENGTH);
          }
        }
        for (i = 1; i <= len; ) {
          # 检测并跳过已有的 ANSI 转义序列（例如 \033[...m）
          if (substr($0, i, 1) == "\033" && substr($0, i+1, 1) == "[") {
            # 查找匹配的 'm' 结尾
            start = i;
            while (i <= len && substr($0, i, 1) != "m") i++;
            if (i <= len) i++;  # 包含 'm'
            seq = substr($0, start, i - start);
            out = out seq;      # 原样保留颜色序列
            continue;
          }
          # 检测开始标记 {{
          if (!in_marker && substr($0, i, 2) == "{{") {
            in_marker = 1;
            mpos = 0;
            i += 2;
            continue;
          }
          # 检测结束标记 }}
          if (in_marker && substr($0, i, 2) == "}}") {
            in_marker = 0;
            # 结束标记后立即重置颜色，避免溢出
            out = out "\033[0m";
            i += 2;
            continue;
          }
          ch = substr($0, i, 1);
          if (in_marker) {
            # 标记内的字符动态上色
            idx = (NR + frame / spread) + (i / spread);
            mpos++;
            out = out paint(idx, mpos) ch;
          } else {
            # 普通字符：输出重置 + 字符，确保默认颜色
            out = out ch;
          }
          i++;
        }
        # 行末添加重置，防止影响后续行（可选）
        printf "%s\033[0m\n", out;
      }
    '
}

