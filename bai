# 从文件导入本地化数据
# 用法: Import-String <文件路径>
function Import-String {
    local file="$1"
    [[ ! -f "$file" ]] && { return 101; }

    
    local lang=""
    while IFS= read -r line || [[ -n "$line" ]];do
        # 遇到注释直接跳过
        [[ "$line" =~ ^"# " ]] && continue

        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        
        if ((import_string_status==0));then
          import_string_status=1
          if [[ "$line" =~ ^Language:[[:space:]]*([a-z]{2}_[A-Z]{2}) ]];then
              lang="${BASH_REMATCH[1]}"
          fi
        
          [[ -z "$lang" ]] && { return 102; }

          [[ " ${__loc_file_map[*]} " == *" ::$file:: "* ]] && {
            echo -e "${c33}WARNING:${c0} 文件 ${c35}$file${c0} 已导入，跳过重复导入" >&2
            break
          }
          __loc_file_map+=("::$file::")

          [[ " ${__loc_import_map[*]} " == *" $lang "* ]] && {
            echo -e "${c33}WARNING:${c0} 语言 ${c35}$lang${c0} 已导入，跳过重复导入" >&2
            break
          }
          __loc_import_map+=("$lang")
          continue
        fi
        
        # 修复：使用第一个空格分隔，键名可包含多个点
        [[ "$line" =~ ^([a-zA-Z0-9_.-]+)[[:space:]]+(.*)$ ]] && {
            __loc_map["$lang.${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
        }
    done < "$file"
    import_string_status=0
}

