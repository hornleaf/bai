# 处理模型静态输出
# 用法: Return-Assistant-Content
# 行为控制:
#       变量 API_RETURN
#       处理模型静态输出
function Return-Assistant-Content {
  local __render="$API_RETURN"
  # 非交互模式没有"循环顶部落盘"的机会，这里补写本轮助手回复
  if ! $INTERACT_MODE && [ -n "$API_RETURN" ];then
    local __ra_file __ra_msg
    if __ra_file="$(bai_jq_rawfile "$API_RETURN")";then
      __ra_msg="$(jq --rawfile c "$__ra_file" '{role: "assistant", content: $c}' <<< '{}' 2>/dev/null)"
      rm -f "$__ra_file"
      [ -n "$__ra_msg" ] && bai_append_message "$__ra_msg"
    fi
  fi
  # 每轮结束落盘会话
  bai_session_save
  # 把 $...$ / $$...$$ 公式渲染成 Unicode 文本
  $BAI_LATEX_RENDER && __render="$(bai_latex_text "$API_RETURN")"
  # 非连续对话模式下禁用逐字输出和前缀，以提高效率
  # 连续对话模式下启用逐字输出和前缀，以提升体验
  if $INTERACT_MODE;then
    if $PRINT;then
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.typing_effect_output 使用打字效果输出")"
    else
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.direct_output_with_syntax_highlighting 直接输出结果，如果可能，将使用 bat 语法高亮")"
    fi
    $INTERACT_MODE && printf "${c32}$ai_prompt${c0} "
    # 指定输出模式
    if $PRINT;then
      Print-FakeStream <<< "$__render"
    else
      if $__has_extend_bat;then
        bat --plain --no-pager -l markdown <<< "$__render"
      else
        cat <<< "$__render"
      fi
    fi
  else
    if $__has_extend_bat;then
      bat --plain --no-pager -l markdown <<< "$__render"
    else
      cat <<< "$__render"
    fi
    exit
  fi
}

