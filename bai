# 向对话提交文件
# 用法: Get-Import-File <文件路径>
# 选项:
#       文件路径 要提交的文件路径
function Get-Import-File {
  filepath="$1"
  if [ -z "$filepath" ];then
    erron "$(L10n-zh-Hans "get_import_file.no_filepath 未输入文件")"
    return
  fi
  if [ -f "$filepath" ];then
    if ! Check-File-Type "$filepath";then
      erron "$(L10n-zh-Hans "get_import_file.invalid_file_type 非法的文件类型")"
      return
    fi
    filesize=$(stat -c %s "$filepath")
    case "$check_file_type" in
      text)
        # 如果文件大小大于 100KB，拦截此请求
        if ((filesize>102400));then
          erron "$(L10n-zh-Hans "get_import_file.file_too_large 过大的文件") ($(Get-Data-Size "$filesize") > 100 KB)"
          return
        fi
        if [ -z "$old_filepath" ];then
          msg "$(L10n-zh-Hans "get_import_file.file_submitted 提交文件") $filepath"
        else
          msg "$(L10n-zh-Hans "get_import_file.file_replaced 最新提交的文件") $filepath => $old_filepath"
        fi
        STDIN_INPUT="$(echo "File: $filepath";echo "@File Content Head";cat -n "$filepath" | sed -E 's/^([[:space:]]*[0-9]+)/\1 |/g')"$'\n@File Content Tail\n'
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "get_import_file.debug_input_to_stdin 向标准输入提交文件") $filepath"
        old_filepath="$filepath"
        ;;
      image)
        # 如果文件大小大于 50MB，拦截此请求
        if ((filesize>52428800));then
          erron "$(L10n-zh-Hans "get_import_file.file_too_large 过大的文件") ($(Get-Data-Size "$filesize") > 50 MiB)"
          return
        fi
        if [ -z "$old_filepath" ];then
          msg "$(L10n-zh-Hans "get_import_file.image_submitted 提交图片") ${c35}${filepath##*/}${c0}"
        else
          msg "$(L10n-zh-Hans "get_import_file.image_replaced 最新提交的图片") ${c35}${old_filepath##*/}(${c32}old${c0}) ${c33}=>${c0} ${c35}${filepath##*/}(${c34}new${c0})"
        fi
        Show-Sixel-Image "$filepath"
        echo -e "${c33}[TIPS]:${c0} $(L10n-zh-Hans "get_import_file.image_tips 图像识别需要模型支持，此功能可能无法正常使用")"
        msg "$(L10n-zh-Hans "get_import_file.input_prompt 请继续输入对图片的描述或相关问题...")"
        IS_PUSH_IMAGE=true
        case "$filepath" in
          *.jpg|*.jpeg) image_type="image/jpeg";;
          *.png) image_type="image/png";;
          *.gif) image_type="image/gif";;
          *.webp) image_type="image/webp";;
          *.avif) image_type="image/avif";;
          *.bmp) image_type="image/bmp";;
          *.tiff|*.tif) image_type="image/tiff";;
          *.svg) image_type="image/svg+xml";;
          *.ico) image_type="image/x-icon";;
          *.heic|*.heif) image_type="image/heic";;
          *)
            image_type="image/png"
            emsg "$(L10n-zh-Hans "get_import_file.unknown_image_type 未知图片类型，使用默认类型 image/png")"
            ;;
        esac
        IMAGE_INPUT="$(printf "data:%s;base64," "$image_type";base64 -i "$filepath" | tr -d '\n')"
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "get_import_file.debug_input_image_to_stdin 向标准输入提交图片 (数据格式: Base64 Data URI)")"
        old_filepath="$filepath"
        ;;
    esac
  else
    emsg "$filepath: $(L10n-zh-Hans "get_import_file.file_not_exist 文件不存在")"
  fi
}

