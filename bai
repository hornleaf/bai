# 按终端显示宽度换行（CJK 等宽字符按 2 列计算）
# 用法: bai_wrap_cjk <宽度>
# 按终端显示宽度换行（CJK 等宽字符按 2 列计算，尽量不在词/标点处断开）
# 用法: bai_wrap_cjk <宽度>
# 选项:
#       <宽度> 目标显示宽度
# 规则:
#       * CJK/全角/emoji=2 列，ASCII/框线/箭头=1 列，tab=0，测量前剥离 ANSI
#       * 英文/路径/URL 尽量整词换行，单词本身超宽才硬断
#       * 中文禁则：行首不出现收尾标点（，。、；：？！）】」』" 等），
#         行尾不出现开括号（（【「『" 等）
#       * 每行去掉行首/行尾空格
function bai_wrap_cjk {
  local width="${1:-80}"
  [[ "$width" =~ ^[0-9]+$ ]] && ((width>4)) || width=80
  LC_ALL="${BAI_UTF8_LOCALE:-C.UTF-8}" gawk -v W="$width" '
    BEGIN {
      CLOSE = "）)】]」』》〉，,。.、；;：:？！?!…—\"\x27"
      OPEN  = "（(【[「『《〈\"\x27"
    }
    # 显示宽度：ASCII/半角=1，CJK/全角/emoji=2，制表符=0，其余（框线、箭头等）=1
    function cw(ch) {
      if (ch == "\t") return 0
      if (ch >= "一" && ch <= "鿿") return 2
      if (ch >= "㐀" && ch <= "䶿") return 2
      if (ch >= "぀" && ch <= "ヿ") return 2
      if (ch >= "가" && ch <= "힣") return 2
      if (ch >= "＀" && ch <= "｠") return 2
      if (ch >= "　" && ch <= "〿") return 2
      if (ch >= "🌀" && ch <= "🫿") return 2
      return 1
    }
    function isword(ch) { return ch != "" && ch ~ /[A-Za-z0-9_\/\\.:@%+=~$&?#-]/ }
    function isclose(ch) { return ch != "" && index(CLOSE, ch) > 0 }
    function isopen(ch)  { return ch != "" && index(OPEN, ch) > 0 }
    function emit(s, e,   buf, k) {
      buf = ""
      for (k = s; k <= e; k++) buf = buf tok[k]
      sub(/[ \t]+$/, "", buf)
      print buf
      fflush()
    }
    {
      line = $0
      m = length(line); ntok = 0; i = 1
      # 拆成 token：ANSI 转义整体当一个零宽 token，其余按字符
      while (i <= m) {
        ch = substr(line, i, 1)
        if (ch == "\033" && substr(line, i+1, 1) == "[") {
          j = i + 1
          while (j <= m && substr(line, j, 1) != "m") j++
          if (j > m) j = m
          ntok++; tok[ntok] = substr(line, i, j - i + 1); wid[ntok] = 0; wch[ntok] = ""
          i = j + 1; continue
        }
        ntok++; tok[ntok] = ch; wch[ntok] = ch; wid[ntok] = cw(ch)
        i++
      }
      if (ntok == 0) { print ""; fflush(); next }
      s = 1
      while (s <= ntok) {
        while (s <= ntok && wch[s] == " ") s++      # 行首空格不入行
        if (s > ntok) break
        w = 0; e = s - 1
        while (e + 1 <= ntok && w + wid[e+1] <= W) { e++; w += wid[e] }
        if (e < s) e = s                             # 单字符就超宽时也要占位
        if (e >= ntok) { emit(s, e); break }
        nxt = wch[e+1]
        # 禁则 1：行首不能是收尾标点 → 把当前行最后一个字符一起带到下行
        if (isclose(nxt) && e > s) e--
        # 禁则 2：行尾不能是开括号
        while (e > s && isopen(wch[e])) e--
        # 英文/路径整词换行
        if (isword(nxt) && isword(wch[e])) {
          k = e
          while (k > s && isword(wch[k-1])) k--
          if (k > s) e = k - 1
        }
        if (e < s) e = s
        emit(s, e)
        s = e + 1
      }
    }
  '
}
# 按显示宽度右侧补空格（用于画方框右对齐）
# 用法: bai_pad_display <宽度>
function bai_pad_display {
  local width="${1:-80}"
  [[ "$width" =~ ^[0-9]+$ ]] || width=80
  LC_ALL="${BAI_UTF8_LOCALE:-C.UTF-8}" gawk -v W="$width" '
    function cw(ch) {
      if (ch == "\t") return 0
      if (ch >= "一" && ch <= "鿿") return 2
      if (ch >= "㐀" && ch <= "䶿") return 2
      if (ch >= "぀" && ch <= "ヿ") return 2
      if (ch >= "가" && ch <= "힣") return 2
      if (ch >= "＀" && ch <= "｠") return 2
      if (ch >= "　" && ch <= "〿") return 2
      if (ch >= "🌀" && ch <= "🫿") return 2
      return 1
    }
    function strip_ansi(s,   t){ t=s; gsub(/\033\[[0-9;]*[A-Za-z]/, "", t); return t }
    function vw(s,   i,c,n,t) {
      t=strip_ansi(s); n=0
      for(i=1;i<=length(t);i++){c=substr(t,i,1); n+=cw(c)}
      return n
    }
    {
      pad = W - vw($0)
      if (pad < 0) pad = 0
      printf "%s%*s\n", $0, pad, ""
    }
  '
}

# ── 工具权限 ──────────────────────────────────────────────────────────
# 级别: never / low / medium / always（未声明按 medium）
# 模式: normal=按级别；full=全部放行；auto=自审查，仅高危需确认
declare -gA BAI_TOOL_PERMISSION BAI_TOOL_PERMISSION_BASE BAI_PERMISSION_GRANTED BAI_PERMISSION_REVIEW_CACHE
BAI_PERMISSION_DENIED=0
BAI_PERMISSION_CACHE_LOADED=0

# 读取工具权限级别
# 用法: bai_permission_level <工具名>
function bai_permission_level {
  local name="$1" lvl="${BAI_TOOL_PERMISSION[$1]:-medium}"
  case "$lvl" in
    never|low|medium|always) printf '%s' "$lvl" ;;
    *) printf '%s' medium ;;
  esac
}

# 从工具文件加载权限声明，并对 never 级别给出红色警告
# 用法: bai_permission_load <工具文件>
function bai_permission_load {
  local file="$1" name lvl
  [ -n "$file" ] && [ -f "$file" ] || return 0
  BAI_TOOL_PERMISSION=()
  BAI_TOOL_PERMISSION_BASE=()
  while IFS=$'\t' read -r name lvl;do
    [ -n "$name" ] || continue
    case "$lvl" in
      never)
        BAI_TOOL_PERMISSION["$name"]=never
        BAI_TOOL_PERMISSION_BASE["$name"]=never
        L10n-zh-Hans "permission.warning.no_request ${c31}警告: 工具 %s 声明权限为 never，任何时候都不会请求用户确认${c0}" "${name}" >&2
        ;;
      low|medium|always)
        BAI_TOOL_PERMISSION["$name"]="$lvl"
        BAI_TOOL_PERMISSION_BASE["$name"]="$lvl"
        ;;
      *)
        BAI_TOOL_PERMISSION["$name"]=medium
        BAI_TOOL_PERMISSION_BASE["$name"]=medium
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.permission_default 工具 %s 未声明权限级别，按 medium 处理" "$name")"
        ;;
    esac
  done < <(jq -r '[.name // "", (.permission // "medium")] | @tsv' "$file" 2>/dev/null)
}

# 依据命令内容做风险判断（low 级别用）
# 用法: bai_permission_risk_check <文本>
function bai_permission_risk_check {
  local text="$1"
  local risky='(^|[^[:alnum:]_])(rm|rmdir|dd|mkfs|shred|chmod|chown|chattr|sudo|su|kill|pkill|killall|shutdown|reboot|mount|umount|systemctl|service)([[:space:]]|$)|>[[:space:]]*/(etc|usr|boot|dev|bin|sbin)|(curl|wget)[^|]{0,200}\|[[:space:]]*(ba|z)?sh|eval[[:space:]]|/dev/tcp|base64[[:space:]]+-d|(>>?)[[:space:]]*[^ ]*(\.ssh/|\.bashrc|\.profile|authorized_keys)'
  [[ "$text" =~ $risky ]]
}

# 审查缓存文件
# 用法: bai_permission_cache_file
function bai_permission_cache_file {
  printf '%s' "${BAI_PERMISSION_CACHE_FILE:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/bai/permission-review.tsv}"
}

# 审查缓存键（工具名 + 参数）
# 用法: bai_permission_review_key <工具名> <参数JSON>
function bai_permission_review_key {
  printf '%s\n%s' "$1" "$2" | sha1sum 2>/dev/null | cut -d' ' -f1
}

# 载入审查缓存（带 TTL）
# 用法: bai_permission_cache_load
function bai_permission_cache_load {
  [ "${BAI_PERMISSION_CACHE:-true}" = "true" ] || return 0
  (( BAI_PERMISSION_CACHE_LOADED )) && return 0
  BAI_PERMISSION_CACHE_LOADED=1
  local file ttl now key verdict ts
  file="$(bai_permission_cache_file)"
  ttl="${BAI_PERMISSION_CACHE_TTL:-86400}"
  [[ "$ttl" =~ ^[0-9]+$ ]] || ttl=86400
  now="$(date +%s)"
  [ -f "$file" ] || return 0
  while IFS=$'\t' read -r key verdict ts;do
    [[ -n "$key" && -n "$verdict" && "$ts" =~ ^[0-9]+$ ]] || continue
    (( now - ts > ttl )) && continue
    BAI_PERMISSION_REVIEW_CACHE["$key"]="$verdict"
  done < "$file"
  return 0
}

# 写入审查缓存
# 用法: bai_permission_cache_set <键> <risky|safe>
function bai_permission_cache_set {
  local key="$1" verdict="$2" file dir
  [ "${BAI_PERMISSION_CACHE:-true}" = "true" ] || return 0
  BAI_PERMISSION_REVIEW_CACHE["$key"]="$verdict"
  file="$(bai_permission_cache_file)"
  dir="$(dirname "$file")"
  mkdir -p "$dir" 2>/dev/null || return 0
  printf '%s\t%s\t%s\n' "$key" "$verdict" "$(date +%s)" >> "$file" 2>/dev/null
  return 0
}

# 自审查：让模型判断是否高危（结果带缓存）
# 用法: bai_permission_ai_review <工具名> <参数JSON>
# 返回: 0=高危 1=安全/无法判断
function bai_permission_ai_review {
  [ "${BAI_PERMISSION_AI:-true}" = "true" ] || return 1
  local tool="$1" args="$2" resp verdict model key cached
  model="${BAI_PERMISSION_REVIEW_MODEL:-${OPENAI_API_MODEL:-}}"
  bai_permission_cache_load
  key="$(bai_permission_review_key "$tool" "$args")"
  cached="${BAI_PERMISSION_REVIEW_CACHE[$key]:-}"
  if [ -n "$cached" ];then
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.permission_cache_hit 权限审查缓存命中: %s=%s" "$tool" "$cached")"
    [ "$cached" = "risky" ]
    return $?
  fi
  local sys='You are a security auditor. Users will provide you with a tool call (tool name + parameters). You should only output one word: RISKY (potentially damaging data, elevating privileges, leaking privacy, accessing the network, executing arbitrary commands) or SAFE (read-only, querying, calculating, and other harmless operations).'
  resp="$(curl -sS -m 30 "$(bai_api_aux_endpoint)" \
      -H "Authorization: Bearer ${OPENAI_API_KEY}" \
      -H 'Content-Type: application/json' \
      -d "$(jq -cn --arg m "$model" --arg s "$sys" \
            --arg u "tool: $tool\nparameter: $args" \
            '{model:$m, temperature:0, max_tokens:8, stream:false,
              messages:[{role:"system",content:$s},{role:"user",content:$u}]}')" 2>/dev/null)"
  verdict="$(jq -r "$(bai_api_aux_content_path) // empty" <<<"$resp" 2>/dev/null)"
  if [[ "$verdict" =~ (RISKY|RISK|UNSAFE) ]];then
    bai_permission_cache_set "$key" risky
    return 0
  fi
  if [[ "$verdict" =~ (SAFE|OK) ]];then
    bai_permission_cache_set "$key" safe
  fi
  return 1
}

# 请求用户确认
# 用法: bai_permission_ask <工具名> <参数JSON> <原因>
# 终端尺寸与宽度来源自检（.term 指令）
# 用法: bai_term_info
function bai_term_info {
  local tty_size stdin_size tput_size
  tty_size="$(stty size -F /dev/tty 2>/dev/null)"
  stdin_size="$(stty size 2>/dev/null)"
  tput_size="$(printf '%s %s' "$(tput lines 2>/dev/null)" "$(tput cols 2>/dev/null)")"
  printf "%-16s %s\n" "stty /dev/tty"   "${tty_size:-<无>}"
  printf "%-16s %s\n" "stty stdin"      "${stdin_size:-<无>}"
  printf "%-16s %s\n" "tput"            "${tput_size:-<无>}"
  printf "%-16s %s\n" "LINES/COLUMNS"   "${LINES:-<无>}/${COLUMNS:-<无>}"
  printf "%-16s %s\n" "BAI_TERM_WIDTH"  "${BAI_TERM_WIDTH:-<无>}"
  printf "%-16s %s\n" "Get-TWidth"      "$(Get-TWidth)"
}

function bai_permission_ask {
  local tool="$1" args="$2" reason="$3" width lvl
  if [ "${BAI_STDOUT_TTY:-false}" != "true" ] || ! $INTERACT_MODE;then
    erron "$(L10n-zh-Hans "permission.non_interactive 工具 %s 需要用户确认，但当前不是交互终端，已拒绝" "$tool")"
    BAI_PERMISSION_DENIED=$((BAI_PERMISSION_DENIED+1))
    return 1
  fi
  Wait-Task kill >/dev/null 2>&1
  width="$(Get-TWidth)"; [[ "$width" =~ ^[0-9]+$ ]] || width=80
  # 窄终端（手机/分屏，常见 30-45 列）也要按实际宽度折行，不能退回 80
  (( width >= 20 )) || width=20
  lvl="$(bai_permission_level "$tool")"
  local __timeout="${BAI_PERMISSION_ASK_TIMEOUT:-60}"

  # 参数摘要：命令类工具显示命令原文，其余显示压缩 JSON
  local __body="" __k __k2 __rc
  if [[ "$tool" == run_command ]];then
    __body="$(jq -r '.command // empty' <<< "$args" 2>/dev/null)"
  fi
  [ "$__body" ] || __body="$(jq -c '.' <<< "$args" 2>/dev/null || printf '%s' "$args")"
  [ "$__body" ] || __body="{}"
  local __wrapped __total
  __wrapped="$(printf '%s' "$__body" | bai_wrap_cjk $(( width - 8 )))"
  __total="$(printf '%s\n' "$__wrapped" | wc -l)"

  # 菜单项：always 级别不提供「本会话允许」，否则「每次确认」的语义会被破坏
  local -a __labels=() __values=()
  local __sel
  if [[ "$lvl" == "always" ]];then
    __labels=("$(L10n-zh-Hans "permission.opt_once 本次允许")" "$(L10n-zh-Hans "permission.opt_deny 拒绝")")
    __values=(once deny)
    __sel=1
  else
    __labels=("$(L10n-zh-Hans "permission.opt_once 本次允许")" "$(L10n-zh-Hans "permission.opt_session 本会话允许")" "$(L10n-zh-Hans "permission.opt_deny 拒绝")")
    __values=(once session deny)
    __sel=2
  fi
  local __n=${#__labels[@]} __i

  # 标题按终端宽度折行：长工具名（尤其是 mcp__server__tool）否则会顶出框外
  local __title="需要确认: $tool ($reason)" __tl
  local -a __title_lines=()
  while IFS= read -r __tl;do __title_lines+=("$__tl");done < <(printf '%s' "$__title" | bai_wrap_cjk $(( width - 6 )))
  if (( ${#__title_lines[@]} > 3 ));then
    __title_lines=("${__title_lines[@]:0:3}")
    __title_lines[2]+="…"
  fi
  if (( ${#__title_lines[@]} <= 1 ));then
    printf " $c35┃$c0 $c33┏$c0 需要确认: $c36%s$c0 (%s)\n" "$tool" "$reason"
  else
    local __ti
    printf " $c35┃$c0 $c33┏$c0 %s\n" "${__title_lines[0]}"
    for ((__ti=1; __ti<${#__title_lines[@]}; __ti++));do
      # 续行也带 ┃（与首行 ┏ 同列），文字仍与首行对齐
      printf " $c35┃$c0 $c33┃$c0 %s\n" "${__title_lines[__ti]}"
    done
  fi
  while IFS= read -r __k;do
    printf " $c35┃$c0 $c33┃$c0 %s\n" "$__k"
  done < <(printf '%s\n' "$__wrapped" | head -5)
  if (( __total > 5 ));then
    printf " $c35┃$c0 $c33┃$c0 $c237… (已截断，共 %s 行)$c0\n" "$__total"
  fi
  for ((__i=0; __i<__n; __i++));do
    if (( __i == __sel ));then
      printf " $c35┃$c0 $c33┃$c0 $c36❯ %s$c0\n" "${__labels[__i]}"
    else
      printf " $c35┃$c0 $c33┃$c0   %s\n" "${__labels[__i]}"
    fi
  done
  local __hint="↑↓ 选择 · Enter 确认 · Esc 取消 · ${__timeout} 秒后将超时" __hint_line
  local -a __hint_lines=()
  while IFS= read -r __hint_line;do __hint_lines+=("$__hint_line");done < <(printf '%s' "$__hint" | bai_wrap_cjk $(( width - 6 )))
  local __up=$(( __n + ${#__hint_lines[@]} )) __hi
  printf " $c35┃$c0 $c33┗$c0 %s\n" "${__hint_lines[0]}"
  for ((__hi=1; __hi<${#__hint_lines[@]}; __hi++));do
    printf " $c35┃$c0   %s\n" "${__hint_lines[__hi]}"
  done
  printf "\e[?25l"
  while true;do
    IFS= read -rsn1 -t "$__timeout" __k </dev/tty
    __rc=$?
    if (( __rc > 128 ));then
      printf "\r\e[K"
      erron "$(L10n-zh-Hans "permission.timeout 确认超时 (%s 秒)，已拒绝" "$__timeout")"
      __sel=$((__n-1)); break
    elif (( __rc != 0 ));then
      printf "\r\e[K"
      __sel=$((__n-1)); break
    fi
    case "$__k" in
      $'\e')
        IFS= read -rsn2 -t 0.05 __k2 </dev/tty
        case "$__k2" in
          '[A') __k=up;;
          '[B') __k=down;;
          *)    __k=esc;;
        esac
        ;;
      '')   __k=enter;;
      k|K)  __k=up;;
      j|J)  __k=down;;
      q|Q)  __k=esc;;
      y|Y)  __k=y;;
      a|A)  __k=a;;
      n|N)  __k=n;;
    esac
    case "$__k" in
      up)    (( __sel > 0 )) && __sel=$((__sel-1)) ;;
      down)  (( __sel < __n-1 )) && __sel=$((__sel+1)) ;;
      enter) break ;;
      esc)   __sel=$((__n-1)); break ;;
      y)     __sel=0; break ;;
      a)     [[ "$__n" -eq 3 ]] && { __sel=1; break; } ;;
      n)     __sel=$((__n-1)); break ;;
      *)     continue ;;
    esac
    printf '\e[%dA' "$__up"
    for ((__i=0; __i<__n; __i++));do
      if (( __i == __sel ));then
        printf "\r\e[K $c35┃$c0 $c33┃$c0 $c36❯ %s$c0\n" "${__labels[__i]}"
      else
        printf "\r\e[K $c35┃$c0 $c33┃$c0   %s\n" "${__labels[__i]}"
      fi
    done
    for ((__hi=0; __hi<${#__hint_lines[@]}; __hi++));do
      if (( __hi == 0 ));then
        printf "\r\e[K $c35┃$c0 $c33┗$c0 %s\n" "${__hint_lines[__hi]}"
      else
        printf "\r\e[K $c35┃$c0   %s\n" "${__hint_lines[__hi]}"
      fi
    done
  done
  printf "\e[?25h"
  case "${__values[__sel]}" in
    once) return 0 ;;
    session)
      BAI_PERMISSION_GRANTED["$tool"]=1
      return 0
      ;;
    *)
      BAI_PERMISSION_DENIED=$((BAI_PERMISSION_DENIED+1))
      erron "$(L10n-zh-Hans "permission.denied 已拒绝工具 %s" "$tool")"
      return 1
      ;;
  esac
}

# 权限判定
# 用法: bai_permission_gate <工具名> <参数JSON>
function bai_permission_gate {
  local tool="$1" args="$2" mode lvl reason=""
  mode="${BAI_PERMISSION_MODE:-normal}"
  lvl="$(bai_permission_level "$tool")"
  case "$mode" in
    full) return 0 ;;
    auto)
      if bai_permission_ai_review "$tool" "$args";then
        reason="$(L10n-zh-Hans "permission.auto_risky 自审查判定为高危操作")"
        bai_permission_ask "$tool" "$args" "$reason"
        return $?
      fi
      return 0
      ;;
  esac
  case "$lvl" in
    never) return 0 ;;
    always) reason="$(L10n-zh-Hans "permission.level_always Level: Always | 该工具要求每次确认")" ;;
    medium)
      [ -n "${BAI_PERMISSION_GRANTED[$tool]:-}" ] && return 0
      reason="$(L10n-zh-Hans "permission.level_medium Level: Medium | 首次使用需要确认")"
      ;;
    low)
      bai_permission_risk_check "$tool $args" || return 0
      reason="$(L10n-zh-Hans "permission.level_low Level: Low | 检测到潜在风险操作")"
      ;;
  esac
  bai_permission_ask "$tool" "$args" "$reason"
}

# 运行时修改工具权限级别
# 用法: bai_permission_set <工具名> <never|low|medium|always>
function bai_permission_set {
  local tool="$1" lvl="$2" old
  if [ -z "$tool" ] || [ -z "$lvl" ];then
    msg "$(L10n-zh-Hans "permission.set_usage 用法: .perms set <工具名> <never|low|medium|always>")"
    return 1
  fi
  case "$lvl" in
    never|low|medium|always) ;;
    *) erron "$(L10n-zh-Hans "permission.invalid_level 非法的权限级别: %s（never|low|medium|always）" "$lvl")"; return 1 ;;
  esac
  if [ -z "${BAI_TOOL_PERMISSION[$tool]:-}" ] && [ -z "${BAI_TOOL_PERMISSION_BASE[$tool]:-}" ];then
    erron "$(L10n-zh-Hans "permission.tool_not_found 未找到工具: %s" "$tool")"
    return 1
  fi
  old="$(bai_permission_level "$tool")"
  BAI_TOOL_PERMISSION["$tool"]="$lvl"
  # 改成 medium 后应重新走首次确认
  [ "$lvl" = medium ] && unset "BAI_PERMISSION_GRANTED[$tool]"
  msg "$(L10n-zh-Hans "permission.changed 已把 %s 的权限从 %s 临时改为 %s" "$tool" "$old" "$lvl")"
  [ "$lvl" = never ] && L10n-zh-Hans "permission.warning ${c31}警告: %s 现在是 never，不会再请求确认${c0}" "${tool}" >&2
  return 0
}

# 恢复工具权限到声明值
# 用法: bai_permission_reset <工具名>
function bai_permission_reset {
  local tool="$1" base
  if [ -z "$tool" ];then
    msg "$(L10n-zh-Hans "permission.reset_usage 用法: .perms reset <工具名>")"
    return 1
  fi
  if [ -z "${BAI_TOOL_PERMISSION[$tool]:-}" ] && [ -z "${BAI_TOOL_PERMISSION_BASE[$tool]:-}" ];then
    erron "$(L10n-zh-Hans "permission.tool_not_found 未找到工具: %s" "$tool")"
    return 1
  fi
  base="${BAI_TOOL_PERMISSION_BASE[$tool]:-medium}"
  BAI_TOOL_PERMISSION["$tool"]="$base"
  unset "BAI_PERMISSION_GRANTED[$tool]"
  msg "$(L10n-zh-Hans "permission.reset_done 已把 %s 的权限恢复为声明值 %s" "$tool" "$base")"
  return 0
}

# 运行时切换权限模式
# 用法: bai_permission_mode <normal|full|auto>
function bai_permission_mode {
  local mode="$1"
  case "$mode" in
    normal|full|auto)
      BAI_PERMISSION_MODE="$mode"
      msg "$(L10n-zh-Hans "permission.mode_changed 权限模式已切换为 %s" "$mode")"
      return 0
      ;;
    *)
      erron "$(L10n-zh-Hans "permission.invalid_mode 非法的权限模式: %s（normal|full|auto）" "$mode")"
      return 1
      ;;
  esac
}

# 列出工具权限
# 用法: bai_permission_list
function bai_permission_list {
  local rows="$(L10n-zh-Hans "permission.review.table_headline | 工具 | 权限 | 本次已授权 |")"$'\n| --- | --- | --- |\n' name lvl g
  if [ "${#BAI_TOOL_PERMISSION[@]}" -eq 0 ] 2>/dev/null;then
    msg "$(L10n-zh-Hans "permission.none 没有已加载的工具")"
    return 0
  fi
  for name in "${!BAI_TOOL_PERMISSION[@]}";do
    lvl="$(bai_permission_level "$name")"
    g="-"; [ -n "${BAI_PERMISSION_GRANTED[$name]:-}" ] && g="是"
    rows+="| ${name} | ${lvl} | ${g} |"$'\n'
  done
  printf '%s' "$rows" | Render-MDtable
  L10n-zh-Hans "permission.review_mode.current_mode 当前模式: %s（normal/full/auto）" "${BAI_PERMISSION_MODE:-normal}"
  if [ "${BAI_PERMISSION_CACHE:-true}" = "true" ];then
    L10n-zh-Hans "permission.review_mode.list 审查缓存: %s 条（%s）" "${#BAI_PERMISSION_REVIEW_CACHE[@]}" "$(bai_permission_cache_file)"
  else
    L10n-zh-Hans "permission.review_mode.disabled 审查缓存: 已禁用"
  fi
}

# 获取命令输出
# 用法: Get-Command-Output <命令>
# 选项:
#       <命令> 要执行的命令
# 行为控制:
#       变量 gco_return_content
#         命令执行完成后，将输出内容存储在变量 gco_return_content 中
#       变量 gco_status
#         命令执行完成后，将退出状态存储在变量 gco_status 中
#       变量 explicitly
#         为 true 时，命令执行完成后，输出内容将存储在变量 gco_return_content，同时打印到终端
#         为 false 时，命令执行完成后，输出内容仅存储在变量 gco_return_content 中，不会打印至终端
#       变量 catch_strerr
#         为 true 时，命令执行时捕获标准错误输出
#         为 false 时，仅捕获标准输出
# 中断当前 Shell 的全部子进程（用于工具执行超时）
# 用法: bai_kill_children [信号]
# 说明: 工具通过 eval 在当前 Shell 内执行（保留对 ai_prompt 等全局变量的修改），
#       因此无法整体放进 timeout 子进程；这里改为超时后结束当前 Shell 的子进程
function bai_kill_children {
  local __kc_sig="${1:-TERM}" __kc_p __kc_comm __kc_self="$BASHPID"
  while read -r __kc_p __kc_comm;do
    [[ -n "$__kc_p" ]] || continue
    [[ "$__kc_p" == "$__kc_self" ]] && continue
    # 基线进程（工具启动前就存在，如输出管道）不动
    [[ " ${__gco_base:-} " == *" $__kc_p "* ]] && continue
    # 输出管道辅助进程（process substitution）不动，否则主 Shell 会收到 SIGPIPE
    case "$__kc_comm" in
      cat|tee|fold|gawk|sed|stdbuf|ps) continue ;;
    esac
    kill -"$__kc_sig" "$__kc_p" 2>/dev/null
  done < <(ps -o pid=,comm= --ppid $$ 2>/dev/null)
}

function Get-Command-Output {
  local term_width=$(Get-TWidth)
  local mode="${explicitly:-false}"
  local outerrmode="${catch_stderr:-true}"
  local __gco_timeout="${BAI_TOOL_TIMEOUT:-0}"
  local __gco_wd="" __gco_flag="" __gco_timed_out=false __gco_sleep
  Create-TempFile get_command_output
  local temp_file="${BAI_TEMP_FILES[get_command_output]}"
  if [[ "$mode" != "silence" ]];then
    [[ -z "$term_width" ]] && term_width=80
    Wait-Task wait "$(L10n-zh-Hans "wait_task.executing_command {{工具正在执行命令}}")"
  fi
  # 工具执行超时看门狗
  if [[ "$__gco_timeout" =~ ^[0-9]+$ ]] && ((__gco_timeout>0));then
    __gco_flag="${TMPDIR:-/tmp}/.bai_tool_timeout_$$"
    rm -f "$__gco_flag"
    __gco_base="$(ps -o pid= --ppid $$ 2>/dev/null | tr '\n' ' ')"
    (
      trap 'kill "$__gco_sleep" 2>/dev/null; exit 0' TERM INT
      sleep "$__gco_timeout" &
      __gco_sleep=$!
      wait "$__gco_sleep"
      : > "$__gco_flag"
      bai_kill_children TERM
      sleep 0.5
      bai_kill_children KILL
    ) &
    __gco_wd=$!
  fi
  if [[ "$mode" == "true" || "$mode" == "raw" ]];then
    if [[ "$mode" == "true" ]];then
      # 美化：工具输出包在方框内；渲染放在进程替换里，结束时 wait，
      # 保证底部边框先于「工具返回状态」输出（否则状态行会插进方框）。
      eval "$*" "$([[ "$outerrmode" == "true" ]] && echo "2>&1")" > >(
        __box_w="$term_width"
        # 终端宽度未知/过窄（管道、某些 PTY）时给一个可读的默认宽度
        (( __box_w >= 20 )) || __box_w=20
        printf -v __box_dash '%*s' "$(( __box_w - 5 ))" ''
        __box_dash="${__box_dash// /─}"
        Wait-Task kill >/dev/null 2>&1
        printf '\r\e[K \e[35m┃\e[0m ╭%s╮\n' "$__box_dash"
        __box_first=1
        __box_ansi=$'\e'"\[[0-9;?]*[a-zA-Z]"
        tee "$temp_file" | bai_wrap_cjk $(( __box_w - 7 )) | bai_pad_display $(( __box_w - 6 )) | while IFS= read -r __box_raw;do
          if (( __box_first ));then
            Wait-Task kill >/dev/null 2>&1
            __box_first=0
          fi
          printf '\r\e[K \e[35m┃\e[0m │ %s│\n' "$__box_raw"
        done
        printf '\r\e[K \e[35m┃\e[0m ╰%s╯\n' "$__box_dash"
      )
      gco_status=$PIPESTATUS
      wait "$!" 2>/dev/null
    else
      eval "$*" "$([[ "$outerrmode" == "true" ]] && echo "2>&1")" > >( tee "$temp_file" )
      gco_status=$PIPESTATUS
      wait "$!" 2>/dev/null
    fi
  else
    # 静默/默认模式直接写文件，避免多一个 cat 子进程（超时时更好终结）
    eval "$*" "$([[ "$outerrmode" == "true" ]] && echo "2>&1")" > "$temp_file"
    # 状态必须在各分支内就地取：放在 if 外会被方框分支的 wait 覆盖成 0
    # （explicitly=true 的工具尤其明显，真实退出码会丢）
    gco_status=$PIPESTATUS
  fi
  # 收掉看门狗并判断是否超时
  if [ -n "$__gco_wd" ];then
    kill "$__gco_wd" 2>/dev/null
    wait "$__gco_wd" 2>/dev/null
    if [ -f "$__gco_flag" ];then
      __gco_timed_out=true
      gco_status=124
      rm -f "$__gco_flag"
    fi
  fi
  if $__gco_timed_out;then
    {
      echo
      echo "[超时] 工具执行超过 ${__gco_timeout} 秒，已中断（输出可能不完整）"
    } >> "$temp_file"
    [[ "$mode" != "silence" ]] && emsg "$(L10n-zh-Hans "get_command_output.timeout 工具执行超时（%s 秒），已中断" "$__gco_timeout")"
  fi
  : "// 告知模型已调用的函数执行状态，避免无输出的函数让模型产生未成功执行的幻觉，点名GLM-5"
  echo "Run Command: $*, Status Code: $gco_status" >> "$temp_file"
  if [[ "$mode" != "silence" ]];then
    Wait-Task kill
    echo -e " ${c35}┗${c0} $(L10n-zh-Hans "get_command_output.status 工具返回状态:") $( ((gco_status)) && printf "${c31}" || printf "${c32}")$gco_status${c0}"
  fi
  gco_return_content="$(cat "$temp_file")"
  Remove-TempFile get_command_output
}

