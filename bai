# 向对话提交文件
# 用法: Get-Import-File <文件路径>
# 选项:
#       文件路径 要提交的文件路径
function Get-Import-File {
  if (($#==0)) || [ -z "$1" ];then
    erron "$(L10n-zh-Hans "get_import_file.no_filepath 未输入文件")"
    return
  fi
  local __file_path __file_size __image_label
  for __file_path in "$@";do
    if [ ! -f "$__file_path" ];then
      emsg "$__file_path: $(L10n-zh-Hans "get_import_file.file_not_exist 文件不存在")"
      continue
    fi
    if ! Check-File-Type "$__file_path";then
      erron "$(L10n-zh-Hans "get_import_file.invalid_file_type 非法的文件类型")"
      continue
    fi
    filepath="$__file_path"
    __file_size=$(stat -c %s "$filepath")
    case "$check_file_type" in
      text)
        # 如果文件大小大于 100KB，拦截此请求
        if ((__file_size>102400));then
          erron "$(L10n-zh-Hans "get_import_file.file_too_large 过大的文件") ($(Get-Data-Size "$__file_size") > 100 KB)"
          continue
        fi
        if [ -z "$old_filepath" ];then
          msg "$(L10n-zh-Hans "get_import_file.file_submitted 提交文件") $filepath"
        else
          msg "$(L10n-zh-Hans "get_import_file.file_replaced 最新提交的文件") $filepath => $old_filepath"
        fi
        STDIN_INPUT="$(echo "File: $filepath";echo "@File Content Head";cat -n "$filepath" | sed -E 's/^([[:space:]]*[0-9]+)/\1 |/g')"$'\n@File Content Tail\n'
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "get_import_file.debug_input_to_stdin 向标准输入提交文件") $filepath"
        old_filepath="$filepath"
        ;;
      image)
        # 如果文件大小大于 50MB，拦截此请求
        if ((__file_size>52428800));then
          erron "$(L10n-zh-Hans "get_import_file.file_too_large 过大的文件") ($(Get-Data-Size "$__file_size") > 50 MiB)"
          continue
        fi
        Show-Sixel-Image "$filepath"
        echo -e "${c33}[TIPS]:${c0} $(L10n-zh-Hans "get_import_file.image_tips 图像识别需要模型支持，此功能可能无法正常使用")"
        IMAGE_INPUT="$(bai_image_data_uri "$filepath")"
        IMAGE_INPUTS+=("$IMAGE_INPUT")
        IS_PUSH_IMAGE=true
        __image_label="${filepath##*/}"
        if ((${#IMAGE_INPUTS[@]}>1));then
          msg "$(L10n-zh-Hans "get_import_file.image_appended 追加图片 %s, 当前待提交 %s 张" "$__image_label" "${#IMAGE_INPUTS[@]}")"
        else
          msg "$(L10n-zh-Hans "get_import_file.image_submitted 提交图片") ${c35}${__image_label}${c0}"
        fi
        msg "$(L10n-zh-Hans "get_import_file.input_prompt 请继续输入对图片的描述或相关问题...")"
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "get_import_file.debug_input_image_to_stdin 向标准输入提交图片 (数据格式: Base64 Data URI)")"
        old_filepath="$filepath"
        ;;
    esac
  done
}

# JSON 字符串反转义（纯 Bash 快速路径）
# 用法: bai_json_unescape <字符串> <输出变量名>
# 返回: 0 成功；1 含不支持或不认识的转义，调用方应回退 jq
function bai_json_unescape {
  local s="$1" out_name="$2"
  # \uXXXX 与罕见转义交给 jq 处理，避免把 \c 之类误当控制序列
  [[ "$s" == *'\u'* || "$s" == *'\b'* || "$s" == *'\f'* ]] && return 1
  s="${s//\\\\/$'\x01'}"
  s="${s//\\n/$'\n'}"
  s="${s//\\t/$'\t'}"
  s="${s//\\r/$'\r'}"
  s="${s//\\\"/\"}"
  s="${s//\\\//\/}"
  [[ "$s" == *'\'* ]] && return 1
  s="${s//$'\x01'/\\}"
  printf -v "$out_name" '%s' "$s"
  return 0
}

# 从流式增量 JSON 中取 delta 的指定文本字段（纯 Bash 快速路径）
# 用法: bai_stream_delta_text <增量 JSON> <字段名>
# 输出: 全局 __sd_text
# 返回: 0 成功（字段缺失时为空串）；1 需要回退 jq
function bai_stream_delta_text {
  local json="$1" key="$2"
  # 允许 JSON 中的空白：'"delta": {"content": "..."}'
  local re="\"delta\"[[:space:]]*:[[:space:]]*\{[^{}]*\"$key\"[[:space:]]*:[[:space:]]*\"(([^\"\\\\]|\\\\.)*)\""
  if [[ "$json" =~ $re ]];then
    bai_json_unescape "${BASH_REMATCH[1]}" __sd_text || return 1
    return 0
  fi
  # 明明有这个键却匹配不上（格式特殊），交给 jq 处理，避免静默丢字
  if [[ "$json" == *"\"$key\""* ]];then
    return 1
  fi
  __sd_text=""
  return 0
}

# 生成图片的 Base64 Data URI
# 用法: bai_image_data_uri <图片路径>
# 输出: Data URI 字符串
# 行为控制:
#       变量 image_type
function bai_image_data_uri {
  local filepath="$1"
  image_type=""
  case "$filepath" in
    *.jpg|*.jpeg) image_type="image/jpeg";;
    *.png) image_type="image/png";;
    *.gif) image_type="image/gif";;
    *.webp) image_type="image/webp";;
    *.avif) image_type="image/avif";;
    *.bmp) image_type="image/bmp";;
    *.tiff|*.tif) image_type="image/tiff";;
    *.svg) image_type="image/svg+xml";;
    *.ico) image_type="image/x-icon";;
    *.heic|*.heif) image_type="image/heic";;
    *)
      image_type="image/png"
      emsg "$(L10n-zh-Hans "get_import_file.unknown_image_type 未知图片类型，使用默认类型 image/png")"
      ;;
  esac
  printf "data:%s;base64," "$image_type"
  base64 -i "$filepath" | tr -d '\n'
}

# 助手给自己喂图：把图片排队，下一轮作为用户消息发送
# 用法: bai_tool_send_image <路径或URL> [说明]
# 行为控制:
#       变量 BAI_TOOL_JSON（模型调用时自动设置）, BAI_PENDING_IMAGES, BAI_PENDING_CAPTION
function bai_tool_send_image {
  local source="" caption="" args="${BAI_TOOL_JSON:-}" tmp="" file="" size max="${BAI_IMAGE_MAX_BYTES:-10485760}" mime ext
  if [ -n "$args" ] && jq -e 'type == "object"' <<<"$args" >/dev/null 2>&1;then
    source="$(jq -r '.source // .path // .url // empty' <<<"$args" 2>/dev/null)"
    caption="$(jq -r '.caption // empty' <<<"$args" 2>/dev/null)"
  fi
  [ -n "$source" ] || source="$1"
  [ -n "$caption" ] || caption="$2"
  if [ -z "$source" ];then
    printf '%s\n' "缺少 source（图片路径或 URL）"
    return 1
  fi
  case "$source" in
    http://*|https://*)
      tmp="$(mktemp "${TMPDIR:-/tmp}/.bai_tool_img.XXXXXX" 2>/dev/null)" || { printf '%s\n' "无法创建临时文件"; return 1; }
      if ! curl -fsSL --max-time 30 -o "$tmp" "$source" 2>/dev/null;then
        rm -f "$tmp"
        printf '%s\n' "下载图片失败: $source"
        return 1
      fi
      mime="$(file -b --mime-type "$tmp" 2>/dev/null)"
      case "$mime" in
        image/png) ext=png ;;
        image/jpeg) ext=jpg ;;
        image/gif) ext=gif ;;
        image/webp) ext=webp ;;
        image/bmp) ext=bmp ;;
        *) ext=png ;;
      esac
      file="$tmp.$ext"
      mv -f "$tmp" "$file"
      ;;
    *)
      file="${source/#\~/$HOME}"
      if [ ! -f "$file" ];then
        printf '%s\n' "图片不存在: $source"
        return 1
      fi
      ;;
  esac
  size=$(stat -c %s "$file" 2>/dev/null || echo 0)
  if (( size > max ));then
    printf '%s\n' "图片过大（$(Get-Data-Size "$size") > $(Get-Data-Size "$max")）"
    [ -n "$tmp" ] && rm -f "$file"
    return 1
  fi
  BAI_PENDING_IMAGES+=("$(bai_image_data_uri "$file")")
  BAI_PENDING_CAPTION="$caption"
  [ -n "$tmp" ] && rm -f "$file"
  printf '%s\n' "已排队 1 张图片：$source（$(Get-Data-Size "$size")），将在下一轮作为用户消息发送给模型。"
  return 0
}

# 把排队的图片作为一条 user 消息追加到对话（在工具结果之后调用）
# 用法: bai_flush_pending_images
function bai_flush_pending_images {
  (( ${#BAI_PENDING_IMAGES[@]} )) || return 0
  local imgs_file text_file caption="${BAI_PENDING_CAPTION:-（图片）}" uri sep
  imgs_file="$(mktemp "${TMPDIR:-/tmp}/.bai_pending_imgs.XXXXXX" 2>/dev/null)" || return 1
  {
    printf '['
    sep=""
    for uri in "${BAI_PENDING_IMAGES[@]}";do
      printf '%s{"type": "image_url", "image_url": {"url": ' "$sep"
      printf '%s' "$uri" | jq -Rs .
      printf '}}'
      sep=","
    done
    printf ']'
  } > "$imgs_file"
  text_file="$(bai_jq_rawfile "$caption")" || { rm -f "$imgs_file"; return 1; }
  data="$(jq --rawfile text "$text_file" --slurpfile images "$imgs_file" \
    '.messages += [{"role": "user", "content": ([{"type": "text", "text": $text}] + $images[0])}]' <<<"$data" 2>/dev/null)"
  rm -f "$text_file" "$imgs_file"
  BAI_PENDING_IMAGES=()
  BAI_PENDING_CAPTION=""
  return 0
}

# 内置命令执行工具：在子 Shell 中执行一条命令，输出交给 Get-Command-Output 捕获
# 用法: bai_tool_run_command <命令>
# 行为控制:
#       变量 BAI_TOOL_RUN_SHELL（默认 bash）
#       执行命令所用的 Shell
#       变量 BAI_TOOL_TIMEOUT（由 Get-Command-Output 的看门狗处理）
#       超过该秒数会结束本次命令的子进程
function bai_tool_run_command {
  local command="$1" shell="${BAI_TOOL_RUN_SHELL:-bash}"
  if [ -z "$command" ];then
    L10n-zh-Hans "tools.run_command.need_parameter [run_command] 缺少 command 参数" >&2
    return 2
  fi
  # 子 Shell 执行：不污染 bai 自身的 cwd/变量/函数；stdin 接 /dev/null，防止交互式命令挂死
  "$shell" -c "$command" </dev/null
}

# 把内置工具（send_image / run_command）注册到工具文件
# 用法: bai_register_builtin_tools
# 行为控制:
#       变量 BAI_SELF_IMAGE（默认 true）
#       为 false 时不注册 send_image
#       变量 BAI_RUN_COMMAND_TOOL（默认 true）
#       为 false 时不注册 run_command
#       说明: run_command 不声明 permission 字段，按默认级别 medium 处理（首次使用需确认）
function bai_register_builtin_tools {
  local want_image=false want_run=false want_prompt=false dir file
  [ "${BAI_SELF_IMAGE:-true}" = "true" ] && want_image=true
  [ "${BAI_RUN_COMMAND_TOOL:-true}" = "true" ] && want_run=true
  [ "${BAI_SELF_SET_PROMPT:-false}" = "true" ] && want_prompt=true
  $want_image || $want_run || $want_prompt || return 0
  [ -n "${BAI_CALLING_FILE:-}" ] && [ -f "$BAI_CALLING_FILE" ] || return 0
  dir="${BAI_MCP_DIR:-${TMPDIR:-/tmp}/bai-builtin-tools-$$}"
  mkdir -p "$dir" 2>/dev/null || return 0
  file="$dir/with-builtin-tools.jsonl"
  cat "$BAI_CALLING_FILE" > "$file" 2>/dev/null || return 0
  if $want_image;then
    printf '%s\n' '{"name":"send_image","description":"把一张本地图片或 http(s) 图片发给自己，下一轮就能看到。需要查看截图、图表、照片时使用。","function":"bai_tool_send_image \"$@\"","permission":"low","parameters":{"type":"object","properties":{"source":{"type":"string","description":"图片文件路径或 URL"},"caption":{"type":"string","description":"可选说明文字"}},"required":["source"]}}' >> "$file"
  fi
  if $want_run;then
    printf '%s\n' '{"name":"run_command","explicitly":"true","description":"在当前终端环境执行一条 Bash 命令并返回输出（stdout 与 stderr）。用于查看文件、运行脚本、查系统信息、跑构建或测试等；只能执行一次性非交互命令，不要启动需要键盘输入的程序（vim、less、top、ssh、交互式 REPL）。","function":"bai_tool_run_command \"$@\"","parameters":{"type":"object","properties":{"command":{"type":"string","description":"要执行的 Bash 命令，例如 ls -la /tmp"}},"required":["command"]}}' >> "$file"
  fi
  if $want_prompt;then
    printf '%s\n' '{"name": "get_assisant_prompt", "explicitly": "silence", "description": "获取当前 Assistant 输出提示符前缀", "function": "sleep 1s;echo \"$ai_prompt\""}' >> "$file"
    printf '%s\n' '{"name": "get_thinking_prompt", "explicitly": "silence", "description": "获取当前 Thinking 输出提示符前缀", "function": "sleep 1s;echo \"$thinking_prompt\""}' >> "$file"
    printf '%s\n' '{"name": "set_assisant_prompt", "explicitly": "silence", "description": "[改名] 设置当前 Assistant 输出提示符前缀, 需要先获取前缀形式参考原格式。此外还有 Thinking 输出提示符前缀可设置。", "function": "sleep 1s;[ \"$1\" ] && ai_prompt=\"$1\" && echo \"Assistant 前缀已设置为 $1\"", "parameters": {"type": "object", "properties": {"prompt": {"type": "string", "description": "需要设置的提示符内容"}}, "required": ["prompt"]}}' >> "$file"
    printf '%s\n' '{"name": "set_thinking_prompt", "explicitly": "silence", "description": "[改名] 设置当前 Thinking 输出提示符前缀, 需要先获取前缀形式参考原格式。", "function": "sleep 1s;[ \"$1\" ] && thinking_prompt=\"$1\" && echo \"Thinking 前缀已设置为 $1\"", "parameters": {"type": "object", "properties": {"prompt": {"type": "string", "description": "需要设置的提示符内容"}}, "required": ["prompt"]}}' >> "$file"
  fi
  BAI_CALLING_FILE="$file"
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.builtin_tools_registered 已注册内置工具 (send_image=%s, run_command=%s, *_prompt=%s)" "$want_image" "$want_run" "$want_prompt")"
  return 0
}


# 把文本文件内容追加到标准输入缓冲（带行号标注）
# 用法: bai_append_text_file <文件路径>
# 行为控制:
#       变量 STDIN_INPUT
function bai_append_text_file {
  local filepath="$1" filesize
  filesize=$(stat -c %s "$filepath" 2>/dev/null) || return 1
  if ((filesize>102400));then
    erron "$(L10n-zh-Hans "get_import_file.file_too_large 过大的文件") ($(Get-Data-Size "$filesize") > 100 KB)"
    return 1
