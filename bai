# 转换一段公式（stdin 读，stdout 出）
function bai_latex_math {
  bai_latex_init
  sed -E -f "$BAI_LATEX_SED_FILE"
}

# 判断 $...$ 里的内容是否像公式（避免误伤货币写法）
# 用法: bai_latex_is_math <内容>
function bai_latex_is_math {
  local body="$1"
  [ -n "$body" ] || return 1
  [[ "$body" == " "* || "$body" == *" " ]] && return 1
  [[ "$body" == *'\'* || "$body" == *'^'* || "$body" == *'_'* || "$body" == *'{'* ]] && return 0
  ((${#body} <= 60)) || return 1
  local __lm_re='^[A-Za-z0-9+*/=<>().,|-]+$'
  [[ "$body" =~ $__lm_re ]]
}

# 转换一行里的行内公式：$...$ 与 \(...\)
# 用法: bai_latex_line <文本>
function bai_latex_line {
  local text="$1" out="" before mid
  if [[ "$text" != *'$'* && "$text" != *'('* ]];then
    printf '%s' "$text"
    return 0
  fi
  while [[ "$text" == *'\('* ]];do
    out+="${text%%'\('*}"
    text="${text#*'\('}"
    if [[ "$text" == *'\)'* ]];then
      mid="${text%%'\)'*}"
      text="${text#*'\)'}"
      out+="$(printf '%s' "$mid" | bai_latex_math)"
    else
      out+='\('
    fi
  done
  while [[ "$text" == *'$'* ]];do
    before="${text%%\$*}"
    out+="$before"
    text="${text#*\$}"
    if [[ "$text" == *'$'* ]];then
      mid="${text%%\$*}"
      text="${text#*\$}"
      if bai_latex_is_math "$mid";then
        out+="$(printf '%s' "$mid" | bai_latex_math)"
      else
        out+="\$$mid\$"
      fi
    else
      out+='$'"$text"
      text=""
    fi
  done
  out+="$text"
  printf '%s' "$out"
}

# 把公式编译成 PNG（latex + dvipng），成功时输出文件路径
# 用法: bai_latex_png <公式>
# 行为控制:
#       变量 BAI_LATEX_DPI, BAI_LATEX_CACHE
function bai_latex_png {
  local formula="$1" hash png work
  command -v latex >/dev/null 2>&1 && command -v dvipng >/dev/null 2>&1 || return 1
  if [ -z "${BAI_LATEX_CACHE:-}" ];then
    BAI_LATEX_CACHE="${TMPDIR:-/tmp}/.bai_latex_$$"
    mkdir -p "$BAI_LATEX_CACHE" 2>/dev/null
  fi
  hash=$(printf '%s' "$formula" | sha256sum | cut -d' ' -f1)
  png="$BAI_LATEX_CACHE/$hash.png"
  [ -s "$png" ] && { printf '%s' "$png"; return 0; }
  # 同一公式编译失败过就不再重试（避免每次多花 200ms）
  [ -e "$png.fail" ] && return 1
  work="$BAI_LATEX_CACHE/work_$hash"
  mkdir -p "$work" 2>/dev/null || return 1
  {
    printf '%s\n' '\documentclass[border=2pt,varwidth]{standalone}'
    printf '%s\n' '\usepackage{amsmath,amssymb,amsfonts}'
    printf '%s\n' '\usepackage{mathtools}'
    printf '%s\n' '\usepackage{bm}'
    printf '%s\n' '\begin{document}'
    printf '\\[%s\\]\n' "$formula"
    printf '%s\n' '\end{document}'
  } > "$work/formula.tex"
  ( cd "$work" && latex -interaction=nonstopmode -halt-on-error -output-format=dvi formula.tex >/dev/null 2>&1 ) || { : > "$png.fail"; return 1; }
  dvipng -D "${BAI_LATEX_DPI:-300}" -T tight -bg Transparent -o "$png" "$work/formula.dvi" >/dev/null 2>&1 || { : > "$png.fail"; return 1; }
  [ -s "$png" ] || { : > "$png.fail"; return 1; }
  printf '%s' "$png"
}

# 在终端里显示公式图片（chafa/catimg）
# 用法: bai_latex_show_png <png 路径>
function bai_latex_show_png {
  local png="$1" w h cols rows sz
  [ "${BAI_STDOUT_TTY:-false}" = "true" ] || [ -t 1 ] || return 1
  # 终端尺寸（行 列），拿不到就用 80x24
  sz=( $(stty size -F /dev/tty 2>/dev/null) )
  rows="${sz[0]:-24}"; cols="${sz[1]:-80}"
  [[ "$cols" =~ ^[0-9]+$ ]] && ((cols>20)) || cols=80
  [[ "$rows" =~ ^[0-9]+$ ]] && ((rows>10)) || rows=24
  # 宽度不超过终端 80%（最多 100 列），高度不超过终端一半，保持原比例
  w=$(( cols * 8 / 10 )); ((w>90)) && w=90; ((w<20)) && w=20
  # 公式图片只占几行：默认 6 行，可用 BAI_LATEX_IMG_ROWS 调整
  h="${BAI_LATEX_IMG_ROWS:-6}"
  [[ "$h" =~ ^[0-9]+$ ]] && ((h>=2)) || h=6
  ((h>rows-3)) && h=$((rows-3))
  if command -v chafa >/dev/null 2>&1;then
    # 先让 chafa 自动选择终端原生图片协议（sixel/kitty），再退回字符画
    chafa --size="${w}x${h}" --animate=off "$png" 2>/dev/null && return 0
    chafa --format=symbols --symbols=braille --size="${w}x${h}" --animate=off "$png" 2>/dev/null && return 0
  fi
  if command -v catimg >/dev/null 2>&1;then
    catimg -H "$h" "$png" && return 0
  fi
  return 1
}

# 渲染 $$...$$ 块（多行），加边框输出
# 用法: bai_latex_block <原始块内容> [带颜色]
function bai_latex_block {
  local raw="$1" color="${2:-false}" line __png
  # 默认方式：把区块公式编译成图片在终端显示
  if [[ "${BAI_LATEX_MODE:-unicode}" == "image" ]];then
    if __png="$(bai_latex_png "$raw")" && bai_latex_show_png "$__png";then
      return 0
    fi
  fi
  while [[ "$raw" == $'\n'* ]];do raw="${raw#$'\n'}";done
  while [[ "$raw" == *$'\n' ]];do raw="${raw%$'\n'}";done
  local prefix="  │ " border="  ┌─ math"
  if $color;then prefix="  ${c237}│${c0} "; border="  ${c237}┌─ math${c0}";fi
  printf '%s\n' "$border"
  while IFS= read -r line;do
    printf '%s%s\n' "$prefix" "$(printf '%s' "$line" | bai_latex_math)"
  done <<< "$raw"
  if $color;then printf '  ${c237}└─${c0}\n';else printf '  └─\n';fi
}

# 处理单行（含 $$ 块状态机）
# 用法: bai_latex_emit_line <单行文本> [颜色]
# 处理一行文本（围栏 / 块公式 / 行内公式）
# 用法: bai_latex_process_line <行> [颜色]
function bai_latex_process_line {
  local line="$1" color="${2:-false}" pre rest mid post dd='$$'
  local fre='^[[:space:]]*```'
  if [[ "$line" =~ $fre ]];then
    if [[ "$BAI_LATEX_FENCE" == "true" ]];then BAI_LATEX_FENCE=false;else BAI_LATEX_FENCE=true;fi
    printf '%s' "$line"
    return 0
  fi
  if [[ "$BAI_LATEX_FENCE" == "true" ]];then
    printf '%s' "$line"
    return 0
  fi
  # 图片模式下，整行只有一个行内公式时也按区块出图
  if [[ "${BAI_LATEX_MODE:-unicode}" == "image" ]];then
    local __only="$line" __body
    __only="${__only#"${__only%%[![:space:]]*}"}"
    __only="${__only%"${__only##*[![:space:]]}"}"
    if [[ "$__only" =~ ^\$[^$]+\$$ ]];then
      __body="${__only:1:${#__only}-2}"
      bai_latex_block "$__body" "$color"
      return 0
    fi
    if [[ "$__only" =~ ^\\\(.*\\\)$ ]];then
      __body="${__only:2:${#__only}-4}"
      bai_latex_block "$__body" "$color"
      return 0
    fi
  fi
  if $BAI_LATEX_BLOCK;then
    if [[ "$line" == *"$dd"* ]];then
      BAI_LATEX_MATHBUF+="${line%%"$dd"*}"
      bai_latex_block "$BAI_LATEX_MATHBUF" "$color"
      BAI_LATEX_MATHBUF=""
      BAI_LATEX_BLOCK=false
      rest="${line#*"$dd"}"
      [ -n "$rest" ] && bai_latex_line "$rest"
    else
      BAI_LATEX_MATHBUF+="$line"$'\n'
    fi
    return 0
  fi
  if [[ "$line" == *"$dd"* ]];then
    pre="${line%%"$dd"*}"
    rest="${line#*"$dd"}"
    if [[ "$rest" == *"$dd"* ]];then
      mid="${rest%%"$dd"*}"
      post="${rest#*"$dd"}"
      bai_latex_line "$pre"
      bai_latex_block "$mid" "$color"
      [ -n "$post" ] && bai_latex_line "$post"
    else
      bai_latex_line "$pre"
      BAI_LATEX_BLOCK=true
      BAI_LATEX_MATHBUF="$rest"$'\n'
    fi
    return 0
  fi
  bai_latex_line "$line"
}

# 判断一段文本是否有未闭合的行内公式（$...$ 或 \(...\)）
# 用法: bai_latex_line_pending <文本>
function bai_latex_line_pending {
  local s="$1" t d
  t="${s//\$\$/}"
  d="${t//[^$]/}"
  (( ${#d} % 2 == 1 )) && return 0
  if [[ "$s" == *'\('* && "$s" != *'\)'* ]];then return 0;fi
  return 1
}

# 流式/整段通用入口（按行拆分并保持 $$ 块状态）
# 用法: bai_latex_emit <文本> [颜色]
# 行为控制:
#       变量 BAI_LATEX_BLOCK, BAI_LATEX_MATHBUF, BAI_LATEX_PARTIAL, BAI_LATEX_FENCE
function bai_latex_emit {
  local text="$1" color="${2:-false}" nl=$'\n' line rest
  $BAI_LATEX_RENDER || { printf '%s' "$text"; return 0; }
  # 快速路径：没有公式/围栏/换行时直接透传
  if ! $BAI_LATEX_BLOCK && [ -z "${BAI_LATEX_PARTIAL:-}" ] \
     && [[ "$BAI_LATEX_FENCE" != "true" && "$text" != *'`'* && "$text" != *'$'* && "$text" != *'\('* && "$text" != *"$nl"* ]];then
    printf '%s' "$text"
    return 0
  fi
  if [ -n "${BAI_LATEX_PARTIAL:-}" ];then
    text="$BAI_LATEX_PARTIAL$text"
    BAI_LATEX_PARTIAL=""
  fi
  rest="$text"
  while [[ "$rest" == *"$nl"* ]];do
    line="${rest%%"$nl"*}"
    rest="${rest#*"$nl"}"
    bai_latex_process_line "$line" "$color"
    printf '%s' "$nl"
  done
  if [ -n "$rest" ];then
    # 以下情况需要等后续分片再处理，否则会把公式/围栏拆坏
    if $BAI_LATEX_BLOCK || [[ "$rest" == *'$$'* ]] || bai_latex_line_pending "$rest" || [[ "$rest" =~ ^[[:space:]]*@TICK@+$ ]];then
      BAI_LATEX_PARTIAL="$rest"
    else
      bai_latex_process_line "$rest" "$color"
    fi
  fi
  return 0
}

# 结束流时刷新残留缓冲
function bai_latex_flush {
  if [ -n "${BAI_LATEX_PARTIAL:-}" ];then
    bai_latex_process_line "$BAI_LATEX_PARTIAL" false
    BAI_LATEX_PARTIAL=""
  fi
  if $BAI_LATEX_BLOCK;then
    bai_latex_block "$BAI_LATEX_MATHBUF" false
    BAI_LATEX_BLOCK=false
    BAI_LATEX_MATHBUF=""
  fi
}

# 整段文本渲染（非流式用）
# 用法: bai_latex_text <文本>
function bai_latex_text {
  $BAI_LATEX_RENDER || { printf '%s' "$1"; return 0; }
  local sb="$BAI_LATEX_BLOCK" sm="$BAI_LATEX_MATHBUF" sp="$BAI_LATEX_PARTIAL" sf="$BAI_LATEX_FENCE"
  BAI_LATEX_BLOCK=false
  BAI_LATEX_MATHBUF=""
  BAI_LATEX_PARTIAL=""
  BAI_LATEX_FENCE=false
  bai_latex_emit "$1" false
  bai_latex_flush
  BAI_LATEX_BLOCK="$sb"
  BAI_LATEX_MATHBUF="$sm"
  BAI_LATEX_PARTIAL="$sp"
  BAI_LATEX_FENCE="$sf"
  return 0
}

