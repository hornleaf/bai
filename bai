function Get-Call-Tools {
  # printf "%s\n" "${__bai_function_tools[@]}" # 列出所有已注册的工具函数
  [ "$1" ] || return
  if ! [[ " ${__bai_function_tools[*]} " == *" $1 "* ]];then
    emsg "$(L10n-zh-Hans "set_temp_file_messages.tools_not_found 找不到工具函数 %s" "$1")"
    return
  fi
  "$function_head::$1" "${@:2}"
}

