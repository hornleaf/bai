# 切换模型
# 用法: Switch-Model <模型>
# 输入: <模型> 模型名称
function Switch-Model {
  local model=$1
  if [[ -z "$model" ]];then
    erron "$(L10n-zh-Hans "switch_model.model_unknown 请指定模型")"
    return 1
  fi
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "switch_model.switching_to_model 切换模型为 %s" "$model")"
  if [[ "$model" == "$(jq -r .model <<<"$data")" ]];then
    msg "$(L10n-zh-Hans "switch_model.already_using 重复的设置")"
    return 1
  fi
  if [[ " ${OPENAI_API_MODEL_in_array[*]} " == *" $model "* ]];then
    data="$(jq --arg model "$model" '.model = $model' <<<"$data")"
    old_data="$(jq --arg model "$model" '.model = $model' <<<"$old_data")"
    msg "$(L10n-zh-Hans "switch_model.switched_to_model 已切换为 %s" "$model")"
    return 0
  else
    erron "$(L10n-zh-Hans "switch_model.unknown_model 未知的模型 %s" "$model")"
    return 1
  fi
}

