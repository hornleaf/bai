# 打印 token 用量（chat 的 [DONE] 与 responses 的 response.completed 共用）
# 用法: bai_print_token_usage <含 usage 的响应 JSON>
function bai_token_human {
  gawk -v size="$1" -v mp=1000 '
    function human(x){
      if (x<mp) return sprintf("%d",x)
      else if (x<mp**2) return sprintf("%.2fK",x/mp)
      else return sprintf("%.2fM",x/(mp**2))
    }
    BEGIN {print human(size)}
  '
}

function bai_print_token_usage {
  $OPENAI_INCLUDE_USAGE || return 0
  local __tu_src="$1"
  jq -e '.usage | type == "object" and .total_tokens' <<<"$__tu_src" &>/dev/null || return 0
  LFR=false
  declare -A token_map=(
    [prompt_token]=".usage.prompt_tokens"
    [completion_token]=".usage.completion_tokens"
    [reasoning_token]=".usage.completion_tokens_details.reasoning_tokens"
    [total_token]=".usage.total_tokens"
    [hit_token]=".usage.prompt_cache_hit_tokens"
    [miss_token]=".usage.prompt_cache_miss_tokens"
  )
  for v in "${!token_map[@]}";do
    local ${v} ${v}s
  done
  for var in "${!token_map[@]}"; do
    local tokens_key="__${var}"
    [ "${!tokens_key}" ] || printf -v "$tokens_key" 0
    local value=$(jq -r "${token_map[$var]}" <<<"$__tu_src" 2>/dev/null)
    if [[ $? -eq 0 && -n "$value" && "$value" != "null" ]]; then
      printf -v "$var" "%s" "$value"
      printf -v "${var}s" "%s" "$(bai_token_human "$value")"
      let $tokens_key+=$value
      printf -v "${tokens_key}s" "%s" "$(bai_token_human "${!tokens_key}")"
    fi
  done
  echo
  local cache_hit_rate=$(gawk -v h=$((hit_token)) -v t=$((total_token)) 'BEGIN{printf("%.2f", h/t*100)}' 2>/dev/null)
  __usage_rate=$(gawk -v t=$((__total_token)) -v c=$((__model_cl)) 'BEGIN{printf("%.2f", t/c*100)}' 2>/dev/null)
  __cache_hit_rate=$(gawk -v h=$((__hit_token)) -v t=$((__total_token)) 'BEGIN{printf("%.2f", h/t*100)}' 2>/dev/null)
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.dialogue_data_report 本轮对话完成, 消耗 %s Tokens (输入: %s, 输出: %s), 缓存命中 %s Tokens, 缓存未命中 %s Tokens, 花费 %ss, 缓存命中率 %s%%" "$__total_token" "$__prompt_token" "$__completion_token" "$__hit_token" "$__miss_token" "$Get_AssistantTimer" "$__cache_hit_rate")"
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.dialogue_data_report_total 历史统计: 消耗 %s Tokens (输入: %s, 输出: %s), 缓存命中 %s Tokens, 缓存未命中 %s Tokens, 缓存命中率 %s%%" "$__total_tokens" "$__prompt_tokens" "$__completion_tokens" "$__hit_tokens" "$__miss_tokens" "$__cache_hit_rate")"
  return 0
}

