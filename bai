      ARG_KEY="$FILE_ARG" \
      Get-Arguments-Value "$@"
      RETURN=$?
      if [[ "$RETURN" =~ ^10([12])$ ]];then
        readarray -t __bai_add_l10n_files < <(tr ',' '\n' <<< "${!FILE_ARG}" | sed 's/^\s*//;s/\s*$//;')
        for file in "${__bai_add_l10n_files[@]}";do
          [ -f "$file" ] || exmsg "$arg1: $file: $(L10n-zh-Hans "option.add_l10n_file.file_not_exist 文件不存在")"
