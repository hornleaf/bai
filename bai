#       变量 DEBUG_MODE[1]*, CHAT[2]*
#       1* 调试模式
#       2* 连续对话返回
function Get-Stream-Assistant-Content {
  bai_api_require_supported || return 1
  # 流模式下的调试
  if $DEBUG_MODE;then
    echo -en " + POST: $OPENAI_BASE_URL\n"\
            "+ DATA: "
    jq -C <<< "$data"
    cat <<EOF
COMMAND:
"""
curl -sS -XPOST \\
  "$(bai_api_endpoint)" \\
  -H "$API_AUTH" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "$OPENAI_API_MODEL",
    "messages": [
      {
        "role": "user",
        "content": "$OPENAI_USER_PROMPT"
      }
    ]
  }'
"""
EOF
    API_RETURN="this a test message"
    if $INTERACT_MODE;then
      continue
    else
      exit
    fi
  fi

  # 构建流式接口请求
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.starting_stream_request 向此 BaseURL 发起 POST 请求: %s, 使用模型: %s, 使用流式响应" "$OPENAI_BASE_URL" "$OPENAI_API_MODEL")"
  debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.waiting_for_api_response 等待接口响应...")"
  Wait-Task wait "$(L10n-zh-Hans "set_temp_file_messages.waiting_for_assistant_response {{稍等片刻，BAI正在服务器烧烤}}")"
  STREAM_DATA=""
  STREAM_CONTENT=""
  REASONING_CONTENT=""
  STREAM_LINE=0
  REASONING_LINE=0
  TOOLS_IS_CALL=false
  TOOLS_CHECK_COUNT=0
  [ "$TOOLS_TRUN_COUNT" ] || TOOLS_TRUN_COUNT=0
  [ "$TOOLS_USE_COUNT" ] || TOOLS_USE_COUNT=0

  DEBUG_ORIGIN=""

  function_run_name=""
  function_name=""
  function_args=""
  function_call_msg=""
  function_return=""
  function_id=""
  # 串行工具调用：同一轮响应可能返回多个 tool_calls，
  # 按 index 分别累积 id / name / arguments，待响应结束后依次串行执行
  declare -gA __stream_tc_id=()
  declare -gA __stream_tc_name=()
  declare -gA __stream_tc_args=()
  __stream_tc_order=()
  mark_thinking=false
  mark_thinking_count=0
  
  __gar_error=""
  __gar_headers=""
  __http_response=""
  BAI_RESP_ERROR=""
  __resp_tc_args_seen=()

  # ── 代码块实时高亮状态机 ───────────────────────────────────────────────────
  # 拦截 content 流中的 ```围栏代码块```，缓冲，闭合时整块丢给 bat 高亮。
  # 围栏检测兼容跨 fragment 分裂的情况（如 `` + `ja = ```java）。
  # 关闭围栏要求行首（前有 $'\n'），防止代码内嵌 ``` 或 ```` 误触发。

  __hl_flush_code_block() {           # 将缓冲的代码体交给 bat 高亮输出
    local lang="${__hl_lang:-text}" code="${1-}"
    # 代码体已是展开后的真实文本，用 %s 原样输出
    local bat_options=(
      --style=plain
      --color=always
      --paging=never
      --theme=base16
      --number
    )
    local term_width="$(Get-TWidth)"  # 获取终端宽度
          term_width="$[term_width-3]"  # 留出边距
    bat_options+=("--terminal-width=${term_width}")  # 限制 bat 最大宽度，防止过宽导致的换行问题
    __hl_bat(){
      # 如果是不支持的语法则默认设为 text
      local syntax="${1,,}"
       (bat -L | grep -qiE "(:|,)${syntax}(,|$)" || bat -L | grep -qi "${syntax}.*:") || syntax="txt"
      [[ "$syntax" == "text" ]] && syntax="txt"
      # 设置背景色
      local bg_color="32;32;32"  # 默认灰色背景
      local title_color="8;8;8"  # 默认深灰色标题
      __hl_bat_setbg(){
        sed -r -e 's/\x1B]8;;(.*?)\x07(.*?)\x1B]8;;\x07/\2/g' -e 's/\t/    /g' -e "s/^/\x1B[48;2;${bg_color}m/" -e "s/$/\x1B[49m/" -e "s/\x1B\[0m/\x1B[0m\x1B[48;2;${bg_color}m/g"
      }
      local max_width="$(printf '%s\n' "$code" | bat --number --color=never --terminal-width=${term_width} 2>/dev/null | wc -L)"  # 提取无高亮的样本，准备计算最长行以渲染背景
      local lang_label="$(wc -L <<< "$lang")"  # 获取语言标签的长度
      local line_number="$(wc -l <<< "$code")"  # 获取代码行数
      # 渲染语言标签背景
      printf '\e[48;2;%sm%*s\e[2;37m%s \e[0m\n' "$title_color" "$[max_width-lang_label+2]" ' ' "$lang"
        printf '%s\n' "$code" | bat -l "$syntax" "${bat_options[@]}" 2>/dev/null | while IFS= read -r line;do
          printf '\e[48;2;%sm%*s\e[0m' "$bg_color" "$[max_width+3]" ' '  # 渲染背景
          printf '\r%s\n' "$line" | __hl_bat_setbg
        done
    }
    if $__has_extend_bat;then
      __hl_bat "$lang"
    else
      printf '%s\n' "$code"
    fi
  }

  __hl_state=0                        # 0=文本 1=提取语言标签 2=缓冲代码体
  BAI_LATEX_BLOCK=false
  BAI_LATEX_BUF=""
  BAI_LATEX_PARTIAL=""
  BAI_LATEX_LINEBUF=""
  __hl_hold=""                        # 待定行（尾部有反引号，可能为裂围栏前半段）
  __hl_block=""                       # 代码体缓冲（已展开的真实文本）
  __hl_tag=""                         # 语言标签缓冲
  __hl_lang="text"                    # 检测到的语言
  __hl_table=""                       # 表格行缓冲
  __hl_line_buf=""                    # 行组装缓冲（碎片拼成完整逻辑行）

  # 将 content 碎片组装为完整逻辑行后逐行喂入状态机。
  # SSE 流中的一个表格行可能被拆成多个 STREAM_MSG 碎片到达，
  # 因此先把碎片拼到遇到 \n 为止，形成完整行再交给状态机。
  __hl_feed() {
    local text="$1"
    [[ -z "$text" ]] && return

    # 无 bat 时直接透传，整个状态机旁路
    if ! $__has_extend_bat || ! $BAI_STREAM_SYNTAX;then
      # 快路径：本片既没有真实换行也没有字面 \n 时，直接拼接返回。
      # 旧实现每片都对不断增长的 LINEBUF 做一次 glob 匹配（*= *$'\n'*），
      # 缓冲越大越慢，三千个分片能吃掉 6s+；这里只看本片是否含换行。
      if [[ "$1" != *$'\n'* && "$1" != *'\n'* ]];then
        BAI_LATEX_LINEBUF+="$1"
        return
      fi
      text="${text//\\n/$'\n'}"
      BAI_LATEX_LINEBUF+="$text"
      local __ll_nl=$'\n' __ll_line
      local __ll_fre='^[[:space:]]*```'
      while [[ "$BAI_LATEX_LINEBUF" == *"$__ll_nl"* ]];do
        __ll_line="${BAI_LATEX_LINEBUF%%"$__ll_nl"*}"
        BAI_LATEX_LINEBUF="${BAI_LATEX_LINEBUF#*"$__ll_nl"}"
        if [[ "$__ll_line" =~ $__ll_fre ]];then
          if [[ "$BAI_LATEX_FENCE" == "true" ]];then BAI_LATEX_FENCE=false;else BAI_LATEX_FENCE=true;fi
          printf '%s' "$__ll_line"
        elif [[ "$BAI_LATEX_FENCE" == "true" ]];then
          printf '%s' "$__ll_line"
        else
          bai_latex_emit "$__ll_line" false
        fi
        printf '%s' "$__ll_nl"
      done
      return
    fi

    # 兼容不同 API 供应商：将字面 \n（两字符）展开为真实换行符（先做廉价判定，省掉每片 6 次替换）
    [[ "$text" == *'\n'* ]] && text="${text//\\n/$'\n'}"

    if [[ $__hl_state -eq 0 ]]; then
      # 从 state 1/2/3 切回 0 时，行缓冲可能残留半行，先拼上
      [[ -n "$__hl_line_buf" ]] && { text="$__hl_line_buf$text"; __hl_line_buf=""; }
      if [[ "$text" != *$'\n'* ]]; then
        # 无换行单片段：可能为表格/水平线开头则暂扣到 \n 再判，否则即时输出
        if [[ "$text" =~ ^[[:space:]]*([|│]|[┌├└┃┏┣┗]) ]]; then
          __hl_line_buf="$text"
        else
          __hl_process_line "$text"
        fi
      else
        # 含换行：拆行逐条喂入状态机
        local rest="$text" ln
        while [[ "$rest" == *$'\n'* ]]; do
          ln="${rest%%$'\n'*}"
          rest="${rest#*$'\n'}"
          __hl_process_line "$ln"$'\n'
        done
        [[ -n "$rest" ]] && __hl_process_line "$rest"
      fi
    else
      # States 1/2/3：缓冲到完整行再处理（代码块/表格需要整块渲染）
      __hl_line_buf+="$text"
      local ln
      while [[ "$__hl_line_buf" == *$'\n'* ]]; do
        ln="${__hl_line_buf%%$'\n'*}"
        __hl_line_buf="${__hl_line_buf#*$'\n'}"
        __hl_process_line "$ln"$'\n'
      done
    fi
  }

  # 状态机核心：逐行处理
  __hl_process_line() {
    local line="$1" chunk before after

    case $__hl_state in
      0)
        # 普通文本：直接输出，检测开围栏 ```
        chunk="$__hl_hold$line"
        __hl_hold=""

        if [[ "$chunk" == *'```'* ]];then
          before="${chunk%%'```'*}"
          after="${chunk#*'```'}"
          [[ -n "$before" ]] && bai_latex_emit "$before"
          __hl_state=1
          __hl_tag="$after"
        elif [[ "$chunk" =~ \`\`$ ]];then
          __hl_hold="$chunk"           # 尾有 2 反引号 → 持有待判
        elif [[ "$chunk" =~ \`$ ]];then
          __hl_hold="$chunk"           # 尾有 1 反引号 → 持有待判
        elif [[ "$chunk" =~ ^[[:space:]]*([-][[:space:]]*){3,}$ ]] || \
             [[ "$chunk" =~ ^[[:space:]]*([*][[:space:]]*){3,}$ ]] || \
             [[ "$chunk" =~ ^[[:space:]]*([_][[:space:]]*){3,}$ ]]; then
          # 注意：这里不要用 ( ... ) 包成子壳，否则每个分片一次 fork（约 1.5ms/片）
          local cols pad
          cols=$(Get-TWidth)
          printf -v pad '%*s' "${cols:-80}" ''
          printf '%s\n' "${pad// /─}"
        elif [[ "$chunk" =~ ^[[:space:]]*(\||│).*(\||│)[[:space:]]*$ ]] || \
             [[ "$chunk" =~ ^[[:space:]]*[┌├└┃┏┣┗] ]];then
          __hl_state=3                 # 检测到表格行（管道表或制表符表）→ 缓冲
          __hl_table="$chunk"          # chunk 已含行尾 \n
          Wait-Task wait "$(L10n-zh-Hans "set_temp_file_messages.table_rendering {{BAI正在制作表格}}")"
        elif [[ -n "$chunk" ]];then
          bai_latex_emit "$chunk"
        fi
        ;;

      1)
        # 提取语言标签：``` 到第一个 $'\n' 之间
        __hl_tag+="$line"
        if [[ "$__hl_tag" == *'```'* ]];then
          before="${__hl_tag%%'```'*}"
          after="${__hl_tag#*'```'}"
          if [[ "$before" == *$'\n'* ]];then
            __hl_lang="${before%%$'\n'*}"
            __hl_block="${before#*$'\n'}"
          else
            __hl_lang="$before"; __hl_block=""
          fi
          Wait-Task kill                     # 清除等待动画
          [[ -n "$__hl_block" ]] && __hl_flush_code_block "$__hl_block"
          [[ -n "$after" ]]     && printf '%s' "$after"
          __hl_state=0; __hl_tag=""; __hl_block=""; __hl_lang="text"
        elif [[ "$__hl_tag" == *$'\n'* ]];then
          __hl_lang="${__hl_tag%%$'\n'*}"
          __hl_block="${__hl_tag#*$'\n'}"
          [[ -z "$__hl_lang" ]] && __hl_lang="text"
          __hl_state=2; __hl_tag=""
          Wait-Task wait "$(L10n-zh-Hans "set_temp_file_messages.code_coloring {{BAI正在为代码上色}}")"                     # 显示缓冲等待提示
        fi
        ;;

      2)
        # 缓冲代码体：累积直到行首关闭围栏 ```
        chunk="$__hl_block$line"

        if [[ "$chunk" == *$'\n''```'* || "$chunk" == '```'* ]];then
          before="${chunk%%$'\n''```'*}"
          after="${chunk#*$'\n''```'}"
          [[ "$before" == "$chunk" ]] && { before=""; after="${chunk#'```'}"; }
          Wait-Task kill                     # 清除等待动画
          [[ -n "$before" ]] && __hl_flush_code_block "$before"
          [[ -n "$after" ]]  && printf '%s' "$after"
          __hl_state=0; __hl_block=""; __hl_lang="text"
        else
          __hl_block="$chunk"
        fi
        ;;

      3)
      # 缓冲表格：逐行收集直到非表格行
        if [[ "$line" =~ ^[[:space:]]*(\||│).*(\||│)[[:space:]]*$ ]] || \
           [[ "$line" =~ ^[[:space:]]*[┌├└│┃┏┣┗] ]];then
          __hl_table+="$line"            # 仍是表格行 → 继续缓冲（line 已含行尾 \n）
        else
          __hl_format_table "$__hl_table"  # 表格结束 → 格式化输出
          __hl_state=0; __hl_table=""
          __hl_process_line "$line"     # 重新处理当前行（属于普通文本）
        fi
        ;;
    esac
  }

  # 表格格式化
  __hl_format_table() {
    local table="$1"
    Wait-Task kill
    # 纯管道表（含 | 但不含 ─│）→ 直接渲染
    if [[ "$table" == *'|'* && "$table" != *[─│┌├└┐┤┘┬┴┼]* ]];then
      printf '%s' "$table" | Render-MDtable
      return
    fi

    # 制表符表 → │ 替换为 |，去掉边框行，重绘以修正列宽
    printf '%s' "$table" | sed 's/│/|/g' | grep -v '^[[:space:]]*[┌├└┐┤┘┬┴┼─]' | Render-MDtable
  }

  # 流结束时刷新各状态的残留缓冲
  __hl_flush_eof() {
    # State 1/2/3 行组装缓冲中的残留半行（state 0 不缓冲，无需清）
    if [[ $__hl_state -ne 0 && -n "$__hl_line_buf" ]];then
      __hl_process_line "$__hl_line_buf"
      __hl_line_buf=""
    fi
    # 再清各状态的残留缓冲
    case $__hl_state in
      2) Wait-Task kill; [[ -n "$__hl_block" ]] && __hl_flush_code_block "$__hl_block" ;;
      3) [[ -n "$__hl_table" ]] && __hl_format_table "$__hl_table" ;;
      1) [[ -n "$__hl_tag" ]]   && printf '%s' "$__hl_tag" ;;
      0) [[ -n "$__hl_hold" ]]  && printf '%s' "$__hl_hold" ;;
    esac
    if [ -n "${BAI_LATEX_LINEBUF:-}" ];then
      bai_latex_emit "$BAI_LATEX_LINEBUF" false
      BAI_LATEX_LINEBUF=""
    fi
    bai_latex_flush
  }
  # ── 高亮状态机结束 ─────────────────────────────────────────────────────────

  # 流式解析模式提示
  if $BAI_STREAM_SAFE;then
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.stream_safe_mode 流式处理使用旧版兼容模式")"
  fi

  # 开始计时
  Get-Timer Assistant
  Get-Timer ToolsCall

  # 流式处理接口数据
  Create-TempFile http_response_error
  Create-TempFile http_response_headers
  # 热路径常量：每个分片都要用到，提前算好（每分片省 3 次 $( ) fork）
  local _path _odata _data _key1="content" _key2="reasoning_content" _style_is_chat=true _ifile
  local _func='gsub("\\n"; "\\n")'
  _path="$(bai_api_delta_path)"
  [[ "$(bai_api_style)" == "chat" ]] || _style_is_chat=false
  _ifile="$(bai_interrupt_file)"
  while IFS= read -r line;do
    # 文件打断：每收到一个分片检查一次（直接 [ -e ]，不再 fork 子壳）
    if [[ "${BAI_INTERRUPT:-true}" == "true" && -e "$_ifile" ]];then
      BAI_INTERRUPTED=true
      rm -f "$_ifile" 2>/dev/null
      break
    fi
    # 如果是空行，则跳过，避免连续误判思考模式
    [ -z "$line" ] && continue
    # 上一个块的数据
    _odata="$_data"
    # 定义交换变量
    _data="${line#data: }"

    # Responses API：把语义事件翻译成 chat delta；非 data 行（event: 等）跳过
    if ! $_style_is_chat;then
      [[ "$line" == data:* ]] || continue
      bai_api_stream_translate "$_data"
      _data="$__ast_out"
      [ -n "$_data" ] || continue
      # response.completed 带 usage：打印 token 统计（--include-usage）
      [[ "$_data" == *'"usage"'* ]] && bai_print_token_usage "$_data"
    fi

    # 原始响应只用于「解析不出内容」时的兜底报错：用布尔标记判断（不要展开大字符串，
    # 展开 __http_response/STREAM_CONTENT 做 -n 测试，每分片都要复制几百 KB，三千分片能吃 6s+）
    if [ -z "$__http_have_content" ] && ((${#__http_response} < 131072));then
      __http_response+="$line"$'\n'
    fi

    if [[ "$_data" =~ ^\[DONE\] ]];then
      bai_print_token_usage "$_odata"
      Wait-Task kill
      continue
    fi
    # 原始增量只在调试图层需要，正常流程不再累积（省一次每分片的字符串拷贝）
    $DEBUG && STREAM_DATA+="$_data"$'\n'
    
    # 杀死半阻塞进程后将等待片刻，防止输出时被吞字
    ((STREAM_LINE)) || Wait-Task kill
    
    # 尝试分支响应类型(reasoning/normal)，并设置相应的前缀
    unset STREAM_HEAD REASONING_HEAD RT
    $INTERACT_MODE && ! ((STREAM_LINE)) && STREAM_HEAD="${c32}$ai_prompt${c0} " REASONING_HEAD="${c32}$thinking_prompt${c0} "

    # 检查是否具备思维链响应特征 + 提取流消息
    # 快速路径：普通分片用纯 Bash 解析，省掉每个分片 2~3 次 jq fork
    local is_reasoning=false
    local __sd_reasoning_ready=false
    if $BAI_STREAM_SAFE;then
      # 回退模式：完全按旧版逐字段 jq 解析，兼容性优先
      is_reasoning=$(jq --exit-status "$_path | (.[\"$_key2\"] // \"\") | length > 0" <<< "$_data" 2>/dev/null || echo false)
      STREAM_MSG="$(jq -r "$_path.$_key1 | $_func" <<< "$_data" 2>/dev/null)"
    elif [[ "$_data" == *'"tool_calls"'* ]];then
      # 工具分片通常不带正文，只有真的出现 content 键时才回退 jq，避免每片 2 次 fork
      if [[ "$_data" == *'"content"'* ]];then
        is_reasoning=$(jq --exit-status "$_path | (.[\"$_key2\"] // \"\") | length > 0" <<< "$_data" 2>/dev/null || echo false)
        STREAM_MSG="$(jq -r "$_path.$_key1 | $_func" <<< "$_data" 2>/dev/null)"
      else
        is_reasoning=false
        STREAM_MSG=""
      fi
    else
      # 正文与思维链必须分别提取：思考模式下正文分片往往仍带 reasoning_content
      # （值为 null 或空串），不能因为出现思维链字段就把正文丢掉
      if ! bai_stream_delta_text "$_data" "$_key1";then
        STREAM_MSG="$(jq -r "$_path.$_key1 | $_func" <<< "$_data" 2>/dev/null)"
      else
        STREAM_MSG="$__sd_text"
      fi
      if [[ "$_data" == *"\"$_key2\""* ]];then
        if bai_stream_delta_text "$_data" "$_key2";then
          STREAM_REASONING="$__sd_text"
        else
          STREAM_REASONING="$(jq -r "$_path.[\"$_key2\"] // empty | $_func" <<< "$_data" 2>/dev/null)"
        fi
        __sd_reasoning_ready=true
        # 空的 reasoning_content（null/""）不算思维链，否则会打印空白的“正在思考”前缀
        [ -n "$STREAM_REASONING" ] && is_reasoning=true || is_reasoning=false
      else
        is_reasoning=false
      fi
    fi

    # 拼接对话
    STREAM_CONTENT+="$STREAM_MSG"
    [ -n "$STREAM_MSG" ] && __http_have_content=1

    # 在此分支流模式
    if $is_reasoning;then # 思维链，可依 DeepSeek 响应格式

      # 拼接思维链和对话，并独立输出
      # tip: 思维链模式下的命令生成稳定性尚待验证
      if ! $mark_thinking;then
        Get-Timer Assistant
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.thinking_chain_response 流模式: 思维链, 响应耗时: %s, 继续等待..." "$Get_AssistantTimer")"
        Get-Timer Assistant
        mark_thinking=true # 标记是否思考过
      fi
      RT=""
      ((STREAM_LINE==0)) && RT+="\n"
      $__sd_reasoning_ready || STREAM_REASONING="$(jq -r "$_path.[\"$_key2\"] | $_func" <<< "$_data" 2>/dev/null)"
      ((REASONING_LINE==0)) && STREAM_REASONING="${STREAM_REASONING//'\n'/}"
      ((REASONING_LINE==0)) || unset REASONING_HEAD
      REASONING_CONTENT+="$STREAM_REASONING"
      [ -n "$STREAM_REASONING" ] && BAI_REASONING_SEEN=true
      
      # 适时插入前缀，去除开头多余的换行符
      if ((STREAM_LINE==0));then
        $INTERACT_MODE && RT+="${c32}$ai_prompt${c0} "
        STREAM_MSG="${STREAM_MSG//'\n'/}"
      fi
      
      if [ "$STREAM_MSG" ];then
        if ((STREAM_LINE==0));then
          if $DEBUG;then
            Get-Timer Assistant
            if ! $OPENAI_INCLUDE_USAGE;then
              _tokens=$(Estimate-Tokens-Int "$REASONING_CONTENT")
              echo
              debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.thinking_chain_tokens 思考耗时: %s, 大约输出了 %s Tokens" "$Get_AssistantTimer" "$_tokens")"
            fi
            Get-Timer Assistant
          fi
        else
          unset RT
        fi
        [[ -n "$RT" ]] && printf "%b" "$RT" && RT=""; __hl_feed "$STREAM_MSG"
      else
        [ -n "$STREAM_REASONING" ] && printf "%b" "$REASONING_HEAD$c237$STREAM_REASONING$c0"
        let REASONING_LINE++
        continue
      fi
    
    else # openai | 在此将尝试支持流模式下使用 function calling 功能
      # 检查是否使用了工具
      $TOOLS_IS_CALL || TOOLS_IS_CALL=false
      _local_toolcalls_path="${_path}.tool_calls"
      if $USE_TOOLS;then
        ((TOOLS_TRUN_COUNT)) || { $DEBUG && debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.checking_if_tools_used 检查是否使用了工具")"; }
        if $BAI_STREAM_SAFE;then
          RETURN_MSG="$(jq -e "(${_local_toolcalls_path} // []) | length > 0" <<< "$_data" 2>/dev/null)"
          STATUS=$?
        elif [[ "$_data" =~ \"tool_calls\"[[:space:]]*:[[:space:]]*\[[[:space:]]*\{ ]];then
          RETURN_MSG=true
          STATUS=0
        else
          RETURN_MSG=false
          STATUS=1
        fi
        ((TOOLS_TRUN_COUNT)) || { $DEBUG && debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.jq_check_status jq 检查时返回状态: %s" "$STATUS")"; }
        # 在第一轮确认调用时锁定工具调用状态
        if ! $TOOLS_IS_CALL;then
          if ((STATUS));then                              # 检查是否使用了工具
            ((TOOLS_TRUN_COUNT)) || { $DEBUG && debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.tools_not_used 模型还未使用工具")"; }
            TOOLS_IS_CALL=false                           # 未使用工具
            RETURN_MSG="$STREAM_MSG"
          else
            ((TOOLS_TRUN_COUNT)) || { $DEBUG && debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.tools_used 发现模型使用了工具")"; }
            TOOLS_IS_CALL=true                            # 使用了工具
            ((TOOLS_CHECK_COUNT++))                       # 锁定工具调用状态，避免冗余日志
            ((TOOLS_TRUN_COUNT++))                        # 锁定工具多轮调用状态，避免冗余日志
          fi
        fi
      else
        RETURN_MSG="$STREAM_MSG"
        TOOLS_IS_CALL=false
      fi
      ((TOOLS_TRUN_COUNT)) || { $DEBUG && debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.tools_call_status 工具调用状态: %s" "$TOOLS_IS_CALL")"; }
      if ! $TOOLS_IS_CALL && ((STATUS)) && [[ "$RETURN_MSG" == "null" ]];then
        erron "$(L10n-zh-Hans "set_temp_file_messages.exception_during_session_processing 处理本轮会话时发生异常")"
        unset RETURN_MSG
      fi
      if $TOOLS_IS_CALL;then
        ((TOOLS_CHECK_COUNT==1)) && { debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.building_tool_call 构建工具调用...")"; ((TOOLS_CHECK_COUNT++)); }
        # 累积本次增量中的全部工具调用片段，同一轮返回多个 tool_calls 时按 index 分别累积
        bai_accumulate_tool_call_delta "$_data"
        continue
      fi
      # 仅拼接对话并输出
      if ! ((STREAM_LINE));then
        if $DEBUG;then
          if $TOOLS_IS_CALL;then
            Get-Timer ToolsCall
            debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.tools_call_response 流模式: 工具调用, 响应耗时: %s" "$Get_ToolsCallTimer")"
            Get-Timer ToolsCall
          else
            Get-Timer Assistant
            debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.standard_openai_response 流模式: 标准 OpenAI 响应, 响应耗时: %s" "$Get_AssistantTimer")"
            [ "$DEBUG_ORIGIN" ] || DEBUG_ORIGIN=$DEBUG
            DEBUG=false
            Get-Timer Assistant
          fi
        fi
      fi
      # 处理部分供应商因机制差异可能导致的的消息错位
      $mark_thinking && mark_thinking=false && echo;[ "$STREAM_MSG" ] && printf "%b" "$STREAM_HEAD"; __hl_feed "$STREAM_MSG"
    fi
    [ "$STREAM_MSG" ] && let STREAM_LINE++
  done < <(Get-Assistant-Return;echo)
  # 缓存 HTTP 响应头和错误信息
  __gar_headers="$(cat "${BAI_TEMP_FILES["http_response_headers"]}")"
  __gar_error="$(cat "${BAI_TEMP_FILES["http_response_error"]}")"
  Remove-TempFile http_response_headers
  Remove-TempFile http_response_error
  __hl_flush_eof                       # 刷新代码块高亮状态机残留缓冲"
  bai_interrupt_trap_input

  # 接口显式返回失败/不完整：给出原因并结束本轮，避免只显示空白错误
  if [ -n "${BAI_RESP_ERROR:-}" ];then
    emsg "$(L10n-zh-Hans "responses.failed 响应失败: %s" "$BAI_RESP_ERROR")"
    bai_session_save
    $INTERACT_MODE || exit 1
    return 1
  fi

  if $BAI_INTERRUPTED;then
    Wait-Task kill
    STREAM_CONTENT+="$(L10n-zh-Hans "interrupt.suffix ｜[已打断]")"
    API_RETURN="${STREAM_CONTENT//'\n'/$'\n'}"
    API_STATUS=130
    erron "$(L10n-zh-Hans "interrupt.message 已按文件标记打断当前请求")"
    bai_session_save
    $INTERACT_MODE || exit 130
    return 130
  fi

  # 如果有返回消息、且末尾无换行符时，强制换行一次
  [ "$STREAM_CONTENT$REASONING_CONTENT" ] && { [[ "$STREAM_CONTENT" == *$'\n' ]] || ${LFR:-true} && echo ;}

  # 重置 debug 状态
  [ "$DEBUG_ORIGIN" ] && DEBUG=$DEBUG_ORIGIN

  # 处理工具调用
  Get-Stream-Assistant-ToolsCall || return 1

  function_run_name=""
  function_name=""
  function_args=""
  function_call_msg=""
  function_return=""
  function_id=""

  # 再次尝试杀死半阻塞进程
  Wait-Task kill

  # 处理最终返回
  # 如果仅有思维链但无对话内容，则直接 copy 思维链为最终返回内容
  [[ "$REASONING_CONTENT" && ! "$STREAM_CONTENT" ]] && STREAM_CONTENT="$REASONING_CONTENT"
  API_RETURN="${STREAM_CONTENT//'\n'/$'\n'}"
  if ! [ "$API_RETURN" ];then
    # printf "\e[1A\r\e[K"
    Get-ReturnError-Info
    # 4xx 属于客户端错误，重试不会成功：提示一次后结束本轮，避免反复请求刷屏
    if [[ "$__gar_headers" =~ HTTP/[0-9.]+[[:space:]]+4[0-9][0-9] ]];then
      emsg "请求被拒绝（HTTP 4xx），已停止本次自动重试；可用 /debug 查看请求体排查"
      bai_session_save
      $INTERACT_MODE || exit 1
      return 1
    fi
    # jq <<<"$data"
    # echo "$STREAM_DATA"
    return 114
  fi

  # 最终计时
  if ! ((TOOLS_USE_COUNT));then
    Get-Timer Assistant
    if [ "$Get_AssistantTimer" ];then
      if ! $OPENAI_INCLUDE_USAGE;then
        _return_tokens="$(Estimate-Tokens-Int "$STREAM_CONTENT")"
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_temp_file_messages.assistant_return_time 模型返回耗时: %s, 大约输出了 %s Tokens" "$Get_AssistantTimer" "$_return_tokens")"
      fi
      ((TOOLS_USE_COUNT++))
      unset TOOLS_TRUN_COUNT TOOLS_USE_COUNT
    fi
  fi
  # 无工具调用时，把本轮助手回复写入历史（否则连续对话会丢失模型自己的回答）
  if ! $INTERACT_MODE && ! $TOOLS_IS_CALL && [ -n "$API_RETURN" ];then
    local __as_file __as_msg
    if __as_file="$(bai_jq_rawfile "$API_RETURN")";then
      __as_msg="$(jq --rawfile c "$__as_file" '{role: "assistant", content: $c}' <<< '{}' 2>/dev/null)"
      rm -f "$__as_file"
      if [ -n "$REASONING_CONTENT" ];then
        if __as_file="$(bai_jq_rawfile "$REASONING_CONTENT")";then
          __as_msg="$(jq --rawfile c "$__as_file" '. += {reasoning_content: $c}' <<< "$__as_msg" 2>/dev/null)"
          rm -f "$__as_file"
        fi
      fi
      [ -n "$__as_msg" ] && bai_append_message "$__as_msg"
    fi
  fi

  bai_session_save
  $INTERACT_MODE || exit 0
}

# 累积流式响应中的工具调用增量
# 用法: bai_accumulate_tool_call_delta <响应片段>
# 选项:
#       <响应片段> 单条 SSE data 的 JSON 文本
# 行为控制:
#       变量 __stream_tc_id[], __stream_tc_name[], __stream_tc_args[], __stream_tc_order[]
#       按 tool_calls[].index 分别累积，以支持同一轮内的多个工具调用（串行执行）
# 将一条工具调用增量累加到全局状态
# 用法: bai_record_tool_delta <index> <id> <name> <arguments>
# 行为控制:
#       变量 __stream_tc_id[], __stream_tc_name[], __stream_tc_args[], __stream_tc_order[]
function bai_record_tool_delta {
  local _tc_idx="$1" _tc_id="$2" _tc_part_name="$3" _tc_part_args="$4"
  local _tc_prev_idx _tc_count
  if [[ ! "$_tc_idx" =~ ^[0-9]+$ ]];then
    # 部分供应商不返回 index：按 name / id 判断是否为新的调用，纯参数片段则追加到最后一个调用
    _tc_count=${#__stream_tc_order[@]}
    _tc_prev_idx="${__stream_tc_order[_tc_count-1]:-}"
    if [[ "$_tc_prev_idx" && -z "${__stream_tc_name[$_tc_prev_idx]}" && -z "${__stream_tc_args[$_tc_prev_idx]}" ]];then
      _tc_idx="$_tc_prev_idx"                 # 上一个调用只收到 id，仍属于同一个调用
    elif [[ "$_tc_part_name" || "$_tc_id" ]];then
      _tc_idx="${#__stream_tc_order[@]}"    # 出现了新的 name / id，视为新的调用
    else
      _tc_idx="${_tc_prev_idx:-0}"          # 纯参数片段
    fi
  fi
  [[ -n "$_tc_id" ]] && __stream_tc_id["$_tc_idx"]="$_tc_id"
  [[ -n "$_tc_part_name" ]] && __stream_tc_name["$_tc_idx"]="$_tc_part_name"
  [[ -n "$_tc_part_args" ]] && __stream_tc_args["$_tc_idx"]+="$_tc_part_args"
  [[ " ${__stream_tc_order[*]} " == *" $_tc_idx "* ]] || __stream_tc_order+=("$_tc_idx")
  return 0
}

# 旧版工具增量累积（逐字段 jq，兼容性优先，较慢）
# 用法: bai_accumulate_tool_call_delta_safe <增量 JSON>
function bai_accumulate_tool_call_delta_safe {
  local _data="$1"
  local _tc_len _tc_pos _tc_idx _tc_id _tc_part_name _tc_part_args
  _tc_len="$(jq -r "${_path}.tool_calls | length" <<< "$_data" 2>/dev/null)"
  [[ "$_tc_len" =~ ^[0-9]+$ ]] || _tc_len=0
  ((_tc_len)) || return 0
  for ((_tc_pos=0; _tc_pos<_tc_len; _tc_pos++));do
    _tc_idx="$(jq -r "${_path}.tool_calls[$_tc_pos].index // empty" <<< "$_data" 2>/dev/null)"
    _tc_id="$(jq -r "${_path}.tool_calls[$_tc_pos].id // empty" <<< "$_data" 2>/dev/null)"
    _tc_part_name="$(jq -r "${_path}.tool_calls[$_tc_pos].function.name // empty" <<< "$_data" 2>/dev/null)"
    _tc_part_args="$(jq -r "${_path}.tool_calls[$_tc_pos].function.arguments // empty" <<< "$_data" 2>/dev/null)"
    bai_record_tool_delta "$_tc_idx" "$_tc_id" "$_tc_part_name" "$_tc_part_args"
  done
  return 0
}

function bai_accumulate_tool_call_delta {
  # 回退模式：逐字段 jq，慢但语义最保守
  if $BAI_STREAM_SAFE;then
    bai_accumulate_tool_call_delta_safe "$1"
    return 0
  fi
  local _data="$1"
  local _tc_idx _tc_id _tc_part_name _tc_part_args
  local _fast=false

  # 快速路径：单元素增量（绝大多数情况）用纯 Bash 解析，避免每个分片 fork jq
  # 注意：这些正则必须放在单引号变量里，直接内联到 [[ =~ ]] 会被多剥一层反斜杠
  if [[ "$_data" == *'"tool_calls"'* ]];then
    local _no_idx="${_data//'"index"'/}"
    if (( ${#_data} - ${#_no_idx} == 7 ));then
      local _re_index='"index"[[:space:]]*:[[:space:]]*([0-9]+)'
      local _re_id='"id"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
      local _re_name='"name"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
      local _re_args='"arguments"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)"'
      if [[ "$_data" =~ $_re_index ]];then
        _tc_idx="${BASH_REMATCH[1]}"
        _tc_id=""; _tc_part_name=""; _tc_part_args=""
        _fast=true
        if [[ "$_data" =~ $_re_id ]];then
          bai_json_unescape "${BASH_REMATCH[1]}" _tc_id || _fast=false
        fi
        if $_fast && [[ "$_data" =~ $_re_name ]];then
          bai_json_unescape "${BASH_REMATCH[1]}" _tc_part_name || _fast=false
        fi
        if $_fast && [[ "$_data" =~ $_re_args ]];then
          bai_json_unescape "${BASH_REMATCH[1]}" _tc_part_args || _fast=false
        fi
      fi
    fi
  fi
  if $_fast;then
    bai_record_tool_delta "$_tc_idx" "$_tc_id" "$_tc_part_name" "$_tc_part_args"
    return 0
  fi

  # 慢速路径：一次 jq 取出本增量中所有工具调用字段（\x01 分隔字段、\x02 分隔记录）
  while IFS=$'\x01' read -r -d $'\x02' _tc_idx _tc_id _tc_part_name _tc_part_args;do
    bai_record_tool_delta "$_tc_idx" "$_tc_id" "$_tc_part_name" "$_tc_part_args"
  done < <(jq -j '.choices[0].delta.tool_calls[]? |
      (((.index // -1) | if . < 0 then "" else tostring end)) + "\u0001" +
      (.id // "") + "\u0001" +
      (.function.name // "") + "\u0001" +
      (.function.arguments // "") + "\u0002"' <<< "$_data" 2>/dev/null)
  return 0
}

# 处理模型工具调用
# 用法: Get-Stream-Assistant-ToolsCall
# 行为控制:
#       变量 TOOLS_IS_CALL, TOOLS_CHECK_COUNT, TOOLS_TRUN_COUNT, TOOLS_USE_COUNT
#       变量 __stream_tc_id[], __stream_tc_name[], __stream_tc_args[], __stream_tc_order[]
#       处理模型工具调用，同一轮返回多个工具时按 index 顺序串行执行
# 当前会话是否处于「思考模式」
# 用法: bai_thinking_active
# 返回值: 0 是 / 1 否
# 行为控制:
#       变量 BAI_REASONING_SEEN
#       会话里出现过非空思维链时置 true
#       变量 OPENAI_ENABLE_THINKING
#       enable 强制视为思考模式；disable 强制否
function bai_thinking_active {
  case "${OPENAI_ENABLE_THINKING:-default}" in
    disable) return 1 ;;
    enable)  return 0 ;;
  esac
  [[ "${BAI_REASONING_SEEN:-false}" == "true" ]] && return 0
  return 1
}

function Get-Stream-Assistant-ToolsCall {
  $TOOLS_IS_CALL || return 0

  # 整理待执行的工具调用列表（按 index 顺序串行）
  local -a __tc_order=()
  if ((${#__stream_tc_order[@]}));then
    __tc_order=("${__stream_tc_order[@]}")
  else
    __tc_order=(0)
  fi
  local __tc_total=${#__tc_order[@]}
  local __tc_pos __tc_index __tc_id __tc_run __tc_args_raw
  local -a __tc_ids=() __tc_runs=() __tc_args_list=()

  for ((__tc_pos=0; __tc_pos<__tc_total; __tc_pos++));do
    __tc_index="${__tc_order[__tc_pos]}"
    __tc_id="${__stream_tc_id[$__tc_index]:-}"
    __tc_run="${__stream_tc_name[$__tc_index]:-}"
    __tc_args_raw="${__stream_tc_args[$__tc_index]:-}"
    # 部分供应商不返回工具调用 id，此处补齐可用的调用标识
    [[ "$__tc_id" ]] || __tc_id="call_${__tc_pos}_$$_$(date +%s%N 2>/dev/null)"
    __tc_ids+=("$__tc_id")
    __tc_runs+=("$__tc_run")
    __tc_args_list+=("$__tc_args_raw")
  done

  # 构建工具调用消息（同一轮内的全部调用放在同一条 assistant 消息中）
  # 参数与内容经临时文件传给 jq，避免超长参数触发 "参数列表过长" 而静默清空请求体
  local __tc_json='[]' __tc_args_file __tc_json_file __tc_text_file __append_error
  __append_error="$(L10n-zh-Hans "set_temp_file_messages.message_append_failed 会话消息写入失败")"
  for ((__tc_pos=0; __tc_pos<__tc_total; __tc_pos++));do
    __tc_args_file="$(bai_jq_rawfile "${__tc_args_list[__tc_pos]}")" || { emsg "$__append_error"; return 1; }
    __tc_json="$(jq --arg id "${__tc_ids[__tc_pos]}" \
                   --arg name "${__tc_runs[__tc_pos]}" \
                   --rawfile args "$__tc_args_file" \
                   --argjson index "$__tc_pos" \
                   '. += [{index: $index, id: $id, type: "function", function: {name: $name, arguments: $args}}]' \
                   <<< "$__tc_json" 2>/dev/null)"
    rm -f "$__tc_args_file"
  done
  __tc_json_file="$(bai_jq_rawfile "$__tc_json")" || { emsg "$__append_error"; return 1; }
  function_call_msg="$(jq --rawfile tool_calls "$__tc_json_file" '{content: "", role: "assistant", tool_calls: ($tool_calls | fromjson)}' <<< '{}' 2>/dev/null)"
  rm -f "$__tc_json_file"
  # 根据 DeepSeek 官方文档，如果是在思考时调用工具，也应该要回传思维链内容，避免后续缺失思维链导致接口返回 400 状态错误
  # 参考文档：https://api-docs.deepseek.com/zh-cn/guides/thinking_mode#输入输出参数
  if [ "$REASONING_CONTENT" ];then
    __tc_text_file="$(bai_jq_rawfile "$REASONING_CONTENT")" || { emsg "$__append_error"; return 1; }
    function_call_msg="$(jq --rawfile content "$__tc_text_file" '. += {"reasoning_content": $content}' <<< "$function_call_msg" 2>/dev/null)"
    rm -f "$__tc_text_file"
  fi
  # 保存本轮助手消息：正文 + 思维链 + 工具调用合并成同一条 assistant 消息。
  # DeepSeek 思考模式要求：带 tool_calls 的 assistant 消息必须回传 reasoning_content；
  # 拆成两条（一条空正文、一条 tool_calls）既会产生连续 assistant 消息，也容易触发 400。
  local msg='{"role": "assistant", "content": ""}'
  if [ "$STREAM_CONTENT" ];then
    __tc_text_file="$(bai_jq_rawfile "$STREAM_CONTENT")" || { emsg "$__append_error"; return 1; }
    msg="$(jq --rawfile content "$__tc_text_file" '. += {"content": $content}' <<< "$msg" 2>/dev/null)"
    rm -f "$__tc_text_file"
  fi
  if [ "$REASONING_CONTENT" ];then
    __tc_text_file="$(bai_jq_rawfile "$REASONING_CONTENT")" || { emsg "$__append_error"; return 1; }
    msg="$(jq --rawfile content "$__tc_text_file" '. += {"reasoning_content": $content}' <<< "$msg" 2>/dev/null)"
    rm -f "$__tc_text_file"
  elif bai_thinking_active;then
    # 本轮模型没有输出思维链（直接调工具），但接口处于思考模式时仍必须回传该字段，
    # 否则下一轮 400：The reasoning_content in the thinking mode must be passed back to the API.（空串实测可接受）
    msg="$(jq '. += {"reasoning_content": ""}' <<< "$msg" 2>/dev/null)"
  fi
  __tc_json_file="$(bai_jq_rawfile "$__tc_json")" || { emsg "$__append_error"; return 1; }
  msg="$(jq --rawfile tc "$__tc_json_file" '. += {"tool_calls": ($tc | fromjson)}' <<< "$msg" 2>/dev/null)"
  rm -f "$__tc_json_file"
  bai_append_message "$msg" || { emsg "$__append_error"; return 1; }

  # 依次串行执行全部工具调用，每次执行后立即追加对应的 tool 结果消息
  for ((__tc_pos=0; __tc_pos<__tc_total; __tc_pos++));do
    # 文件打断：跳过剩余工具调用
    if bai_interrupt_check;then
      BAI_INTERRUPTED=true
      erron "$(L10n-zh-Hans "interrupt.tools_skipped 已按文件标记打断，跳过剩余 %s 个工具调用" "$((__tc_total-__tc_pos))")"
      break
    fi
    function_id="${__tc_ids[__tc_pos]}"
    function_run_name="${__tc_runs[__tc_pos]}"
    function_args_raw="${__tc_args_list[__tc_pos]}"
    function_args="$function_args_raw"
    function_name="$function_head::$function_run_name"
    bai_expand_tool_args "$function_run_name" "$function_args_raw"
    explicitly="${gco_explicitly[$function_name]}"
    catch_stderr="${gco_getstderr[$function_name]}"
    if [[ "$explicitly" != "silence" ]];then
      local term_width="$(Get-TWidth)"
      if ((__tc_total>1));then
        echo -e " ${c35}┏${c0} $(L10n-zh-Hans "set_temp_file_messages.tool_calling_multiple 工具调用中 (%s/%s)" "$((__tc_pos+1))" "$__tc_total")..."
      else
        echo -e " ${c35}┏${c0} $(L10n-zh-Hans "set_temp_file_messages.tool_calling 工具调用中")..."
      fi
      echo -en " ${c35}┃${c0} ${c34}❯${c0} "
      local execute_title="call: $function_run_name$([[ "$function_args" =~ ^(\{\})+$ ]] || echo ", arg: $function_args")"
      output_width=$(($(wc -L <<<"$execute_title")+26))
      if (((term_width-28)<output_width));then
        bai_wrap_cjk $((term_width-28)) <<< "$execute_title" | head -2 | sed '2s/.*/.../' | sed ':a;N;$!ba;s/\n//g'
      else
        echo "$execute_title"
      fi
    fi
    if ! bai_permission_gate "$function_run_name" "$function_args_raw";then
      function_return="$(L10n-zh-Hans "permission.user_reject [权限] 工具 %s 未获用户授权，已跳过执行。" "$function_run_name")"
      RETURN=1
      bai_append_tool_message "$function_id" "$function_return" || { emsg "$__append_error"; return 1; }
      continue
    fi
    Get-Command-Output "$function_name $BAI_TOOL_EXPANDED_ARGS"
    function_return="$gco_return_content"
    RETURN=$gco_status
    ((RETURN)) && { emsg "$(L10n-zh-Hans "set_temp_file_messages.tools_execution_failed 工具执行失败")";}
    bai_append_tool_message "$function_id" "$function_return" || { emsg "$__append_error"; return 1; }
  done

  # 工具执行完、发起下一轮请求前，把 send_image 排队的图片作为 user 消息补上
  bai_flush_pending_images

  Get-Stream-Assistant-Content
  [[ $? == 114 ]] && return
  if ((STATUS)) && [[ "$RETURN_MSG" == "null" ]];then
    erron "$(L10n-zh-Hans "set_temp_file_messages.request_not_accepted 该次请求未正确被接受")"
    unset RETURN_MSG
  fi
}

# 以临时文件向 jq 传递长字符串
# 用法: bai_jq_rawfile <内容>
# 输出: 临时文件路径
# 说明: 单个 argv 参数有长度上限（MAX_ARG_STRLEN，约 128KB），
#       超长内容直接作为 jq --arg 的参数会触发 "参数列表过长" 并使 jq 失败，
#       进而静默清空请求体
function bai_jq_rawfile {
  local content="$1" file
  file="$(mktemp "${TMPDIR:-/tmp}/.bai_jq_arg.XXXXXX" 2>/dev/null)" || return 1
  if ! printf '%s' "$content" > "$file";then
    rm -f "$file"
    return 1
  fi
  printf '%s' "$file"
}

# 安全地向请求体追加一条 JSON 消息
# 用法: bai_append_message <消息JSON>
# 行为控制:
#       变量 data
#       成功时更新 data，失败时保持 data 不变并返回非零
function bai_append_message {
  local message="$1" file new_data status
  file="$(bai_jq_rawfile "$message")" || return 1
  new_data="$(jq --rawfile message "$file" '.messages += [$message | fromjson]' <<< "$data" 2>/dev/null)"
  status=$?
  rm -f "$file"
  if ((status)) || [ -z "$new_data" ];then
    return 1
  fi
  data="$new_data"
}

# 安全地向请求体追加一条 tool 结果消息
# 用法: bai_append_tool_message <tool_call_id> <内容>
function bai_append_tool_message {
  local id="$1" content="$2" file message status
  # 工具输出过大时保留头尾，全文落盘供模型分片查看
  local limit="${BAI_TOOL_OUTPUT_LIMIT:-0}"
  if [[ "$limit" =~ ^[0-9]+$ ]] && ((limit>0)) && ((${#content} > limit));then
    local head tail omitted saved
    if [ -z "${BAI_TOOLOUT_DIR:-}" ];then
      BAI_TOOLOUT_DIR="${TMPDIR:-/tmp}/.bai_toolout_$$"
      mkdir -p "$BAI_TOOLOUT_DIR" 2>/dev/null
    fi
    saved="$BAI_TOOLOUT_DIR/$(printf '%s' "$id" | tr -c 'A-Za-z0-9._-' '_').txt"
    printf '%s' "$content" > "$saved" 2>/dev/null
    head=$(( limit * 7 / 10 ))
    tail=$(( limit - head ))
    omitted=$(( ${#content} - head - tail ))
    content="${content:0:head}"$'\n'"$(L10n-zh-Hans "tools.message_prompt …[已省略 %s 字符，完整输出见 %s（可用 sed -n 起,止p 分片查看）]…" "$omitted" "$saved")"$'\n'"${content: -tail}"
  fi
  file="$(bai_jq_rawfile "$content")" || return 1
  message="$(jq -n --arg id "$id" --rawfile content "$file" '{role: "tool", content: $content, tool_call_id: $id}' 2>/dev/null)"
  status=$?
  rm -f "$file"
  ((status)) && return 1
  bai_append_message "$message"
}

########################################################################

# 按工具定义的 arg_alias 将 JSON 参数展开为命令行选项
# 有 arg_alias 时：JSON key → 命令行选项，值追加在后面
# 无 arg_alias 时：退回旧行为（按 JSON 值展开、换行拼空格）
function bai_expand_tool_args {
  local tool_name="$1" args="$2"
  BAI_TOOL_JSON="$args"
  BAI_TOOL_EXPANDED_ARGS=""

  local alias_json="${bai_tool_argalias[$tool_name]:-}"

  if [[ -z "$alias_json" ]]; then
    # 无别名表：完全复刻原有逻辑
    if jq -e '.[]' <<< "$args" &>/dev/null; then
      # @sh 对每个值做 shell 转义，避免空格/括号/引号在 eval 时被拆开
      # 注意：不能用 tr 把换行压成空格——@sh 会保留字符串里的字面换行，
      # 压平会毁掉 heredoc / 多行脚本。这里用 -j 逐项输出，仅去掉项间换行。
      BAI_TOOL_EXPANDED_ARGS="$(jq -j '.[] | @sh + " "' <<< "$args")"
      BAI_TOOL_EXPANDED_ARGS="${BAI_TOOL_EXPANDED_ARGS% }"
    else
      BAI_TOOL_EXPANDED_ARGS="$args"
    fi
    return 0
  fi

  # 有别名表：按定义顺序展开
  local key opt raw
  while IFS=$'\t' read -r key opt; do
    [[ -z "$key" || -z "$opt" ]] && continue
    raw="$(jq -r --arg k "$key" '
      if type == "object" and has($k) then
        .[$k] | if type == "string" then .
                elif type == "boolean" then tostring
                elif type == "number" then tostring
                else tostring end
      else empty end
    ' <<< "$args" 2>/dev/null)"
    [[ -z "$raw" ]] && continue
    case "$opt" in
      *!)
        [[ "$raw" == "true" ]] || continue
        BAI_TOOL_EXPANDED_ARGS+=" $(printf '%q' "${opt%!}")"
        ;;
      *=)
        BAI_TOOL_EXPANDED_ARGS+=" $(printf '%q' "${opt%=}=$raw")"
        ;;
      *)
        BAI_TOOL_EXPANDED_ARGS+=" $(printf '%q' "$opt") $(printf '%q' "$raw")"
        ;;
    esac
  done < <(jq -r 'to_entries[] | "\(.key)\t\(.value)"' <<< "$alias_json")

  BAI_TOOL_EXPANDED_ARGS="${BAI_TOOL_EXPANDED_ARGS# }"
  return 0
}

