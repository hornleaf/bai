# 探测 latex 是否真能编译公式（结果按 latex/dvipng 版本缓存；失败则降级）
# 用法: bai_latex_probe
function bai_latex_probe {
  local cache dir key rc
  [ "${BAI_LATEX_PROBE:-true}" = "true" ] || return 0
  cache="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/bai"
  mkdir -p "$cache" 2>/dev/null || return 1
  key="probe-v1-$( { latex --version 2>/dev/null | head -1; dvipng --version 2>/dev/null | head -1; } | sha256sum | cut -c1-16)"
  [ -f "$cache/$key.ok" ] && return 0
  [ -f "$cache/$key.fail" ] && return 1
  dir=$(mktemp -d "${TMPDIR:-/tmp}/bai-latex-probe.XXXXXX") || return 1
  {
    printf '%s\n' '\documentclass[border=2pt,varwidth]{standalone}'
    printf '%s\n' '\usepackage{amsmath,amssymb,amsfonts}'
    printf '%s\n' '\usepackage{mathtools}'
    printf '%s\n' '\usepackage{bm}'
    printf '%s\n' '\begin{document}'
    printf '%s\n' '\[ x^2+y^2=z^2 \]'
    printf '%s\n' '\end{document}'
  } > "$dir/probe.tex"
  if ( cd "$dir" && latex -interaction=nonstopmode -halt-on-error -output-format=dvi probe.tex >/dev/null 2>&1 \
       && dvipng -D 150 -T tight -bg Transparent -o probe.png probe.dvi >/dev/null 2>&1 && [ -s probe.png ] );then
    : > "$cache/$key.ok"
    rc=0
  else
    : > "$cache/$key.fail"
    rc=1
  fi
  rm -rf "$dir"
  return "$rc"
}

