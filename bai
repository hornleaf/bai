# 交互式补全
# 用法: alias=[命令别名] cmd=[命令] argc_[上一选项]=选项1,选项2.. Interactive-Completion 选项1 选项2..
function Interactive-Completion {
  if ! $BAI_INTERACT_COMPLE; then
    "$@"
    return
  fi
  local arg argc argv args argp valuep valuename valuedesc value desc dict dictf dictd choose mode input i
  args=(${alias:=$cmd})
  argv=0
  while true;do
    valuename=argc_${args[-1]//-/_}
    valuedesc=${valuename}_desc
    argc="${!valuename}"
    argc_desc="${!valuedesc}"
    [[ "$argc" ]] || { $cmd "${args[@]:1}"; return; }
    dict=(${argc//,/ })
    dictf=(${dict[@]})
    dictd=()
    readarray -t desc <<<"$(awk 'NF' <<<"$argc_desc")"
    for ((i=0;i<${#dict[@]};i++));do
      if [[ "${dict[i]}" =~ ^.\:(.+)$ ]];then
        dictf[i]="${BASH_REMATCH[1]}"
      fi
      dictd[i]="${dictf[i]}|${desc[i]}"
    done
    choose=$(
      enable_backspace=true Dialog-Select "${args[*]}" \
      "${dictd[@]}"
    )
    case $choose in
    exit) return;;
    backspace)
      if ((${#args[@]} > 1));then
        unset args[-1]
        args=(${args[@]})
        ((argv--))
      fi
      ;;
    [0-9]*)
      arg="${dict[choose]}"
      if [[ "$arg" == i:* ]];then
        arg="${dictf[choose]}"
        mode=input
      elif [[ "$arg" == n:* ]];then
        arg="${dictf[choose]}"
        mode=number
      elif [[ "$arg" == b:* ]];then
        arg="${dictf[choose]}"
        mode=bool
      else
        mode=default
      fi
      args+=("$arg")
      ((argv++))
      if [[ ! "$mode" == default ]];then
        case $mode in
          input)
            value="$(Dialog-Input "${args[*]}")"
            case $value in
              exit)
                unset args[-1]
                args=(${args[@]})
                ((argv--))
                continue
                ;;
              *) input=$value;;
            esac
            ;;
          number)
            value="$(Dialog-Range "${args[*]}" 0 256)"
            case $value in
              exit)
                unset args[-1]
                args=(${args[@]})
                ((argv--))
                continue
                ;;
              [0-9]*) input=$value;;
            esac
            ;;
          bool)
            value="$(yes=true no=false notip=true Dialog-Confirm "${args[*]}")"
            case $value in
              yes) input=true;;
              no)  input=false;;
              exit)
                unset args[-1]
                args=(${args[@]})
                ((argv--))
                continue
                ;;
            esac
            ;;
        esac
        args+=("$input")
        ((argv++))
      fi
      ;;
    esac
  done
}

