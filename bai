# 纯 Bash 实现的 Token 估算函数，毫无准确度可言，只是看个乐
Estimate-Tokens-Int() {
  local text="$1"
  local en_chars=0
  local zh_chars=0
  # 统计英文字符
  en_chars=$(echo "$text" | grep -o '[A-Za-z0-9[:punct:][:space:]]' | wc -l)
  # 统计中文字符
  zh_chars=$(echo "$text" | LC_ALL=C.UTF-8 grep -Po '[\x{4e00}-\x{9fff}]' | wc -l)
  # 使用整数运算: token = (en_chars*3 + zh_chars*6 + 5) / 10
  # 0.3 = 3/10, 0.6 = 6/10，加5实现四舍五入
  local tokens=$(( (en_chars * 3 + zh_chars * 6 + 5) / 10 ))
  echo "$tokens"
}


