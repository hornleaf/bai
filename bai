# 本地化语言模块

# 私有存储
declare -gA __loc_map
declare -ga __loc_import_map=("zh_CN")
declare -ga __loc_file_map

# 获取本地化字符串
# 用法: Get-String <消息> [参数...]
# 行为控制：
#     变量 BAI_LOCATE_PERFORMANCE_MODE
#       为 true 时（默认），将启用性能模式，仅忽略语言标签，直接返回纯消息
#       为 false 时，启用完整的本地化功能，将解析语言标签、键名，并根据环境变量 LANG 获取对应的本地化字符串
#     参数[0]: 带本地化语言标识和键的格式化字符串
#       格式: @[lang].key 消息文本
#       lang: 语言标签，格式为 xx_XX，如 zh_CN, en_US
#       key: 可选的键名，用于存储和检索本地化字符串，若未指定，则使用纯消息文本作为键名
#     参数[1...N]: 可选的格式化参数，使用 printf 风格的格式化字符串
function Get-String {
    # 在非调试模式下，若处于调试消息 (DEBUG_MESSAGE=true)，则不工作，避免消息性能下降
    if [[ "${DEBUG:-false}" == "false" ]];then
      if [[ "${DEBUG_MESSAGE:-false}" == "true" ]];then
        return
      fi
    fi
    # 添加性能模式（默认开启），仅忽略语言标签，直接返回纯消息
    if [[ "${BAI_LOCATE_PERFORMANCE_MODE:-true}" == "true" ]];then
        # 使用内置正则表达式快速提取纯消息，避免使用外部工具导致性能大幅下降
        [[ "$1" =~ ^@\[[a-z]{2}_[A-Z]{2}\](\.([a-zA-Z0-9_.-]+))?' '*(.*)$ ]]
        printf "${BASH_REMATCH[3]}" "${@:2}"
        return
    fi

    local default="zh_CN"
    local env_lang="${LANG%%.*}"
    [[ -z "$env_lang" ]] && env_lang="$default"
    
    local msg="$1" lang="$default" key="" pure=""
    shift
    
    # 解析 @[lang].key
    [[ "$msg" =~ @\[([a-z]{2}_[A-Z]{2})\](\.([a-zA-Z0-9_.-]+))? ]] && {
        lang="${BASH_REMATCH[1]}"
        key="${BASH_REMATCH[3]}"
    }
    
    # 提取纯消息
    pure="${msg#* ]}"                    # 删除 @[lang].key 部分
    pure="${pure#* }"                    # 删除 ] 后的第一个空格
    # 如果上面正则没匹配到，pure 就是原字符串，需要处理无标签的情况
    if [[ "$pure" == "$msg" ]];then
        pure="$msg"
    fi
    [[ -z "$key" ]] && key="$pure"
    
    # 存储
    local map_key="$lang.$key"
    [[ -z "${__loc_map[$map_key]}" ]] && __loc_map[$map_key]="$pure"
    
    # 获取最终字符串
    local result="${__loc_map[$env_lang.$key]:-${__loc_map[$default.$key]:-$pure}}"
    
    # 使用 printf 格式化
    if [[ $# -gt 0 ]];then
        printf "$result" "$@"
    else
        printf "$result"
    fi
}

