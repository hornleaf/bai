# 检查文件类型
# 用法: Check-File-Type <文件路径>
# 输入: <文件路径> 要检查的文件路径
# 行为控制:
#       变量 check_file_type
#       存储目标文件的大致类型
# * 作为条件组件使用时，返回值为 0 时为真，1 为假
function Check-File-Type {
  local typeof="$(file -b "${1:--}" 2>/dev/null)"
  local check
  check_file_type=""
  [[ "$typeof" =~ ^(.+UTF-8.+|ASCII text|JSON text data)$ ]]
  case "$typeof" in
  *UTF-8*|ASCII*|*text*)
    check_file_type=text
    check=true
    ;;
  *image*)
    check_file_type=image
    check=true
    ;;
  *)
    check_file_type=unknown
    check=false
    ;;
  esac
  $check
}

# 判断变量类型
# 用法: Check-Variable-Type <变量名>
# 输入: <变量名> 要检查的变量名
# 输出: 变量类型
# 类型:
#       zero 空变量
#       array 数组
#       number 数值
#       url 链接
#       boolean 布尔值
#       option 选项参数
#       string 字符串
#       unknown 未知类型
function Check-Variable-Type {
  if [ -z "${!1}" ];then
    echo "zero"      # 空变量
  elif declare -p "$1" 2>/dev/null | grep -q 'declare -a';then
    echo "array"     # 数组
  elif [[ "${!1}" =~ ^-?[0-9,]+(\.[0-9,]+)?([kmgtpy])?$ ]];then   
    echo "number"    # 数值
  # elif [[ "${!1}" =~ ^([Vv])?[0-9a-zA-Z_-]+(\.[0-9a-zA-Z_-]+)?$ ]];then
  #   echo "version"   # 版本号，这可能与其他类型冲突，将合并至字符串类型
  elif [[ "${!1}" =~ ^https?://[0-9a-zA-Z./?=\&%-_]+$ ]];then
    echo "url"       # 链接
  elif [[ "${!1,,}" =~ ^(fals|tru)e$ ]];then
    echo "boolean"   # 布尔值
  elif [[ "${!1}" =~ ^-{1,2}[0-9a-zA-Z_-]+$ ]];then
    echo "option"    # 选项参数
  elif [[ "${!1}" =~ ^.+$ ]];then
    echo "string"    # 字符串
  else
    echo "unknown"   # 未知类型
  fi
}

########################################################################

function Print-ColorFull {
  local freq="${LOL_FREQ:-0.1}"
  local spread="${LOL_SPREAD:-3.0}"
  awk -v freq="$freq" -v spread="$spread" -v frame="$1" '
      BEGIN { pi = atan2(0, -1); }
      function rainbow(idx) {
        r = int(sin(freq * idx) * 127 + 128);
        g = int(sin(freq * idx + 2*pi/3) * 127 + 128);
        b = int(sin(freq * idx + 4*pi/3) * 127 + 128);
        return sprintf("\033[38;2;%d;%d;%dm", r, g, b);
      }
      {
        out = "";
        in_marker = 0;
        len = length($0);
        for (i = 1; i <= len; ) {
          # 检测并跳过已有的 ANSI 转义序列（例如 \033[...m）
          if (substr($0, i, 1) == "\033" && substr($0, i+1, 1) == "[") {
            # 查找匹配的 'm' 结尾
            start = i;
            while (i <= len && substr($0, i, 1) != "m") i++;
            if (i <= len) i++;  # 包含 'm'
            seq = substr($0, start, i - start);
            out = out seq;      # 原样保留颜色序列
            continue;
          }
          # 检测开始标记 {{
          if (!in_marker && substr($0, i, 2) == "{{") {
            in_marker = 1;
            i += 2;
            continue;
          }
          # 检测结束标记 }}
          if (in_marker && substr($0, i, 2) == "}}") {
            in_marker = 0;
            # 结束标记后立即重置颜色，避免溢出
            out = out "\033[0m";
            i += 2;
            continue;
          }
          ch = substr($0, i, 1);
          if (in_marker) {
            # 标记内的字符动态上色
            idx = (NR + frame / spread) + (i / spread);
            out = out rainbow(idx) ch;
          } else {
            # 普通字符：输出重置 + 字符，确保默认颜色
            out = out ch;
          }
          i++;
        }
        # 行末添加重置，防止影响后续行（可选）
        printf "%s\033[0m\n", out;
      }
    '
}

