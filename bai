# 限制用户对话轮次
__max_turns=32
__turns="${BAI_SESSION_RESUME_TURNS:-0}"

while true;do

  # llama.cpp 进程若已结束，直接退出（避免后续请求必然失败）
  bai_llamacpp_check

  if $BAI_LIMIT_TURNS;then
    ((__turns>=__max_turns)) && {
      msg "$(L10n-zh-Hans "msg.turns_limit_reached 对话轮次已达上限，重置对话")"
      data="${old_data}"
      unset old_filepath
      IS_PUSH_IMAGE=false
      IMAGE_INPUTS=()
      __turns=0
    }
  fi

  ########################################################################
  # 前置准备

  # 新一轮开始：清掉上一轮遗留的打断标记
  bai_interrupt_clear
  BAI_INTERRUPTED=false

  # 开启历史记录
  set -o history

  if $INTERACT_MODE;then
    __model_cl=${OPENAI_API_MODEL_CONTEXT_LENGTH["$OPENAI_API_MODEL"]}

    # 未收到/无接口返回/不在连续对话模式时不再输入聊天记录
    if [ "$API_RETURN" ];then
      __return_file="$(bai_jq_rawfile "$API_RETURN")"
      if [ "$__return_file" ];then
        __return_content="$(jq --rawfile content "$__return_file" '{role: "assistant", content: $content}' <<< '{}')"
        rm -f "$__return_file"
      else
        __return_content="$(jq -n '{role: "assistant", content: ""}')"
      fi
      if [ "$REASONING_CONTENT" ];then
        __return_file="$(bai_jq_rawfile "$REASONING_CONTENT")" && {
          __return_content="$(jq --rawfile content "$__return_file" '. += {reasoning_content: $content}' <<< "$__return_content")"
          rm -f "$__return_file"
        }
      fi
      bai_append_message "$__return_content" || emsg "$(L10n-zh-Hans "set_temp_file_messages.message_append_failed 会话消息写入失败")"
      data.setkey "tool_choice" "$BAI_CALLTOOLS"
      $BAI_LIMIT_TURNS && ((__turns++))
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.assistant_response_recorded 已完成本轮会话记录，当前进程占用内存：%s MiB" "$(ps -o rss= -p $$ | gawk '{printf "%.2f", $1/1024}')")"
      unset API_RETURN
    fi

    # 获取最新一轮对话
    function Get-New-Msg(){
      jq -r '[ .messages | .[] | select(.role == "assistant") ] | last | .content' <<< "$data"
    }
    # 等待用户输入阶段：Ctrl+C 退出程序
    bai_interrupt_trap_input

    # 用户输入
    Refresh-User-Prompt
    if $__has_extend_gum;then
      OPENAI_USER_PROMPT="$(gum write --placeholder "$(L10n-zh-Hans "msg.gum_placeholder 用户输入...")")"
      _return=$?
      ((_return==130)) && { for i in {1..6};do printf "\r\e[K\e[A"; done; trap=true bye;}
      [ -z "$OPENAI_USER_PROMPT" ] || echo -e "${c36}$user_prompt${c0} $OPENAI_USER_PROMPT"
    else
      read $read_e_option -rp "$__BAI_CHAT_PS1 " OPENAI_USER_PROMPT
      _return=$?
      __bai_multline_prompt="\[${c35}\]>>\[${c0}\]"
      Get-Var-Extend __bai_multline_prompt a:p
      # 判断最后两个个字符是否是空格+反斜杠
      while [[ "$OPENAI_USER_PROMPT" =~ [[:space:]]\\$ ]];do
        OPENAI_USER_PROMPT="${OPENAI_USER_PROMPT%?}" # 去掉最后一个反斜杠
        OPENAI_USER_PROMPT="${OPENAI_USER_PROMPT%?}" # 去掉最后一个空格
        read -rp "$__bai_multline_prompt " _additional_input
        OPENAI_USER_PROMPT+="$_additional_input"
      done
    fi
    BAI_MENTIONS_RESOLVED=false
    ((_return==1)) && exit
  fi
  ((${#OPENAI_USER_PROMPT}>0)) && echo "$OPENAI_USER_PROMPT" >> $HISTFILE

  # 空输入时直接跳过，避免浪费资源
  if [ -z "$OPENAI_USER_PROMPT" ];then
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.user_input_empty 用户输入为空，跳过")"
    continue
  fi

  ########################################################################
  # 参数解析
  # 注册为指令参数

    # 添加一个函数来正确解析带引号的参数
  function Parse-Quoted-Args {
      local input="$1"
      local args=()
      local arg=''
      local in_quote=false
      local quote_char=''
      local escaped=false
      local name
      for ((i=0; i<${#input}; i++)); do
          char="${input:i:1}"
          if $escaped;then
              arg+="$char"
              escaped=false
          elif [[ $char == '\' ]];then
              escaped=true
          elif $in_quote;then
              if [[ $char == $quote_char ]];then
                  in_quote=false
                  args+=("$arg")
                  arg=''
              else
                  arg+="$char"
              fi
          else
              if [[ $char == '"' || $char == "'" ]];then
                  in_quote=true
                  quote_char="$char"
                  case "$quote_char" in
                      '"') name="$(L10n-zh-Hans "msg.quote.double 双引号")";;
                      "'") name="$(L10n-zh-Hans "msg.quote.single 单引号")";;
                  esac
              elif [[ $char == ' ' || $char == $'\t' ]];then
                  if [[ -n $arg ]];then
                      args+=("$arg")
                      arg=''
                  fi
              else
                  arg+="$char"
              fi
          fi
      done
      if $in_quote;then
          erron "$(L10n-zh-Hans "error.quote_unmatched 寻找匹配的%s时遇到了未预期的行结束符" "$name")"
          return 1
      fi
      if [[ -n $arg ]];then
          args+=("$arg")
      fi
      printf "%s\n" "${args[@]}"
  }

if [[ "$OPENAI_USER_PROMPT" =~ ^\.(.+)?$ && ! "$OPENAI_USER_PROMPT" =~ ^\.run' '(.+)?$ ]];then
    readarray -t subargv < <(Parse-Quoted-Args "$OPENAI_USER_PROMPT" || echo ".pass")
  else
    subargv=($OPENAI_USER_PROMPT)
  fi
  subarg0="${subargv[0]}"
  subargs=("${subargv[@]:1}")
  # 替换 ~ 为 $HOME，但保持数组结构
  for i in "${!subargs[@]}"; do
    subargs[$i]="${subargs[$i]/'~'/$HOME}"
  done
  debug "subarg0='$subarg0', subargs=(${subargs[*]})" >&2
  # 自定义局内指令
  $INTERACT_MODE && 
  if [[ "$subarg0" =~ ^\.(.+)?$ ]];then
    CMD="${BASH_REMATCH[1]}"
    # 忽略大小写进行指令匹配
    case "${CMD,,}" in
      pass)      
      # 无操作，等价于仅回车
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.empty_instruction 空的指令，跳过")"
        continue
        ;;
      cls)       
      # 清除屏幕
        clear
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.clear_screen 清除屏幕")"
        continue
        ;;
      exit|bye) 
      # 退出会话
        exitcode="$[${subargs[0]}]"
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.exit_session 退出会话，退出码: %s" "$exitcode")"
        exit $exitcode
        ;;
      run)
      # 执行命令
        subexec="${subargs[@]}"
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.execute_command 执行命令: %s" "$subexec")"
        if $LEXEC;then
          PS1="$BAI_SHELL_PROMPT" eval "$subexec"
          CMD_RETURN=$?
        else
          PS1="$BAI_SHELL_PROMPT" bash -ic "$subexec"
          CMD_RETURN=$?
        fi
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.command_return_value 命令返回值: %s" "$CMD_RETURN")"
        continue
        ;;
      call)
      # 手动执行工具
        Get-Call-Tools "${subargs[@]}"
        continue
        ;;
      record)   
      # 记录管理
        Get-Session-Messages "${subargs[@]}"
        continue
        ;;
      list)     
      # 列出对话记录
        Get-Session-History
        continue
        ;;
      clear)     
      # 清空对话
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.clear_conversation 清除对话轮数据和提交的文件...")"
        data="${old_data}"
        __turns=0
        unset old_filepath
        IS_PUSH_IMAGE=false
        IMAGE_INPUTS=()
        STDIN_INPUT=""
        BAI_USERNAME="${BAI_USERNAME_OLD}"
        BAI_TITLE="${BAI_TITLE_OLD}"
        $INTERACT_MODE && Set-Terminal-Title "$BAI_TITLE"
        # 清空后换新会话文件，旧记录保留在 .sessions 里
        BAI_SESSION_ID="$(bai_session_new_id)"
        unset BAI_SESSION_CREATED BAI_SESSION_RESUME_TURNS
        msg "$(L10n-zh-Hans "msg.conversation_cleared 对话已清空")"
        continue
        ;;
      api)
      # 接口风格自检（适配层）
        bai_api_selfcheck
        continue
        ;;
      term)
      # 终端尺寸自检
        bai_term_info
        continue
        ;;
      logo)
      # 自定义 logo
        bai_logo_cmd "${subargs[@]}"
        continue
        ;;
      perms|permissions)
      # 工具权限
        case "${subargs[0]:-}" in
          ""|list)  bai_permission_list ;;
          set)      bai_permission_set "${subargs[1]:-}" "${subargs[2]:-}" ;;
          reset)    bai_permission_reset "${subargs[1]:-}" ;;
          mode)     bai_permission_mode "${subargs[1]:-}" ;;
          *)        erron "$(L10n-zh-Hans "permission.unknown_arg 未知的权限参数: %s（list|set|reset|mode）" "${subargs[0]}")" ;;
        esac
        continue
        ;;
      mcp)
      # MCP 状态
        bai_mcp_status
        continue
        ;;
      sessions)
      # 列出最近会话
        bai_session_list || erron "$(L10n-zh-Hans "session.list_failed 没有可列出的会话")"
        continue
        ;;
      models)
      # 列出服务商模型
        bai_models_print || erron "$(L10n-zh-Hans "models.fetch_failed 获取模型列表失败")"
        continue
        ;;
      compact)
      # 上下文压缩
        case "${subargs[0]:-}" in
          show|status)   bai_compact_status ;;
          undo|restore)  bai_compact_undo ;;
          tools|light)   bai_compact tools ;;
          ""|now|full)   bai_compact full ;;
          *) erron "$(L10n-zh-Hans "compact.unknown_arg 未知的压缩参数: %s" "${subargs[0]}")" ;;
        esac
        continue
        ;;
      help|\?)   
      # 显示帮助
        Get-Session-Help "${subargs[@]}"
        continue
        ;;
      set)
      # 设置
        argcs="${SET_ALIAS[*]//:*/,}"
        for i in debug-output erron-effect eval-skipask interact-complete local-execute print-effect;do
          argcs="${argcs/$i/b:$i}"
        done
        alias=set cmd=Set-Session-Functions \
        argc_set="$argcs" \
        argc_set_desc="${SET_DESCRIPTION[*]/#/$'\n'}" \
        argc_call_tools="${__bai_function_tools[*]/#/i:}" \
        argc_chat_model="${OPENAI_API_MODEL_in_array[*]}" \
        argc_enable_search="${__bai_shared_switches[*]}" \
        argc_enable_thinking="${__bai_shared_switches[*]}" \
        argc_reasoning_effort="${reasoning_effort_options[*]}" \
        Interactive-Completion \
        Set-Session-Functions "${subargs[@]}"
        continue
        ;;
      # 尝试执行 shell 命令
      eval)
        [ "$subargs" ] || continue
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.eval_mode 提交一段临时的提示词，并启用 EVAL 模式")"
        # OPENAI_USER_PROMPT="[!] 本次对话你只需要提供可以直接使用的终端命令或 Bash 脚本，我将执行它，我不需要你对此做任何解释，我很清楚后果。| [!] In this conversation, all you need to do is provide a terminal command or Bash script that can be used directly, and I will execute it. I don't need you to explain anything about it, I am aware of the consequences."$'\n'"${subargs[@]:1}"
        # data.setkey "tool_choice" "none"
        eval_system_prompt='You are a command-generation assistant. Your sole purpose is to output valid, executable commands based on user requests.\n\n**Rules:**\n- Respond **only** with the command(s) — no explanations, descriptions, or additional text.\n- If multiple commands are needed, separate them with `&&` or newlines.\n- Assume a Linux/bash environment unless the user specifies otherwise.\n- If the request is ambiguous, output the most common default command and nothing else.\n- Do not ask clarifying questions; if unable to generate a command, output `echo "Error"` (or a safe fallback).\n**Example:**\nUser: "list all files sorted by size"\nOutput: `ls -lS`'
        eval_system_prompt+="$(cat /etc/os-release 2>/dev/null || :)"
        data="$(jq --arg model "$OPENAI_API_MODEL" --arg sys "$eval_system_prompt" --arg msg "${subargs[@]}" '. | .model = $model | .messages[0].content = $sys | .messages[1].content = $msg' <<<'{"stream":false,"messages":[{"role":"system"},{"role":"user"}]}')" \
        Wait-Assistant-Content
        return_cmd="$(jq -r "$(bai_api_aux_content_path)" <<< "$CURL_GET_API" 2>/dev/null)"
        if [[ "$return_cmd" && ! "$return_cmd" == null ]];then
          echo -e "\$ $c35$return_cmd$c0"
          if [[ "$(Dialog-Confirm "$(L10n-zh-Hans "eval_mode.confirm_message 确定执行以上命令？")" no)" == yes ]];then
            bash -c "$return_cmd"
            echo "Exit code: $?"
          else
            msg "$(L10n-zh-Hans "eval_mode.confirm_cancel 取消")"
          fi
        else
          Get-ReturnError-Info
        fi
        continue
        ;;
      code)
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.copy_code_block 复制代码块")"
        Get-New-Msg | Get-MarkDown-CodeBlocks "${subargs[@]}"
        continue
        ;;
      files)      
      # 提交文件
        Set-Temp-File "${subargs[@]}"
        continue
        ;;
      at)
      # 提及在服务商存储的文件并发出提问
        Get-AtFiles-Ask "${subargs[@]}" || continue
        ;;
      # 向对话提供文件内容
      file)
        Get-Import-File "${subargs[@]}"
        continue
        ;;
      *)        
      # 排除未知指令
      if [ "$CMD" ];then
        erron "$(L10n-zh-Hans "error.unknown_command 未知的指令 \"%s\"" "$CMD")"
      else
        erron "$(L10n-zh-Hans "error.empty_command 空的指令")"
      fi
      continue
    esac
  elif [[ "$subarg0" =~ ^\!(.+)?$ ]];then
    # 直接执行 shell 命令
    subexec="${subargv[*]#!}"
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.execute_command_shortcut 直接执行命令快捷方式: %s" "$subexec")"
    if $LEXEC;then
      PS1="$BAI_SHELL_PROMPT" eval "$subexec"
      CMD_RETURN=$?
    else
      PS1="$BAI_SHELL_PROMPT" bash -ic "$subexec"
      CMD_RETURN=$?
    fi
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.command_return_value_shortcut 命令返回值: %s" "$CMD_RETURN")"
    continue
  elif [[ "$subarg0" =~ ^\:(.+)?$ ]];then
    # 执行工具函数
    toolcalls_head="${subarg0#:}"
    Get-Call-Tools "$toolcalls_head" "${subargs[@]}"
    continue
  fi
  

  ########################################################################
  # 构建请求，主要逻辑实现

  # 解析提示词里的 @文件 / @图片 提及（支持引号包裹的含空格路径）
  if ! $BAI_MENTIONS_RESOLVED;then
    bai_resolve_at_mentions
    BAI_MENTIONS_RESOLVED=true
  fi

  # 上下文自动压缩（在拼接本轮消息之前处理历史）
  if $INTERACT_MODE && $BAI_CONTEXT_COMPRESS;then
    __ctx_tokens="$(bai_context_tokens)"
    if [[ "$__ctx_tokens" =~ ^[0-9]+$ ]] && [[ "${__model_cl:-0}" =~ ^[0-9]+$ ]] && ((__model_cl>0));then
      if ((__ctx_tokens * 100 >= __model_cl * BAI_COMPRESS_THRESHOLD));then
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "compact.auto_trigger 上下文占用 %s%%，触发自动压缩" "$((__ctx_tokens * 100 / __model_cl))")"
        bai_compact auto
      fi
    fi
  fi

  if $IS_PUSH_IMAGE && ((${#IMAGE_INPUTS[@]}));then
    # 模型未声明图片输入能力时提醒一次
    if [ -z "${__bai_warned_img:-}" ];then
      __bai_mods="$(bai_model_input_modalities "$OPENAI_API_MODEL" 2>/dev/null)"
      if [ -n "$__bai_mods" ] && [[ ",$__bai_mods," != *",image,"* ]];then
        erron "$(L10n-zh-Hans "models.image_unsupported 模型 %s 未声明图片输入能力（input_modalities: %s），图片可能被忽略" "$OPENAI_API_MODEL" "$__bai_mods")"
        __bai_warned_img=1
      fi
    fi
    # 多图提交：同一轮把文本与全部图片放进同一条 user 消息的 content 数组
    # 图片是 Base64 Data URI，体积远超 argv 上限，故经临时文件交给 jq
    __images_json_file="$(mktemp "${TMPDIR:-/tmp}/.bai_images.XXXXXX" 2>/dev/null)" || { emsg "$(L10n-zh-Hans "set_temp_file_messages.message_append_failed 会话消息写入失败")"; continue; }
    {
      printf '['
      __image_sep=""
      for __image_uri in "${IMAGE_INPUTS[@]}";do
        printf '%s{"type": "image_url", "image_url": {"url": ' "$__image_sep"
        printf '%s' "$__image_uri" | jq -Rs .
        printf '}}'
        __image_sep=","
      done
      printf ']'
    } > "$__images_json_file"
    __text_file="$(bai_jq_rawfile "$STDIN_INPUT$OPENAI_USER_PROMPT")" || { emsg "$(L10n-zh-Hans "set_temp_file_messages.message_append_failed 会话消息写入失败")"; rm -f "$__images_json_file"; continue; }
    __read="$(jq --rawfile text "$__text_file" --slurpfile images "$__images_json_file" '.messages += [{"role": "user", "content": ([{"type": "text", "text": $text}] + $images[0])}]' <<< "$data")"
    rm -f "$__text_file" "$__images_json_file"
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.push_image 提交图片数据 (共 %s 张)" "${#IMAGE_INPUTS[@]}")"
    IS_PUSH_IMAGE=false
    IMAGE_INPUTS=()
    unset STDIN_INPUT
  else
    __read_file="$(bai_jq_rawfile "$STDIN_INPUT$OPENAI_USER_PROMPT")" || { emsg "$(L10n-zh-Hans "set_temp_file_messages.message_append_failed 会话消息写入失败")"; continue; }
    __read="$(jq --rawfile content "$__read_file" '.messages += [{"role": "user", "content": $content}]' <<< "$data")"
    rm -f "$__read_file"
  fi

  if [[ "$OPENAI_USER_PROMPT" == *@file:* ]];then
    file_id="${OPENAI_USER_PROMPT#*@file:}"
    user_atfile_prompt="${OPENAI_USER_PROMPT%@file:*}"
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.at_file 提及文件ID: %s" "$file_id")"
    __read="$(jq --arg content "$user_atfile_prompt" --arg file_id "$file_id" '.messages += [{"role": "user", "content": [{"type": "text", "text": $content},{"type": "file", "file_id": $file_id}]}]' <<< "$data")"
  fi

  if $OPENAI_ENABLE_PARTIAL;then
    if [[ "$OPENAI_USER_PROMPT" == *@prefix ]];then
      OPENAI_USER_PROMPT="${OPENAI_USER_PROMPT%@prefix}"
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.partial_prompt 使用局部提示词")"
      data="$(jq --arg content "$OPENAI_USER_PROMPT" '.messages += [{"role": "assistant", "content": $content, "partial": true}]' <<< "$data")"
    else
      data="$__read"
    fi
  else
    data="$__read"
  fi
  unset STDIN_INPUT

  # 请求前再确认 llama.cpp 仍在运行
  bai_llamacpp_check

  # 等待回复阶段：Ctrl+C = 打断
  bai_interrupt_trap_wait

  # 文件打断：请求发出前检查（允许提前标记）
  if $BAI_INTERRUPTED;then
    BAI_INTERRUPTED=false
    msg "$(L10n-zh-Hans "interrupt.before_request 检测到打断标记，已跳过本次请求")"
    unset API_RETURN
    continue
  fi

  # 兜底：手动 .call send_image 等场景，请求发出前把排队图片补成 user 消息
  bai_flush_pending_images

  # 流模式分支
  $OPENAI_ENABLE_STREAM && { Get-Stream-Assistant-Content; continue; }
  # 构建接口请求
  if ! $DEBUG_MODE;then
    # 异步请求接口
    Wait-Assistant-Content
    # 文件打断：请求返回后清标记
    bai_interrupt_requested && { BAI_INTERRUPTED=true; bai_interrupt_clear; }
    bai_interrupt_trap_input
  else
    echo -en " + POST: $OPENAI_BASE_URL\n"\
            "+ DATA: "
    jq -C <<< "$data"
    echo
    API_RETURN="this a test message."
    continue
  fi

  # 检查响应中的错误
  if $(jq 'has("error")' <<< "$CURL_GET_API" 2>/dev/null);then
    ERROR_MSG=$(jq --exit-status -r '.error.message' <<< "$CURL_GET_API" 2>/dev/null || echo "$(L10n-zh-Hans "error.unexpected_request_error 请求时发生了意料之外的错误")")
    erron "$ERROR_MSG"
    unset API_RETURN
    bai_session_save
    $INTERACT_MODE || exit 1
    continue
  else
    # 检查是否使用了工具
    debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.check_tools 检查是否使用了工具")"
    TOOLS_IS_CALL=false
    if $USE_TOOLS;then
      __api_msg_path="$(bai_api_message_path)"
      API_RETURN="$(jq --exit-status "$__api_msg_path.tool_calls" <<< "$CURL_GET_API" 2>/dev/null)"
      API_STATUS=$?
      if ! ((API_STATUS));then
        TOOLS_IS_CALL=true
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.tools_found 发现模型使用了工具")"
      else
        TOOLS_IS_CALL=false
        debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.tools_not_used 模型还未使用工具")"
        Get-Assistant-Content
      fi
    else
      Get-Assistant-Content
      TOOLS_IS_CALL=false
    fi
    if ((API_STATUS)) && [[ "$API_RETURN" == "null" ]];then
      erron "$(L10n-zh-Hans "error.request_not_accepted 该次请求未正确被接受")"
      unset API_RETURN
    else
      # 调用工具，支持同一轮内的多个工具调用（按顺序串行执行）
      $TOOLS_IS_CALL || { Return-Assistant-Content; continue; }
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.init_tool_call 初始化工具调用")"
      function_call_msg="$(jq -r "$__api_msg_path" <<< "$CURL_GET_API")"
      # 思考模式下带 tool_calls 但缺 reasoning_content 时补空串，避免下一轮 400
      if bai_thinking_active && [[ -z "$(jq -r "$__api_msg_path.reasoning_content // empty" <<< "$CURL_GET_API" 2>/dev/null)" ]];then
        function_call_msg="$(jq '. += {"reasoning_content": ""}' <<< "$function_call_msg" 2>/dev/null)"
      fi
      bai_append_message "$function_call_msg" || { erron "$(L10n-zh-Hans "set_temp_file_messages.message_append_failed 会话消息写入失败")"; unset API_RETURN; continue; }
      __tc_total="$(jq -r "$__api_msg_path.tool_calls | length" <<< "$CURL_GET_API" 2>/dev/null)"
      # 工具调用列表为空时不视为工具调用，直接返回模型内容
      if [[ "$__tc_total" =~ ^[0-9]+$ ]] && ((__tc_total==0));then
        Get-Assistant-Content
        Return-Assistant-Content
        continue
      fi
      [[ "$__tc_total" =~ ^[0-9]+$ ]] || __tc_total=1
      for ((__tc_pos=0; __tc_pos<__tc_total; __tc_pos++));do
        __tc_call_path="$__api_msg_path.tool_calls[$__tc_pos]"
        function_id="$(jq -r "$__tc_call_path.id" <<< "$CURL_GET_API")"
        function_args_raw="$(jq -r "$__tc_call_path.function.arguments" <<< "$CURL_GET_API")"
        function_args="$function_args_raw"
        function_run_name="$(jq -r "$__tc_call_path.function.name" <<< "$CURL_GET_API")"
        bai_expand_tool_args "$function_run_name" "$function_args_raw"
        function_name="$function_head::$function_run_name"
        __tc_term_width="$(Get-TWidth)"
        if ((__tc_total>1));then
          echo -e " ${c35}┏${c0} $(L10n-zh-Hans "set_temp_file_messages.tool_calling_multiple 工具调用中 (%s/%s)" "$((__tc_pos+1))" "$__tc_total")..."
        else
          echo -e " ${c35}┏${c0} $(L10n-zh-Hans "set_temp_file_messages.tool_calling 工具调用中")..."
        fi
        echo -en " ${c35}┃${c0} ${c34}❯${c0} "
        execute_title="$function_run_name$([[ "$function_args" =~ ^(\{\})+$ ]] || echo ", arg: $function_args")"
        output_width=$(($(wc -L <<<"$execute_title")+26))
        if (((__tc_term_width-28)<output_width));then
          bai_wrap_cjk $((__tc_term_width-28)) <<< "$execute_title" | head -2 | sed '2s/.*/.../' | sed ':a;N;$!ba;s/\n//g'
        else
          echo "$execute_title"
        fi
        explicitly="${gco_explicitly[$function_name]}"
        catch_stderr="${gco_getstderr[$function_name]}"
        if ! bai_permission_gate "$function_run_name" "$function_args_raw";then
          function_return="[权限] 工具 $function_run_name 未获用户授权，已跳过执行。"
          RETURN=1
          bai_append_tool_message "$function_id" "$function_return" || { emsg "$(L10n-zh-Hans "set_temp_file_messages.message_append_failed 会话消息写入失败")"; unset API_RETURN; continue; }
          continue
        fi
        Get-Command-Output "$function_name $BAI_TOOL_EXPANDED_ARGS"
        function_return="$gco_return_content"
        RETURN=$gco_status
        ((RETURN)) && { emsg "$(L10n-zh-Hans "error.tool_execution_failed 工具执行失败")";}
        bai_append_tool_message "$function_id" "$function_return" || { emsg "$(L10n-zh-Hans "set_temp_file_messages.message_append_failed 会话消息写入失败")"; unset API_RETURN; continue 2; }
      done
      bai_flush_pending_images
      Wait-Assistant-Content
      Get-Assistant-Content
      (((API_STATUS)) && [[ "$API_RETURN" == "null" ]]) || { Return-Assistant-Content; continue; }
      erron "$(L10n-zh-Hans "error.request_not_accepted 该次请求未正确被接受")"
      unset API_RETURN
      continue
    fi
  fi
done

# 拦截此后所有内容执行
exit $?

