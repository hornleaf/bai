# 初始化对话框: 计算可用空间、输出占位符、捕获光标位置
# 调用前设置: opts_count, prefix_width
# 调用后可用: max_visible, max_text_width, scroll_offset,
#           dlg_lastrow, dlg_startrow
function Dialog-Core {
  local term_size=( $(Get-Terminal-Size both) )
  local term_lines=${term_size[0]} term_cols=${term_size[1]}
  local current_row=$(Read-Cursor row)
  if ((term_lines >= 10));then
    if (((term_lines - current_row) < 7));then
      for mark in {1..7};do echo >&2;done; printf "\e[7A" >&2
    fi
  fi
  current_row=$(Read-Cursor row)
  max_visible=$((term_lines - current_row - 1))
  ((max_visible < 1)) && max_visible=1
  ((max_visible > opts_count)) && max_visible=$opts_count
  max_text_width=$((term_cols - prefix_width))
  scroll_offset=0
  local i=0
  while ((i<max_visible));do echo >&2;((i++));done
  dlg_lastrow=$(Read-Cursor row)
  dlg_startrow=$((dlg_lastrow - max_visible + 1))
}

# 清理对话框: 定位光标、清屏行、恢复 echo 和光标显示
function Dialog-Reset {
  printf "\033[%s;%sH" "${dlg_lastrow}" >&2
  stty echo -F /dev/tty 2>/dev/null
  printf "\e[?25h\n" >&2
  local i=0
  while ((i<(max_visible+2)));do
    printf "\e[1A\r\e[K" >&2
    ((i++))
  done
}

# 读取光标位置
# 用法: Read-Cursor [row|cal|pos]
function Read-Cursor {
  local row col
  IFS=';' read -sdR -p $'\e[6n' row col </dev/tty
  case ${1:-pos} in
    row) printf '%d\n'    "${row#*[}"            ;;
    col) printf '%d\n'    "${col%[}"             ;;
    pos) printf '%d %d\n' "${row#*[}" "${col%[}" ;;
  esac
}

# 读取按键
function Read-Keyboard {
  function lrk { read -rsn$1 key </dev/tty;}
  function ltk { read -rsn$1 -t$t key </dev/tty;}
  function ltr { read -rst$t </dev/tty;}
  local IFS= key= t=0.01
  lrk 1
  if [[ $key == $'\e' ]] ; then
      ltk 1
      if [[ "$key" == "[" ]] ; then
        ltk 2
        ltr
        case $key in
          A)    printf "up";;      B)    printf "down";;
          C)    printf "right";;   D)    printf "left";;
          H|1~) printf "home";;    F|4~) printf "end";;
          5~)   printf "pgup";;    6~)   printf "pgdn";;
          2~)   printf "insert";;  3~)   printf "delete";;
          15)   printf "f5";;      17)   printf "f6";;
          18)   printf "f7";;      19)   printf "f8";;
          20)   printf "f9";;      21)   printf "f10";;
          23)   printf "f11";;     24)   printf "f12";;
        esac
      elif [[ "$key" == O ]];then
        ltk 1
        ltr
        case $key in
          P)    printf "f1";;      Q)    printf "f2";;
          R)    printf "f3";;      S)    printf "f4";;
        esac
      else
        printf "esc"
      fi
  # 数字键
  elif [[ $key =~ ^[0-9a-zA-Z]$ ]];then
    printf "$key"
  # 空格
  elif [[ "$key" == ' ' ]];then
    printf "space"
  # 退格
  elif [[ "$key" == $'\x7f' ]];then
    printf "backspace"
  # 回车
  elif [[ "$key" == '' ]];then
    printf "enter"
  # TAB
  elif [[ "$key" == $'\t' ]];then
    printf "tab"
  # 加/减
  elif [[ "$key" =~ [-+] ]];then
    printf "$key"
  fi
  unset -f lrk ltk ltr
}

# 截断文本至显示宽度 (超出末尾追加 …)
# 用法: Truncate-Text "文本" 最大宽度
function Truncate-Text {
  local text="$1" max_width="$2"
  local text_width
  if [ "${text//[ -~]/}" ];then
    text_width=$(wc -L <<<"$text")
  else
    text_width=${#text}
  fi
  ((text_width <= max_width)) && { printf "%s" "$text"; return; }
  ((max_width < 1)) && { printf "…"; return; }
  let truncated_width=max_width-1
  printf "%s…" "${text:0:truncated_width}"
}

# 单选列表
# 用法: Dialog-Select "标题" "选项1" "选项2" ... "选项N"
# 返回值: 选中项的索引 (0-based)，取消返回 exit
function Dialog-Select {
    local opts=("${@:2}")
    local opts_width="$(     printf "%s\n" "${opts[@]}" | cut -d '|' -sf 1 | wc -L)"
    local desc_width="$(     printf "%s\n" "${opts[@]}" | cut -d '|' -sf 2 | wc -L)"
    # local extcolumn_width="$(printf "%s\n" "${opts[@]}" | cut -d '|' -sf 3 | wc -L)"
    local opts_count=$(($# -1))
    ((opts_count == 0)) && return 0
    local prefix_width=3  # "│  " 或 "├> "
    local max_visible max_text_width scroll_offset dlg_lastrow dlg_startrow
    printf "╭┤ %b\n│" "$1" >&2
    Dialog-Core
    # 预计算显示串 (选项固定, 一次算好; 重绘循环零子 shell)
    local -a opts_disp=()
    local idx
    for ((idx=0; idx<opts_count; idx++)); do
      opts_disp[idx]="$(Truncate-Text "${opts[idx]}" "$max_text_width")"
    done
    trap 'Dialog-Reset;trap - 2;exit' 2
    printf "\e[?25l" >&2
    local selected=0
    while true; do
        # 滚动偏移
        if ((selected < scroll_offset));then
          scroll_offset=$selected
        elif ((selected >= scroll_offset + max_visible));then
          scroll_offset=$((selected - max_visible + 1))
        fi
        local end=$((scroll_offset + max_visible))
        ((end > opts_count)) && end=$opts_count
        # 渲染可见选项
        for ((idx=scroll_offset; idx<end; idx++));do
            printf "\033[%s;%sH" $((dlg_startrow + idx - scroll_offset)) >&2
            local display="${opts_disp[$idx]}"
            local display_column
            readarray -t display_column <<<"${display//'|'/$'\n'}"
               display="${display_column[0]}"
            local desc="${display_column[1]}"
            local extd="${display_column[2]}"
            [[ "$desc" == "$display" ]] && desc=""
            if [ "$idx" -eq "$selected" ]; then
                printf "\r\e[K├\033[0m\033[36m>\033[0m \033[36m%-$((opts_width+2))s\033[0m%s" "$display" "$desc" >&2
            else
                printf "\r\e[K│  %-$((opts_width+2))s%s" "$display" "$desc" >&2
            fi
            # 如果有扩展列，手动计算列宽差对齐显示
            if [ "$extd" ];then
              local extcolumn_width cjk_width ascii_width cjk_str ascii_str corrent_desc_width remain_col_width
              # # CJK+ASCII 计算第二列 desc 列宽
              cjk_str="${desc//[ -~]/}"; cjk_width="${#cjk_str}"
              ascii_str="${desc//[^ -~]/}"; ascii_width="${#ascii_str}"
              let corrent_desc_width=cjk_width*2+ascii_width
              # 不知道在算什么，但是对齐了
              # 对齐宽度=描述最大宽度-当前描述条目宽度+第一列选项宽度-4*2
              let remain_col_width=desc_width-corrent_desc_width+opts_width-4*2
              printf "%*s%s" "$remain_col_width" "$extd" >&2
            fi
        done
        # 清除多余旧行
        for ((idx=end - scroll_offset; idx < max_visible; idx++));do
          printf "\033[%s;%sH\r\e[K" $((dlg_startrow + idx)) >&2
        done
        # 按键处理
        case $(Read-Keyboard) in
            esc|q)    selected=exit;break;;
            enter|f)  break;;
            up|w|j)   ((selected--)); ((selected<0)) && selected=$((opts_count-1));;
            down|s|k) ((selected++)); ((selected>=opts_count)) && selected=0;;
        esac
    done
    echo >&2
    printf "\033[%s;%sH" "${dlg_lastrow}" >&2
    Dialog-Reset
    trap - 2
    echo "${selected}"
    [[ "$selected" == "exit" ]] && return 1 || return 0
}


# 多选列表
# 用法: Dialog-MultiSelect "标题" "选项1" "选项2" ... "选项N"
# 返回值: 选中项的索引列表 (0-based)，取消返回 exit
function Dialog-MultiSelect {
    local opts=("${@:2}")
    local opts_count=$(($# -1))
    ((opts_count == 0)) && return 0
    local prefix_width=5  # "│  ◯ " 或 "├> ◉ "
    local max_visible max_text_width scroll_offset dlg_lastrow dlg_startrow
    printf "╭┤ %b\n│" "$1" >&2
    Dialog-Core
    stty -echo -F /dev/tty
    trap 'Dialog-Reset;trap - 2;exit' 2
    printf "\e[?25l" >&2
    local selected=0
    local checked=()
    # 处理 ^ 预选标记
    local idx=0
    for opt in "${opts[@]}"; do
      if [[ "$opt" =~ ^\^.*$ ]]; then
        checked+=("$idx")
        opt_strip="$(sed 's|^\^||;s|\$||' <<< "$opt")"
        opts["$idx"]="${opt_strip}"
      fi
      ((idx++))
    done
    # 预计算显示串 (选项在 ^ 处理后已定型, 一次算好; 重绘循环零子 shell)
    local -a opts_disp=()
    for ((idx=0; idx<opts_count; idx++)); do
      opts_disp[idx]="$(Truncate-Text "${opts[idx]}" "$max_text_width")"
    done
    while true; do
        # 滚动偏移
        if ((selected < scroll_offset));then
          scroll_offset=$selected
        elif ((selected >= scroll_offset + max_visible));then
          scroll_offset=$((selected - max_visible + 1))
        fi
        local end=$((scroll_offset + max_visible))
        ((end > opts_count)) && end=$opts_count
        # 渲染可见选项
        for ((idx=scroll_offset; idx<end; idx++));do
            printf "\033[%s;%sH" $((dlg_startrow + idx - scroll_offset)) >&2
            local icon='◯'
            for item in "${checked[@]}"; do
                if [ "$item" == "$idx" ]; then
                    icon=$'\e[1;32m◉\e[0m'; break
                fi
            done
            if [ "$idx" -eq "$selected" ]; then
                printf "\r\e[K├\e[0m\e[36m>\e[0m %s \e[36m%s\e[0m" "$icon" "${opts_disp[$idx]}" >&2
            else
                printf "\r\e[K│  %s %s" "$icon" "${opts_disp[$idx]}" >&2
            fi
        done
        # 清除多余旧行
        for ((idx=end - scroll_offset; idx < max_visible; idx++));do
          printf "\033[%s;%sH\r\e[K" $((dlg_startrow + idx)) >&2
        done
        # 按键处理
        case $(Read-Keyboard) in
            esc|q) local exit=true;break;;
            enter) break;;
            space)
                local found=0
                for item in "${checked[@]}"; do
                    if [ "$item" == "$selected" ]; then found=1;break;fi
                done
                if ((found==1));then
                    # 精确匹配删除（避免 selected=1 误删 10,11...）
                    local __tmp=() __item
                    for __item in "${checked[@]}";do
                      [[ "$__item" == "$selected" ]] && continue
                      __tmp+=("$__item")
                    done
                    checked=("${__tmp[@]}")
                else
                    checked+=("${selected}")
                fi
                ;;
            up|w|j)   ((selected--)); ((selected<0)) && selected=$((opts_count-1));;
            down|s|k) ((selected++)); ((selected>=opts_count)) && selected=0;;
        esac
    done
    ${exit:-false} && { checked=("exit");}
    Dialog-Reset
    trap - 2
    echo "${checked[*]}"
}

# 文件选择
# 用法: Dialog-FileChoose [起始目录]（默认当前目录）
# 返回值: 选中的文件路径或 "exit"
function Dialog-FileChoose {
  local cur_dir
  if [[ -d "${1:-}" ]]; then
    cur_dir="$(cd "$1" && pwd)"
  else
    cur_dir="$PWD"
  fi
  local selected=0 show_hidden=0
  local entries=() entries_disp=() opts_count=0
  local prefix_width=3
  local max_visible max_text_width scroll_offset dlg_lastrow dlg_startrow
  # 加载当前目录条目: 目录优先, 各自字典序
  fc_load(){
    local item
    local -a all=() dirs=() files=()
    mapfile -t all < <(
      shopt -s nullglob
      # 注意: 用 ${cur_dir%/} 展开, 避免 git-bash 在根目录 ("/") 下
      # 对 "$cur_dir"/* 这类变量展开卡死; 同时避免拼出 // 双斜杠
      if ((show_hidden)); then
        # Tab 开: 显示全部条目 (隐藏目录 + 隐藏文件)
        for item in "${cur_dir%/}"/* "${cur_dir%/}"/.[!.]* "${cur_dir%/}"/..?*; do printf '%s\n' "${item##*/}"; done
      else
        # Tab 关 (默认): 只显示可见条目
        for item in "${cur_dir%/}"/*; do printf '%s\n' "${item##*/}"; done
      fi
    )
    for item in "${all[@]}"; do
      if [[ -d "${cur_dir%/}/$item" ]]; then dirs+=("$item"); else files+=("$item"); fi
    done
    # 注意: 空数组时 printf 会输出一个空行, 必须先判空再排序
    ((${#dirs[@]}))  && mapfile -t dirs  < <(printf '%s\n' "${dirs[@]}"  | sort)
    ((${#files[@]})) && mapfile -t files < <(printf '%s\n' "${files[@]}" | sort)
    entries=("${dirs[@]}" "${files[@]}")
    opts_count=${#entries[@]}
  }
  # 标题: 超宽时保留路径尾部 (当前目录名), 左侧用 … 截断
  fc_title(){
    local maxw=$(( $(Get-Terminal-Size cols) - 3 ))
    if (( ${#cur_dir} <= maxw )); then
      printf '%s' "$cur_dir"
      return
    fi
    printf '…%s' "${cur_dir: -$((maxw - 1))}"
  }
  # 预计算显示串: 目录加 / 后缀并按终端宽度截断
  # (每次进目录执行一次; 重绘循环只做 printf, 不再逐行测宽/stat)
  fc_build_disp(){
    entries_disp=()
    [ "$max_text_width" ] || max_text_width=$(Get-TWidth)
    local item
    for item in "${entries[@]}"; do
      [[ -d "${cur_dir%/}/$item" ]] && item="$item/"
      entries_disp+=("$(Truncate-Text "$item" "$max_text_width")")
    done
  }
  # 目录切换后: 清除旧对话框并重新初始化
  fc_restart(){
    Dialog-Reset
    printf "\e[?25l" >&2
    fc_load
    selected=0
    printf "\r╭┤ %b\n│" "$(fc_title)" >&2
    Wait-Task wait
    fc_build_disp
    Wait-Task kill
    printf "│" >&2
    Dialog-Core
    printf "\e[?25l" >&2
  }
  fc_load
  printf "\r╭┤ %b\n│" "$(fc_title)" >&2
  Wait-Task wait
  fc_build_disp
  Wait-Task kill
  printf "│" >&2
  Dialog-Core
  trap 'Dialog-Reset;Set-Osc-Progress clear;trap - 2;exit' 2
  printf "\e[?25l" >&2
  local result=""
  while true; do
    # 滚动偏移
    if ((selected < scroll_offset)); then
      scroll_offset=$selected
    elif ((selected >= scroll_offset + max_visible)); then
      scroll_offset=$((selected - max_visible + 1))
    fi
    local end=$((scroll_offset + max_visible))
    ((end > opts_count)) && end=$opts_count
    # 绘制可见条目 (显示串已预计算, 纯 printf 零子 shell)
    local idx
    for ((idx=scroll_offset; idx<end; idx++)); do
      printf "\033[%s;%sH" $((dlg_startrow + idx - scroll_offset)) >&2
      if ((idx == selected)); then
        printf "\r\e[K├\033[0m\033[36m>\033[0m \033[36m%s\033[0m" "${entries_disp[idx]}" >&2
      else
        printf "\r\e[K│  %s" "${entries_disp[idx]}" >&2
      fi
    done
    Set-Osc-Progress info $((selected+1)):$opts_count
    if ((opts_count == 0)); then
      printf "\033[%s;1H\r\e[K╰ [Empty Directory]" "$dlg_startrow" >&2
    fi
    # 清除多余旧行
    for ((idx=end - scroll_offset; idx < max_visible && idx >= 0; idx++)); do
      printf "\033[%s;%sH\r\e[K" $((dlg_startrow + idx)) >&2
    done
    # 按键处理
    local key=$(Read-Keyboard)
    case "$key" in
      up|j|w)     ((selected--)); ((selected < 0)) && selected=$((opts_count - 1));;
      down|k|s)   ((selected++)); ((selected >= opts_count)) && selected=0;;
      home)       selected=0;;
      end)        ((opts_count > 0)) && selected=$((opts_count - 1));;
      pgup)       ((selected -= max_visible)); ((selected < 0)) && selected=0;;
      pgdn)       ((selected += max_visible)); ((selected >= opts_count)) && selected=$((opts_count - 1));;
      enter|l|d|right)
        if ((opts_count > 0)) && [[ -d "${cur_dir%/}/${entries[selected]}" ]]; then
          cur_dir="${cur_dir%/}/${entries[selected]}"
          fc_restart
        elif ((opts_count > 0)); then
          result="${cur_dir%/}/${entries[selected]}"
          break
        fi
        ;;
      backspace|h|a|left)
        local parent="${cur_dir%/*}"
        if [[ "$parent" == "$cur_dir" || -z "$parent" ]]; then
          [[ "$cur_dir" == /* ]] && parent="/" || parent=".."
        fi
        cur_dir="$parent"
        fc_restart
        ;;
      tab)        show_hidden=$((1 - show_hidden)); fc_restart;;
      esc|q)      result="exit"; break;;
    esac
  done
  echo >&2
  printf "\033[%s;1H\r\e[K" "$dlg_startrow" >&2
  printf "\033[%s;%sH" "${dlg_lastrow}" >&2
  Set-Osc-Progress clear
  Dialog-Reset
  trap - 2
  unset -f fc_load fc_title fc_build_disp fc_restart
  echo "$result"
  [[ "$result" == "exit" ]] && return 1
  return 0
}

# 范围选择
# 用法: Dialog-Range "标题" 最小值 最大值 [默认值]
# 输出: 选择的值 | exit
function Dialog-Range {
  [ "$3" ] || return 0
  local title="$1" min="$2" max="$3"
  local default="${4:-0}"
  local choose=$default read_key
  local display_title="$(Truncate-Text "$title" $((`Get-TWidth` - 5)))"
  stty -echo -F /dev/tty 2>/dev/null
  printf "\e[?25l" >&2
  function lreset {
    printf "\r\e[K\e[1A\r\e[K\e[0m" >&2
    stty echo -F /dev/tty 2>/dev/null
    printf "\e[?25h" >&2
    unset -f $FUNCNAME
  }
  trap 'lreset; trap - 2; exit' 2
  echo -e "╭ $display_title" >&2
    while true; do
    printf "\r\e[K╰| $min \e[1;90m<\e[0m \e[1;34m%d\e[0m \e[1;90m>\e[0m $max" "$choose" >&2
    case `Read-Keyboard` in
      up)              choose=$min;;
      down)            choose=$max;;
      enter)           lreset;echo "$choose";return 0;;
      esc|backspace)   lreset;echo exit;return 1;;
      left)            ((choose==min)) && choose=$max || choose=$((choose-1));;
      right)           ((choose==max)) && choose=$min || choose=$((choose+1));;
    esac
  done
}

# 用户输入
# 用法: Dialog-Input "标题"
# 输出: 用户输入
function Dialog-Input {
  [ "$1" ] || return 0
  local display_title="$(Truncate-Text "$1" $(($(Get-Terminal-Size cols) - 3)))"
  local size=$(( $(Get-Terminal-Size cols) - 6 ))
  function reset(){
    local i=0 lines="${1:-2}"
    while ((i<lines));do printf "\r\e[K\e[1A\r\e[K\e[0m" >&2;((i++));done
    printf "\e[?25h" >&2
    unset -f $FUNCNAME
  }
  printf "\e[?25l" >&2
  echo -e "╭ $display_title" >&2
  echo -n "╰| " >&2
  local input="" tail=""
  trap 'reset 1;trap - 2;exit' 2
  while IFS= read -rsn1 char </dev/tty;do
    [[ -z "${char}" ]] && { printf '\n' >&2; break; }
    if [[ "${char}" == $'\x7f' ]];then               # 退格
      if ((${#input}>0)); then
        tail="${input: -1}"
        input="${input%?}"
        printf '\b \b' >&2
        [[ $(wc -L <<<"${tail}") == 2 ]] && printf '\b \b' >&2  # CJK 双宽字符
      else
        read -rsn2 -t0.01 char2 </dev/tty && continue
        reset 1
        echo exit; return 1
      fi
    elif [[ "${char}" == $'\e' ]]; then              # ESC
      read -rsn2 -t0.01 char2 </dev/tty && continue
      reset 1
      echo exit; return 1
    else
      (($(wc -L <<<"${input}")>=size)) && continue
      input+="$char"
      printf "\e[1;32m$char\e[0m" >&2
    fi
  done
  reset 2
  trap - 2
  echo "${input}"
}

# 密码输入
# 用法: Dialog-Password "标题"
# 输出: 用户输入
function Dialog-Password {
  [ "$1" ] || return 0
  local display_title="$(Truncate-Text "$1" $(($(Get-Terminal-Size cols) - 3)))"
  local size=$(( $(Get-Terminal-Size cols) - 3 ))
  function reset(){
    local i=0 lines="${1:-2}"
    while ((i<lines));do printf "\r\e[K\e[1A\r\e[K\e[0m" >&2;((i++));done
    printf "\e[?25h" >&2
    unset -f $FUNCNAME
  }
  printf "\e[?25l" >&2
  echo -e "╭ $display_title" >&2
  echo -n "╰| " >&2
  local password=""
  trap 'reset 1;trap - 2;exit' 2
  while IFS= read -rsn1 char </dev/tty;do
    [[ -z "${char}" ]] && { printf '\n' >&2; break; }
    if [[ "${char}" == $'\x7f' ]]; then          # 退格
      if ((${#password}>0)); then
        password="${password%?}"
        printf '\b \b' >&2
      fi
    elif [[ "${char}" == $'\e' ]]; then          # ESC
      read -rsn2 -t0.01 char2 </dev/tty && continue
      reset 1
      echo exit; return 1
    else
      ((${#password}>=size)) && continue
      password+="$char"
      printf '\e[1;34m*\e[0m' >&2
    fi
  done
  reset 2
  trap - 2
  echo "${password}"
}

# 确认对话框
# 用法: Dialog-Confirm "问题" [默认选项: yes|no]
# 输出: yes | no | exit
function Dialog-Confirm {
  [ -z "$1" ] && return 1
  local default_tip stat
  local n_yc n_nc n_yi n_ni c_c c_o y n
  local i_ns='○'
  local i_is='◉'
  local i_c='●'
  local gray='\e[90m' blue='\e[34m' green='\e[32m' red='\e[31m' reset='\e[0m'
  local dc_yes=${yes,,} dc_no=${no,,} dc_notip=${notip:=false}
  :     ${dc_yes:=yes}  ${dc_no:=no}
  function print_now_option(printf "\r╰| $n_yc$n_yi ${dc_yes^} $reset / $n_nc$n_ni ${dc_no^} $reset" >&2)
  function lreset_retract(printf "\e[?25h\n" >&2;for i in {1..2};do printf "\e[1A\r\e[K" >&2;done)
  function lreset(if [[ "${DIALOG_RETRACT:-true}" == true ]];then lreset_retract;else [[ "$1" == "confirm" ]] && printf "\e[?25h\r\e[K" >&2; print_now_option;fi)
  case ${2:-yes} in
    yes)
         y=${dc_yes^}; y=${y:0:1}
         n=${dc_no,};  n=${n:0:1}
         $dc_notip && default_tip="" || default_tip="[$y/$n]"
         stat=true
    ;;
    no)
         y=${dc_yes,}; y=${y:0:1}
         n=${dc_no^};  n=${n:0:1}
         $dc_notip && default_tip="" || default_tip="[$y/$n]"
         stat=false
    ;;
  esac
  printf "\e[?25l" >&2
  echo -e "╭ $1 $default_tip" >&2
  while true;do
    if [[ "$stat" == true ]];then
      n_yc="$blue"; n_nc="$gray"; n_yi="$i_is"; n_ni="$i_ns"; c_o="yes"
    elif [[ "$stat" == false ]];then
      n_yc="$gray"; n_nc="$blue"; n_yi="$i_ns"; n_ni="$i_is"; c_o="no"
    elif [[ "$stat" == "exit" ]];then
      n_yc="$gray"; n_nc="$gray"; n_yi="$i_ns"; n_ni="$i_ns"
      lreset
      echo exit
      return 1
    elif [[ "$stat" == "confirm" ]];then
      if [[ "$c_o" == "yes" ]];then
        n_yc="$green"; n_nc="$gray"; n_yi="$i_c"; n_ni="$i_ns" c_o=$dc_yes
      elif [[ "$c_o" == "no" ]];then
        n_yc="$gray"; n_nc="$red"; n_yi="$i_ns"; n_ni="$i_c" c_o=$dc_no
      fi
      lreset confirm
      echo "$c_o"
      return
    fi
    print_now_option
    case `Read-Keyboard` in
      y|Y) stat=true;;
      n|N) stat=false;;
      left|right)
        if [[ "$stat" == true ]];then
          stat=false
        else
          stat=true
        fi
      ;;
      enter) stat="confirm";;
      esc|backspace) stat="exit";;
    esac
  done
  unset -f print_now_option lreset_retract lreset
}

