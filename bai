        'procps-ng'                      "$((LANG=C ps    --version | head -1 | cut -d ' ' -f4)                  2>/dev/null || echo "[Unknown]")"
        'curl'                           "$((LANG=C curl  --version | head -1 | cut -d ' ' -f2)                  2>/dev/null || echo "[Unknown]")"
        'file'                           "$((LANG=C file  --version | head -1 | cut -d '-' -f2)                  2>/dev/null || echo "[Unknown]")"
        'jq'                             "$((LANG=C jq    --version | head -1 | cut -d '-' -f2)                  2>/dev/null || echo "[Unknown]")"
      )
      EXTEND_VERSION=(
        "Expansion"                      "Version"
        'bat'                            "$((LANG=C bat       --version | head -1 | cut -d ' ' -f2) 2>/dev/null || echo "[Unknown]")"
        'gum'                            "$((LANG=C gum       --version | head -1 | cut -d ' ' -f3) 2>/dev/null || echo "[Unknown]")"
        'fzf'                            "$((LANG=C fzf       --version | head -1 | cut -d ' ' -f1) 2>/dev/null || echo "[Unknown]")"
        'Yazi'                           "$((LANG=C yazi      --version | sed -n 2p | awk '{print $2}') 2>/dev/null || echo "[Unknown]")"
        'Chafa'                          "$((LANG=C chafa     --version | head -1 | cut -d ' ' -f3) 2>/dev/null || echo "[Unknown]")"
        'dvipng'                         "$((LANG=C dvipng    --version | head -1 | cut -d ' ' -f4) 2>/dev/null || echo "[Unknown]")"
        'pdfTeX'                         "$((LANG=C pdftex    --version | head -1 | cut -d ' ' -f2 | cut -d '-' -f3) 2>/dev/null || echo "[Unknown]")"
        'fastfetch'                      "$((LANG=C fastfetch --version | head -1 | cut -d ' ' -f2) 2>/dev/null || echo "[Unknown]")"
        'llama.cpp'                      "$(if command -v llama-server &>/dev/null;then cmd=llama-server;elif command -v llama &>/dev/null;then cmd=llama;else exec echo "[Unknown]";fi; $cmd --version | head -1 | cut -d ' ' -f2 | cut -d '-' -f1)"
        'catimg'                         "$(command -v catimg &>/dev/null && echo "[Installed]"          || echo "[Unknown]")"
      )
      echo "BAI ${status_version[-1]}"
      echo "Copyright © 2026 HornLeaf"
      echo "Thanks to DeepSeek AI for development support."
      echo
      printf "Project Type:      %s\nModification time: %s\nSize:              %s\nNumber of lines:   %s\n" "$VERSION_PROJECTTYPE" "${status_version[0]}" "${status_version[1]}" "${status_version[2]}"
      # printf "|Project Type|%s|\n|Modification time|%s|\n|Size|%s|\n|Number of lines|%s|\n" "$VERSION_PROJECTTYPE" "${status_version[0]}" "${status_version[1]}" "${status_version[2]}" | Render-MDtable
      echo
      echo -e "Depend on:"
      printf "  %-17s%s\n" "${VERSION[@]}"
      # printf "| %s | %s |\n" "${VERSION[@]}" | Render-MDtable
      echo
      echo -e "Optional Extend:"
      printf "  %-17s%s\n" "${EXTEND_VERSION[@]}"
      # printf "|%s|%s|\n" "${EXTEND_VERSION[@]}" | Render-MDtable

      echo
      INTERACT_MODE=false LF=false bye
      ;;
  esac
done

# 次优先解析测试参数，直接退出
for arg in "$@";do
