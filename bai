      ARG_ERR="$(L10n-zh-Hans "option.mcp_config.no_arg_value 未指定 MCP 服务器配置")" \
      ARG_OPTS="mcp-config" \
      ARG_KEY="BAI_MCP_CONFIG" \
      Get-Arguments-Value "$@"
      RETURN=$?
      if [[ "$RETURN" =~ ^10([12])$ ]];then
