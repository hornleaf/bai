          grep -qEv '^\s*$|^\s*#' &&
          ! grep -qE '\$\(|`' "$1"
        );then
      source "$1"
    else
      exmsg "$1: $(L10n-zh-Hans "option.config.sensitive_content 敏感的文件内容")"
    fi
  fi

