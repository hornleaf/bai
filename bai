# 提取脚本内录
function Get-Builtin-Content {
  sed -n \
    "$(
        sed -n "/^# $1/=;/^# $2/=" "$BASH_SOURCE" |
        tr '\n' , | sed 's/,$/p/'
    )" "$BASH_SOURCE" | sed '$d' |
      (${NOTE:-true} && sed '1d;$d;s/^# //g' || cat)
}

