# 规范化 logo 色彩模式
# 用法: bai_logo_mode
# 输出: color | gray | none
# 行为控制:
#       变量 BAI_LOGO_MODE
#       auto（默认）= 跟随 BAI_WAIT_GRADIENT；也可显式指定 color/gray/dual/none
function bai_logo_mode {
  local m="${BAI_LOGO_MODE:-auto}"
  case "${m,,}" in
    auto|follow|跟随)
      bai_wait_gradient_mode "${BAI_WAIT_GRADIENT:-dual}" || echo dual
      ;;
    gray|grey|灰度) echo gray;;
    dual|two|two-color|duo|双色) echo dual;;
    none|off|plain|无) echo none;;
    *) echo color;;
  esac
}

# 渲染 logo 内容
# 用法: bai_logo_render <color|gray|none> [文件]
# 选项:
#       <color|gray|none> 色彩模式
#       [文件] 未指定时从标准输入读取
# 说明:
#       支持与内置 logo 相同的 R,G,B<字符> 彩色令牌（灰度模式下按亮度转灰阶）
#       支持 {{...}} 渐变标记：标记内的字符按模式做渐变着色，标记本身不输出
function bai_logo_render {
  local mode="${1:-color}"
  local file="${2:-}"
  local dual=""
  if [[ "$mode" == "dual" ]];then
    dual="${__bai_wait_dual:-}"
    [ "$dual" ] || dual="$(bai_wait_dual_colors)" || dual="255;128;255 128;255;255"
  fi
  gawk -v mode="$mode" -v dual="$dual" '
    BEGIN {
      freq = 0.1; spread = 3.0; pi = atan2(0, -1);
      split(dual, _dp, " ");
      split(_dp[1], _da, ";"); split(_dp[2], _db, ";");
      d1r = _da[1] + 0; d1g = _da[2] + 0; d1b = _da[3] + 0;
      d2r = _db[1] + 0; d2g = _db[2] + 0; d2b = _db[3] + 0;
    }
      function rainbow(idx) {
        r = int(sin(freq * idx) * 127 + 128);
        g = int(sin(freq * idx + 2*pi/3) * 127 + 128);
        b = int(sin(freq * idx + 4*pi/3) * 127 + 128);
        return sprintf("\033[38;2;%d;%d;%dm", r, g, b);
      }
      function grayscale(idx,   v) {
        v = int(88 + (sin(freq * idx) * 0.5 + 0.5) * 167);
        return sprintf("\033[38;2;%d;%d;%dm", v, v, v);
      }
      # 双色渐变：标记段内从 A 平滑过渡到 B（单项渐变，静止时也像渐变）
      function dual_shade(pos,   t, w, r, g, b) {
        if (mlen > 1) t = (pos - 1) / (mlen - 1); else t = 0.5;
        w = 0.5 - 0.5 * cos(2 * pi * t);
        r = int(d1r + (d2r - d1r) * w);
        g = int(d1g + (d2g - d1g) * w);
        b = int(d1b + (d2b - d1b) * w);
        return sprintf("\033[38;2;%d;%d;%dm", r, g, b);
      }
      function paint(idx, pos) {
        if (mode == "gray") return grayscale(idx);
        if (mode == "dual") return dual_shade(pos);
        return rainbow(idx);
      }
      # 将 R,G,B<字符> 令牌转换为颜色转义（none 模式直接丢掉令牌）
      function convert_tokens(str,   out, tok, a, v) {
        out = "";
        while (match(str, /[0-9][0-9]*,[0-9][0-9]*,[0-9][0-9]*/)) {
          out = out substr(str, 1, RSTART - 1);
          tok = substr(str, RSTART, RLENGTH);
          str = substr(str, RSTART + RLENGTH);
          if (mode != "none") {
            split(tok, a, ",");
            if (mode == "gray") {
              # 亮度映射到 60..255，避免纯色（如亮品红）在灰度下过暗
              v = int(60 + (0.299 * a[1] + 0.587 * a[2] + 0.114 * a[3]) * 0.75);
              if (v > 255) v = 255;
              out = out sprintf("\033[38;2;%d;%d;%dm", v, v, v);
            } else {
              out = out sprintf("\033[38;2;%d;%d;%dm", a[1] + 0, a[2] + 0, a[3] + 0);
            }
          }
        }
        return out str;
      }
      {
        line = convert_tokens($0);
        if (mode == "none" || index(line, "{{") == 0) {
          gsub(/[{][{]/, "", line);
          gsub(/[}][}]/, "", line);
          print line;
          next;
        }
        out = ""; in_marker = 0; mpos = 0; len = length(line); i = 1;
        # 预扫描最长标记段长度，dual 的段内渐变要用
        mlen = 1;
        if (mode == "dual") {
          tmp = line;
          while (match(tmp, /[{][{][^{}]*[}][}]/)) {
            seg = substr(tmp, RSTART + 2, RLENGTH - 4);
            if (length(seg) > mlen) mlen = length(seg);
            tmp = substr(tmp, RSTART + RLENGTH);
          }
        }
        while (i <= len) {
          if (substr(line, i, 1) == "\033" && substr(line, i+1, 1) == "[") {
            start = i;
            while (i <= len && substr(line, i, 1) != "m") i++;
            if (i <= len) i++;
            out = out substr(line, start, i - start);
            continue;
          }
          if (!in_marker && substr(line, i, 2) == "{{") { in_marker = 1; mpos = 0; i += 2; continue; }
          if (in_marker && substr(line, i, 2) == "}}") { in_marker = 0; out = out "\033[0m"; i += 2; continue; }
          ch = substr(line, i, 1);
          if (in_marker) { mpos++; out = out paint(NR + i / spread, mpos) ch; }
          else out = out ch;
          i++;
        }
        print out;
      }
  ' "${file:--}"
}

# 显示ASCII图标
# 用法: Print-Logo
# 行为控制:
#       变量 BAI_LOGO_FILE
#       非空时读取该文件作为 logo；文件不可读或为空时告警并回退内置 logo
#       变量 BAI_LOGO_MODE
#       color（默认经 auto 生效）/ gray / none / auto
#       文件内可使用 R,G,B<字符> 彩色令牌与 {{...}} 渐变标记
function Print-Logo {
  local mode logo_file
  mode="$(bai_logo_mode)"
  bai_color_enabled || mode=none
  logo_file="${BAI_LOGO_FILE:-}"
  if [[ -n "$logo_file" ]];then
    logo_file="${logo_file/#\~/$HOME}"
    if [[ -r "$logo_file" && -s "$logo_file" ]];then
      debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "debug.print_logo_from_file 使用自定义 logo 文件: %s" "$logo_file")"
      bai_logo_render "$mode" "$logo_file"
      return 0
    fi
    emsg "$(L10n-zh-Hans "logo.file_unreadable 自定义 logo 文件不可读或为空: %s，已回退内置 logo" "$logo_file")"
  fi
  Get-Builtin-Content __LOGO_HEAD__ __LOGO_TAIL__ | bai_logo_render "$mode"
}

# logo 状态与切换（.logo 指令）
# 用法: bai_logo_cmd [preview|off|<color|gray|none|auto>|<文件路径>]
function bai_logo_cmd {
  local arg="${1:-}" file
  case "${arg,,}" in
    "")
      msg "$(L10n-zh-Hans "logo.status 当前 logo 文件: %s | 色彩模式: %s（生效: %s）" "${BAI_LOGO_FILE:-$(L10n-zh-Hans "logo.builtin 内置")}" "${BAI_LOGO_MODE:-auto}" "$(bai_logo_mode)")"
      msg "$(L10n-zh-Hans "logo.usage 用法: .logo [preview|off|color|gray|dual|none|auto|<文件路径>]")"
      ;;
    preview)
      Print-Logo
      echo -e "${c0}"
      ;;
    off|builtin|default|内置)
      BAI_LOGO_FILE=""
      msg "$(L10n-zh-Hans "logo.restored 已恢复内置 logo")"
      Print-Logo
      echo
      ;;
    color|gray|grey|dual|two|duo|双色|none|auto)
      BAI_LOGO_MODE="$arg"
      msg "$(L10n-zh-Hans "logo.mode_set logo 色彩模式已设置为: %s（生效: %s）" "$arg" "$(bai_logo_mode)")"
      Print-Logo
      echo
      ;;
    *)
      file="${arg/#\~/$HOME}"
      if [[ -r "$file" && -s "$file" ]];then
        BAI_LOGO_FILE="$file"
        msg "$(L10n-zh-Hans "logo.loaded 已加载自定义 logo: %s" "$file")"
        Print-Logo
        echo
      else
        erron "$(L10n-zh-Hans "logo.file_not_found 文件不存在、不可读或为空: %s" "$file")"
        return 1
      fi
      ;;
  esac
}

