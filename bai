# 等待阻塞任务
# 用法: Wait-Task <wait|kill|pid>
# 选项: <wait|kill|pid>
#       wait 永远等待
#       kill 杀死进程 （wait）
#       pid 进程 PID
# 行为控制:
#       变量 CHAT
#       为 true 时，会在等待过程中输出提示信息
#       为 false 时，<wait> 会立即返回
# 渲染一帧等待动画
# 用法: bai_wait_render <帧号> <帧字符> <已用时间> <提示文字>
# 行为控制:
#       变量 BAI_WAIT_FRAME
#       为 false 时隐藏帧动画前缀（绿色转动的字符），只保留提示文字与计时
function bai_wait_render {
  local frame="$1" glyph="$2" elapsed="$3" text="$4" tmpl
  if [[ "${BAI_WAIT_FRAME:-false}" == "false" ]];then
    tmpl="${l25}\r${text} ${c237}%s${c0}${ek}"
    printf "$(Print-ColorFull "$frame" <<<"$tmpl")" "$elapsed" >&2
  else
    tmpl="${l25}\r\e[1;32m%s${c0} ${text} ${c237}%s${c0}${ek}"
    printf "$(Print-ColorFull "$frame" <<<"$tmpl")" "$glyph" "$elapsed" >&2
  fi
}

function Wait-Task {
  [ "$__wait_task_frame" ] || Switch-Wait-Frame "${BAI_WAIT_STYLE:-}"
  [ "$__bai_wait_gradient" ] || bai_wait_gradient_apply
  local ARG1="$1"
  local ARG2="$2"
  local frame=0
  local wait_msg="${ARG2:-$(L10n-zh-Hans "wait_task.waiting {{正在等待}}")}"
  local exit_prompt="${h25}\r${ek}"
  case "${ARG1:-null}" in
    null)return;;
    wait)
    # 永远等待
      local start_time=$(date +%s)
      Set-Osc-Progress doubt
      while $INTERACT_MODE;do
        for i in "${__wait_task_frame[@]}";do
          bai_wait_render "$frame" "$i" "$(( $(date +%s) - start_time ))s" "$wait_msg"
          frame=$[frame+4]
          sleep 0.05
        done
      done &
      GETWAIT_PID=$!
      ;;
    kill)
    # 杀死进程 （wait）
      Set-Osc-Progress clear
      if kill -0 "$GETWAIT_PID" &>/dev/null;then
        kill "$GETWAIT_PID" &>/dev/null
        printf "$exit_prompt" >&2
      fi
      ;;
    *) 
    # 使用 kill 命令判断进程存在，不存在即停止等待
      local start_time=$(date +%s)
      Set-Osc-Progress doubt
      while $INTERACT_MODE;do
        for i in "${__wait_task_frame[@]}";do
          if kill -0 "$ARG1" &>/dev/null;then
            bai_wait_render "$frame" "$i" "$(( $(date +%s) - start_time ))s" "$wait_msg"
            frame=$[frame+4]
            sleep 0.05
          else
            printf "$exit_prompt" >&2
            Set-Osc-Progress clear
            exec true
          fi
        done
      done
  esac
}

