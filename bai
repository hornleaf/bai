# 交互式补全
# 用法: alias=[命令别名] cmd=[命令] argc_[上一选项]=选项1,选项2.. Interactive-Completion 选项1 选项2..
function Interactive-Completion {
  if ! $BAI_INTERACT_COMPLE; then
    "$@"
    return
  fi
  local arg argc argv args argp valuep valuename valuedesc value desc dict dictf dictd choose mode input i
  args=(${alias:=$cmd})
  argv=0
  while true;do
    valuename=argc_${args[-1]//-/_}
    valuedesc=${valuename}_desc
    argc="${!valuename}"
    argc_desc="${!valuedesc}"
    [[ "$argc" ]] || { $cmd "${args[@]:1}"; return; }
    dict=(${argc//,/ })
    dictf=(${dict[@]})
    dictd=()
    readarray -t desc <<<"$(gawk 'NF' <<<"$argc_desc")"
    for ((i=0;i<${#dict[@]};i++));do
      if [[ "${dict[i]}" =~ ^.\:(.+)$ ]];then
        dictf[i]="${BASH_REMATCH[1]}"
      fi
      dictd[i]="${dictf[i]}|${desc[i]}"
    done
    choose=$(
      enable_backspace=true Dialog-Select "${args[*]}" \
      "${dictd[@]}"
    )
    case $choose in
    exit) return;;
    backspace)
      if ((${#args[@]} > 1));then
        unset args[-1]
        args=(${args[@]})
        ((argv--))
      fi
      ;;
    [0-9]*)
      arg="${dict[choose]}"
      if [[ "$arg" == i:* ]];then
        arg="${dictf[choose]}"
        mode=input
      elif [[ "$arg" == n:* ]];then
        arg="${dictf[choose]}"
        mode=number
      elif [[ "$arg" == b:* ]];then
        arg="${dictf[choose]}"
        mode=bool
      else
        mode=default
      fi
      args+=("$arg")
      ((argv++))
      if [[ ! "$mode" == default ]];then
        case $mode in
          input)
            value="$(Dialog-Input "${args[*]}")"
            case $value in
              exit)
                unset args[-1]
                args=(${args[@]})
                ((argv--))
                continue
                ;;
              *) input=$value;;
            esac
            ;;
          number)
            value="$(Dialog-Range "${args[*]}" 0 256)"
            case $value in
              exit)
                unset args[-1]
                args=(${args[@]})
                ((argv--))
                continue
                ;;
              [0-9]*) input=$value;;
            esac
            ;;
          bool)
            value="$(yes=true no=false notip=true Dialog-Confirm "${args[*]}")"
            case $value in
              yes) input=true;;
              no)  input=false;;
              exit)
                unset args[-1]
                args=(${args[@]})
                ((argv--))
                continue
                ;;
            esac
            ;;
        esac
        args+=("$input")
        ((argv++))
      fi
      ;;
    esac
  done
}

# 用法: Create-Config [文件路径]?
# 格式化创建配置文件
function Create-Config {
  local filepath="$1"
  local i item key keys desc display select input_type inputpath_choose display_value defdisp_value
  declare -A input option envtype message choose
  local env=(
    OPENAI_API_KEY:input#"$(L10n-zh-Hans "create_config.openai_api_key 接口密钥")"
    OPENAI_BASE_URL:input#"$(L10n-zh-Hans "create_config.openai_base_url 起始地址")"
    OPENAI_API_MODEL:input#"$(L10n-zh-Hans "create_config.openai_api_model 模型名称")"
    OPENAI_API_TEMP:input@number#"$(L10n-zh-Hans "create_config.openai_api_temp 采样温度")"
    OPENAI_STOP_TEXTS:input#"$(L10n-zh-Hans "create_config.openai_stop_texts 结束标语")"
    OPENAI_TEXT_NUM:input@number#"$(L10n-zh-Hans "create_config.openai_max_text_num 限制输出字数")"
    OPENAI_TOP_K:input@number#"$(L10n-zh-Hans "create_config.openai_top_k 贪婪采样阈值")"
    OPENAI_TOP_P:input@number#"$(L10n-zh-Hans "create_config.openai_top_p 精简采样阈值")"
    OPENAI_PRESENCE:input@number#"$(L10n-zh-Hans "create_config.openai_presence 重复惩罚阈值")"
    OPENAI_FREQUENCY:input@number#"$(L10n-zh-Hans "create_config.openai_frequency 频率惩罚阈值")"
    OPENAI_MAX_TOKENS:input@number#"$(L10n-zh-Hans "create_config.openai_max_token 限制最大输出量")"
    OPENAI_ENABLE_STREAM:confirm#"$(L10n-zh-Hans "create_config.openai_enable_stream 启用流式响应")"
    OPENAI_INCLUDE_USAGE:confirm#"$(L10n-zh-Hans "create_config.openai_include_usage 启用 Token 统计")"
    OPENAI_ENABLE_SEARCH:confirm#"$(L10n-zh-Hans "create_config.openai_enable_search 启用联网搜索")"
    OPENAI_ENABLE_THINKING:confirm#"$(L10n-zh-Hans "create_config.openai_enable_thinking 启用思维链")"
    OPENAI_ENABLE_PARTIAL:confirm#"$(L10n-zh-Hans "create_config.openai_enable_partial 启用前缀续写")"

    BAI_TITLE:input#"$(L10n-zh-Hans "create_config.bai_title 会话标题")"
    BAI_HISTFILE:file#"$(L10n-zh-Hans "create_config.bai_histfile 历史记录文件")"
    BAI_USERNAME:input#"$(L10n-zh-Hans "create_config.bai_username 用户名")"
    BAI_USERGENDER:confirm[man,woman]#"$(L10n-zh-Hans "create_config.bai_usergender 用户性别")"
    BAI_USERAGE:range[1,100]#"$(L10n-zh-Hans "create_config.bai_userage 用户年龄")"
    BAI_L10N_FILES:file#"$(L10n-zh-Hans "create_config.bai_l10n_files 本地化语言文件")"
    BAI_WAIT_STYLE:select[bar,arc,arrow,dotmatrix,bell,dot,line,block,wave,square,pushpull,roll,invisible]#"$(L10n-zh-Hans "create_config.bai_wait_style 等待时的指示样式")"
    BAI_WAIT_GRADIENT:select[color,gray,dual,none]#"$(L10n-zh-Hans "create_config.bai_wait_gradient 等待指示器渐变模式")"
    BAI_WAIT_DUAL_COLORS:string#"$(L10n-zh-Hans "create_config.bai_wait_dual_colors 双色渐变的两个端点颜色 (r,g,b:r,g,b)")"
    BAI_WAIT_FRAME:bool#"$(L10n-zh-Hans "create_config.bai_wait_frame 是否显示等待动画的帧前缀")"
    BAI_WAIT_GRAY_STYLE:select[band,sine,white,breath,contrast,ramp]#"$(L10n-zh-Hans "create_config.bai_wait_gray_style 灰度渐变风格")"
    BAI_LOGO_FILE:file#"$(L10n-zh-Hans "create_config.bai_logo_file 自定义 logo 文件")"
    BAI_LOGO_MODE:select[auto,color,gray,none]#"$(L10n-zh-Hans "create_config.bai_logo_mode logo 色彩模式")"
    BAI_LIMIT_TURNS:confirm#"$(L10n-zh-Hans "create_config.bai_limit_turns 是否限制对话轮次")"
    BAI_LIMIT_TOOLS:confirm#"$(L10n-zh-Hans "create_config.bai_limit_turns 是否限制小模型使用工具")"
    BAI_CONEMU_STATUS:confirm#"$(L10n-zh-Hans "create_config.bai_conemu_status 启用 ConEmu 进度指示特性")"
    BAI_CALLING_FILE:file#"$(L10n-zh-Hans "create_config.bai_calling_file 指定工具文件")"
    BAI_DISABLE_EXTEND:multiselect[bat,yazi,fzf,gum,chafa,catimg,fastfetch]#"$(L10n-zh-Hans "create_config.bai_disable_multiselect 禁用指定的可选依赖命令")"
    BAI_IMAGE_PREVIEW:confirm#"$(L10n-zh-Hans "create_config.bai_image_preview 启用图像预览")"
    BAI_STREAM_SYNTAX:confirm#"$(L10n-zh-Hans "create_config.bai_stream_syntax 流模式下是否启用 MarkDown 语法增强")"
    BAI_REASONING_REPLACE:input#"$(L10n-zh-Hans "create_config.bai_reasoning_replace 思考强度替换")"
    BAI_USER_PROMPT:input#"$(L10n-zh-Hans "create_config.bai_user_prompt 用户输入提示符")"
    BAI_ASSISANT_PROMPT:input#"$(L10n-zh-Hans "create_config.bai_assisant_prompt 模型返回提示符")"
    BAI_REASONING_PROMPT:input#"$(L10n-zh-Hans "create_config.bai_reasoning_prompt 思维链提示符")"
    BAI_BYE_PROMPT:input#"$(L10n-zh-Hans "create_config.bai_bye_prompt 退出提示符")"
    BAI_RC_FILE:file#"$(L10n-zh-Hans "create_config.bai_rc_file 启动时执行的文件")"
    BAI_ENV_FILE:file#"$(L10n-zh-Hans "create_config.bai_env_file 环境变量文件")"
    BAI_SYSTEM_FILE:file#"$(L10n-zh-Hans "create_config.bai_system_file 系统提示词文件")"
    BAI_PRINT_WELCOME:confirm#"$(L10n-zh-Hans "create_config.bai_print_welcome 显示欢迎词")"
  )

  for ((i=0;i<${#env[@]};i++));do
    [[ "${env[i]}" =~ ^([A-Z0-9_]+?)(\:[a-z]+(\[([a-zA-Z0-9,\-]+)\])?)?(\@([a-z]+))?(\#.+)$ ]]
    # declare -p BASH_REMATCH
    key="${BASH_REMATCH[1]}"
    input["$key"]="${BASH_REMATCH[2]/\:/}"
    envtype["$key"]="${BASH_REMATCH[-2]}"
    message["$key"]="${BASH_REMATCH[-1]/\#/}"
    if [[ "${input["$key"]}" =~ ^([a-z]+)\[([a-zA-Z0-9,\-]+)\]$ ]];then
      input["$key"]="${BASH_REMATCH[1]}"
      option["$key"]="${BASH_REMATCH[2]}"
    fi
    # echo key: $key \| input: ${input["$key"]} \| envtype: ${envtype["$key"]} \| option: ${option["$key"]} \| message: ${message["$key"]}
  done
  # declare -p input envtype message option

  while true;do
    keys=("${!message[@]}")
    desc=("${message[@]}")
    defdisp_value="[Empty Value]"
    for ((i=0;i<${#keys[@]};i++));do
      display_value="${choose["${keys[i]}"]:-$defdisp_value}"
      ((${#display_value}>${#defdisp_value})) && display_value="...${display_value: -$((${#defdisp_value}-3))}"
      display[i]="${keys[i]}|${desc[i]}|$display_value"
    done
    select=$(Dialog-Select "$(L10n-zh-Hans "create_config.home_title 选择要配置的选项")" "${display[@]}")
    case $select in
      exit) break;;
      *)
        select=${keys[select]}
        input_type=${input["$select"]}
        # echo $select, $type
        local -n sel_choose=choose["$select"]
        local -n sel_desc=message["$select"]
        local -n sel_option=option["$select"]
        local -n sel_type=envtype["$select"]
        # echo $sel_desc, $sel_option
        case $input_type in
          input)
            sel_choose="$(Dialog-Input "$sel_desc")"
            [[ "$sel_choose" == exit ]] && sel_choose=""
            if [ "$sel_type" ];then
              if ! [[ "$(Check-Variable-Type sel_choose)" == "$sel_type" ]];then
                sel_choose=""
              fi
            fi
            ;;
          confirm)
            if [[ "$sel_option" ]];then
              local confirm_yes="${sel_option%,*}"
              local confirm_no="${sel_option#*,}"
              sel_choose="$(yes=$confirm_yes no=$confirm_no notip=true Dialog-Confirm "$sel_desc")"
            else
              sel_choose="$(yes=true no=false notip=true Dialog-Confirm "$sel_desc")"
            fi
            [[ "$sel_choose" == exit ]] && sel_choose=""
            ;;
          file)
            sel_choose="$(Get-Choose-File "$sel_desc")"
            ;;
          range)
            local range_min="${sel_option%,*}"
            local range_max="${sel_option#*,}"
            sel_choose="$(Dialog-Range "$sel_desc" $range_min $range_max)"
            [[ "$sel_choose" == exit ]] && sel_choose=""
            ;;
          select)
            [ "$sel_option" ] || continue
            local sel_list=(${sel_option//,/ })
            sel_choose="$(Dialog-Select "$sel_desc" "${sel_list[@]}")"
            if [[ "$sel_choose" == exit ]];then
              sel_choose=""
            else
              sel_choose="${sel_list[sel_choose]}"
            fi
            ;;
          multiselect)
            [ "$sel_option" ] || continue
            local sel_list=(${sel_option//,/ })
            sel_choose="$(Dialog-MultiSelect "$sel_desc" "${sel_list[@]}")"
            if [[ "$sel_choose" == exit ]];then
              sel_choose=""
            else
              local sel_multisel=($sel_choose)
              local sel_multilist=""
              sel_choose=""
              for i in ${sel_multisel[@]};do
                if [ "$sel_multilist" ];then
                  sel_multilist+=",${sel_list[i]}"
                else
                  sel_multilist="${sel_list[i]}"
                fi
              done
              sel_choose="$sel_multilist"
            fi
        esac
        ;;
    esac
  done
  while true;do
    [ "$filepath" ] || filepath="$(Dialog-Input "$(L10n-zh-Hans "create_config.input_filepath 请输入保存路径")")"
    [[ "$filepath" == exit ]] && inputpath_choose="$(Dialog-Confirm "$(L10n-zh-Hans "create_config.input_filepath_confirm_exit 确定取消保存并退出吗？")" no)"
    [[ "$inputpath_choose" == no ]] || return
    [ "$filepath" ] || { emsg "$(L10n-zh-Hans "create_config.empty_input 输入为空，请重试")"; continue;}
    [[ "$filepath" =~ ^(\.?[a-zA-Z0-9_-]+/?)+$ && ! "$filepath" =~ // && ! "$filepath" =~ /$ && ! "$filepath" =~ (\./|\.\.) ]] || {
      emsg "$(L10n-zh-Hans "create_config.illegal_filepath 非法的文件路径 %s" "$filepath")"
      continue
    }
    [ -f "$filepath" ] && {
      msg "$(L10n-zh-Hans "create_config.already_have_file 文件 %s 已存在" "$filepath")"
      inputpath_choose=""
      inputpath_choose="$(Dialog-Confirm "$(L10n-zh-Hans "create_config.overwrite_file_confirm 文件已存在，确定覆写该文件？")" no)"
      [[ "$inputpath_choose" == no ]] && { filepath=""; continue;}
    }
    unset -n sel_choose
    for i in ${keys[@]};do
      local sel_choose="${choose["$i"]}"
      [ "$sel_choose" ] || continue
      echo "# ${message["$i"]}"
      printf "$i="
      input_type="${input["$key"]}"
      if [[ "$input_type" ]];then
        case "$input_type" in
          input|select|multiselect|file)
            echo "'$sel_choose'"
            ;;
          range|confirm)
            echo "$sel_choose"
            ;;
        esac
        echo
      fi
    done > "$filepath"
  done

}

# 设置会话功能
# 用法: Set-Session-Functions <别名> <true|false>
# 设置 BAI 会话功能
# 未指定 <别名> 时，会以列表显示当前设置状态
# 未指定 <true|false> 时，会显示 <别名> 当前状态
function Set-Session-Functions {
  local alias value type name key RETURN
  case "$#" in
    0)
      printf "${c34}%-26s${c35}%-17s${c33}%s${c0}\n" "$(L10n-zh-Hans "set_session_functions.title.alias 别名")" "$(L10n-zh-Hans "set_session_functions.title.value 值")" "$(L10n-zh-Hans "set_session_functions.title.description 描述")"
      for ((i=0;i<${#SET[@]};i++));do
        key=${SET_ALIAS[i]}
        alias=${key%:*}
        description=${SET_DESCRIPTION[i]}
        value=${!SET[i]}
        ((${#value}>=10)) && value="${value:0:10}..."
        printf "${c32}%-24s\e[1;34m%-16s${c0}%s\n" "$alias" "${value:-<none>}" "$description"
      done
      printf "\n"
      ;;
    1)
      alias=$1
      for ((i=0;i<${#SET[@]};i++));do
        key=${SET_ALIAS[i]}
        type=${key%:*}
        value=${!SET[i]}
        if [[ "$alias" == "$type" ]];then
          debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_session_functions.debug.print_setting 打印 %s 的当前设置" "${1:-Null}")"
          echo "$value"
          return
        fi
      done
      erron "$(L10n-zh-Hans "set_session_functions.error.unknown_option 未知的选项 %s" "$alias")"
      ;;
    2)
      alias=$1
      value=$2
      for ((i=0;i<${#SET[@]};i++));do
        key=${SET_ALIAS[i]}
        type=${key#*:}
        option=${key%:*}
        name=${SET[i]}
        if [[ "$alias" == "$option" ]];then
          case $type in
            bool)
              if [[ "${value}" =~ ^(false|true)$ ]];then
                debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_session_functions.debug.setting_bool 设置项为布尔值: %s 的值将被设置为 %s" "$name" "$value")"
                printf -v "$name" "$value"
              else
                erron "$(L10n-zh-Hans "set_session_functions.error.invalid_bool 仅允许使用布尔值")"
                return
              fi
              return
              ;;
            string)
              case "$alias" in
                enable-thinking)
                  OPENAI_API_ENABLE_THINKING="$value"
                  thinking.setkey "$value"
                  return
                  ;;
                enable-search)
                  OPENAI_API_ENABLE_SEARCH="$value"
                  search.setkey "$value"
                  return
                  ;;
                chat-model)
                  Switch-Model "$value"
                  RETURN=$?
                  ;;
                call-tools)
                  local found=false
                  for option in "${BAI_CALLTOOLS_in_array[@]}";do
                    if [[ "$option" == "$value" ]];then
                      data.setkey "tool_choice" "$value"
                      RETURN=$?
                      found=true
                      break
                    fi
                  done
                  if ! $found;then
                    erron "$(L10n-zh-Hans "set_session_functions.error.invalid_option 仅允许使用以下选项: %s" "${BAI_CALLTOOLS_in_array[*]}")"
                    return
                  fi
                  ;;
                reasoning-effort)
                  reasoning_effort.setkey "$value"
                  RETURN=$?
                  ;;
                api-style)
                  case "$value" in
                    chat|responses) ;;
                    *)
                      erron "$(L10n-zh-Hans "set_session_functions.error.invalid_option 仅允许使用以下选项: %s" "chat responses")"
                      return
                      ;;
                  esac
                  ;;
                wait-gradient)
                  local _wg
                  if ! _wg="$(bai_wait_gradient_mode "$value")";then
                    erron "$(L10n-zh-Hans "set_session_functions.error.invalid_option 仅允许使用以下选项: %s" "color gray dual none")"
                    return
                  fi
                  value="$_wg"
                  bai_wait_gradient_apply "$value"
                  ;;
                wait-dual-colors)
                  local _dc _dc1 _dc2
                  _dc="$(bai_wait_dual_colors "$value")"
                  if [[ "${_dc}" == "255;128;255 128;255;255" && "${value// /}" != "255,128,255:128,255,255" ]];then
                    erron "$(L10n-zh-Hans "set_session_functions.error.invalid_option 仅允许使用以下选项: %s" "r,g,b:r,g,b（如 255,128,255:128,255,255）")"
                    return
                  fi
                  _dc1="${_dc%% *}"; _dc2="${_dc##* }"
                  value="${_dc1//;/},:${_dc2//;/},"
                  value="${value/,:/:}"
                  value="${value%,}"
                  __bai_wait_dual="$_dc"
                  ;;
                wait-gray-style)
                  local _gs
                  if ! _gs="$(bai_wait_gray_style "$value")";then
                    erron "$(L10n-zh-Hans "set_session_functions.error.invalid_option 仅允许使用以下选项: %s" "band sine white breath contrast ramp")"
                    return
                  fi
                  value="$_gs"
                  __bai_gray_style="$value"
                  ;;
                logo-mode)
                  case "${value,,}" in
                    auto|color|gray|grey|dual|two|duo|双色|none) ;;
                    *)
                      erron "$(L10n-zh-Hans "set_session_functions.error.invalid_option 仅允许使用以下选项: %s" "auto color gray dual none")"
                      return
                      ;;
                  esac
                  ;;
                logo-file)
                  value="${value/#\~/$HOME}"
                  if [[ -n "$value" && ( ! -r "$value" || ! -s "$value" ) ]];then
                    erron "$(L10n-zh-Hans "set_session_functions.error.file_not_readable 文件不存在、不可读或为空: %s" "$value")"
                    return
                  fi
                  ;;
              esac
              ((RETURN)) && return
              debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_session_functions.debug.setting_string 设置项为字符串值: %s 的值将被设置为 %s" "$name" "$value")"
              printf -v "$name" "$value"
              return
              ;;
            number)
              if [[ "${value}" =~ ^-?[0-9]+(\.[0-9]+)?$ ]];then
                debug "$(DEBUG_MESSAGE=true L10n-zh-Hans "set_session_functions.debug.setting_number 设置项为数值: %s 的值将被设置为 %s" "$name" "$value")"
                printf -v "$name" "$value"
                return
              else
                erron "$(L10n-zh-Hans "set_session_functions.error.invalid_number 仅允许使用数值")"
                return
              fi
              ;;
            *)
              erron "$(L10n-zh-Hans "set_session_functions.error.unknown_type 未知的类型 %s" "$type")"
              return
              ;;
          esac
          return
        fi
      done
      erron "$(L10n-zh-Hans "set_session_functions.error.unknown_option 未知的选项 %s" "$alias")"
  esac
}

########################################################################

# 检查文件类型
# 用法: Check-File-Type <文件路径>
# 输入: <文件路径> 要检查的文件路径
# 行为控制:
#       变量 check_file_type
#       存储目标文件的大致类型
# * 作为条件组件使用时，返回值为 0 时为真，1 为假
function Check-File-Type {
  local typeof="$(file -b "${1:--}" 2>/dev/null)"
  local check
  check_file_type=""
  [[ "$typeof" =~ ^(.+UTF-8.+|ASCII text|JSON text data)$ ]]
  case "$typeof" in
  *UTF-8*|ASCII*|*text*)
    check_file_type=text
    check=true
    ;;
  *image*)
    check_file_type=image
    check=true
    ;;
  *)
    check_file_type=unknown
    check=false
    ;;
  esac
  $check
}

# 判断变量类型
# 用法: Check-Variable-Type <变量名>
# 输入: <变量名> 要检查的变量名
# 输出: 变量类型
# 类型:
#       zero 空变量
#       array 数组
#       number 数值
#       url 链接
#       boolean 布尔值
#       option 选项参数
#       string 字符串
#       unknown 未知类型
function Check-Variable-Type {
  if [ -z "${!1}" ];then
    echo "zero"      # 空变量
  elif declare -p "$1" 2>/dev/null | grep -q 'declare -a';then
    echo "array"     # 数组
  elif [[ "${!1}" =~ ^-?[0-9,]+(\.[0-9,]+)?([kmgtpy])?$ ]];then   
    echo "number"    # 数值
  # elif [[ "${!1}" =~ ^([Vv])?[0-9a-zA-Z_-]+(\.[0-9a-zA-Z_-]+)?$ ]];then
  #   echo "version"   # 版本号，这可能与其他类型冲突，将合并至字符串类型
  elif [[ "${!1}" =~ ^https?://[0-9a-zA-Z./?=\&%-_]+$ ]];then
    echo "url"       # 链接
  elif [[ "${!1,,}" =~ ^(fals|tru)e$ ]];then
    echo "boolean"   # 布尔值
  elif [[ "${!1}" =~ ^-{1,2}[0-9a-zA-Z_-]+$ ]];then
    echo "option"    # 选项参数
  elif [[ "${!1}" =~ ^.+$ ]];then
    echo "string"    # 字符串
  else
    echo "unknown"   # 未知类型
  fi
}

