# 获取命令输出
# 用法: Get-Command-Output <命令>
# 选项:
#       <命令> 要执行的命令
# 行为控制:
#       变量 gco_return_content
#         命令执行完成后，将输出内容存储在变量 gco_return_content 中
#       变量 gco_status
#         命令执行完成后，将退出状态存储在变量 gco_status 中
#       变量 explicitly
#         为 true 时，命令执行完成后，输出内容将存储在变量 gco_return_content，同时打印到终端
#         为 false 时，命令执行完成后，输出内容仅存储在变量 gco_return_content 中，不会打印至终端
#       变量 catch_strerr
#         为 true 时，命令执行时捕获标准错误输出
#         为 false 时，仅捕获标准输出
function Get-Command-Output {
  local term_width=$(Get-TWidth)
  local mode="${explicitly:-false}"
  local outerrmode="${catch_stderr:-true}"
  Create-TempFile get_command_output
  local temp_file="${BAI_TEMP_FILES[get_command_output]}"
  if [[ "$mode" != "silence" ]];then
    [[ -z "$term_width" ]] && term_width=80
    Wait-Task wait "$(L10n-zh-Hans "wait_task.executing_command {{工具正在执行命令...}}")"
  fi
  eval "$*" "$([[ "$outerrmode" == "true" ]] && echo "2>&1")" > >(
    if [[ "$mode" == "true" ]];then
      tee "$temp_file" | stdbuf -oL fold -w $[term_width+4] | sed $'s/^/\r\e[K \e[35m┃\e[0m /g'
    elif [[ "$mode" == "raw" ]];then
      tee "$temp_file"
    else
      cat > "$temp_file"
    fi
  )
  gco_status=$PIPESTATUS
  : "// 告知模型已调用的函数执行状态，避免无输出的函数让模型产生未成功执行的幻觉，点名GLM-5"
  echo "Run Command: $*, Status Code: $gco_status" >> "$temp_file"
  if [[ "$mode" != "silence" ]];then
    Wait-Task kill
    echo -e " ${c35}┗${c0} $(L10n-zh-Hans "get_command_output.status 工具返回状态:") $( ((gco_status)) && printf "${c31}" || printf "${c32}")$gco_status${c0}"
  fi
  gco_return_content="$(cat "$temp_file")"
  Remove-TempFile get_command_output
}

